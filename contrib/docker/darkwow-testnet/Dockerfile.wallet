# DarkWow Wallet Container
#
# Minimal image with just dwow_wallet — the DarkWow wallet CLI.
# Builds only dwow_wallet (no dwowd, no WASM contracts, no lilith).
# Fast build (~5min vs ~20min for full testnet image).
#
# Build from repo root:
#   docker build -t darkwow-wallet . -f contrib/docker/darkwow-testnet/Dockerfile.wallet \
#     --build-arg CARGO_PACKAGE=dwow_wallet
#
# Or use the build script:
#   IMAGE_NAME=darkwow-wallet contrib/docker/darkwow-testnet/build-and-push.sh

# ============================================================================
# Stage 1: Rust Builder
# ============================================================================
FROM darkwow-base:24.04 AS builder

ENV CARGO_BUILD_JOBS=2
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

WORKDIR /app

# Shallow clone (--depth 1) from origin on linear-master branch.
# Full clone is ~200MB and hits Codeberg CDN 504 timeouts; shallow clone
# transfers <10MB and completes in seconds.
# Retry on transient CDN errors (Codeberg sometimes returns 504).
RUN for i in 1 2 3 4 5; do \
        git clone --depth 1 --single-branch --branch linear-master \
            https://codeberg.org/PatrickM123/darkwow.git /app && break || sleep 10; \
    done

# Build dwow_wallet only — no WASM contracts, no dwowd, no lilith
ARG CARGO_PACKAGE=dwow_wallet
RUN cargo build -p ${CARGO_PACKAGE} --release -j 2

RUN cp target/release/${CARGO_PACKAGE} /app/dwow_wallet

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM darkwow-base:24.04

WORKDIR /app

COPY --from=builder /app/dwow_wallet ./

COPY contrib/docker/darkwow-testnet/entrypoint-wallet.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
