# DarkWow Base Image — pre-baked system dependencies + Rust toolchain
#
# Every DarkWow Docker image inherits from this. All build and runtime
# dependencies across all build profiles live here so per-commit Dockerfiles
# are pure git clone + cargo build with zero apt-get overhead.
#
# Build:
#   docker build -t darkwow-base:24.04 -f contrib/docker/darkwow-testnet/Dockerfile.base .
#
# Push (optional, for CI):
#   docker tag darkwow-base:24.04 codeberg.org/darkrenaissance/darkfi/darkwow-base:24.04
#   docker push codeberg.org/darkrenaissance/darkfi/darkwow-base:24.04

FROM ubuntu:24.04

# All build + runtime dependencies for every Dockerfile in the repo.
# One install line so Docker caches it as a single layer.
RUN apt-get update && apt-get install -y \
    build-essential gcc g++ make cmake curl git wget openssl bzip2 \
    libssl-dev pkg-config tcl-dev clang libsqlite3-dev libasound2-dev libsqlcipher-dev \
    libuv1-dev libhwloc-dev xz-utils xxd \
    libboost-filesystem1.83 libboost-thread1.83 libboost-program-options1.83.0 \
    libzmq5 libsodium23 libunbound8 libhidapi-libusb0 libreadline8t64 libuv1t64 libcurl4t64 && \
    rm -rf /var/lib/apt/lists/*

# Rust toolchain (stable — matches host rustc)
RUN curl https://sh.rustup.rs -sSf | bash -s -- -y \
    --default-toolchain stable

ENV PATH="/root/.cargo/bin:${PATH}"
ENV LIBCLANG_PATH="/usr/lib/x86_64-linux-gnu"
ENV RUST_MIN_STACK=67108864

# Official xmrig binary (statically linked) — avoids glibc fortify buffer overflow
# in Ubuntu's packaged xmrig 6.21.1 during RandomX dataset init.
# Downloaded here so every derived image inherits it; checksum-verified.
RUN wget -q https://github.com/xmrig/xmrig/releases/download/v6.22.2/xmrig-6.22.2-linux-static-x64.tar.gz && \
    echo "b2c88b19699e3d22c4db0d589f155bb89efbd646ecf9ad182ad126763723f4b7  xmrig-6.22.2-linux-static-x64.tar.gz" > /tmp/xmrig.sha256 && \
    sha256sum -c /tmp/xmrig.sha256 && \
    tar xf xmrig-6.22.2-linux-static-x64.tar.gz && \
    cp xmrig-6.22.2/xmrig /usr/local/bin/xmrig && \
    rm -rf xmrig-6.22.2* /tmp/xmrig.sha256

# b3sum — used by entrypoint.sh to derive magic bytes from network name
# CARGO_BUILD_JOBS limits cargo install parallelism (otherwise uses all CPUs)
ENV CARGO_BUILD_JOBS=2
RUN cargo install b3sum
