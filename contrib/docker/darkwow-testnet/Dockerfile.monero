# DarkWow Merge Mining — monerod Docker image
#
# Downloads pre-built monerod binary from getmonero.org.
# Build from repo root:
#   docker build -t darkwow-monerod -f contrib/docker/darkwow-testnet/Dockerfile.monero .

FROM ubuntu:24.04

# Runtime dependencies for Monero CLI binaries (monerod + monero-wallet-cli)
RUN apt-get update && apt-get install -y \
    curl bzip2 \
    libboost-filesystem1.83 libboost-thread1.83 libboost-program-options1.83.0 \
    libssl3 libzmq5 libsodium23 libunbound8 liblzma5 libhidapi-libusb0 \
    libreadline8t64 libuv1t64 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download latest Monero CLI release (includes monerod + monero-wallet-cli)
RUN curl -sL https://downloads.getmonero.org/cli/linux64 -o monero.tar.bz2 && \
    tar -xjf monero.tar.bz2 --strip-components=1 && \
    rm monero.tar.bz2 && \
    chmod +x monerod monero-wallet-cli && \
    cp monerod monero-wallet-cli /usr/local/bin/

COPY contrib/docker/darkwow-testnet/entrypoint-monero.sh /app/entrypoint-monero.sh
RUN chmod +x /app/entrypoint-monero.sh

ENTRYPOINT ["/app/entrypoint-monero.sh"]
