# DarkWow Merge Mining — standalone xmrig Docker image
# Builds xmrig from source. Build from repo root:
#   docker build -t xmrig -f contrib/docker/darkwow-testnet/Dockerfile.xmrig .

FROM darkwow-base:24.04 AS builder

WORKDIR /build

RUN git clone https://github.com/xmrig/xmrig.git && \
    cd xmrig && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DWITH_HWLOC=OFF && \
    make -j2

FROM darkwow-base:24.04

COPY --from=builder /build/xmrig/build/xmrig /usr/local/bin/xmrig

ENTRYPOINT ["/usr/local/bin/xmrig"]
