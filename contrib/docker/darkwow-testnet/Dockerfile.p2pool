# DarkWow Merge Mining — p2pool Docker image
#
# Downloads pre-built p2pool binary from GitHub releases.
# Build from repo root:
#   docker build -t darkwow-p2pool -f contrib/docker/darkwow-testnet/Dockerfile.p2pool .

FROM darkwow-base:24.04

WORKDIR /app

# Download pre-built p2pool binary
ARG P2POOL_VERSION=v4.14
RUN curl -sL "https://github.com/SChernykh/p2pool/releases/download/${P2POOL_VERSION}/p2pool-${P2POOL_VERSION}-linux-x64.tar.gz" -o p2pool.tar.gz && \
    tar -xzf p2pool.tar.gz --strip-components=1 && \
    rm p2pool.tar.gz && \
    chmod +x p2pool && \
    cp p2pool /usr/local/bin/

# Use official xmrig binary (statically linked) to avoid glibc fortify buffer overflow
# in Ubuntu's packaged xmrig 6.21.1 during RandomX dataset init
RUN wget -q https://github.com/xmrig/xmrig/releases/download/v6.22.2/xmrig-6.22.2-linux-static-x64.tar.gz && \
    tar xf xmrig-6.22.2-linux-static-x64.tar.gz && \
    cp xmrig-6.22.2/xmrig /usr/local/bin/xmrig && \
    rm -rf xmrig-6.22.2*

COPY contrib/docker/darkwow-testnet/entrypoint-p2pool.sh /app/entrypoint-p2pool.sh
RUN chmod +x /app/entrypoint-p2pool.sh

ENTRYPOINT ["/app/entrypoint-p2pool.sh"]
