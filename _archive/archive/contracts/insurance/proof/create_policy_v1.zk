k = 11;
field = "pallas";

const "CreatePolicyV1" {
    EcFixedPointBase POLICYHOLDER_K,
    # POLICYHOLDER_K is a fixed generator point on the Pallas curve.
    # Used with ec_mul_base to derive public keys from policyholder secrets.
}

witness "CreatePolicyV1" {
    # =========================================================================
    # PUBLIC INPUTS (verified on-chain)
    # =========================================================================

    # Policy identifier (Poseidon hash commitment)
    Base policy_id,

    # Policyholder's DarkFi public key (X coordinate)
    Base policyholder_pub_x,

    # Policyholder's DarkFi public key (Y coordinate)
    Base policyholder_pub_y,

    # Hash of personal details (stored off-chain)
    Base details_hash,

    # Coverage amount requested (payout on claim)
    Uint64 coverage_amount,

    # Premium amount being paid
    Uint64 premium,

    # Token ID for payment
    Base payment_token,

    # Coverage start block
    Uint64 start_block,

    # Coverage end block
    Uint64 end_block,

    # Policy status (should be 0 = Created)
    Base status,

    # Current block height (for time validation)
    Uint64 current_block,

    # =========================================================================
    # PRIVATE INPUTS (witnesses, never revealed on-chain)
    # =========================================================================

    # Policyholder's secret key (proves ownership)
    Base policyholder_secret,

    # Nonce for the policy ID (unpredictability)
    Base nonce,

    # Coverage ratio in basis points (e.g., 8000 = 80%)
    Uint64 coverage_ratio,
}

circuit "CreatePolicyV1" {
    # ==========================================================================
    # PHASE 1: Derive policyholder public key from secret
    # ==========================================================================
    #
    # The policyholder proves they own the private key by deriving the
    # public key from the secret in zero knowledge.

    # Derive policyholder public key from secret
    derived_pub = ec_mul_base(policyholder_secret, POLICYHOLDER_K);

    # Extract coordinates
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);

    # Constrain derived public key matches the public input
    constrain_equal_base(derived_pub_x, policyholder_pub_x);
    constrain_equal_base(derived_pub_y, policyholder_pub_y);

    # ==========================================================================
    # PHASE 2: Verify policy ID (commitment)
    # ==========================================================================
    #
    # The policy ID is a commitment that binds:
    #   - policyholder: who owns this policy
    #   - details_hash: personal details (stored off-chain)
    #   - coverage_amount: payout amount
    #   - premium: payment amount
    #   - start_block: when coverage begins
    #   - end_block: when coverage ends
    #   - policyholder_secret + nonce: ensures only policyholder can use this

    derived_id = poseidon_hash(
        policyholder_pub_x,
        policyholder_pub_y,
        details_hash,
        coverage_amount.into(),
        premium.into(),
        start_block.into(),
        end_block.into(),
        policyholder_secret,
        nonce
    );

    # Constrain policy ID matches
    constrain_equal_base(derived_id, policy_id);

    # ==========================================================================
    # PHASE 3: Validate policy parameters
    # ==========================================================================
    #
    # The prover must satisfy:
    #   - coverage_amount > 0
    #   - premium > 0
    #   - coverage_ratio <= 10000 (can't exceed 100%)
    #   - coverage_period > 0 (end_block > start_block)
    #   - start_block > current_block (coverage hasn't started)

    # Validate coverage_amount > 0
    # We check that coverage_amount is in valid range [1, max_u64)
    range_check(coverage_amount);
    less_than_strict(0, coverage_amount);

    # Validate premium > 0
    less_than_strict(0, premium);

    # Validate coverage_ratio <= 10000
    # coverage_ratio is in basis points (10000 = 100%)
    less_than_or_equal(coverage_ratio, 10000);

    # Validate coverage period > 0
    less_than_strict(start_block, end_block);

    # Validate coverage hasn't started yet
    less_than_strict(current_block, start_block);

    # Validate status is Created (0)
    # Status 0 = Created
    is_equal_base(status, 0);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes (no grey-market opcodes):
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - less_than_or_equal: verified sound (uses base_div internally)
    #   - range_check: ensures value is in valid range
    #   - constrain_equal_base: equality constraint
    #
    # There are NO uses of:
    #   - IsEqualBase (delta-invert issue when a == b) - replaced with is_equal_base
    #   - NotBase, BaseLtStrict (unused experimental)
    #
    # The block-based time lock is sound because:
    #   - DarkFi block numbers are deterministic
    #   - The constraint only verifies current_block < start_block
    #   - This proves coverage hasn't begun yet
    #
    # The coverage_ratio check uses less_than_or_equal which is verified sound
    # and uses base_div internally for the cross-multiplication approach.
}