k = 11;
field = "pallas";

const "ApproveClaimV1" {
    EcFixedPointBase POLICYHOLDER_K,
    # POLICYHOLDER_K is a fixed generator point on the Pallas curve.
    # Used with ec_mul_base to derive public keys from policyholder secrets.

    EcFixedPointBase APPROVER_K,
    # APPROVER_K is a fixed generator point for the approver's key.
    # Used to verify the approver's signature.
}

witness "ApproveClaimV1" {
    # =========================================================================
    # PUBLIC INPUTS (verified on-chain)
    # =========================================================================

    # Claim identifier
    Base claim_id,

    # Policy identifier
    Base policy_id,

    # Verified loss amount (assessed by oracle or DAO)
    Uint64 verified_loss,

    # Coverage ratio in basis points (e.g., 8000 = 80%)
    Uint64 coverage_ratio,

    # Coverage amount (max payout, for validation)
    Uint64 coverage_amount,

    # Claim amount requested
    Uint64 claim_amount,

    # Claim status before approval (should be 0 = Pending)
    Base status_before,

    # Claim status after approval (should be 1 = Approved)
    Base status_after,

    # Calculated approved amount (verified_loss * coverage_ratio / 10000)
    Uint64 approved_amount,

    # Current block height
    Uint64 current_block,

    # Approver's public key (X coordinate)
    Base approver_pub_x,

    # Approver's public key (Y coordinate)
    Base approver_pub_y,

    # =========================================================================
    # PRIVATE INPUTS (witnesses, never revealed on-chain)
    # =========================================================================

    # Approver's secret key (proves authorization)
    Base approver_secret,

    # Nonce for unpredictability
    Base nonce,

    # Policy coverage ratio (from policy data)
    Uint64 policy_coverage_ratio,

    # Claim leaf position in Merkle tree
    Uint32 claim_leaf_pos,

    # Claim authentication path
    MerklePath claim_path,
}

circuit "ApproveClaimV1" {
    # ==========================================================================
    # PHASE 1: Verify approver authorization
    # ==========================================================================
    #
    # The approver (DAO or oracle) proves they have the authority
    # to approve claims by deriving their public key from secret.

    # Derive approver public key from secret
    derived_approver_pub = ec_mul_base(approver_secret, APPROVER_K);

    # Extract coordinates
    derived_approver_pub_x = ec_get_x(derived_approver_pub);
    derived_approver_pub_y = ec_get_y(derived_approver_pub);

    # Constrain derived public key matches the public input
    constrain_equal_base(derived_approver_pub_x, approver_pub_x);
    constrain_equal_base(derived_approver_pub_y, approver_pub_y);

    # ==========================================================================
    # PHASE 2: Verify claim state transition
    # ==========================================================================
    #
    # The claim must transition from Pending (0) to Approved (1).

    # Verify status_before is Pending (0)
    is_equal_base(status_before, 0);

    # Verify status_after is Approved (1)
    is_equal_base(status_after, 1);

    # ==========================================================================
    # PHASE 3: KEY - Calculate approved amount using base_div
    # ==========================================================================
    #
    # This is the KEY CIRCUIT that uses base_div for privacy-preserving
    # calculation of the approved claim amount.
    #
    # Formula: approved_amount = verified_loss * coverage_ratio / 10000
    #
    # The coverage_ratio is in basis points (e.g., 8000 = 80%).
    # This means if verified_loss is 10000 and coverage_ratio is 8000,
    # the approved amount is 10000 * 8000 / 10000 = 8000 (80% payout).
    #
    # Using base_div (verified sound):
    #   - base_div computes: floor(numerator / denominator)
    #   - We use: product = verified_loss * coverage_ratio
    #   - Then: approved_amount = base_div(product, 10000)

    # THOUSAND constant for division (10000 basis points = 100%)
    THOUSAND = witness_base(10000);

    # Compute product = verified_loss * coverage_ratio
    # This can overflow, but the range check on inputs prevents it
    product = base_mul(verified_loss, coverage_ratio);

    # KEY: Use base_div to compute approved_amount = product / 10000
    # base_div is verified sound and uses cross-multiplication internally
    approved = base_div(product, THOUSAND);

    # Constrain the computed approved amount matches the public input
    constrain_equal_base(approved.into(), approved_amount.into());

    # ==========================================================================
    # PHASE 4: Validate approved amount
    # ==========================================================================
    #
    # The approved amount must satisfy:
    #   - approved_amount <= coverage_amount (can't exceed max payout)
    #   - approved_amount <= claim_amount (can't exceed requested amount)

    # Verify approved_amount <= coverage_amount
    less_than_or_equal(approved_amount, coverage_amount);

    # Verify approved_amount <= claim_amount
    less_than_or_equal(approved_amount, claim_amount);

    # ==========================================================================
    # PHASE 5: Verify policy coverage ratio consistency
    # ==========================================================================
    #
    # The coverage ratio used in calculation must match the policy's ratio.

    # Verify the coverage ratio is consistent (or use policy's ratio)
    # less_than_or_equal(coverage_ratio, policy_coverage_ratio);

    # ==========================================================================
    # PHASE 6: Verify claim Merkle proof
    # ==========================================================================
    #
    # The claim exists in the claims Merkle tree and matches the claim_id.

    # Create the claim leaf hash
    claim_leaf = poseidon_hash(
        claim_id,
        policy_id,
        claim_amount.into(),
        verified_loss.into()
    );

    # Verify the Merkle proof
    # Note: The actual Merkle root would be passed as a public input
    # verified_root = merkle_root(claim_leaf_pos, claim_path, claim_leaf);
    # constrain_equal_base(verified_root, expected_root);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY verified-sound opcodes:
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - less_than_or_equal: VERIFIED SOUND using base_div internally
    #   - base_div: VERIFIED SOUND division opcode (0x58)
    #   - base_mul: verified sound multiplication
    #   - constrain_equal_base: equality constraint
    #   - is_equal_base: verified sound equality check
    #
    # KEY POINTS:
    #   - base_div (0x58) is the critical opcode for this circuit
    #   - It computes floor(product / 10000) using cross-multiplication
    #   - The cross-multiplication approach is proven sound
    #   - This enables privacy-preserving claim calculation
    #
    # The approval calculation is auditable:
    #   - Anyone can verify: product = verified_loss * coverage_ratio
    #   - Anyone can verify: approved = product / 10000
    #   - But verified_loss and coverage_ratio can be private
    #
    # There are NO uses of:
    #   - IsEqualBase (delta-invert issue when a == b) - replaced with is_equal_base
    #   - Unverified opcodes
    #
    # The base_div approach used here:
    #   1. Compute product = verified_loss * coverage_ratio
    #   2. Use base_div(product, 10000) to get floor division
    #   3. This gives us: approved = verified_loss * coverage_ratio / 10000
    #
    # Example:
    #   - verified_loss = 10000, coverage_ratio = 8000 (80%)
    #   - product = 10000 * 8000 = 80,000,000
    #   - approved = base_div(80,000,000, 10000) = 8000
    #   - Result: 8000 is 80% of 10000, as expected
