#!/bin/bash
# Pre-commit check on .zk circuits: a `constrain_equal_base(A, B)` where the prover
# chooses *both* operands proves nothing — the equality holds for any witness, so the
# verifier learns nothing from it. That is OBL-Z9's defect.
#
# ---------------------------------------------------------------------------
# This hook used to enforce the OPPOSITE rule, in awk, and was wrong.
#
# It required that a value derived by `ec_get_x` be bound by `constrain_equal_base`
# before being exposed. Read the sound patterns in src/contract/oracle/proof/push_value.zk
# (which keeps the old form as a comment annotated `-- witness == witness`, line 53) and
# it is clear the derive-and-expose form is what OBL-Z9's remedy ADOPTED:
#
#   SOUND    pub = ec_mul_base(secret, K); constrain_instance(ec_get_x(pub));
#   UNSOUND  derived = ec_get_x(ec_mul_base(s, K)); constrain_equal_base(derived, pub_x);
#            where pub_x is a free witness and neither side is exposed
#
# So the old check would have rejected a commit touching proofs/core/{burn,opcodes}.zk for
# being correct. It never fired only because those files were not edited while it existed.
# It was also line-anchored, tracked a single pending name, matched by substring, and
# scanned only staged files.
#
# ---------------------------------------------------------------------------
# The replacement is `scripts/check-pubkey-binding.sh`. It was REPORT-ONLY here while its
# findings were unadjudicated — a gate whose authority is not yet defensible is worse than a
# report — and it **blocks as of 2026-09-23**, because the adjudication happened. All 57
# candidates were read, circuit and host together, in six slices (OBL-Z18); each is now listed
# in `script/circuit_pubkey_binding_exceptions.txt` with either the mechanism that makes it
# sound or the register row that schedules its repair. Fifteen of the 57 are genuine defects,
# named in OBL-C81, C82, C83, C84 and OBL-C75.
#
# So this hook now fails on any finding NOT in that list — a new vacuous binding anywhere is a
# blocked commit — and passes with the adjudicated set reported and counted. The checker itself
# exits non-zero if it cannot run, because a check that silently does nothing is worse than no
# check.

echo "Checking circuit bindings for vacuous constrain_equal_base..."

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
CHECKER="$REPO_ROOT/scripts/check-pubkey-binding.sh"

if [ ! -x "$CHECKER" ]; then
    echo "ERROR: $CHECKER is missing or not executable."
    echo "A check that cannot run must not look like a check that passed."
    exit 1
fi

# Staged .zk files; fall back to the whole corpus when nothing is staged.
FILES=()
while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$REPO_ROOT/$f" ] && FILES+=("$REPO_ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.zk$' || true)

if [ "${#FILES[@]}" -eq 0 ]; then
    STATUS=0
    OUT="$(bash "$CHECKER" --all 2>&1)" || STATUS=$?
else
    STATUS=0
    OUT="$(bash "$CHECKER" "${FILES[@]}" 2>&1)" || STATUS=$?
fi

# Summarised, not dumped. The full list is 57 lines across twelve contracts and printing it on
# every commit is how a hook gets disabled — and a disabled hook is worse than a quiet one.
if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "BLOCKED: unexcepted vacuous binding(s) — the lines above name them."
    echo "  A constrain_equal_base whose two sides are both prover-chosen proves nothing: the"
    echo "  equality holds for any witness, so the verifier learns nothing from it."
    echo "  If both sides have been read and the finding is sound, add it to"
    echo "  script/circuit_pubkey_binding_exceptions.txt with its mechanism or register row."
    exit 1
fi

if printf '%s' "$OUT" | grep -q '^EXCEPTED:'; then
    N="$(printf '%s' "$OUT" | grep -c '^EXCEPTED:')"
    echo ""
    echo "OK: $N vacuous-binding site(s) adjudicated and scheduled (OBL-Z18)."
    echo "  Each entry names either the register row that schedules its repair or the mechanism that"
    echo "  makes it sound, and this hook fails on a finding that is NOT in that list. No count of"
    echo "  defects is printed here: the classes overlap, so every tally that was written drifted."
    echo "  See script/circuit_pubkey_binding_exceptions.txt, or run scripts/check-pubkey-binding.sh."
else
    echo "OK: no vacuous bindings."
fi
exit 0
