#!/bin/bash
# Pre-commit check on .zk circuits: a `constrain_equal_base(A, B)` where the prover
# chooses *both* operands proves nothing — the equality holds for any witness, so the
# verifier learns nothing from it. That is OBL-Z9's defect.
#
# ---------------------------------------------------------------------------
# This hook used to enforce the OPPOSITE rule, in awk, and was wrong.
#
# It required that a value derived by `ec_get_x` be bound by `constrain_equal_base`
# before being exposed. Read the sound patterns in src/contract/oracle/proof/push_value.zk
# (which keeps the old form as a comment annotated `-- witness == witness`, line 53) and
# it is clear the derive-and-expose form is what OBL-Z9's remedy ADOPTED:
#
#   SOUND    pub = ec_mul_base(secret, K); constrain_instance(ec_get_x(pub));
#   UNSOUND  derived = ec_get_x(ec_mul_base(s, K)); constrain_equal_base(derived, pub_x);
#            where pub_x is a free witness and neither side is exposed
#
# So the old check would have rejected a commit touching proofs/core/{burn,opcodes}.zk for
# being correct. It never fired only because those files were not edited while it existed.
# It was also line-anchored, tracked a single pending name, matched by substring, and
# scanned only staged files.
#
# ---------------------------------------------------------------------------
# The replacement is `scripts/check-pubkey-binding.sh`. It is REPORT-ONLY here, and that
# is deliberate rather than a quieting: it finds **57** sites of the vacuous-binding shape
# across twelve contracts (run it to see them), and each needs its circuit *and* its host
# read together before it is called a defect — a fully private circuit with no host-side
# use of the value has nothing to forge. Blocking commits on 57 unadjudicated findings
# would be a gate whose authority is not yet defensible; the sites are promoted to the
# register as OBL-Z18 instead, and this hook starts failing on them once they are
# adjudicated. Until then it reports, so the class stops being invisible.
#
# The hook does not exit non-zero on findings. It does exit non-zero if the checker itself
# cannot run, because a check that silently does nothing is worse than no check.

echo "Checking circuit bindings for vacuous constrain_equal_base..."

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
CHECKER="$REPO_ROOT/scripts/check-pubkey-binding.sh"

if [ ! -x "$CHECKER" ]; then
    echo "ERROR: $CHECKER is missing or not executable."
    echo "A check that cannot run must not look like a check that passed."
    exit 1
fi

# Staged .zk files; fall back to the whole corpus when nothing is staged.
FILES=()
while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$REPO_ROOT/$f" ] && FILES+=("$REPO_ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.zk$' || true)

if [ "${#FILES[@]}" -eq 0 ]; then
    bash "$CHECKER" --all || true
else
    bash "$CHECKER" "${FILES[@]}" || true
fi

echo ""
echo "NOTE: reported, not blocking — the finding is OBL-Z18 in doc/src/arch/verification-hazop.md"
echo "      and its sites need adjudication before this hook can fail on them."
exit 0
