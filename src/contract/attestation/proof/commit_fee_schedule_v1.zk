k = 11;
field = "pallas";

constant "CommitFeeSchedule" {
}

witness "CommitFeeSchedule" {
    Base attestor_pub_x,
    Base attestor_pub_y,
    Base base_fee_bp,
    Base guaranteed_premium_bp,
    Base max_amount,
    Base min_amount,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CommitFeeSchedule" {
    constrain_instance(attestor_pub_x);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(attestor_pub_y);
}
