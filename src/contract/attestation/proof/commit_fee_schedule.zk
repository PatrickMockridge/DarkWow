# CommitFeeSchedule_V2 — domain-separated fee schedule commitment.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "CommitFeeScheduleV2" { EcFixedPointBase NULLIFIER_K, }
witness "CommitFeeScheduleV2" {
    Base attester_secret, Base attester_pub_x, Base attester_pub_y,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "CommitFeeScheduleV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);

    # Issue #3: as `attest_slash.zk` — the attester's secret was witnessed and
    # unconstrained, so the fee schedule was attributed to the caller's chosen
    # `attestor_pub`. Derive-and-expose; `commit_fee_schedule_v1` compares the exposed
    # coordinates against the `attestor_pub` it records.
    derived_pub = ec_mul_base(attester_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);
    constrain_equal_base(derived_pub_x, attester_pub_x);
    constrain_equal_base(derived_pub_y, attester_pub_y);
    constrain_instance(attester_pub_x); constrain_instance(attester_pub_y);

    # `OBL-C198`: the tx pair is the last two instances (the node reads that position); it sat first.
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
