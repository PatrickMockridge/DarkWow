# ExpireAttestation_V2 — domain-separated attestation expiry.
#
# OBL-C196(i) (github PatrickMockridge/DarkWow#3): `expire_attestation_v1` checked no caller —
# its only conditions were "exists, active, past its `expires_at` block" — so any party could flip
# any attestation to `Expired` once its own declared expiry passed, and `consume`/`validate`/
# `check_attestation` all gate on the state field rather than the block. The circuit below asks
# for proof of the attestor's key in the form `check-pubkey-binding.sh` calls SOUND and
# `revoke_attestation.zk` uses: derive-and-expose. The host compares the published coordinates
# against the `attestor_pub` it reads from the record, so only the attestor expires.
k = 11; field = "pallas";
constant "ExpireAttestationV2" { EcFixedPointBase NULLIFIER_K, }
witness "ExpireAttestationV2" {
    Base attestor_secret, Base attestor_pub_x, Base attestor_pub_y,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "ExpireAttestationV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);

    derived_pub = ec_mul_base(attestor_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);
    constrain_equal_base(derived_pub_x, attestor_pub_x);
    constrain_equal_base(derived_pub_y, attestor_pub_y);
    constrain_instance(attestor_pub_x); constrain_instance(attestor_pub_y);
}
