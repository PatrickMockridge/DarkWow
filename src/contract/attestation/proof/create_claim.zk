# CreateClaim_V2 — domain-separated claim creation.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "CreateClaimV2" { EcFixedPointBase NULLIFIER_K, }
witness "CreateClaimV2" {
    Base creator_secret, Base creator_pub_x, Base creator_pub_y,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "CreateClaimV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);

    # Issue #3: `claim_data`, `creator_secret` and the creator's coordinates were all
    # witnessed and used by nothing, so the claim was created in whatever name the caller
    # wrote in `params.claimant_pub`. `claim_data` had no wire counterpart at all and is
    # removed; the creator is derive-and-exposed as in `consume_claim.zk`, and
    # `create_claim_v1` compares the exposed coordinates against the `claimant_pub` it
    # stores.
    derived_pub = ec_mul_base(creator_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);
    constrain_equal_base(derived_pub_x, creator_pub_x);
    constrain_equal_base(derived_pub_y, creator_pub_y);
    constrain_instance(creator_pub_x); constrain_instance(creator_pub_y);
}
