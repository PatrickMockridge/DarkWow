# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Delegation Chain Verify Circuit (Version 1)
#
# This circuit proves:
# - Delegation chain exists and is valid (set_membership check)
# - Chain depth is within allowed maximum
#
# Public Inputs (constrain_instance):
#   - delegation_id: Unique identifier for this delegation
#   - parent_id: Parent delegation ID in the chain
#   - chain_root: Merkle root of the delegation chain tree
#   - current_depth: Current position in the delegation chain
#   - max_depth: Maximum allowed chain depth
#
# Witnesses:
#   - pos: Position in the delegation Merkle tree
#   - path: Sparse Merkle path for delegation proof

witness "VerifyChain" {
    # Position in the delegation Merkle tree
    Base pos,

    # Sparse Merkle path for delegation proof
    SparseMerklePath path,
}

circuit "VerifyChain" {
    # ==========================================================================
    # PHASE 1: Verify delegation is in the chain (set_membership check)
    # ==========================================================================
    #
    # set_membership(pos, path, leaf, expected_root) -> is_member
    #
    # Returns 1 if the leaf exists in the Merkle tree with the given root.
    # We verify: is_member == 1 (delegation IS in the chain)

    is_in_chain = set_membership(pos, path, delegation_id, chain_root);

    # The result must be 1 (delegation IS in the chain)
    constrain_equal_base(is_in_chain, Base(1));

    # ==========================================================================
    # PHASE 2: Verify chain depth is within limits
    # ==========================================================================
    #
    # The delegation chain must not exceed max_depth
    # This prevents infinite delegation chains

    depth_within_limit = less_than_or_equal(current_depth, max_depth);
    constrain_equal_base(depth_within_limit, Base(1));

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(delegation_id);
    constrain_instance(parent_id);
    constrain_instance(chain_root);
    constrain_instance(current_depth);
    constrain_instance(max_depth);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses proven opcodes:
    #   - set_membership: Merkle membership proof (0x59)
    #   - less_than_or_equal: VERIFIED SOUND depth comparison
    #   - constrain_equal_base: equality constraint
    #   - constrain_instance: public input exposure
    #
    # Chain verification:
    # - delegation_id is proven to be in the Merkle tree via set_membership
    # - chain_root is a PUBLIC INPUT (cannot be manipulated by prover)
    # - pos and path are witnesses that prove membership
    #
    # Depth verification:
    # - Both current_depth and max_depth are public inputs
    # - less_than_or_equal ensures depth doesn't exceed maximum
    #
    # Security considerations:
    # - Prover cannot fake Merkle membership (path must be valid)
    # - Prover cannot manipulate chain_root (public input)
    # - Depth check prevents infinite delegation chain attacks
}