# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Attestation Create Circuit (Version 1)
#
# This circuit proves:
# - Attestor knows their secret key
# - Attestor public key is correctly derived
# - Attestation ID is correctly computed
#
# Public Inputs (constrain_instance):
#   - attestor_pub_x: Attestor's public key x coordinate
#   - attestor_pub_y: Attestor's public key y coordinate
#
# Witnesses:
#   - attestor_secret: Attestor's secret key

constant "CreateAttestation" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateAttestation" {
    # Attestor's secret (for key derivation, not revealed)
    Base attestor_secret,
}

circuit "CreateAttestation" {
    # ==========================================================================
    # PHASE 1: Derive attestor public key from secret
    # ==========================================================================

    attestor_pub = ec_mul_base(attestor_secret, NULLIFIER_K);
    attestor_pub_x = ec_get_x(attestor_pub);
    attestor_pub_y = ec_get_y(attestor_pub);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(attestor_pub_x);
    constrain_instance(attestor_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_instance: public input exposure
    #
    # The attestation data is stored by the contract from the public inputs.
    # The ZK proof only establishes that the attestor knows their secret.
}