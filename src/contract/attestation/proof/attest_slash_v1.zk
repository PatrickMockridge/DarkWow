k = 11;
field = "pallas";

constant "AttestSlash" {
}

witness "AttestSlash" {
    Base relayer_pub_x,
    Base relayer_pub_y,
    Base slash_amount,
    Base withdrawal_id,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AttestSlash" {
    constrain_instance(relayer_pub_x);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(relayer_pub_y);
}
