# CheckNotRevoked_V2 — domain-separated revocation check.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "CheckNotRevokedV2" { EcFixedPointBase NULLIFIER_K, }
witness "CheckNotRevokedV2" {
    Base nonce, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "CheckNotRevokedV2" {
    DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COMMITMENT = witness_base(4);
    leaf = poseidon_hash(DOMAIN_COMMITMENT, nonce);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
