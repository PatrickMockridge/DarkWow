# The k parameter defining the number of rows used in our circuit (2^k)
k = 15;
field = "pallas";

# Attestation Delegate Circuit (Version 1)
#
# This circuit proves:
# - Delegator has sufficient stake to delegate
# - Delegation ratio is within allowed limits (cross-multiplication verification)
# - Delegatee is NOT revoked (set_membership check)
# - Delegation chain is valid (set_membership check for chain)
# - Chain depth is within allowed maximum
# - Delegation type is properly enforced
#
# The delegation ratio verification uses cross-multiplication:
#   Verify: delegator_stake / delegatee_stake <= max_ratio
#   Using: delegator_stake <= delegatee_stake * max_ratio
#   This avoids field division (base_div) which gives wrong results for ratios
#
# Delegation types:
#   - 0 = None (no delegation)
#   - 1 = Full (unlimited delegation)
#   - 2 = Restricted (ratio-based delegation)
#
# Public Inputs (constrain_instance):
#   - delegation_id: Unique identifier for this delegation
#   - parent_id: Parent delegation ID in the chain
#   - delegator_pub_x: Delegator's public key x coordinate
#   - delegator_pub_y: Delegator's public key y coordinate
#   - delegatee_pub_x: Delegatee's public key x coordinate
#   - delegatee_pub_y: Delegatee's public key y coordinate
#   - delegation_type: Type of delegation (0=None, 1=Full, 2=Restricted)
#   - max_ratio: Maximum allowed delegation ratio (e.g., 10000 = 100%)
#   - revocation_root: Merkle root of revocation tree
#   - chain_root: Merkle root of delegation chain tree
#   - current_depth: Current delegation chain depth
#   - max_depth: Maximum allowed chain depth
#   - delegator_stake: Delegator's stake amount
#   - delegatee_stake: Delegatee's stake amount
#
# Witnesses:
#   - delegator_secret: Delegator's secret key
#   - delegator_stake: Delegator's stake amount
#   - delegatee_stake: Delegatee's stake amount
#   - nonce: Nonce for revocation check
#   - pos: Position in revocation Merkle tree
#   - path: Sparse Merkle path for revocation proof
#   - chain_pos: Position in delegation chain Merkle tree
#   - chain_path: Sparse Merkle path for delegation chain proof

constant "DelegateAttestation" {
    EcFixedPointBase NULLIFIER_K,
}

witness "DelegateAttestation" {
    # Public inputs
    Base delegation_id,
    Base parent_id,
    Base delegator_pub_x,
    Base delegator_pub_y,
    Base delegatee_pub_x,
    Base delegatee_pub_y,
    Base delegation_type,
    Base max_ratio,
    Base revocation_root,
    Base chain_root,
    Base current_depth,
    Base max_depth,
    Base delegator_stake,
    Base delegatee_stake,

    # Witnesses
    Base nonce,
    Base pos,
    SparseMerklePath path,
    Base chain_pos,
    SparseMerklePath chain_path,
    Base delegator_secret,

    # Delegation type constants (cannot use Base in constant block)
    Base DELEGATION_TYPE_NONE,
    Base DELEGATION_TYPE_FULL,
    Base DELEGATION_TYPE_RESTRICTED,
    Base tx_commitment,
}

circuit "DelegateAttestation" {
    # Constant witnesses for comparison
    ZERO = witness_base(0);
    ONE = witness_base(1);

    # ==========================================================================
    # PHASE 1: Verify delegator public key from secret
    # ==========================================================================

    delegator_pub = ec_mul_base(delegator_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(delegator_pub);
    derived_pub_y = ec_get_y(delegator_pub);

    # CRITICAL: Verify derived public key matches the public input
    constrain_equal_base(derived_pub_x, delegator_pub_x);
    constrain_equal_base(derived_pub_y, delegator_pub_y);

    # ==========================================================================
    # PHASE 2: Verify delegation type and ratio constraints
    # ==========================================================================
    #
    # For Restricted delegation: verify ratio <= max_ratio
    # For None/Full delegation: ratio check is bypassed
    #
    # PROOF: delegator_stake / delegatee_stake <= max_ratio
    #
    # We use cross-multiplication to avoid expensive and incorrect base_div:
    # Multiply both sides by delegatee_stake (positive, non-zero):
    #   delegator_stake <= delegatee_stake * max_ratio
    #
    # This is correct for integer comparison and avoids field division issues.
    # base_div(a, b) = a * inverse(b) mod p gives field elements, NOT integers.

    # Determine delegation type
    is_restricted = is_equal_base(delegation_type, DELEGATION_TYPE_RESTRICTED);

    # First ensure delegatee_stake is non-zero (division by zero prevention)
    less_than_strict(ZERO, delegatee_stake);

    # Cross-multiplication: check delegator_stake <= delegatee_stake * max_ratio
    max_ratio_times_delegatee = base_mul(max_ratio, delegatee_stake);
    ratio_within_limit = less_than_or_equal(delegator_stake, max_ratio_times_delegatee);

    # Conditional enforcement: only enforce for Restricted type
    # When is_restricted == 1: ratio_within_limit must equal 1
    # When is_restricted == 0: constraint is bypassed
    ratio_check_valid = base_mul(ratio_within_limit, is_restricted);
    constrain_equal_base(ratio_check_valid, is_restricted);

    # ==========================================================================
    # PHASE 3: Verify delegation chain exists
    # ==========================================================================
    #
    # set_membership(chain_pos, chain_path, delegation_id, chain_root) -> is_in_chain
    #
    # This verifies the delegation_id exists in the delegation chain Merkle tree

    is_in_chain = set_membership(chain_pos, chain_path, delegation_id, chain_root);

    # The result must be 1 (delegation IS in the chain)
    constrain_equal_base(is_in_chain, ONE);

    # ==========================================================================
    # PHASE 4: Verify chain depth
    # ==========================================================================
    #
    # The delegation chain must not exceed max_depth
    # This prevents infinite delegation chains

    depth_within_limit = less_than_or_equal(current_depth, max_depth);
    constrain_equal_base(depth_within_limit, ONE);

    # ==========================================================================
    # PHASE 5: Verify delegatee is NOT revoked
    # ==========================================================================
    #
    # set_membership(pos, path, leaf, expected_root) -> is_member
    #
    # Returns 1 if IN the set (revoked), 0 if NOT in (not revoked)
    # We invert to get: 1 if NOT revoked, 0 if revoked

    delegatee_leaf = poseidon_hash(delegatee_pub_x, delegatee_pub_y);
    is_in_revocation_list = set_membership(pos, path, delegatee_leaf, revocation_root);
    is_not_revoked = not_base(is_in_revocation_list);

    # The result must be 1 (delegatee is NOT revoked)
    constrain_equal_base(is_not_revoked, ONE);

    # ==========================================================================
    # PHASE 6: Expose public inputs
    # ==========================================================================

    constrain_instance(delegation_id);
    constrain_instance(parent_id);
    constrain_instance(delegator_pub_x);
    constrain_instance(delegator_pub_y);
    constrain_instance(delegatee_pub_x);
    constrain_instance(delegatee_pub_y);
    constrain_instance(delegation_type);
    constrain_instance(max_ratio);
    constrain_instance(revocation_root);
    constrain_instance(chain_root);
    constrain_instance(current_depth);
    constrain_instance(max_depth);
    constrain_instance(delegator_stake);
    constrain_instance(delegatee_stake);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - equal: equality check for delegation type
    #   - less_than_strict: sound comparison (constrain-only)
    #   - base_mul: field multiplication for cross-multiplication
    #   - less_than_or_equal: VERIFIED SOUND comparison
    #   - set_membership: Merkle membership proof (0x59)
    #   - base_sub: field subtraction for inversion
    #   - poseidon_hash: standardized hash function
    #   - constrain_instance: public input exposure
    #
    # Delegation type enforcement:
    # - delegation_type is a public input
    # - Conditional logic uses field arithmetic (no branching in constraints)
    # - The ratio check is only enforced when type == Restricted
    #
    # Ratio verification (when Restricted):
    # - Uses cross-multiplication: delegator_stake <= delegatee_stake * max_ratio
    # - less_than_strict(ZERO, delegatee_stake) ensures non-zero denominator
    # - less_than_or_equal compares the two sides correctly as integers
    # - This avoids field division (base_div) which gives wrong results for ratios
    #
    # Chain verification:
    # - delegation_id is proven to be in the Merkle tree via set_membership
    # - chain_root is a PUBLIC INPUT (cannot be manipulated by prover)
    # - chain_pos and chain_path are witnesses that prove membership
    #
    # Revocation checking:
    # - revocation_root is a public input (cannot be manipulated)
    # - set_membership proof is verified (cannot fake membership)
    # - Result is inverted to get "NOT revoked"
    #
    # Chain depth:
    # - Both current_depth and max_depth are public inputs
    # - less_than_or_equal ensures depth doesn't exceed maximum
    #
    # Security considerations:
    # - Division by zero: less_than_strict(ZERO, delegatee_stake) prevents it
    # - The ratio check prevents excessive leverage in delegation
    # - The depth check prevents infinite delegation chains
    constrain_instance(tx_commitment);
    # - The chain check ensures delegation chain integrity
}