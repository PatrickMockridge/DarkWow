# Burn circuit - proves spending with nullifier reveal
# Uses Pedersen commitments for additively homomorphic value conservation.
# Schnorr-style signature where public_key = poseidon_hash(secret)
k = 11;
field = "pallas";

# burn_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "Burn_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "Burn_V2" {
    # Secret key for spending
    Base spend_secret,
    # Coin attributes
    Base value,
    Base asset_id,
    Base coin_spend_hook,
    Base user_data,
    Base commitment_blind,
    # Blinding factors
    Scalar value_blind,
    Base asset_id_blind,
    Base user_data_blind,
    # Merkle proof
    Uint32 leaf_pos,
    MerklePath path,
    # Signature secret key (Schnorr-style)
    Base signature_secret,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Burn_V2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TOK_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);
    DOMAIN_USER_DATA_ENC = witness_base(6);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Derive public key from secret using Poseidon (not EC)
    # Schnorr-style: public_key = poseidon_hash(DOMAIN_SIGNATURE_SECRET, secret)
    pub = poseidon_hash(DOMAIN_SIGNATURE_SECRET, spend_secret);

    # Coin hash using derived public key (single field element, not EC point)
    coin = poseidon_hash(DOMAIN_COMMITMENT, 
        pub,
        value,
        asset_id,
        coin_spend_hook,
        user_data,
        commitment_blind,
    );

    # Nullifier - breaks the link between mint and burn
    # nullifier = poseidon_hash(DOMAIN_NULLIFIER, spend_secret, coin)
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, spend_secret, coin);
    constrain_instance(nullifier);

    # Value commitment - Pedersen (additively homomorphic)
    # C = v * G_v + r * G_r
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Token ID commitment
    token_commit = poseidon_hash(DOMAIN_TOK_COMMIT, asset_id, asset_id_blind);
    constrain_instance(token_commit);

    # Merkle proof — guard against zero-value vacuous proofs.
    # RC2: without less_than_strict(ZERO, value), an attacker sets
    # value=0, zero_cond returns the tree's zero leaf, and merkle_root
    # always succeeds. The prover forges ↓prove-inclusion without possessing
    # the coin. Pattern from promissory_note/burn_v1.zk:74-75.
    ZERO = witness_base(0);
    less_than_strict(ZERO, value);
    coin_incl = zero_cond(value, coin);
    root = merkle_root(leaf_pos, path, coin_incl);
    constrain_instance(root);

    # Encrypted user data
    # HAZOP H27 fix: use DOMAIN_USER_DATA_ENC, not DOMAIN_COMMITMENT
    user_data_enc = poseidon_hash(DOMAIN_USER_DATA_ENC, user_data, user_data_blind);
    constrain_instance(user_data_enc);

    # Reveal spend hook (can be used for cross-contract composition)
    constrain_instance(coin_spend_hook);

    # Derive per-burn unique signature_secret from spend_secret + nullifier.
    # RC5: without this binding, an attacker can sign with an arbitrary
    # signature_secret independent of the coin's secret. Pattern from
    # promissory_note/burn_v1.zk:87-98 (HAZOP H2 fix).
    # HAZOP H26 fix: use DOMAIN_SIGNATURE_SECRET, not DOMAIN_COMMITMENT
    derived_signature_secret = poseidon_hash(DOMAIN_SIGNATURE_SECRET, spend_secret, nullifier);
    constrain_equal_base(derived_signature_secret, signature_secret);

    # Derive signature public key using Schnorr-style Poseidon hash
    signature_public = poseidon_hash(DOMAIN_SIGNATURE_SECRET, signature_secret);
    constrain_instance(signature_public);

    # Range proof - ensure value is valid
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, value);
}
