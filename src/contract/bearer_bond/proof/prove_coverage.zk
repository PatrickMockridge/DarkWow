# ProveCoverage_V1: Coverage Ratio Proof for Bearer Bond Governance
# Proves that the issuer's reserves cover outstanding stake obligations.
# coverage_ratio_bps = base_div(reserve_amount, total_outstanding) * 10000
# Uses BaseDiv (opcode 0x58) for exact ratio calculation.
# Expensive (~500 field muls) but accurate for governance reporting.
k = 11;
field = "pallas";

# prove_coverage_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "ProveCoverage_V2" {
}

witness "ProveCoverage_V2" {
    # Issuer's reserve balance (u64)
    Base reserve_amount,
    # Total staked principal across all stake coins in the series (u64)
    Base total_outstanding,
    # coverage_ratio_bps = reserve_amount / total_outstanding * 10000
    Base coverage_ratio_bps,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ProveCoverage_V2" {
    DOMAIN_TX_BINDING = witness_base(3);

    # Range checks for inputs
    range_check(64, reserve_amount);
    range_check(64, total_outstanding);

    # Compute coverage ratio using quotient-remainder (RC4 FIX)
    # coverage_ratio_bps = floor(reserve_amount / total_outstanding) * 10000
    # ⇔ coverage_ratio_bps * total_outstanding <= reserve_amount * 10000
    #   < (coverage_ratio_bps + 10000) * total_outstanding
    ONE = witness_base(1);
    BPS = witness_base(10000);
    crb_times_out = base_mul(coverage_ratio_bps, total_outstanding);
    res_times_bps = base_mul(reserve_amount, BPS);
    lte_check = less_than_or_equal(crb_times_out, res_times_bps);
    constrain_equal_base(lte_check, ONE);
    crb_plus_bps = base_add(coverage_ratio_bps, BPS);
    upper = base_mul(crb_plus_bps, total_outstanding);
    less_than_strict(res_times_bps, upper);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
