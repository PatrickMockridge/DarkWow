# RedeemV1 circuit - proves receipt coin is well-formed with value=0
# The receipt has no monetary value — it is cryptographic proof that
# redemption occurred with the issuer.
#
# value is constrained as a public input so the entrypoint can
# independently verify the receipt has zero monetary value.
k = 11;
field = "pallas";

# redeem_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "Redeem_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "Redeem_V2" {
    Base coin_public,
    Base value,
    Base asset_id,
    Base coin_spend_hook,
    Base user_data,
    Base commitment_blind,
    Scalar value_blind,
    Base asset_id_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Redeem_V2" {
    DOMAIN_TOK_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Coin commitment
    coin = poseidon_hash(DOMAIN_COMMITMENT, 
        coin_public,
        value,
        asset_id,
        coin_spend_hook,
        user_data,
        commitment_blind,
    );
    constrain_instance(coin);

    # Value commitment - Pedersen (additively homomorphic)
    # C = v * G_v + r * G_r
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Token ID commitment — binds receipt to the redeemed token type
    token_commit = poseidon_hash(DOMAIN_TOK_COMMIT, asset_id, asset_id_blind);
    constrain_instance(token_commit);

    # Constrain value to ZERO in-circuit so the receipt cannot carry
    # monetary value. RC5: defense-in-depth — the entrypoint also verifies
    # this, but the circuit-level constraint prevents a compromised entrypoint
    # from issuing value-bearing receipts. Pattern from
    # promissory_note/redeem_v1.zk:57-63 (HAZOP ELEV-4 fix).
    ZERO = witness_base(0);
    constrain_equal_base(value, ZERO);
    constrain_instance(value);

    # Reveal spend_hook so parent contracts verify receipt coin binding
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(coin_spend_hook);
}
