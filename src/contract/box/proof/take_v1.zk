# Box Take Circuit — takes a capability from a Box
# Proves knowledge of box_secret, consumes the Box via nullifier
k = 11;
field = "pallas";

constant "TakeV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "TakeV1" {
    # Box identity
    Base box_id,
    # Current contents commitment
    Base contents_commit,
    # Box ownership
    Base owner_secret,
    Base owner_pub_x,
    Base owner_pub_y,
}

circuit "TakeV1" {
    ONE = witness_base(1);

    # Verify box ownership via Schnorr public key
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(owner_pub);
    derived_pub_y = ec_get_y(owner_pub);
    constrain_equal_base(derived_pub_x, owner_pub_x);
    constrain_equal_base(derived_pub_y, owner_pub_y);

    # Verify the Box is not empty
    less_than_strict(witness_base(0), contents_commit);

    # Nullifier: box_secret + box_id — consumed on open, prevents double-take
    nullifier = poseidon_hash(owner_secret, box_id);
    constrain_instance(nullifier);

    # Expose public inputs
    constrain_instance(box_id);
    constrain_instance(contents_commit);
}
