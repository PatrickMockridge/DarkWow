k = 11;
field = "pallas";

constant "Put" {
}

witness "Put" {
    Base box_id,
    Base old_state_nonce,
    Base new_state_nonce,
    Base old_contents_commit,
    Base new_contents_commit,
    Base nullifier,
    Base expected_root,
    Base new_leaf,
    Base owner_secret,
    Uint32 leaf_pos,
    MerklePath path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
    # LAST on purpose: the manifest's witness_map, its [[parameters]] witness = N
    # annotations and the public_inputs list are all positional, so appending
    # rather than inserting keeps every existing slot index intact.
    Base owner_pub,
}

circuit "Put" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_MERKLE_LEAF = witness_base(5);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);
    ONE = witness_base(1);

    # Ownership — the leaf pins its owner, so a leaf preimage lifted from the
    # plaintext params cannot be consumed with a secret of the attacker's choosing
    derived_owner = poseidon_hash(DOMAIN_SIGNATURE_SECRET, owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Nullifier — circuit computes, constrains against caller-provided
    nullifier_circuit = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, box_id, old_state_nonce);
    constrain_equal_base(nullifier_circuit, nullifier);
    constrain_instance(nullifier);

    # Merkle inclusion of OLD state
    old_leaf = poseidon_hash(DOMAIN_MERKLE_LEAF, box_id, old_contents_commit, old_state_nonce, owner_pub);
    root = merkle_root(leaf_pos, path, old_leaf);
    constrain_equal_base(root, expected_root);
    constrain_instance(expected_root);

    # The successor nonce is derived, not chosen. Purse's Deposit derives its own the same way
    # (`deposit.zk`: `computed_new = base_add(old_balance, deposit_amount)` then
    # `constrain_equal_base(computed_new, new_balance)`); here it arrived as a free witness, so a Put
    # could re-use the nonce it had just consumed — the new leaf would then be identical to the old one,
    # whose nullifier this same call already spent, and the box could never be consumed again. The field
    # is still carried in the call params (nothing reads it there) and is now pinned to this value.
    #
    # The assign-then-constrain form is purse's, copied deliberately: it is the only form the corpus
    # uses for an arithmetic check (`deposit.zk:89-90`), and `tests/box_put_successor_nonce.rs` verifies
    # it holds — three negative arms, plus a control on the nullifier constraint so the file's arms are
    # evidence rather than assertions about `Proof::create`, which produces bytes for an unsatisfying
    # assignment either way.
    computed_nsn = base_add(old_state_nonce, ONE);
    constrain_equal_base(computed_nsn, new_state_nonce);

    # NEW state — circuit computes, constrains against caller-provided
    new_leaf_circuit = poseidon_hash(DOMAIN_MERKLE_LEAF, box_id, new_contents_commit, new_state_nonce, owner_pub);
    constrain_equal_base(new_leaf_circuit, new_leaf);
    constrain_instance(new_leaf);

    # Transaction binding — circuit computes, constrains against caller-provided
    tx_binding_circuit = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_equal_base(tx_binding_circuit, tx_binding);
    constrain_instance(tx_binding);

    # Transaction nonce — direct witness
    constrain_instance(tx_nonce);
}
