k = 11;
field = "pallas";

constant "Put" {
}

witness "Put" {
    Base box_id,
    Base old_state_nonce,
    Base new_state_nonce,
    Base old_contents_commit,
    Base new_contents_commit,
    Base nullifier,
    Base expected_root,
    Base new_leaf,
    Base owner_secret,
    Uint32 leaf_pos,
    MerklePath path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Put" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_MERKLE_LEAF = witness_base(5);
    # Nullifier — circuit computes, constrains against caller-provided
    nullifier_circuit = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, box_id, old_state_nonce);
    constrain_equal_base(nullifier_circuit, nullifier);
    constrain_instance(nullifier);

    # Merkle inclusion of OLD state
    old_leaf = poseidon_hash(DOMAIN_MERKLE_LEAF, box_id, old_contents_commit, old_state_nonce);
    root = merkle_root(leaf_pos, path, old_leaf);
    constrain_equal_base(root, expected_root);
    constrain_instance(expected_root);

    # NEW state — circuit computes, constrains against caller-provided
    new_leaf_circuit = poseidon_hash(DOMAIN_MERKLE_LEAF, box_id, new_contents_commit, new_state_nonce);
    constrain_equal_base(new_leaf_circuit, new_leaf);
    constrain_instance(new_leaf);

    # Transaction binding — circuit computes, constrains against caller-provided
    tx_binding_circuit = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_equal_base(tx_binding_circuit, tx_binding);
    constrain_instance(tx_binding);

    # Transaction nonce — direct witness
    constrain_instance(tx_nonce);
}
