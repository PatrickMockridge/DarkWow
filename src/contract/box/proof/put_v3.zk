k = 11;
field = "pallas";

constant "PutV3" {
    EcFixedPointBase NULLIFIER_K,
}

witness "PutV3" {
    Base box_id,
    Base old_state_nonce,
    Base new_state_nonce,
    Base old_contents_commit,
    Base new_contents_commit,
    Base owner_secret,
    Base owner_pub_x,
    Base owner_pub_y,
    Uint32 leaf_pos,
    MerklePath path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PutV3" {
    # Domain constants (HAZOP RC3 — inherited from V2)
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Ownership proof (Schnorr-style — from put_v2.zk)
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(owner_pub);
    derived_pub_y = ec_get_y(owner_pub);
    constrain_equal_base(derived_pub_x, owner_pub_x);
    constrain_equal_base(derived_pub_y, owner_pub_y);

    # Nullifier for OLD state (NEW — consumes previous box state)
    nullifier_old = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, box_id, old_state_nonce);
    constrain_instance(nullifier_old);

    # Merkle inclusion of OLD box state (NEW — from burn_v2.zk pattern)
    box_leaf_old = poseidon_hash(DOMAIN_SIGNATURE_SECRET, box_id, old_contents_commit, old_state_nonce);
    root = merkle_root(leaf_pos, path, box_leaf_old);
    constrain_instance(root);

    # New contents commit (from put_v2.zk — public input)
    constrain_instance(new_contents_commit);

    # Transaction binding (from put_v2.zk)
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
