# Box Put Circuit — places a capability into a Box
# Proves the Box was empty, now contains H(capability_data)
k = 11;
field = "pallas";

constant "PutV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "PutV1" {
    # Box identity
    Base box_id,
    # Previous contents (must be EMPTY = 0)
    Base old_contents_commit,
    # New contents
    Base new_contents_commit,
    # Capability being placed in the Box
    Base capability_data,
    # Box ownership
    Base owner_secret,
    Base owner_pub_x,
    Base owner_pub_y,
}

circuit "PutV1" {
    ZERO = witness_base(0);

    # Verify box ownership via Schnorr public key
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(owner_pub);
    derived_pub_y = ec_get_y(owner_pub);
    constrain_equal_base(derived_pub_x, owner_pub_x);
    constrain_equal_base(derived_pub_y, owner_pub_y);

    # Verify the Box was empty
    constrain_equal_base(old_contents_commit, ZERO);

    # Verify new contents commitment matches the capability data
    computed_commit = poseidon_hash(capability_data);
    constrain_equal_base(computed_commit, new_contents_commit);

    # Expose public inputs
    constrain_instance(box_id);
    constrain_instance(old_contents_commit);
    constrain_instance(new_contents_commit);
}
