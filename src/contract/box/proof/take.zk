k = 11;
field = "pallas";

constant "Take" {
}

witness "Take" {
    Base box_id,
    Base contents_commit,
    Base state_nonce,
    Base nullifier_witness,
    Base expected_root,
    Base owner_secret,
    Base owner_pub,
    Uint32 leaf_pos,
    MerklePath path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Take" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Ownership proof — Poseidon-based
    derived_owner = poseidon_hash(DOMAIN_SIGNATURE_SECRET, owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Nullifier for current state — caller provides expected value in witness[3]
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, box_id, state_nonce);
    constrain_equal_base(nullifier, nullifier_witness);
    constrain_instance(nullifier_witness);

    # Merkle inclusion of current box state — constrain against expected_root
    box_leaf = poseidon_hash(DOMAIN_SIGNATURE_SECRET, box_id, contents_commit, state_nonce);
    root = merkle_root(leaf_pos, path, box_leaf);
    constrain_equal_base(root, expected_root);
    constrain_instance(expected_root);

    # Transaction binding
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
