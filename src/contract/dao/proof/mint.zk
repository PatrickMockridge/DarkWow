k = 11;
field = "pallas";

constant "Mint" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Mint" {
    Base proposer_limit,
    Base quorum,
    Base early_exec_quorum,
    Base approval_ratio_quot,
    Base approval_ratio_base,
    Base gov_token_id,
    Base notes_secret,
    Base notes_public_x,
    Base notes_public_y,
    Base proposer_secret,
    Base proposer_public_x,
    Base proposer_public_y,
    Base proposals_secret,
    Base proposals_public_x,
    Base proposals_public_y,
    Base votes_secret,
    Base votes_public_x,
    Base votes_public_y,
    Base exec_secret,
    Base exec_public_x,
    Base exec_public_y,
    Base early_exec_secret,
    Base early_exec_public_x,
    Base early_exec_public_y,
    Base bulla_blind,
}

circuit "Mint" {
    # Derive and constrain DAO notes public key
    notes_public = ec_mul_base(notes_secret, NULLIFIER_K);
    derived_notes_pub_x = ec_get_x(notes_public);
    derived_notes_pub_y = ec_get_y(notes_public);
    constrain_equal_base(derived_notes_pub_x, notes_public_x);
    constrain_equal_base(derived_notes_pub_y, notes_public_y);

    # Derive DAO proposer public key
    proposer_public = ec_mul_base(proposer_secret, NULLIFIER_K);
    derived_proposer_pub_x = ec_get_x(proposer_public);
    derived_proposer_pub_y = ec_get_y(proposer_public);
    constrain_equal_base(derived_proposer_pub_x, proposer_public_x);
    constrain_equal_base(derived_proposer_pub_y, proposer_public_y);

    # Derive DAO proposals public key
    proposals_public = ec_mul_base(proposals_secret, NULLIFIER_K);
    derived_proposals_pub_x = ec_get_x(proposals_public);
    derived_proposals_pub_y = ec_get_y(proposals_public);
    constrain_equal_base(derived_proposals_pub_x, proposals_public_x);
    constrain_equal_base(derived_proposals_pub_y, proposals_public_y);

    # Derive DAO votes public key
    votes_public = ec_mul_base(votes_secret, NULLIFIER_K);
    derived_votes_pub_x = ec_get_x(votes_public);
    derived_votes_pub_y = ec_get_y(votes_public);
    constrain_equal_base(derived_votes_pub_x, votes_public_x);
    constrain_equal_base(derived_votes_pub_y, votes_public_y);

    # Derive DAO executor public key
    exec_public = ec_mul_base(exec_secret, NULLIFIER_K);
    derived_exec_pub_x = ec_get_x(exec_public);
    derived_exec_pub_y = ec_get_y(exec_public);
    constrain_equal_base(derived_exec_pub_x, exec_public_x);
    constrain_equal_base(derived_exec_pub_y, exec_public_y);

    # Derive DAO early executor public key
    early_exec_public = ec_mul_base(early_exec_secret, NULLIFIER_K);
    derived_early_exec_pub_x = ec_get_x(early_exec_public);
    derived_early_exec_pub_y = ec_get_y(early_exec_public);
    constrain_equal_base(derived_early_exec_pub_x, early_exec_public_x);
    constrain_equal_base(derived_early_exec_pub_y, early_exec_public_y);

    # Check that early execution quorum is greater or equal to normal quorum
    one = witness_base(1);
    early_exec_quorum_1 = base_add(early_exec_quorum, one);
    less_than_strict(quorum, early_exec_quorum_1);

    # Derive and constrain the DAO bulla
    bulla = poseidon_hash(
        proposer_limit,
        quorum,
        early_exec_quorum,
        approval_ratio_quot,
        approval_ratio_base,
        gov_token_id,
        notes_public_x,
        notes_public_y,
        proposer_public_x,
        proposer_public_y,
        proposals_public_x,
        proposals_public_y,
        votes_public_x,
        votes_public_y,
        exec_public_x,
        exec_public_y,
        early_exec_public_x,
        early_exec_public_y,
        bulla_blind,
    );
    constrain_instance(bulla);
}
