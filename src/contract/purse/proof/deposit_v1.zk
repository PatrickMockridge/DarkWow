# Purse Deposit Circuit — proves tokens are deposited into a Purse
# Uses Pedersen additive homomorphism: old_commit + deposit_commit = new_commit
k = 11;
field = "pallas";

constant "DepositV1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "DepositV1" {
    # Purse identity
    Base purse_id,
    # Old balance
    Base old_balance,
    Scalar old_balance_blind,
    # Deposit amount
    Base deposit_amount,
    Scalar deposit_blind,
    # New balance (= old + deposit)
    Base new_balance,
    Scalar new_balance_blind,
    # Purse ownership
    Base owner_secret,
    Base owner_pub,
    Base tx_commitment,
}

circuit "DepositV1" {
    # Verify purse ownership
    derived_owner = poseidon_hash(owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Old balance Pedersen commitment
    old_vcv = ec_mul_short(old_balance, VALUE_COMMIT_VALUE);
    old_vcr = ec_mul(old_balance_blind, VALUE_COMMIT_RANDOM);
    old_commit = ec_add(old_vcv, old_vcr);

    # Deposit Pedersen commitment
    dep_vcv = ec_mul_short(deposit_amount, VALUE_COMMIT_VALUE);
    dep_vcr = ec_mul(deposit_blind, VALUE_COMMIT_RANDOM);
    dep_commit = ec_add(dep_vcv, dep_vcr);

    # New balance Pedersen commitment
    new_vcv = ec_mul_short(new_balance, VALUE_COMMIT_VALUE);
    new_vcr = ec_mul(new_balance_blind, VALUE_COMMIT_RANDOM);
    new_commit = ec_add(new_vcv, new_vcr);

    # Verify Pedersen additive homomorphism: old + deposit == new
    sum_commit = ec_add(old_commit, dep_commit);
    constrain_equal_point(sum_commit, new_commit);

    # Verify integer addition: old_balance + deposit_amount == new_balance
    computed_new = base_add(old_balance, deposit_amount);
    constrain_equal_base(computed_new, new_balance);

    # Range checks
    range_check(64, old_balance);
    range_check(64, deposit_amount);
    range_check(64, new_balance);

    # Expose public inputs
    constrain_instance(purse_id);
    constrain_instance(ec_get_x(old_commit));
    constrain_instance(ec_get_y(old_commit));
    constrain_instance(ec_get_x(new_commit));
    constrain_instance(tx_commitment);
    constrain_instance(ec_get_y(new_commit));
}
