k = 11;
field = "pallas";

constant "BalanceV3" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "BalanceV3" {
    Base purse_id,
    Base token_id,
    Base balance,
    Scalar balance_blind,
    Base state_nonce,
    Base owner_secret,
    Base owner_pub,
    Base token_blind,
    Uint32 leaf_pos,
    MerklePath path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "BalanceV3" {
    # Domain constants
    DOMAIN_TOK_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Purse ID binding (from balance_v2.zk)
    derived_purse_id = poseidon_hash(DOMAIN_COIN_COMMIT, owner_pub, token_id, purse_id);
    constrain_instance(derived_purse_id);

    # Ownership proof (from balance_v2.zk)
    derived_owner = poseidon_hash(DOMAIN_SIGNATURE_SECRET, owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Merkle inclusion of current purse state (NEW)
    purse_leaf = poseidon_hash(DOMAIN_SIGNATURE_SECRET, purse_id, balance, state_nonce);
    root = merkle_root(leaf_pos, path, purse_leaf);
    constrain_instance(root);

    # Pedersen balance commitment (from balance_v2.zk)
    bvcv = ec_mul_short(balance, VALUE_COMMIT_VALUE);
    bvcr = ec_mul(balance_blind, VALUE_COMMIT_RANDOM);
    balance_commit = ec_add(bvcv, bvcr);
    constrain_instance(ec_get_x(balance_commit));
    constrain_instance(ec_get_y(balance_commit));

    # Token commitment (from balance_v2.zk)
    token_commit = poseidon_hash(DOMAIN_TOK_COMMIT, token_id, token_blind);
    constrain_instance(token_commit);

    # Transaction binding (from balance_v2.zk)
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);

    # Range proof (from balance_v2.zk)
    range_check(64, balance);
}
