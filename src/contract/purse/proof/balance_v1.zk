# Purse Balance Circuit — proves knowledge of purse ownership + balance
# Exposes balance_commit as public input for predicate checks by other contracts
# (e.g., "balance >= 1000" for DAO voting threshold)
k = 11;
field = "pallas";

constant "BalanceV1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "BalanceV1" {
    # Purse identity
    Base purse_id,
    Base token_id,
    # Balance
    Base balance,
    Scalar balance_blind,
    # Purse ownership
    Base owner_secret,
    Base owner_pub,
    # Token type blinding
    Base token_blind,
    Base tx_commitment,
}

circuit "BalanceV1" {
    # Derive purse_id so owner can't claim other purses
    derived_purse_id = poseidon_hash(owner_pub, token_id, purse_id);
    constrain_instance(derived_purse_id);

    # Verify purse ownership
    derived_owner = poseidon_hash(owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Balance Pedersen commitment — public input for predicate checks
    bvcv = ec_mul_short(balance, VALUE_COMMIT_VALUE);
    bvcr = ec_mul(balance_blind, VALUE_COMMIT_RANDOM);
    balance_commit = ec_add(bvcv, bvcr);
    constrain_instance(ec_get_x(balance_commit));
    constrain_instance(ec_get_y(balance_commit));

    # Token type commitment
    token_commit = poseidon_hash(token_id, token_blind);
    constrain_instance(token_commit);

    # Range check
    constrain_instance(tx_commitment);
    range_check(64, balance);
}
