# Purse Withdraw Circuit — proves tokens are withdrawn from a Purse
# Constrains withdraw_amount <= old_balance using LessThanOrEqual (0x55)
# Nullifier prevents double-withdrawal
k = 11;
field = "pallas";

# withdraw_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "WithdrawV2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "WithdrawV2" {
    # Purse identity
    Base purse_id,
    # Old balance
    Base old_balance,
    Scalar old_balance_blind,
    # Withdraw amount
    Base withdraw_amount,
    Scalar withdraw_blind,
    # New balance (= old - withdraw)
    Base new_balance,
    Scalar new_balance_blind,
    # Purse ownership + replay protection
    Base owner_secret,
    Base owner_pub,
    Base operation_nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "WithdrawV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    ZERO = witness_base(0);
    ONE = witness_base(1);

    # Verify purse ownership
    derived_owner = poseidon_hash(DOMAIN_SIGNATURE_SECRET, owner_secret);
    constrain_equal_base(derived_owner, owner_pub);

    # Enforce withdraw_amount > 0 (prevent zero-withdraw griefing)
    less_than_strict(ZERO, withdraw_amount);

    # Enforce withdraw_amount <= old_balance
    is_within_balance = less_than_or_equal(withdraw_amount, old_balance);
    constrain_equal_base(is_within_balance, ONE);

    # Old balance Pedersen commitment
    old_vcv = ec_mul_short(old_balance, VALUE_COMMIT_VALUE);
    old_vcr = ec_mul(old_balance_blind, VALUE_COMMIT_RANDOM);
    old_commit = ec_add(old_vcv, old_vcr);

    # New balance Pedersen commitment
    new_vcv = ec_mul_short(new_balance, VALUE_COMMIT_VALUE);
    new_vcr = ec_mul(new_balance_blind, VALUE_COMMIT_RANDOM);
    new_commit = ec_add(new_vcv, new_vcr);

    # Verify integer subtraction: old_balance - withdraw_amount == new_balance
    computed_new = base_sub(old_balance, withdraw_amount);
    constrain_equal_base(computed_new, new_balance);

    # Nullifier: prevents double-withdrawal of the same operation
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, purse_id, operation_nonce);
    constrain_instance(nullifier);

    # Range checks
    range_check(64, old_balance);
    range_check(64, withdraw_amount);
    range_check(64, new_balance);

    # Expose public inputs
    constrain_instance(purse_id);
    constrain_instance(ec_get_x(old_commit));
    constrain_instance(ec_get_y(old_commit));
    constrain_instance(ec_get_x(new_commit));
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(ec_get_y(new_commit));
}
