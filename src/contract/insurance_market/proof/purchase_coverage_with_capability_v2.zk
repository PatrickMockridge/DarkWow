# Insurance Market PurchaseCoverageWithCapability Circuit
# Proves buyer identity + capability check + nullifier for replay protection.
k = 11; field = "pallas";
constant "PurchaseCoverageV2" { EcFixedPointBase NULLIFIER_K, }
witness "PurchaseCoverageV2" {
    Base buyer_secret, Base buyer_pub_x, Base buyer_pub_y,
    Base required_capability_id, Base capability_predicate_result,
    Base buyer_nullifier, Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "PurchaseCoverageV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    buyer_pub = ec_mul_base(buyer_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(buyer_pub), buyer_pub_x);
    constrain_equal_base(ec_get_y(buyer_pub), buyer_pub_y);
    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);
    computed_nullifier = poseidon_hash(DOMAIN_COIN_COMMIT, buyer_pub_x, buyer_pub_y, buyer_secret);
    constrain_equal_base(computed_nullifier, buyer_nullifier);
    constrain_instance(buyer_pub_x); constrain_instance(buyer_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce); constrain_instance(required_capability_id);
    constrain_instance(buyer_nullifier);
}
