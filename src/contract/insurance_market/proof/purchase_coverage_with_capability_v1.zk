k = 11;
field = "pallas";

# Insurance Market Purchase Coverage With Capability Circuit (Version 1)
#
# This circuit proves:
# - Buyer knows their secret key
# - Buyer public key is correctly derived
# - Buyer has required capability (verified via Identity contract)
# - Buyer is purchasing valid coverage
#
# Public Inputs (constrain_instance):
#   - buyer_pub_x, buyer_pub_y: Buyer's public key coordinates
#   - required_capability_id: The capability this coverage requires
#
# witnesses:
#   - buyer_secret: Buyer's secret key
#   - capability_proof: ZK proof from Identity contract (verified off-chain)

constant "PurchaseCoverageWithCapability" {
    EcFixedPointBase NULLIFIER_K,
}

witness "PurchaseCoverageWithCapability" {
    # Buyer's secret (for key derivation)
    Base buyer_secret,

    # Buyer's public key coordinates
    Base buyer_pub_x,
    Base buyer_pub_y,

    # Required capability ID for this coverage tier
    Base required_capability_id,

    # Capability predicate result (from Identity contract)
    Base capability_predicate_result,
}

circuit "PurchaseCoverageWithCapability" {
    # ==========================================================================
    # PHASE 1: Derive buyer public key from secret
    # ==========================================================================

    buyer_pub = ec_mul_base(buyer_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(buyer_pub);
    derived_pub_y = ec_get_y(buyer_pub);

    # CRITICAL: Verify derived public key matches the public input
    constrain_equal_base(derived_pub_x, buyer_pub_x);
    constrain_equal_base(derived_pub_y, buyer_pub_y);

    # ==========================================================================
    # PHASE 2: Verify capability predicate result
    # ==========================================================================

    # The capability predicate result should be 1 (satisfied)
    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(buyer_pub_x);
    constrain_instance(buyer_pub_y);
    constrain_instance(required_capability_id);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    #
    # The prover proves that:
    # 1. They know the buyer's secret key
    # 2. Their public key is correctly derived
    # 3. The capability_predicate_result is 1 (capability satisfied)
    #
    # What this enables:
    # - Buyer can purchase coverage in markets requiring specific capabilities
    # - The capability verification is done via Identity contract
    # - Buyer identity is hidden, only capability is proven
    #
    # Soundness: Uses proven opcodes (ec_mul_base, ec_get_x, ec_get_y)