k = 11;
field = "pallas";

constant "Underwrite" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Underwrite" {
    Base underwriter_secret,
    Base underwriter_pub_x,
    Base underwriter_pub_y,
    Base required_capability_id,
    Base capability_predicate_result,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Underwrite" {
    underwriter_pub = ec_mul_base(underwriter_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(underwriter_pub);
    derived_pub_y = ec_get_y(underwriter_pub);
    constrain_equal_base(derived_pub_x, underwriter_pub_x);
    constrain_equal_base(derived_pub_y, underwriter_pub_y);

    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);

    constrain_instance(underwriter_pub_x);
    constrain_instance(underwriter_pub_y);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(required_capability_id);
}
