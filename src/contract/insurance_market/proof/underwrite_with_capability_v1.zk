k = 11;
field = "pallas";

# Insurance Market Underwrite With Capability Circuit (Version 1)
#
# This circuit proves:
# - Underwriter knows their secret key
# - Underwriter public key is correctly derived
# - Underwriter has required capability (verified via Identity contract)
# - Underwriter is posting sufficient bond for coverage
#
# Public Inputs (constrain_instance):
#   - underwriter_pub_x, underwriter_pub_y: Underwriter's public key coordinates
#   - required_capability_id: The capability this market requires
#
# witnesses:
#   - underwriter_secret: Underwriter's secret key
#   - capability_proof: ZK proof from Identity contract (verified off-chain)

constant "UnderwriteWithCapability" {
    EcFixedPointBase NULLIFIER_K,
}

witness "UnderwriteWithCapability" {
    # Underwriter's secret (for key derivation)
    Base underwriter_secret,

    # Underwriter's public key coordinates
    Base underwriter_pub_x,
    Base underwriter_pub_y,

    # Required capability ID for this market
    Base required_capability_id,

    # Capability predicate result (from Identity contract)
    Base capability_predicate_result,
}

circuit "UnderwriteWithCapability" {
    # ==========================================================================
    # PHASE 1: Derive underwriter public key from secret
    # ==========================================================================

    underwriter_pub = ec_mul_base(underwriter_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(underwriter_pub);
    derived_pub_y = ec_get_y(underwriter_pub);

    # CRITICAL: Verify derived public key matches the public input
    constrain_equal_base(derived_pub_x, underwriter_pub_x);
    constrain_equal_base(derived_pub_y, underwriter_pub_y);

    # ==========================================================================
    # PHASE 2: Verify capability predicate result
    # ==========================================================================

    # The capability predicate result should be 1 (satisfied)
    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(underwriter_pub_x);
    constrain_instance(underwriter_pub_y);
    constrain_instance(required_capability_id);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    #
    # The prover proves that:
    # 1. They know the underwriter's secret key
    # 2. Their public key is correctly derived
    # 3. The capability_predicate_result is 1 (capability satisfied)
    #
    # What this enables:
    # - Underwriter can post bond in markets requiring specific capabilities
    # - The capability verification is done via Identity contract
    # - Underwriter identity is hidden, only capability is proven
    #
    # Soundness: Uses proven opcodes (ec_mul_base, ec_get_x, ec_get_y)