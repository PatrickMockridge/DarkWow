# MultiSig Finalize Circuit — threshold signature finalization
k = 11;
field = "pallas";

# finalize_V2 — domain-separated circuit.

# Public Inputs (constrain_instance):
#   - group_id: The group being finalized
#   - message_hash: The message being approved
#   - approval_commit: H(DOMAIN_COMMITMENT, group_id, message_hash), the approval's identity
#
# Witnesses:
#   - none beyond the above and the tx binding

constant "FinalizeV2" {}

witness "FinalizeV2" {
    Base group_id,
    Base message_hash,

    Base approval_commit,

    Base tx_commitment,
    Base tx_nonce,
}

circuit "FinalizeV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # ==========================================================================
    # PHASE 1: The approval's identity
    # ==========================================================================
    #
    # `approval_commit` is now EXPOSED, and the host reads it from the params rather than
    # recomputing it. Before this the two sides disagreed: the circuit computed
    # `poseidon_hash(DOMAIN_COMMITMENT, group_id, message_hash)` while the entrypoint computed
    # `poseidon_hash([group_id, message_hash])` with no domain prefix. Because the value was never
    # exposed, nothing compared them, so the proof bound a commitment the contract never used.
    # Exposing it makes the host and the circuit agree by construction.

    computed_approval = poseidon_hash(DOMAIN_COMMITMENT, group_id, message_hash);
    constrain_equal_base(computed_approval, approval_commit);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================
    #
    # The former `threshold` and `signature_count` witnesses are gone. Neither was used by the
    # circuit nor exposed, so they were rows that proved nothing: the count that matters is the
    # host's, taken from the signature records it can actually see.

    constrain_instance(group_id);
    constrain_instance(message_hash);
    constrain_instance(approval_commit);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
