# MultiSig CreateGroup Circuit — verifies group creation parameters
k = 11;
field = "pallas";

constant "CreateGroupV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateGroupV1" {
    Base group_id,
    Base threshold,
    Base total_keys,

    Base tx_commitment,
    Base tx_nonce,
}

circuit "CreateGroupV1" {
    range_check(64, threshold);

    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);

    constrain_instance(group_id);
    constrain_instance(threshold);
    constrain_instance(total_keys);
}
