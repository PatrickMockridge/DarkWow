# MultiSig CreateGroup Circuit — verifies group creation parameters
k = 11;
field = "pallas";

# create_group_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "CreateGroupV2" {}

witness "CreateGroupV2" {
    Base group_id,
    Base threshold,
    Base total_keys,
    # The first (deduplicated) member commitment. The host derives `group_id` from it and publishes
    # that derivation in the metadata; the circuit now requires the exposed `group_id` to be the
    # same derivation, so the proof commits to the group's first member and counts. Before this the
    # exposed id was related to nothing and a proof over any bytes verified.
    Base first_commitment,

    Base tx_commitment,
    Base tx_nonce,
}

circuit "CreateGroupV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_GROUP_ID = witness_base(14);

    range_check(64, threshold);

    derived_group_id = poseidon_hash(DOMAIN_GROUP_ID, first_commitment, threshold, total_keys);
    constrain_equal_base(derived_group_id, group_id);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);

    # `OBL-C198`: the tx pair is the **last two** instances of every circuit. The node reads
    # that position to recompute the binding from the enclosing transaction and refuse a proof
    # whose published value differs; there is no per-circuit index map, so the position IS the
    # convention. This circuit placed the pair first, which the convention forbids.
    constrain_instance(group_id);
    constrain_instance(threshold);
    constrain_instance(total_keys);

    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
