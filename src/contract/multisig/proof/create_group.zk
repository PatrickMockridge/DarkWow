# MultiSig CreateGroup Circuit — verifies group creation parameters
k = 11;
field = "pallas";

# create_group_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "CreateGroupV2" {}

witness "CreateGroupV2" {
    Base group_id,
    Base threshold,
    Base total_keys,

    Base tx_commitment,
    Base tx_nonce,
}

circuit "CreateGroupV2" {
    DOMAIN_TX_BINDING = witness_base(3);

    range_check(64, threshold);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);

    # `OBL-C198`: the tx pair is the **last two** instances of every circuit. The node reads
    # that position to recompute the binding from the enclosing transaction and refuse a proof
    # whose published value differs; there is no per-circuit index map, so the position IS the
    # convention. This circuit placed the pair first, which the convention forbids.
    constrain_instance(group_id);
    constrain_instance(threshold);
    constrain_instance(total_keys);

    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
