# MultiSig Sign Circuit — proves the signer holds a secret that opens one of the group's member
# commitments, and derives the signature's nullifier from that same secret.
k = 11;
field = "pallas";

# sign_V2 — domain-separated circuit.

# Public Inputs (constrain_instance):
#   - group_id: The group being signed for
#   - message_hash: The message being approved
#   - member_commitment: H(DOMAIN_MEMBER_COMMITMENT, signer_secret)
#   - nullifier: H(DOMAIN_NULLIFIER, signer_secret, group_id, message_hash)
#
# Witnesses:
#   - signer_secret: The member's secret

constant "SignV2" {
}

witness "SignV2" {
    Base group_id,
    Base message_hash,

    Base signer_secret,

    Base tx_commitment,
    Base tx_nonce,
}

circuit "SignV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_MEMBER_COMMITMENT = witness_base(4);
    DOMAIN_NULLIFIER = witness_base(1);

    # ==========================================================================
    # PHASE 1: The signer's identity in the group, and the operation's nullifier
    # ==========================================================================
    #
    # This circuit used to do
    #
    #     signer_pub    = ec_mul_base(signer_secret, NULLIFIER_K);
    #     derived_pub_x = ec_get_x(signer_pub);
    #     constrain_equal_base(derived_pub_x, signer_pub_x);   -- witness == witness
    #
    # with `signer_pub_x`/`signer_pub_y` declared `witness` and NEVER exposed. The equality was
    # therefore between two prover-chosen values and held for *any* secret, and the entrypoint's
    # membership test `group.pubkeys.iter().any(|pk| pk == &params.signer_pub)` compared a key the
    # caller had typed against the stored list. A non-member could name any member's key, pass the
    # check, and have that member's nullifier recorded — and, repeating over the group's other
    # members, forge a threshold approval outright (OBL-Z11).
    #
    # The member commitment below is what the group stores. It is derived here from the secret, so
    # it is proof-bound; the host checks it against the group's set, so naming someone else's
    # commitment is useless — the proof would have to open it.

    member_commitment = poseidon_hash(DOMAIN_MEMBER_COMMITMENT, signer_secret);

    # The nullifier is bound to the group *and* the message, so one signature cannot be replayed
    # onto another message and two members signing the same message stay distinct.
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, signer_secret, group_id, message_hash);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(group_id);
    constrain_instance(message_hash);
    constrain_instance(member_commitment);
    constrain_instance(nullifier);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
