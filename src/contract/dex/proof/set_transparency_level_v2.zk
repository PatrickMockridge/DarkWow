# SetTransparencyLevel_V2 circuit — domain-separated governance identity.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11; field = "pallas";
constant "SetTransparencyLevelV2" { EcFixedPointBase NULLIFIER_K, }
witness "SetTransparencyLevelV2" {
    Base gov_secret, Base gov_pub_x, Base gov_pub_y,
    Base gov_nullifier, Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
    # HAZOP H-8 fix: pair_id for per-pair unique governance nullifiers
    Base pair_id,
}
circuit "SetTransparencyLevelV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    gov_pub = ec_mul_base(gov_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(gov_pub), gov_pub_x);
    constrain_equal_base(ec_get_y(gov_pub), gov_pub_y);
    # HAZOP H-8 fix: include pair_id for per-operation unique nullifiers
    computed = poseidon_hash(DOMAIN_NULLIFIER, gov_pub_x, gov_pub_y, gov_secret, pair_id);
    constrain_equal_base(computed, gov_nullifier);
    constrain_instance(gov_pub_x); constrain_instance(gov_pub_y);
    constrain_instance(gov_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
