# CancelSwap_V2 circuit — domain-separated swap cancellation.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
# V3 (PN CapCommitment): the lock is a Promissory Note CapCommitment
k = 11;
field = "pallas";

constant "CancelSwapV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CancelSwapV2" {
    Base lock_commitment,
    Base secret,
    Base token,
    Base amount,
    Base blind,
    Base request_token,
    Base request_amount,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CancelSwapV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_CAP_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);
    SPEND_HOOK = witness_base(0);
    USER_DATA = witness_base(0);

    # PHASE 1: Verify lock commitment (offer side, canonical PN CapCommitment)
    public_key = poseidon_hash(DOMAIN_SIGNATURE_SECRET, secret);
    derived_lock = poseidon_hash(
        DOMAIN_CAP_COMMIT,
        public_key,
        token,
        amount,
        SPEND_HOOK,
        USER_DATA,
        blind,
    );
    constrain_equal_base(derived_lock, lock_commitment);

    # PHASE 2: Derive nullifier
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, secret, lock_commitment);
    constrain_instance(computed_nullifier);

    # PHASE 3: Verify swap ID consistency (request side, matching create's swap_id)
    computed_swap_id = poseidon_hash(DOMAIN_CAP_COMMIT, lock_commitment, request_token, request_amount);
    constrain_instance(computed_swap_id);

    # PHASE 4: Range proofs
    range_check(64, amount);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
