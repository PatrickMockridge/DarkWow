# CreateSwap_V2 circuit — domain-separated swap creation.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "CreateSwapV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateSwapV2" {
    Base secret,
    Base offer_token,
    Base offer_amount,
    Base request_token,
    Base request_amount,
    Base token_blind,
    Base amount_blind,
    Base signature_secret,
    Base signature_public_x,
    Base signature_public_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateSwapV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # PHASE 1: Compute lock commitment
    computed_lock = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );
    constrain_instance(computed_lock);

    # PHASE 2: Derive and verify swap ID
    computed_swap_id = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        computed_lock,
        request_token,
        request_amount,
    );
    constrain_instance(computed_swap_id);

    # PHASE 3: Derive nullifier
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, secret, computed_lock);
    constrain_instance(nullifier);

    # PHASE 4: Signature public key verification
    signature_public = ec_mul_base(signature_secret, NULLIFIER_K);
    derived_sig_pub_x = ec_get_x(signature_public);
    derived_sig_pub_y = ec_get_y(signature_public);
    constrain_equal_base(derived_sig_pub_x, signature_public_x);
    constrain_equal_base(derived_sig_pub_y, signature_public_y);
    constrain_instance(signature_public_x);
    constrain_instance(signature_public_y);

    # PHASE 5: Range proofs
    range_check(64, offer_amount);
    range_check(64, request_amount);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
