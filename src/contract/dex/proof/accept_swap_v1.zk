k = 11;
field = "pallas";

constant "AcceptSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AcceptSwapV1" {
    # Public inputs
    Base swap_id,
    Base proposer_lock_commitment,
    Base acceptor_lock_commitment,
    Base swaps_root,

    # Private inputs
    Base acceptor_secret,
    Base offer_token,
    Base offer_amount,
    Base token_blind,
    Base amount_blind,
}

circuit "AcceptSwapV1" {
    # Compute acceptor's lock commitment
    computed_lock = poseidon_hash(
        acceptor_secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );
    constrain_instance(computed_lock);

    # Verify lock commitment matches
    assert_equal(computed_lock, acceptor_lock_commitment);

    # Derive acceptor's nullifier
    acceptor_nullifier = poseidon_hash(acceptor_secret, acceptor_lock_commitment);
    constrain_instance(acceptor_nullifier);

    # Verify swap ID consistency
    # Both parties' locks must match the swap_id
    # swap_id = H(proposer_lock, request_token, request_amount, timestamp)
    # We only verify acceptor lock is valid
    assert(offer_amount > 0);
    assert(offer_amount < 2^64);
}