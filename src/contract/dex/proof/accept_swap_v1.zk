k = 11;
field = "pallas";

# DEX: Accept Swap Circuit (Version 1)
#
# Accepts a swap proposal.
#
# This circuit proves:
# - Acceptor knows the secret to their locked funds
# - The lock commitment is correctly computed
# - The acceptor lock matches the proposer's request
# - Acceptor knows the secret key corresponding to signature_public
#
# Public Inputs (constrain_instance):
#   - acceptor_lock_commitment: The commitment to Bob's locked funds
#   - acceptor_nullifier: Prevents double-acceptance
#   - signature_public_x: X coordinate of acceptor's signature public key
#   - signature_public_y: Y coordinate of acceptor's signature public key
#
# witnesses:
#   - swap_id: The swap being accepted
#   - proposer_lock_commitment: The proposer's lock (for verification)
#   - acceptor_secret: Bob's secret for his lock
#   - offer_token: Token Bob is offering
#   - offer_amount: Amount Bob is offering
#   - token_blind: Blinding factor for token
#   - amount_blind: Blinding factor for amount
#   - signature_secret: Bob's secret key for signature

constant "AcceptSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AcceptSwapV1" {
    # The swap being accepted
    Base swap_id,

    # Proposer's lock (referenced in the swap)
    Base proposer_lock_commitment,

    # Acceptor's offer details
    Base acceptor_secret,
    Base offer_token,
    Base offer_amount,

    # Blinding factors
    Base token_blind,
    Base amount_blind,

    # Signature secret key
    Base signature_secret,
    # Signature public key coordinates (public input - must match derived)
    Base signature_public_x,
    Base signature_public_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AcceptSwapV1" {
    # ==========================================================================
    # PHASE 1: Compute and verify acceptor's lock commitment
    # ==========================================================================
    #
    # Acceptor's lock = poseidon_hash(acceptor_secret, offer_token, offer_amount, blinds)
    # This proves the acceptor has locked funds for this swap.

    computed_lock = poseidon_hash(
        acceptor_secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );

    # The acceptor_lock_commitment is a PUBLIC INPUT
    constrain_instance(computed_lock);

    # ==========================================================================
    # PHASE 2: Derive acceptor's nullifier - PUBLIC INPUT
    # ==========================================================================
    #
    # acceptor_nullifier = poseidon_hash(acceptor_secret, acceptor_lock)
    # This prevents accepting the same swap twice.

    acceptor_nullifier = poseidon_hash(acceptor_secret, computed_lock);
    constrain_instance(acceptor_nullifier);

    # ==========================================================================
    # PHASE 3: Verify proposer lock matches
    # ==========================================================================
    #
    # The proposer's lock should match what was committed in the swap.
    # This is verified via constrain_equal_base with the proposer's commitment.

    constrain_equal_base(computed_lock, proposer_lock_commitment);

    # ==========================================================================
    # PHASE 4: Signature public key verification
    # ==========================================================================
    #
    # Derive signature public key from secret and constrain coordinates.
    # This proves the signer knows the secret key corresponding to signature_public.
    # The host verifies the actual signature; this constrains the public key.

    signature_public = ec_mul_base(signature_secret, NULLIFIER_K);
    derived_sig_pub_x = ec_get_x(signature_public);
    derived_sig_pub_y = ec_get_y(signature_public);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the signature_secret to the signature_pubkey
    constrain_equal_base(derived_sig_pub_x, signature_public_x);
    constrain_equal_base(derived_sig_pub_y, signature_public_y);

    constrain_instance(signature_public_x);
    constrain_instance(signature_public_y);

    # ==========================================================================
    # PHASE 5: Range proofs
    # ==========================================================================

    range_check(64, offer_amount);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # bool_check removed (RC1-A) — range_check below is sufficient
}