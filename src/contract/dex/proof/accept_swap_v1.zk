k = 11;
field = "pallas";

constant "AcceptSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AcceptSwapV1" {
    # Public inputs
    Base swap_id,
    Base proposer_lock_commitment,
    Base acceptor_lock_commitment,
    Base swaps_root,

    # Private inputs
    Base acceptor_secret,
    Base offer_token,
    Base offer_amount,
    Base token_blind,
    Base amount_blind,
}

circuit "AcceptSwapV1" {
    # Compute acceptor's lock commitment
    computed_lock = poseidon_hash(
        acceptor_secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );
    constrain_instance(computed_lock);

    # Verify acceptor lock commitment matches public input
    constrain_equal_base(computed_lock, acceptor_lock_commitment);

    # Derive acceptor's nullifier
    acceptor_nullifier = poseidon_hash(acceptor_secret, acceptor_lock_commitment);
    constrain_instance(acceptor_nullifier);

    # Verify proposer lock matches the one referenced in swap
    constrain_equal_base(computed_lock, proposer_lock_commitment);

    # Range proof for amount
    range_check(64, offer_amount);
}
