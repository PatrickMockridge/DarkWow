k = 11;
field = "pallas";

constant "CancelSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CancelSwapV1" {
    # Public inputs
    Base swap_id,
    Base lock_commitment,
    Base nullifier,

    # Private inputs
    Base secret,
    Base token,
    Base amount,
}

circuit "CancelSwapV1" {
    # Derive nullifier from secret and lock commitment
    computed_nullifier = poseidon_hash(secret, lock_commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches (proves ownership)
    constrain_equal_base(computed_nullifier, nullifier);

    # Verify lock commitment can be derived from secret
    derived_lock = poseidon_hash(secret, token, amount);
    constrain_equal_base(derived_lock, lock_commitment);

    # Verify swap ID consistency
    computed_swap_id = poseidon_hash(lock_commitment);
    constrain_equal_base(computed_swap_id, swap_id);

    # Range check for amount
    range_check(64, amount);
}