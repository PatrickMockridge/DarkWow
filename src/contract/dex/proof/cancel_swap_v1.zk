k = 11;
field = "pallas";

# DEX: Cancel Swap Circuit (Version 1)
#
# Cancels a swap and refunds the locked funds.
#
# This circuit proves:
# - Canceler knows the secret to the lock
# - The nullifier is correctly computed
#
# Public Inputs (constrain_instance):
#   - nullifier: Prevents double-cancellation
#
# witnesses:
#   - swap_id: The swap being cancelled
#   - lock_commitment: The lock commitment
#   - secret: The secret to the lock
#   - token: Token being cancelled
#   - amount: Amount being cancelled

constant "CancelSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CancelSwapV1" {
    # The swap being cancelled
    Base swap_id,

    # The lock commitment
    Base lock_commitment,

    # The secret to the lock
    Base secret,

    # Token and amount
    Base token,
    Base amount,
}

circuit "CancelSwapV1" {
    # ==========================================================================
    # PHASE 1: Verify lock commitment can be derived
    # ==========================================================================
    #
    # The lock should be derivable from the secret, token, and amount.
    # This proves the canceller knows the lock details.

    derived_lock = poseidon_hash([secret, token, amount]);
    constrain_equal_base(derived_lock, lock_commitment);

    # ==========================================================================
    # PHASE 2: Derive and verify nullifier - PUBLIC INPUT
    # ==========================================================================
    #
    # nullifier = poseidon_hash(secret, lock_commitment)
    # This prevents cancelling the same swap twice.

    computed_nullifier = poseidon_hash([secret, lock_commitment]);
    constrain_instance(computed_nullifier);

    # ==========================================================================
    # PHASE 3: Verify swap ID consistency - PUBLIC INPUT
    # ==========================================================================

    computed_swap_id = poseidon_hash([lock_commitment]);
    constrain_instance(computed_swap_id);

    # ==========================================================================
    # PHASE 4: Range proofs
    # ==========================================================================

    range_check(64, amount);
    bool_check(amount);
}