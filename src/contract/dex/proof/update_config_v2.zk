# UpdateConfig_V2 circuit — domain-separated governance identity.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11; field = "pallas";
constant "UpdateConfigV2" { EcFixedPointBase NULLIFIER_K, }
witness "UpdateConfigV2" {
    Base gov_secret, Base gov_pub_x, Base gov_pub_y,
    Base config_nullifier, Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "UpdateConfigV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    gov_pub = ec_mul_base(gov_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(gov_pub), gov_pub_x);
    constrain_equal_base(ec_get_y(gov_pub), gov_pub_y);
    computed = poseidon_hash(DOMAIN_NULLIFIER, gov_pub_x, gov_pub_y, gov_secret);
    constrain_equal_base(computed, config_nullifier);
    constrain_instance(gov_pub_x); constrain_instance(gov_pub_y);
    constrain_instance(config_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
