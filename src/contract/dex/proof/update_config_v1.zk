# DEX UpdateConfig Circuit — proves governance identity via ZK.
k = 11; field = "pallas";
constant "UpdateConfigV1" { EcFixedPointBase NULLIFIER_K, }
witness "UpdateConfigV1" {
    Base gov_secret, Base gov_pub_x, Base gov_pub_y,
    Base config_nullifier, Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "UpdateConfigV1" {
    gov_pub = ec_mul_base(gov_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(gov_pub), gov_pub_x);
    constrain_equal_base(ec_get_y(gov_pub), gov_pub_y);
    computed = poseidon_hash(gov_pub_x, gov_pub_y, gov_secret);
    constrain_equal_base(computed, config_nullifier);
    constrain_instance(gov_pub_x); constrain_instance(gov_pub_y);
    constrain_instance(config_nullifier); tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
