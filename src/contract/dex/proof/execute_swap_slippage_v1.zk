k = 11;
field = "pallas";

# DEX: Execute Swap with Slippage Tolerance Circuit (Version 1)
#
# Executes an atomic swap between Alice and Bob with slippage protection.
#
# This circuit proves:
# - All standard swap validity (secrets, locks, nullifiers)
# - Fill amount satisfies slippage tolerance
#
# Slippage tolerance: received >= min_expected * (1 - slippage_bps / 10000)

constant "ExecuteSwapSlippageV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExecuteSwapSlippageV1" {
    # Alice's secret for her lock
    Base alice_secret,

    # Alice's offer details
    Base alice_token,
    Base alice_amount,

    # Alice's lock commitment (public input)
    Base alice_lock,

    # Bob's secret for his lock
    Base bob_secret,

    # Bob's offer details
    Base bob_token,
    Base bob_amount,

    # Bob's lock commitment (public input)
    Base bob_lock,

    # Partial fill amount
    Base fill_amount,

    # Slippage tolerance in basis points (e.g., 50 = 0.5%)
    Base slippage_bps,
}

circuit "ExecuteSwapSlippageV1" {
    # ==========================================================================
    # PHASE 1: Verify Alice's lock commitment
    # ==========================================================================

    alice_lock_check = poseidon_hash(
        alice_secret,
        alice_token,
        alice_amount,
    );
    constrain_equal_base(alice_lock_check, alice_lock);

    # ==========================================================================
    # PHASE 2: Verify Bob's lock commitment
    # ==========================================================================

    bob_lock_check = poseidon_hash(
        bob_secret,
        bob_token,
        bob_amount,
    );
    constrain_equal_base(bob_lock_check, bob_lock);

    # ==========================================================================
    # PHASE 3: Derive and verify nullifiers
    # ==========================================================================

    alice_nullifier_check = poseidon_hash(alice_secret, alice_lock);
    bob_nullifier_check = poseidon_hash(bob_secret, bob_lock);

    constrain_instance(alice_nullifier_check);
    constrain_instance(bob_nullifier_check);

    # ==========================================================================
    # PHASE 4: Verify swap ID consistency
    # ==========================================================================

    computed_swap_id = poseidon_hash(alice_lock, bob_token, bob_amount);
    constrain_instance(computed_swap_id);

    # ==========================================================================
    # PHASE 5: Partial fill check using LessThanOrEqual
    # ==========================================================================

    range_check(64, alice_amount);
    range_check(64, bob_amount);
    range_check(64, fill_amount);
    range_check(64, slippage_bps);

    # Fill amount <= alice offered
    ONE = witness_base(1);
    is_lte = less_than_or_equal(fill_amount, alice_amount);
    constrain_equal_base(is_lte, ONE);

    # Bob's amount >= fill
    less_than_strict(fill_amount, bob_amount);

    # ==========================================================================
    # PHASE 6: Slippage tolerance check — cross-multiplication (no base_div)
    # ==========================================================================
    #
    # HAZOP ELEV-5 FIX: Previously used base_div (field division) which produces
    # a field element, not an integer. For token amounts that must be integers,
    # field division creates a semantic gap where non-divisible amounts produce
    # unexpected results.
    #
    # Cross-multiplication avoids division entirely:
    #   Goal: fill_amount * bob_amount / alice_amount >= bob_amount * (1 - slippage/10000)
    #   Cancel bob_amount (both sides positive): fill_amount * 10000 >= (10000 - slippage) * alice_amount
    #
    # This uses only base_mul and less_than_or_equal — both verified sound.

    BPS = witness_base(10000);
    slippage_sub = base_sub(BPS, slippage_bps);

    # left = fill_amount * 10000
    left = base_mul(fill_amount, BPS);

    # right = (10000 - slippage_bps) * alice_amount
    right = base_mul(slippage_sub, alice_amount);

    # Verify: fill_amount * 10000 >= (10000 - slippage) * alice_amount
    # i.e., right <= left
    ONE = witness_base(1);
    is_satisfied = less_than_or_equal(right, left);
    constrain_equal_base(is_satisfied, ONE);

    # HAZOP ELEV-6 FIX: bool_check removed (same as execute_swap_v1.zk).
    # range_check(64) on amounts already provides the needed constraint.
}
