# ExecuteSwap_V2 circuit — domain-separated atomic swap execution.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "ExecuteSwapV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExecuteSwapV2" {
    Base alice_secret,
    Base alice_token,
    Base alice_amount,
    Base alice_lock,
    Base bob_secret,
    Base bob_token,
    Base bob_amount,
    Base bob_lock,
    Base fill_amount,
    Base alice_otc_func_id,
    Base bob_otc_func_id,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ExecuteSwapV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # PHASE 1: Verify Alice's lock
    alice_lock_check = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        alice_secret,
        alice_token,
        alice_amount,
    );
    constrain_equal_base(alice_lock_check, alice_lock);

    # PHASE 2: Verify Bob's lock
    bob_lock_check = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        bob_secret,
        bob_token,
        bob_amount,
    );
    constrain_equal_base(bob_lock_check, bob_lock);

    # PHASE 3: Derive nullifiers
    alice_nullifier_check = poseidon_hash(DOMAIN_NULLIFIER, alice_secret, alice_lock);
    bob_nullifier_check = poseidon_hash(DOMAIN_NULLIFIER, bob_secret, bob_lock);
    constrain_instance(alice_nullifier_check);
    constrain_instance(bob_nullifier_check);

    constrain_instance(alice_otc_func_id);
    constrain_instance(bob_otc_func_id);

    # PHASE 4: Verify swap ID
    computed_swap_id = poseidon_hash(DOMAIN_COIN_COMMIT, alice_lock, bob_token, bob_amount);
    constrain_instance(computed_swap_id);

    # PHASE 5: Partial fill check
    range_check(64, alice_amount);
    range_check(64, bob_amount);
    range_check(64, fill_amount);

    ONE = witness_base(1);
    is_lte = less_than_or_equal(fill_amount, alice_amount);
    constrain_equal_base(is_lte, ONE);
    less_than_strict(fill_amount, bob_amount);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
