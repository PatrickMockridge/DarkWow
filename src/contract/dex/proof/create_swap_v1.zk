k = 11;
field = "pallas";

# DEX: Create Swap Circuit (Version 1)
#
# Creates a swap proposal.
#
# This circuit proves:
# - Creator knows the secret to the locked funds
# - The lock commitment is correctly computed
# - The swap ID is consistent
# - Creator knows the secret key corresponding to signature_public
#
# Public Inputs (constrain_instance):
#   - lock_commitment: The commitment to Alice's locked funds
#   - swap_id: The derived swap identifier
#   - nullifier: Prevents double-creation
#   - signature_public_x: X coordinate of proposer's signature public key
#   - signature_public_y: Y coordinate of proposer's signature public key
#
# witnesses:
#   - secret: Alice's secret for the lock
#   - offer_token: Token Alice is offering
#   - offer_amount: Amount Alice is offering
#   - request_token: Token Alice wants in return
#   - request_amount: Amount Alice wants in return
#   - token_blind: Blinding factor for token
#   - amount_blind: Blinding factor for amount
#   - signature_secret: Alice's secret key for signature

constant "CreateSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateSwapV1" {
    # Swap details
    Base secret,
    Base offer_token,
    Base offer_amount,
    Base request_token,
    Base request_amount,

    # Blinding factors
    Base token_blind,
    Base amount_blind,

    # Signature secret key
    Base signature_secret,
    # Signature public key coordinates (public input - must match derived)
    Base signature_public_x,
    Base signature_public_y,
}

circuit "CreateSwapV1" {
    # ==========================================================================
    # PHASE 1: Compute and verify lock commitment
    # ==========================================================================
    #
    # Lock commitment = poseidon_hash(secret, offer_token, offer_amount, blinds)
    # This proves Alice has locked funds for this swap.

    computed_lock = poseidon_hash(
        secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );

    # The lock_commitment is a PUBLIC INPUT
    constrain_instance(computed_lock);

    # ==========================================================================
    # PHASE 2: Derive and verify swap ID - PUBLIC INPUT
    # ==========================================================================
    #
    # swap_id = poseidon_hash(lock_commitment, request_token, request_amount)
    # This binds the swap parameters together.

    computed_swap_id = poseidon_hash(
        computed_lock,  # Use the computed lock
        request_token,
        request_amount,
    );

    # The swap_id is a PUBLIC INPUT
    constrain_instance(computed_swap_id);

    # ==========================================================================
    # PHASE 3: Derive nullifier - PUBLIC INPUT
    # ==========================================================================
    #
    # nullifier = poseidon_hash(secret, lock_commitment)
    # This prevents creating the same swap twice.

    nullifier = poseidon_hash(secret, computed_lock);
    constrain_instance(nullifier);

    # ==========================================================================
    # PHASE 4: Signature public key verification
    # ==========================================================================
    #
    # Derive signature public key from secret and constrain coordinates.
    # This proves the signer knows the secret key corresponding to signature_public.
    # The host verifies the actual signature; this constrains the public key.

    signature_public = ec_mul_base(signature_secret, NULLIFIER_K);
    derived_sig_pub_x = ec_get_x(signature_public);
    derived_sig_pub_y = ec_get_y(signature_public);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the signature_secret to the signature_pubkey
    constrain_equal_base(derived_sig_pub_x, signature_public_x);
    constrain_equal_base(derived_sig_pub_y, signature_public_y);

    constrain_instance(signature_public_x);
    constrain_instance(signature_public_y);

    # ==========================================================================
    # PHASE 5: Range proofs
    # ==========================================================================

    range_check(64, offer_amount);
    range_check(64, request_amount);

    # Boolean checks
    bool_check(offer_amount);
    bool_check(request_amount);
}