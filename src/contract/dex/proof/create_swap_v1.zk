k = 11;
field = "pallas";

constant "CreateSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateSwapV1" {
    # Public inputs
    Base swap_id,
    Base lock_commitment,
    Base offer_token,
    Base offer_amount,
    Base request_token,
    Base request_amount,
    Base swaps_root,
    Base timestamp,
    Base expiry,

    # Private inputs
    Base secret,
    Base token_blind,
    Base amount_blind,
}

circuit "CreateSwapV1" {
    # Compute lock commitment: H(secret, offer_token, offer_amount, blinds)
    computed_lock = poseidon_hash(
        secret,
        offer_token,
        offer_amount,
        token_blind,
        amount_blind,
    );
    constrain_instance(computed_lock);

    # Verify lock commitment matches
    assert_equal(computed_lock, lock_commitment);

    # Derive swap ID: H(lock_commitment, request_token, request_amount, timestamp)
    computed_swap_id = poseidon_hash(
        lock_commitment,
        request_token,
        request_amount,
        timestamp,
    );
    constrain_instance(computed_swap_id);

    # Verify swap ID matches
    assert_equal(computed_swap_id, swap_id);

    # Derive nullifier for this swap
    nullifier = poseidon_hash(secret, lock_commitment);
    constrain_instance(nullifier);

    # Range proofs
    assert(offer_amount > 0);
    assert(request_amount > 0);
    assert(offer_amount < 2^64);
    assert(request_amount < 2^64);
}