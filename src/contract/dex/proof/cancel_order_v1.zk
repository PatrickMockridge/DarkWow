// DarkFi DEX Cancel Order Proof V1
//
// Circuit for cancelling an order and recovering funds.

circuit cancel_order_v1(prover: Witness) {
    // ============================================
    // PUBLIC INPUTS
    // ============================================

    // Nullifier = H(secret) - proves ownership
    nullifier: Scalar = prover.pub_input("nullifier");

    // Current order book root
    orderbook_root: Scalar = prover.pub_input("orderbook_root");

    // Commitment being cancelled (for verification)
    order_commitment: Scalar = prover.pub_input("order_commitment");

    // ============================================
    // PRIVATE INPUTS (WITNESS)
    // ============================================

    // User's secret key
    secret: Scalar = prover.witness("secret");

    // Order parameters (to verify commitment)
    amount: Scalar = prover.witness("amount");
    price: Scalar = prover.witness("price");
    token: Scalar = prover.witness("token");
    side: Scalar = prover.witness("side");

    // Merkle proof that order exists
    existence_proof: MerklePath = prover.witness("existence_proof");

    // ============================================
    // NULLIFIER VERIFICATION
    // ============================================

    // Verify nullifier = H(secret)
    computed_nullifier: Scalar = poseidon_hash(secret);
    assert_equal(computed_nullifier, nullifier);

    // ============================================
    // ORDER VERIFICATION
    // ============================================

    // Recompute commitment
    commitment: Scalar = poseidon_hash(secret, amount, price, token, side);
    assert_equal(commitment, order_commitment);

    // Verify order exists in book
    verified: Bool = existence_proof.verify(orderbook_root, order_commitment);
    assert(verified);
}

// ============================================
// NOTES
// ============================================
//
// Cancelling reveals:
// - The nullifier (which order was cancelled)
// - The commitment (proves order existed)
//
// Does NOT reveal:
// - The amount
// - The price
// - The token
// - The side
//
// This is safe because by cancelling, the user
// is removing the order from the book anyway.
// ============================================