k = 11;
field = "pallas";

constant "ExecuteSwapV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExecuteSwapV1" {
    # Public inputs
    Base swap_id,
    Base alice_lock,
    Base bob_lock,
    Base alice_nullifier,
    Base bob_nullifier,
    Base swaps_root,

    # Private inputs
    Base alice_secret,
    Base bob_secret,
    Base alice_token,
    Base bob_token,
    Base alice_amount,
    Base bob_amount,
}

circuit "ExecuteSwapV1" {
    # Verify Alice's lock
    alice_lock_check = poseidon_hash(
        alice_secret,
        alice_token,
        alice_amount,
    );
    assert_equal(alice_lock_check, alice_lock);

    # Verify Bob's lock
    bob_lock_check = poseidon_hash(
        bob_secret,
        bob_token,
        bob_amount,
    );
    assert_equal(bob_lock_check, bob_lock);

    # Derive nullifiers
    alice_nullifier_check = poseidon_hash(alice_secret, alice_lock);
    bob_nullifier_check = poseidon_hash(bob_secret, bob_lock);

    # Verify nullifiers
    assert_equal(alice_nullifier_check, alice_nullifier);
    assert_equal(bob_nullifier_check, bob_nullifier);

    # Verify swap ID consistency
    computed_swap_id = poseidon_hash(alice_lock, bob_token, bob_amount);
    assert_equal(computed_swap_id, swap_id);

    # Both amounts must be valid
    assert(alice_amount > 0);
    assert(bob_amount > 0);
    assert(alice_amount < 2^64);
    assert(bob_amount < 2^64);
}