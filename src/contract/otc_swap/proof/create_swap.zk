# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# create_swap_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# OTC Swap Create Circuit (Version 1)
#
# This circuit proves:
# - Alice knows (alice_pubkey, alice_secret)
# - Bob's public key is correctly formed
# - Swap commitment is correctly computed from public parameters
#
# Privacy: Bob's pubkey is NOT exposed in the commitment.
# Instead, we store H(bob_pub) which allows private verification
# at execute time without revealing Bob's public key on-chain.
#
# Public Inputs (constrain_instance):
#   - C = H(alice_pub.x, alice_pub.y, H(bob_pub), send_value, send_token, recv_value, recv_token, timeout)
#   - bob_commitment = H(bob_pub.x, bob_pub.y)
#
# Witnesses:
#   - alice_pub_x, alice_pub_y: Alice's public key coordinates
#   - bob_pub_x, bob_pub_y: Bob's public key coordinates
#   - send_value: Value Alice sends (u64)
#   - send_asset_id: Token Alice sends
#   - recv_value: Value Alice wants to receive (u64)
#   - recv_asset_id: Token Alice wants to receive
#   - timeout: Block height for refund
#   - alice_secret: Alice's secret for deriving public key

constant "CreateSwapV2" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "CreateSwapV2" {
    # Alice's public key
    Base alice_pub_x,
    Base alice_pub_y,

    # Bob's public key
    Base bob_pub_x,
    Base bob_pub_y,

    # Swap parameters
    Base send_value,
    Base send_asset_id,
    Base recv_value,
    Base recv_asset_id,
    Base timeout,

    # Alice's secret (for key derivation, not revealed)
    Base alice_secret,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateSwapV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # Verify Alice public key is correctly derived from secret
    # alice_pub = alice_secret * G
    alice_pub_computed = ec_mul_base(alice_secret, NULLIFIER_K);
    alice_pub_computed_x = ec_get_x(alice_pub_computed);
    alice_pub_computed_y = ec_get_y(alice_pub_computed);
    # Constrain computed pubkey to match revealed pubkey
    constrain_equal_base(alice_pub_x, alice_pub_computed_x);
    constrain_equal_base(alice_pub_y, alice_pub_computed_y);

    # Privacy: Compute Bob commitment (hides bob_pub on-chain)
    bob_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, bob_pub_x, bob_pub_y);

    # Compute swap commitment
    # C = H(alice_pub.x, alice_pub.y, H(bob_pub), send_value, send_token, recv_value, recv_token, timeout)
    C = poseidon_hash(DOMAIN_COIN_COMMIT, 
        alice_pub_x,
        alice_pub_y,
        bob_commitment,
        send_value,
        send_asset_id,
        recv_value,
        recv_asset_id,
        timeout,
    );

    # Expose commitment and bob commitment as public inputs
    constrain_instance(C);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(bob_commitment);
}
