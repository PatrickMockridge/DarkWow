# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# OTC Swap Fund Circuit (Version 1)
#
# This circuit proves:
# - The swap exists and is in Created state
# - A Pedersen commitment to Alice's value is correctly formed
# - The value commitment matches what was declared at creation
#
# Public Inputs (constrain_instance):
#   - swap_id: The swap commitment from creation
#   - value_commit.x, value_commit.y: Pedersen commitment coordinates
#   - merkle_root: Root of the swaps Merkle tree
#
# Witnesses:
#   - value: The value Alice locks
#   - value_blind: Blinding factor for Pedersen commitment
#   - merkle_leaf_pos: Position in Merkle tree
#   - merkle_path: Merkle proof path

constant "FundSwap" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "FundSwap" {
    # Swap ID (commitment from CreateSwap)
    Base swap_id,

    # Value being locked
    Base value,
    Scalar value_blind,

    # Merkle proof witnesses
    Uint32 merkle_leaf_pos,
    MerklePath merkle_path,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "FundSwap" {
    # Verify value commitment is correctly formed
    # C = value * G + value_blind * H
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);

    # Expose commitment coordinates as public inputs
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Expose swap_id as public input
    constrain_instance(swap_id);

    # Merkle proof verification
    # Verify swap_id exists in the swaps Merkle tree
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(merkle_root(merkle_leaf_pos, merkle_path, swap_id));
}
