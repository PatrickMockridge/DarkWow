k = 11;
field = "pallas";

# verify_access_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "VerifyAccessV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "VerifyAccessV2" {
    Base expected_capability,
    Base subscription_id,
    Base subscriber_pub_x,
    Base subscriber_pub_y,
    Base plan_id,
    Base lock_until_block,
    Base subscriber_secret,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "VerifyAccessV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    derived_pub = ec_mul_base(subscriber_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);
    constrain_equal_base(derived_pub_x, subscriber_pub_x);
    constrain_equal_base(derived_pub_y, subscriber_pub_y);

    derived_capability = poseidon_hash(DOMAIN_COMMITMENT, 
        subscriber_pub_x,
        subscriber_pub_y,
        plan_id,
        subscription_id,
        lock_until_block,
        nonce
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_equal_base(derived_capability, expected_capability);

    # OBL-C84: the capability must be one the *verifier* receives.
    #
    # Every other value here is a witness the prover picks — the secret, the plan, the subscription
    # id, the expiry, the nonce — and the equalities above relate only witnesses to witnesses. So the
    # proof said "there exists some subscription this caller can open", which every caller can say
    # about every subscription, and the host had nothing to compare it against: it published the tx
    # pair and did nothing with the call in either phase.
    #
    # Instancing the capability is what makes those equalities do work. The host recomputes this hash
    # from the **stored record** (`Subscription::access_capability`) and the nonce the call carries,
    # and refuses unless it equals the published capability. Because the circuit's instance *is* the
    # hash of its witnesses, a match forces those witnesses to be the record's own subscriber key,
    # plan, id and expiry — so the caller must hold the secret behind the key the subscription was
    # opened with.
    constrain_instance(derived_capability);
}