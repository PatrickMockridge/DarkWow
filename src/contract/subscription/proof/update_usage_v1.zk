k = 11;
field = "pallas";

constant "UpdateUsage" {
}

witness "UpdateUsage" {
    Base subscription_id,
    Base subscriber_pub_x,
    Base subscriber_pub_y,
    Base usage_timestamp,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "UpdateUsage" {
    derived_id = poseidon_hash(
        subscription_id,
        subscriber_pub_x,
        subscriber_pub_y,
        usage_timestamp,
        nonce
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_id);
}