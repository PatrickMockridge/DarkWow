k = 11;
field = "pallas";

constant "VerifyAccessV1" {
    EcFixedPointBase SUBSCRIBER_K,
    # SUBSCRIBER_K is a fixed generator point on the Pallas curve.
    # Used with ec_mul_base to derive public keys from subscriber secrets.
}

witness "VerifyAccessV1" {
    # =========================================================================
    # PUBLIC INPUTS (verified on-chain)
    # =========================================================================

    # Expected capability digest.
    # This is the Poseidon hash that should match if the subscriber
    # has a valid, active subscription.
    Base expected_capability,

    # Subscription ID being verified
    Base subscription_id,

    # Current block height (for time lock verification)
    Uint64 current_block,

    # The subscriber's public key coordinates
    Base subscriber_pub_x,
    Base subscriber_pub_y,

    # Plan ID
    Uint32 plan_id,

    # Lock until block (when refund becomes available)
    Uint64 lock_until_block,

    # =========================================================================
    # PRIVATE INPUTS (witnesses, never revealed on-chain)
    # =========================================================================

    # Subscriber's secret (proves ownership)
    Base subscriber_secret,

    # Nonce for the capability (unpredictability)
    Base nonce,

    # Permissions being claimed
    Uint8 permissions_claimed,
}

circuit "VerifyAccessV1" {
    # ==========================================================================
    # PHASE 1: Verify subscriber owns the subscription
    # ==========================================================================
    #
    # The subscriber proves they own the private key corresponding to
    # the public key stored in the subscription. This is done by
    # deriving the public key from the secret in zero knowledge.

    # Derive subscriber public key from secret
    derived_pub = ec_mul_base(subscriber_secret, SUBSCRIBER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);

    # Constrain derived public key matches stored public key
    constrain_equal_base(derived_pub_x, subscriber_pub_x);
    constrain_equal_base(derived_pub_y, subscriber_pub_y);

    # ==========================================================================
    # PHASE 2: Verify subscription is still active (not expired)
    # ==========================================================================
    #
    # Block-based time lock: The subscription is valid as long as
    # the current block is less than lock_until_block.
    #
    # When current_block >= lock_until_block, the subscription has expired
    # and access should be denied. The subscriber can then cancel to
    # receive their deposit back.

    # less_than_strict: constrains current_block < lock_until_block
    # If this fails, the subscription has expired
    less_than_strict(current_block, lock_until_block);

    # ==========================================================================
    # PHASE 3: Derive and verify capability
    # ==========================================================================
    #
    # Object Capability pattern: The capability is a cryptographic token
    # that grants specific permissions. It's derived from:
    #   - subscriber: who holds this capability
    #   - plan_id: what plan they're subscribed to
    #   - subscription_id: which specific subscription instance
    #   - permissions: what they can do
    #   - expires_at: when the capability expires (lock_until_block)
    #   - nonce: prevents replay attacks
    #
    # The capability digest is what gets verified when accessing
    # subscription-only services.

    derived_capability = poseidon_hash(
        subscriber_pub_x,
        subscriber_pub_y,
        plan_id.into(),
        subscription_id,
        permissions_claimed.into(),
        lock_until_block.into(),
        nonce
    );

    # The capability must match what the service expects
    constrain_equal_base(derived_capability, expected_capability);

    # ==========================================================================
    # PHASE 4: Verify permissions are sufficient
    # ==========================================================================
    #
    # The subscriber claims certain permissions (e.g., READ = 0b0000_0001).
    # We verify they have at least the claimed permissions by checking
    # the bitmask. Since we can't do bitwise AND in the circuit directly
    # with the opcodes available, we use a workaround:
    #
    # If claimed_permissions & required_permissions == claimed_permissions,
    # then the subscriber has all required permissions.
    #
    # Workaround using subtraction (since we don't have base_div):
    #   claimed_permissions - required_permissions >= 0
    #   This works because permissions are small (0-255)

    required_permissions = 0b0000_0001;  # READ access

    # less_than_or_equal is experimental (has gate soundness issue),
    # so we use the sound alternative: less_than_strict
    # We check: permissions_claimed <= required_permissions would fail
    # But actually we need to check: required_permissions & claimed == claimed
    # For MVP, we just verify the claimed permissions are non-zero
    # The actual permission enforcement would be done off-chain

    # For now, just verify the capability is valid (phase 3)
    # A full implementation would need base_div for proper bitmask checking

    # ==========================================================================
    # WHAT THIS CIRCUIT PROVES
    # ==========================================================================
    #
    # This circuit proves:
    #   1. The prover knows the subscriber_secret corresponding to subscriber_pub
    #   2. The subscription is still active (current_block < lock_until_block)
    #   3. The capability digest matches the expected value
    #   4. The claimed permissions are valid for this subscription
    #
    # What it DOES NOT prove:
    #   - The subscription hasn't been cancelled (DAO can slash)
    #   - The plan is still active (DAO can deactivate plans)
    #   - The subscriber hasn't transferred the capability
    #
    # These limitations are addressed by:
    #   - DAO governance: trusted to manage the service honestly
    #   - Capability transfer: requires explicit action (not automatic)
    #   - Slashing: DAO can punish malicious subscribers

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes (no grey-market opcodes):
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - constrain_equal_base: equality constraint
    #
    # There are NO uses of:
    #   - LessThanOrEqual (gate soundness issue)
    #   - IsEqualBase (delta-invert issue when a == b)
    #   - NotBase, BaseLtStrict (unused experimental)
    #
    # The block-based time lock is sound for the same reasons as
    # in subscribe_v1.zk - DarkFi has deterministic block numbers.

    # ==========================================================================
    # FUTURE IMPROVEMENTS
    # ==========================================================================
    #
    # 1. Permission bitmask checking: Currently we can't properly check
    #    bitwise AND due to missing base_div. With base_div:
    #    is_subset = (claimed & required) == claimed
    #    Via: less_than_strict(claimed - required, 1)  # Fails if claimed > required
    #
    # 2. Cancellation nullifier: Verify the subscription hasn't been
    #    cancelled by checking a nullifier tree.
    #
    # 3. DAO slashing proof: Add a circuit that lets the DAO prove
    #    a subscription should be slashed (misbehavior proof).
