k = 11;
field = "pallas";

constant "VerifyAccessV1" {
    EcFixedPointBase SUBSCRIBER_K,
    # SUBSCRIBER_K is a fixed generator point on the Pallas curve.
    # Used with ec_mul_base to derive public keys from subscriber secrets.
}

witness "VerifyAccessV1" {
    # =========================================================================
    # PUBLIC INPUTS (verified on-chain)
    # =========================================================================

    # Expected capability digest.
    # This is the Poseidon hash that should match if the subscriber
    # has a valid, active subscription.
    Base expected_capability,

    # Subscription ID being verified
    Base subscription_id,

    # Current block height (for time lock verification)
    Uint64 current_block,

    # The subscriber's public key coordinates
    Base subscriber_pub_x,
    Base subscriber_pub_y,

    # Plan ID
    Uint32 plan_id,

    # Lock until block (when refund becomes available)
    Uint64 lock_until_block,

    # =========================================================================
    # PRIVATE INPUTS (witnesses, never revealed on-chain)
    # =========================================================================

    # Subscriber's secret (proves ownership)
    Base subscriber_secret,

    # Nonce for the capability (unpredictability)
    Base nonce,

    # Permissions being claimed
    Uint8 permissions_claimed,
}

circuit "VerifyAccessV1" {
    # ==========================================================================
    # PHASE 1: Verify subscriber owns the subscription
    # ==========================================================================
    #
    # The subscriber proves they own the private key corresponding to
    # the public key stored in the subscription. This is done by
    # deriving the public key from the secret in zero knowledge.

    # Derive subscriber public key from secret
    derived_pub = ec_mul_base(subscriber_secret, SUBSCRIBER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);

    # Constrain derived public key matches stored public key
    constrain_equal_base(derived_pub_x, subscriber_pub_x);
    constrain_equal_base(derived_pub_y, subscriber_pub_y);

    # ==========================================================================
    # PHASE 2: Verify subscription is still active (not expired)
    # ==========================================================================
    #
    # Block-based time lock: The subscription is valid as long as
    # the current block is less than lock_until_block.
    #
    # When current_block >= lock_until_block, the subscription has expired
    # and access should be denied. The subscriber can then cancel to
    # receive their deposit back.

    # less_than_strict: constrains current_block < lock_until_block
    # If this fails, the subscription has expired
    less_than_strict(current_block, lock_until_block);

    # ==========================================================================
    # PHASE 3: Derive and verify capability
    # ==========================================================================
    #
    # Object Capability pattern: The capability is a cryptographic token
    # that grants specific permissions. It's derived from:
    #   - subscriber: who holds this capability
    #   - plan_id: what plan they're subscribed to
    #   - subscription_id: which specific subscription instance
    #   - permissions: what they can do
    #   - expires_at: when the capability expires (lock_until_block)
    #   - nonce: prevents replay attacks
    #
    # The capability digest is what gets verified when accessing
    # subscription-only services.

    derived_capability = poseidon_hash(
        subscriber_pub_x,
        subscriber_pub_y,
        plan_id.into(),
        subscription_id,
        permissions_claimed.into(),
        lock_until_block.into(),
        nonce
    );

    # The capability must match what the service expects
    constrain_equal_base(derived_capability, expected_capability);

    # ==========================================================================
    # PHASE 4: Verify permissions are sufficient (TIERED APPROACH - SHIT VERSION)
    # ==========================================================================
    #
    # !!! THIS IS THE SHIT VERSION - SEE PHASE 4 PROPER FOR CORRECT IMPLEMENTATION !!!
    #
    # This tiered approach sacrifices fine-grained permission control for
    # a working implementation using only proven opcodes. It's a PRIVACY-LEAKING
    # simplification: you can only have tiered access, not arbitrary bitmasks.
    #
    # The proper implementation requires base_div for true bitmask checking.
    #
    # TIERED ACCESS (this implementation):
    # - Tier 1 = BASIC (READ only)
    # - Tier 2 = PREMIUM (READ + WRITE)
    # - Tier 3 = ADMIN (READ + WRITE + ADMIN)
    #
    # The permission_claimed value IS the tier level (1, 2, or 3).
    # We verify: claimed_tier >= required_tier
    #
    # PRIVACY LEAK: Anyone can see your TIER LEVEL, not just that you have access,
    # but roughly what level (basic/premium/admin). This is a significant privacy
    # regression from true zero-knowledge permission checking.

    # ==========================================================================
    # SHIT VERSION: Tier-based checking with less_than_strict (proven opcode)
    # ==========================================================================

    # Tier definitions (mapped from plan_id by the service):
    #   TIER_BASIC = 1    -> READ only
    #   TIER_PREMIUM = 2  -> READ + WRITE
    #   TIER_ADMIN = 3    -> READ + WRITE + ADMIN

    # Required tier for access (passed as constant in capability)
    # This is embedded in the expected_capability by the service
    required_tier = 1;  # Default to BASIC tier requirement

    # SHIT VERSION CHECK: less_than_strict(required_tier - 1, claimed_tier)
    # This constrains: (required_tier - 1) < claimed_tier
    # Which means: claimed_tier >= required_tier
    #
    # This works because:
    # - If required_tier = 1, we check: 0 < claimed_tier (any positive tier passes)
    # - If required_tier = 2, we check: 1 < claimed_tier (only tier 2 or 3 passes)
    # - If required_tier = 3, we check: 2 < claimed_tier (only tier 3 passes)
    #
    # LIMITATION: claimed_tier must be >= 1, and the subtraction (required_tier - 1)
    # could wrap if required_tier is 0 (but we never have tier 0).

    less_than_strict(required_tier - 1, permissions_claimed);

    # ==========================================================================
    # PHASE 4 PROPER: True Bitmask Checking (REQUIRES base_div - NOT IMPLEMENTED)
    # ==========================================================================
    #
    # !!! THE PROPER VERSION THAT ACTUALLY WORKS WITH base_div !!!
    #
    # Proper bitmask checking would allow arbitrary permission combinations:
    #   READ = 0b0001
    #   WRITE = 0b0010
    #   ADMIN = 0b0100
    #
    # The check: (claimed & required) == claimed
    # Means: all bits in 'required' are also set in 'claimed'
    #
    # With base_div, we can verify bitwise subset relationship:
    #
    #   is_subset = (claimed | required) / claimed  # should be 1 if claimed contains required
    #   Actually, proper implementation:
    #
    #   # Check that (claimed - required) has no bits outside of claimed
    #   # i.e., (claimed & ~required) == 0 means all required bits are in claimed
    #   #
    #   # base_div approach:
    #   # remainder = (claimed - required) % claimed
    #   # If remainder == 0, then required is a subset of claimed
    #   #
    #   # Actually that's still wrong. The real base_div approach:
    #   #
    #   # For bitwise: we need to check that (claimed | required) == claimed
    #   # This means claimed contains all bits of required
    #   #
    #   # The CORRECT base_div approach for bitwise subset:
    #   # Claimed contains Required if and only if:
    #   #   (claimed & ~required) == 0
    #   #   (where ~required is bitwise NOT)
    #   #
    #   # In field arithmetic, this is tricky. The base_div approach uses:
    #   #   (claimed - required) & claimed == 0  (if claimed > required)
    #   #
    #   # PROPER IMPLEMENTATION (when base_div is available):
    #   #
    #   # 1. Compute difference: diff = claimed - required (field subtraction)
    #   # 2. Compute bitwise AND: bits = diff & claimed
    #   # 3. Verify: bits == 0 (no unauthorized bits in claimed)
    #   #
    #   # But we need base_div for step 2 (bitwise AND on field elements).
    #   # The circuit would look like:
    #   #
    #   #   required_tier = 0b0001;  # READ
    #   #   claimed_tier = permissions_claimed;
    #   #
    #   #   # PROPER: Check (claimed & ~required) == 0 using base_div
    #   #   # This verifies claimed contains all bits of required
    #   #   excess_bits = base_div(claimed, required);  # claimed / required
    #   #   # If claimed >= required and (claimed & ~required) == 0, this passes
    #   #
    #   # For now, the tiered approach is the ONLY working option.

    # ==========================================================================
    # WHAT THIS CIRCUIT PROVES
    # ==========================================================================
    #
    # This circuit proves:
    #   1. The prover knows the subscriber_secret corresponding to subscriber_pub
    #   2. The subscription is still active (current_block < lock_until_block)
    #   3. The capability digest matches the expected value
    #   4. [SHIT VERSION] The claimed tier is >= required tier
    #
    # What it DOES NOT prove:
    #   - The subscription hasn't been cancelled (DAO can slash)
    #   - The plan is still active (DAO can deactivate plans)
    #   - The subscriber hasn't transferred the capability
    #   - [SHIT VERSION] The exact permission level (only tier, not granular)
    #
    # These limitations are addressed by:
    #   - DAO governance: trusted to manage the service honestly
    #   - Capability transfer: requires explicit action (not automatic)
    #   - Slashing: DAO can punish malicious subscribers

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes (no grey-market opcodes):
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - constrain_equal_base: equality constraint
    #
    # There are NO uses of:
    #   - LessThanOrEqual (gate soundness issue)
    #   - IsEqualBase (delta-invert issue when a == b)
    #   - base_div (NOT YET AVAILABLE - when it is, use proper bitmask check)
    #
    # The block-based time lock is sound for the same reasons as
    # in subscribe_v1.zk - DarkFi has deterministic block numbers.

    # ==========================================================================
    # PRIVACY LEAK DOCUMENTATION (SHIT VERSION)
    # ==========================================================================
    #
    # The tiered approach reveals the subscriber's TIER LEVEL on-chain.
    # This is a privacy regression compared to proper bitmask checking.
    #
    # Attack vector:
    # - Observer sees tier 3 (ADMIN) subscriber accessing service
    # - Observer learns subscriber has elevated privileges
    # - Cannot determine exact permissions, but knows high-tier status
    #
    # Comparison:
    # - TRUE zero-knowledge: Only proves "has access" (binary)
    # - Tiered (SHIT): Proves "has tier N access" (leaks tier level)
    # - Bitmask (PROPER with base_div): Only proves "has required permissions" (binary)
    #
    # The tiered approach is a privacy-for-simplicity tradeoff:
    # - LESS private than proper bitmask
    # - MORE private than revealing exact bitmask (0b0101 reveals READ+ADMIN)
    # - MUCH better than no permission checking at all
    #
    # See: doc/src/arch/security-analysis.md Issue #2 for full analysis.
