k = 11;
field = "pallas";

constant "CreateSwap" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateSwap" {
    Base swap_id,
    Base secret,
    Base hash,
    Base timelock,
    Base amount,
    Base token_id,
    Base side,
    Base blind,
    Base receiver_pub_x,
    Base receiver_pub_y,
}

circuit "CreateSwap" {
    computed_hash = poseidon_hash(secret);
    constrain_equal_base(computed_hash, hash);

    derived_swap_id = poseidon_hash(
        hash,
        timelock,
        receiver_pub_x,
        receiver_pub_y,
        amount,
        token_id,
        side,
        blind
    );
    constrain_instance(derived_swap_id);
}