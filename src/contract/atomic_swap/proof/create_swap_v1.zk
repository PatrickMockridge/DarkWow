k = 11;
field = "pallas";

# Atomic Swap: Create Swap Circuit (Version 1)
#
# Creates a hashed timelock contract (HTLC) on DarkFi.
#
# This circuit proves:
# - Creator knows the secret (but doesn't reveal it yet)
# - The hash of the secret is computed correctly
# - The timelock is set correctly
#
# Public Inputs (constrain_instance):
#   - swap_id: H(hash, timelock, receiver_pub, amount, token_id, side, blind)
#   - hash: SHA256(secret) - same hash used on external chain
#   - timelock: block height before which refund is not allowed
#   - receiver_pub_x, receiver_pub_y: DarkFi public key of recipient
#
# Witnesses:
#   - secret: The secret (never revealed on-chain in this step)
#   - amount: Swap amount
#   - token_id: Token being swapped
#   - side: 0 = Alice (initiator), 1 = Bob (responder)
#   - blind: Blinding factor for commitment

constant "CreateSwap" {
    EcFixedPointBase NULLIFIER_K,
    # NULLIFIER_K is used to derive public keys from secrets.
}

witness "CreateSwap" {
    # Hash of the secret (same on both chains)
    # This is the external chain's hash function output
    # For Ethereum: SHA256(secret)
    # For Bitcoin: SHA256(secret) or RIPEMD160(SHA256(secret))
    Base hash,

    # Timelock block height
    # Refund not allowed before this block
    Uint64 timelock,

    # The secret (known only to the initiator)
    # NOT revealed on-chain during CreateSwap
    Base secret,

    # Swap details
    Base amount,
    Base token_id,

    # Which side: 0 = Alice (initiator), 1 = Bob (responder)
    Uint8 side,

    # Blinding factor
    Base blind,

    # Receiver public key
    Base receiver_pub_x,
    Base receiver_pub_y,
}

circuit "CreateSwap" {
    # ==========================================================================
    # PHASE 1: Verify the hash is correctly computed
    # ==========================================================================
    #
    # The hash is computed externally (on the other chain).
    # We accept it as a public input.
    #
    # In a full implementation, we would verify the hash function itself,
    # but that would require implementing SHA256 or similar in-circuit.
    # For the MVP, we trust the hash from the external chain.

    # Hash is passed as public input - it's computed on the external chain
    # The external chain's HTLC verifies the hash matches the secret

    # ==========================================================================
    # PHASE 2: Verify timelock is in the future
    # ==========================================================================
    #
    # Block-based timelock: The refund is not allowed until timelock block.
    # This uses DarkFi's deterministic block heights.

    # Note: We don't constrain timelock here since it's a public input
    # The refund circuit will verify current_block >= timelock

    # ==========================================================================
    # PHASE 3: Derive swap ID (commitment)
    # ==========================================================================
    #
    # The swap ID commits to all swap parameters.
    # This is what gets stored on-chain.

    derived_swap_id = poseidon_hash(
        hash,
        timelock.into(),
        receiver_pub_x,
        receiver_pub_y,
        amount,
        token_id,
        side.into(),
        blind
    );

    # Verify the derived swap ID matches the public input
    constrain_equal_base(derived_swap_id, swap_id);

    # ==========================================================================
    # PHASE 4: Verify receiver public key
    # ==========================================================================
    #
    # The receiver must have the corresponding private key.
    # We derive the public key from a derived secret (not the HTLC secret).

    # For the MVP, we just store the receiver pubkey directly
    # A full implementation might derive it from a different secret

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - constrain_equal_base: equality constraint
    #
    # There are NO uses of experimental opcodes.
    #
    # The hash is trusted from the external chain - we don't verify
    # SHA256 in-circuit. This is a limitation of the MVP.
    #
    # FUTURE: Implement Poseidon-based hash verification in-circuit
    # to avoid trusting external chain hash functions.

    # ==========================================================================
    # WHAT THIS CIRCUIT DOES NOT VERIFY
    # ==========================================================================
    #
    # 1. Hash function correctness: We trust the external chain's hash
    #    To fix this, we'd need SHA256 or similar in-circuit
    #
    # 2. Fund deposit: We don't verify the funds are actually locked
    #    This requires Money contract integration
    #
    # These are covered by the contract logic outside the circuit.
}