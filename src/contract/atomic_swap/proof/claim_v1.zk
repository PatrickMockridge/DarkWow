k = 11;
field = "pallas";

constant "ClaimSwap" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ClaimSwap" {
    Base swap_id,
    Base secret,
    Base hash,
    Base timelock,
    Base side,
}

circuit "ClaimSwap" {
    computed_hash = poseidon_hash(secret);
    constrain_equal_base(computed_hash, hash);

    nullifier_check = poseidon_hash(swap_id, secret);
    constrain_instance(nullifier_check);
}