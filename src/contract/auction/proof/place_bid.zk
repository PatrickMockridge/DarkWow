# PlaceBid_V2 — domain-separated auction bid placement.
k = 11; field = "pallas";
constant "PlaceBidV2" { EcFixedPointBase NULLIFIER_K, }
witness "PlaceBidV2" { Base auction_id, Base bidder_pub_x, Base bidder_pub_y, Base bidder_secret, Base amount, Base nonce, Base block_height, Base tx_commitment, Base tx_nonce, Base tx_binding, }
circuit "PlaceBidV2" {
    DOMAIN_COIN_COMMIT = witness_base(4); DOMAIN_TX_BINDING = witness_base(3);
    bidder_pub = ec_mul_base(bidder_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(bidder_pub), bidder_pub_x);
    constrain_equal_base(ec_get_y(bidder_pub), bidder_pub_y);
    bid_id = poseidon_hash(DOMAIN_COIN_COMMIT, auction_id, bidder_pub_x, bidder_pub_y, amount, nonce);
    constrain_instance(bid_id);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
