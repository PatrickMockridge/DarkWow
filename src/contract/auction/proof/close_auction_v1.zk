# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Auction Close Circuit (Version 1)
#
# This circuit proves:
# - Seller knows their secret key
# - Seller public key is correctly derived
# - Auction deadline has passed
# - Winner bid ID is correctly associated with this auction
#
# Public Inputs (constrain_instance):
#   - auction_id: The auction being closed
#   - winner_bid_id: The winning bid ID
#
# Witnesses:
#   - seller_secret: Seller's secret key
#   - auction_deadline: When auction ends
#   - current_block: Current block height

constant "CloseAuction" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CloseAuction" {
    # Auction being closed
    Base auction_id,

    # Seller's secret (for key derivation)
    Base seller_secret,

    # Winner bid ID (the winning bid)
    Base winner_bid_id,

    # Time verification
    Base auction_deadline,
    Base current_block,

    # Seller's public key coordinates (public input - must match derived)
    Base seller_pub_x,
    Base seller_pub_y,
    Base tx_commitment,
}

circuit "CloseAuction" {
    # ==========================================================================
    # PHASE 1: Derive seller public key from secret
    # ==========================================================================

    seller_pub = ec_mul_base(seller_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(seller_pub);
    derived_pub_y = ec_get_y(seller_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the seller_secret to the seller_pubkey
    constrain_equal_base(derived_pub_x, seller_pub_x);
    constrain_equal_base(derived_pub_y, seller_pub_y);

    # ==========================================================================
    # PHASE 2: Verify auction deadline has passed
    # ==========================================================================
    #
    # less_than_strict(auction_deadline, current_block)
    # constrains: auction_deadline < current_block
    # This means the auction has ended

    less_than_strict(auction_deadline, current_block);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(auction_id);
    constrain_instance(winner_bid_id);
    constrain_instance(seller_pub_x);
    constrain_instance(seller_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - constrain_instance: public input exposure
    #
    # The contract layer verifies:
    # 1. Auction is in Active state
    # 2. Winner bid ID corresponds to the highest bid
    constrain_instance(tx_commitment);
    # 3. Seller is authorized to close this auction
}