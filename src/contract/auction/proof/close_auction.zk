# CloseAuction_V2 — domain-separated auction closure.
k = 11; field = "pallas";
constant "CloseAuctionV2" { EcFixedPointBase NULLIFIER_K, }
witness "CloseAuctionV2" { Base auction_id, Base seller_pub_x, Base seller_pub_y, Base seller_secret, Base tx_commitment, Base tx_nonce, Base tx_binding, }
circuit "CloseAuctionV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    seller_pub = ec_mul_base(seller_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(seller_pub), seller_pub_x);
    constrain_equal_base(ec_get_y(seller_pub), seller_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
