# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Auction Claim Winnings Circuit (Version 1)
#
# This circuit proves:
# - Winner knows their secret key
# - Winner public key is correctly derived
# - Winner is the actual winner of the auction
#
# Public Inputs (constrain_instance):
#   - auction_id: The auction
#   - winner_bid_id: The winning bid ID
#   - winner_pub_x, winner_pub_y: Winner's public key coordinates
#
# Witnesses:
#   - winner_secret: Winner's secret key

constant "ClaimWinnings" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ClaimWinnings" {
    # Auction
    Base auction_id,

    # Winner's secret (for key derivation)
    Base winner_secret,

    # Winning bid ID
    Base winner_bid_id,

    # Winner's public key coordinates (public input - must match derived)
    Base winner_pub_x,
    Base winner_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ClaimWinnings" {
    # ==========================================================================
    # PHASE 1: Derive winner public key from secret
    # ==========================================================================

    winner_pub = ec_mul_base(winner_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(winner_pub);
    derived_pub_y = ec_get_y(winner_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the winner_secret to the winner_pubkey
    constrain_equal_base(derived_pub_x, winner_pub_x);
    constrain_equal_base(derived_pub_y, winner_pub_y);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================
    #
    # The winner's public key being valid proves they are the winner.
    # The contract layer verifies the winner_bid_id is the highest bid
    # for this auction and that winner_pub matches the bidder.

    constrain_instance(auction_id);
    constrain_instance(winner_bid_id);
    constrain_instance(winner_pub_x);
    constrain_instance(winner_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - constrain_instance: public input exposure
    #
    # The contract layer verifies:
    # 1. Auction is in Closed state
    # 2. winner_bid_id corresponds to the highest bid
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # 3. winner_pub matches the bidder who placed that bid
}