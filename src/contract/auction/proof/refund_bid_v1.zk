# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Auction Refund Bid Circuit (Version 1)
#
# This circuit proves:
# - Bidder knows their secret key
# - Bidder public key is correctly derived
# - Bidder is reclaiming their bid amount
# - Refund nullifier is correctly computed
#
# Public Inputs (constrain_instance):
#   - bid_id: The bid being refunded
#   - bidder_pub_x, bidder_pub_y: Bidder's public key coordinates
#   - refund_nullifier: Nullifier for this refund
#
# Witnesses:
#   - bidder_secret: Bidder's secret key

constant "RefundBid" {
    EcFixedPointBase NULLIFIER_K,
}

witness "RefundBid" {
    # Bid being refunded
    Base bid_id,

    # Bidder's secret (for key derivation and nullifier)
    Base bidder_secret,

    # Bidder's public key coordinates (public input - must match derived)
    Base bidder_pub_x,
    Base bidder_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "RefundBid" {
    # ==========================================================================
    # PHASE 1: Derive bidder public key from secret
    # ==========================================================================

    bidder_pub = ec_mul_base(bidder_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(bidder_pub);
    derived_pub_y = ec_get_y(bidder_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the bidder_secret to the bidder_pubkey
    constrain_equal_base(derived_pub_x, bidder_pub_x);
    constrain_equal_base(derived_pub_y, bidder_pub_y);

    # ==========================================================================
    # PHASE 2: Compute refund nullifier
    # ==========================================================================
    #
    # refund_nullifier = H(bid_id, bidder_secret)
    # This uniquely identifies this refund and prevents double-refund

    refund_nullifier = poseidon_hash(bid_id, bidder_secret);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(bid_id);
    constrain_instance(bidder_pub_x);
    constrain_instance(bidder_pub_y);
    constrain_instance(refund_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The contract layer verifies:
    # 1. Bid is in Outbid state (not active or won)
    # 2. Bidder pubkey matches the original bidder
    # 3. Refund hasn't been claimed yet
    #
    # Note: The actual refund of funds happens via the escrow contract's
    # refund function. This circuit just proves the bidder is authorized
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # to receive the refund for this specific bid.
}