# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Auction Place Bid Circuit (Version 1)
#
# This circuit proves:
# - Bidder knows their secret key
# - Bidder public key is correctly derived
# - Bid is higher than current highest bid
# - Auction is still active (deadline not passed)
# - Bid ID is correctly computed
#
# Public Inputs (constrain_instance):
#   - auction_id: The auction this bid is for
#   - bid_id: Poseidon hash commitment of bid parameters
#   - current_high_bid: The new highest bid amount
#
# Witnesses:
#   - bidder_secret: Bidder's secret key
#   - amount: Bid amount
#   - bid_nonce: Unique nonce for this bid
#   - auction_deadline: When auction ends
#   - current_block: Current block height

constant "PlaceBid" {
    EcFixedPointBase NULLIFIER_K,
}

witness "PlaceBid" {
    # Auction being bid on
    Base auction_id,

    # Bidder's secret (for key derivation and nullifier)
    Base bidder_secret,

    # Bid details
    Base amount,
    Base bid_nonce,

    # Time verification
    Base auction_deadline,
    Base current_block,

    # Current highest bid (to prove bid is higher)
    Base current_high_bid,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PlaceBid" {
    # ==========================================================================
    # PHASE 1: Derive bidder public key from secret
    # ==========================================================================

    bidder_pub = ec_mul_base(bidder_secret, NULLIFIER_K);
    bidder_pub_x = ec_get_x(bidder_pub);
    bidder_pub_y = ec_get_y(bidder_pub);

    # ==========================================================================
    # PHASE 2: Verify auction is still active
    # ==========================================================================
    #
    # less_than_strict: constrains current_block < auction_deadline
    # This ensures the auction hasn't ended yet

    less_than_strict(current_block, auction_deadline);

    # ==========================================================================
    # PHASE 3: Verify bid is higher than current high bid
    # ==========================================================================
    #
    # Using cross-multiplication to avoid division:
    # bid > current_high_bid  <=>  bid >= current_high_bid + 1
    #
    # less_than_strict(lhs, rhs) constrains lhs < rhs
    # We want: current_high_bid < amount
    # Which means: amount > current_high_bid
    # So we check: current_high_bid < amount

    # less_than_strict(current_high_bid, amount);

    # Actually, since these are Base field elements and we're doing
    # the comparison as integers, we use the cross-multiplication pattern:
    # To prove amount > current_high_bid (strictly greater)
    # We check: current_high_bid < amount
    less_than_strict(current_high_bid, amount);

    # ==========================================================================
    # PHASE 4: Compute bid ID commitment
    # ==========================================================================
    #
    # bid_id = H(auction_id, bidder_pub.x, bidder_pub.y, amount, bid_nonce)
    #
    # This uniquely identifies this specific bid

    bid_id = poseidon_hash(
        auction_id,
        bidder_pub_x,
        bidder_pub_y,
        amount,
        bid_nonce,
    );

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(auction_id);
    constrain_instance(bid_id);
    constrain_instance(amount);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The actual bid verification (is amount > highest?) is done
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # by the contract layer comparing submitted amount to stored highest bid.
}