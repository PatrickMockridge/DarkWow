k = 11;
field = "pallas";

# allocate_coverage_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "AllocateCoverageV2" {
}

witness "AllocateCoverageV2" {
    Base pool_id,
    Base member_pub_x,
    Base member_pub_y,
    Base coverage_amount,
    Base withdrawal_id,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AllocateCoverageV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    derived_allocation_id = poseidon_hash(DOMAIN_COMMITMENT, 
        pool_id,
        member_pub_x,
        member_pub_y,
        coverage_amount,
        withdrawal_id,
        nonce
    );
    constrain_instance(derived_allocation_id);

    # The pair is the LAST two instances (`OBL-C198`): the node reads `pubvals[len-2]`/
    # `pubvals[len-1]` and recomputes `tx_binding` there, because nothing in `src/linear/` indexes
    # this vector — the position IS the interface. It sat at 0,1 of 3 with
    # `derived_allocation_id` after it. The metadata arm's push order and the client's `to_vec`
    # move with it.
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}