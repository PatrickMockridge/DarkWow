k = 11;
field = "pallas";

constant "CreatePool" {
}

witness "CreatePool" {
    Base creator_pub_x,
    Base creator_pub_y,
    Base pool_config_hash,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreatePool" {
    derived_pool_id = poseidon_hash(
        creator_pub_x,
        creator_pub_y,
        pool_config_hash,
        nonce
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_pool_id);
}