k = 11;
field = "pallas";

# slash_coverage_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SlashCoverageV2" {
}

witness "SlashCoverageV2" {
    Base allocation_id,
    Base slashed_amount,
    Base slashed_to_pub_x,
    Base slashed_to_pub_y,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SlashCoverageV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    derived_slash_id = poseidon_hash(DOMAIN_COMMITMENT, 
        allocation_id,
        slashed_amount,
        slashed_to_pub_x,
        slashed_to_pub_y,
        nonce
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_slash_id);
}