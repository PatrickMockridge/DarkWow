k = 11;
field = "pallas";

# create_pool_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "CreatePoolV2" {
}

witness "CreatePoolV2" {
    Base creator_pub_x,
    Base creator_pub_y,
    Base pool_config_hash,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreatePoolV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    derived_pool_id = poseidon_hash(DOMAIN_COMMITMENT, 
        creator_pub_x,
        creator_pub_y,
        pool_config_hash,
        nonce
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_pool_id);
}