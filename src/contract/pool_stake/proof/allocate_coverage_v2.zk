k = 11;
field = "pallas";

# allocate_coverage_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "AllocateCoverageV2" {
}

witness "AllocateCoverageV2" {
    Base pool_id,
    Base member_pub_x,
    Base member_pub_y,
    Base coverage_amount,
    Base withdrawal_id,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AllocateCoverageV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    derived_allocation_id = poseidon_hash(DOMAIN_COIN_COMMIT, 
        pool_id,
        member_pub_x,
        member_pub_y,
        coverage_amount,
        withdrawal_id,
        nonce
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_allocation_id);
}