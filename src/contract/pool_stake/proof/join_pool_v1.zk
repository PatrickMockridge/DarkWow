k = 11;
field = "pallas";

constant "JoinPool" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "JoinPool" {
    Base pool_id,
    Base member_pub_x,
    Base member_pub_y,
    Base stake_amount,
    Base token_id,
    Base nonce,
    Scalar value_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "JoinPool" {
    derived_member_id = poseidon_hash(
        pool_id,
        member_pub_x,
        member_pub_y,
        stake_amount,
        nonce
    );
    constrain_instance(derived_member_id);

    vcv = ec_mul_short(stake_amount, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(ec_get_y(value_commit));
}