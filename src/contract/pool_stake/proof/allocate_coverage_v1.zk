k = 11;
field = "pallas";

constant "AllocateCoverage" {
}

witness "AllocateCoverage" {
    Base pool_id,
    Base member_pub_x,
    Base member_pub_y,
    Base coverage_amount,
    Base withdrawal_id,
    Base nonce,
    Base tx_commitment,
}

circuit "AllocateCoverage" {
    derived_allocation_id = poseidon_hash(
        pool_id,
        member_pub_x,
        member_pub_y,
        coverage_amount,
        withdrawal_id,
        nonce
    );
    constrain_instance(tx_commitment);
    constrain_instance(derived_allocation_id);
}