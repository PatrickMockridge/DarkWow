# Betting Stake Initialize Circuit
#
# This circuit proves that:
# 1. The staking table ID is correctly derived from the betting contract
#
# Public inputs:
# - table_id: The derived table ID for this staking instance

k = 11;
field = "pallas";

# init_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "InitV2" {
}

witness "InitV2" {
    Base betting_contract_id,
    Base house_edge_bp,
    Base risk_profile,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "InitV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Derive table_id from betting_contract_id and nonce (must match contract logic)
    derived_table_id = poseidon_hash(DOMAIN_COMMITMENT, 
        betting_contract_id,
        nonce,
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);

    # `OBL-C198`: the tx pair is the **last two** instances of every circuit — the node reads that
    # position to recompute the binding from the enclosing transaction and refuse a proof whose
    # published value differs, and there is no per-circuit index map, so the position IS the
    # convention. This circuit placed the pair first.
    constrain_instance(derived_table_id);

    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}