# Betting Stake Unstake Circuit
#
# Proves staker knows secret key matching staker_pubkey,
# and that the stake ID and value commitment are valid.
#
# Public inputs:
# - stake_id: The stake ID being unstaked
# - value_commit_x/y: Pedersen commitment coordinates
# - staker_nullifier: H(stake_id, staker_secret) for replay protection
# - tx_commitment: C-4 cross-circuit binding

k = 11;
field = "pallas";

# unstake_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "UnstakeV2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
    EcFixedPointBase NULLIFIER_K,
}

witness "UnstakeV2" {
    Base table_id,
    Base staker_secret,
    Base staker_pub_x,
    Base staker_pub_y,
    Base original_amount,
    Base current_amount,
    Base accumulated_earnings,
    Base asset_id,
    Base nonce,
    Base staker_nullifier,
    Scalar value_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "UnstakeV2" {
    DOMAIN_NULLIFIER = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Verify staker knows secret matching pubkey
    staker_pub = ec_mul_base(staker_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(staker_pub), staker_pub_x);
    constrain_equal_base(ec_get_y(staker_pub), staker_pub_y);

    # RC1-E: Range proofs for u64 stake amounts
    range_check(64, original_amount);
    range_check(64, current_amount);

    # Derive stake_id from parameters
    derived_stake_id = poseidon_hash(DOMAIN_COMMITMENT, table_id, staker_pub_x, staker_pub_y, original_amount, nonce);
    constrain_instance(derived_stake_id);

    # Verify the original value commitment
    vcv = ec_mul_short(original_amount, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Compute and verify staker nullifier
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, derived_stake_id, staker_secret);
    constrain_equal_base(computed_nullifier, staker_nullifier);
    constrain_instance(staker_nullifier);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
