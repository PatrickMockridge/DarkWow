# Betting Stake Update Risk Circuit
#
# This circuit proves that:
# 1. The caller is authorized (is the betting contract)
# 2. The payout amounts are valid
#
# Public inputs:
# - table_id: The table being updated

k = 11;
field = "pallas";

# update_risk_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "UpdateRiskV2" {
}

witness "UpdateRiskV2" {
    Base betting_contract_id,
    Base total_stake,
    Base accumulated_losses,
    Base house_edge_bp,
    Base risk_profile,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "UpdateRiskV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # RC1-E: Range proofs for u64 risk parameters
    range_check(64, total_stake);
    range_check(64, accumulated_losses);
    range_check(64, house_edge_bp);

    # Derive table_id from betting_contract_id and nonce (must match contract logic)
    derived_table_id = poseidon_hash(DOMAIN_COMMITMENT, 
        betting_contract_id,
        nonce,
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_table_id);
}