# Betting Stake Update Risk Circuit
#
# This circuit proves that:
# 1. The caller is authorized (is the betting contract)
# 2. The payout amounts are valid
#
# Public inputs:
# - table_id: The table being updated

k = 11;
field = "pallas";

constant "UpdateRisk" {
}

witness "UpdateRisk" {
    Base betting_contract_id,
    Base total_stake,
    Base accumulated_losses,
    Base house_edge_bp,
    Base risk_profile,
    Base nonce,
    Base tx_commitment,
}

circuit "UpdateRisk" {
    # Derive table_id from betting_contract_id and nonce (must match contract logic)
    derived_table_id = poseidon_hash(
        betting_contract_id,
        nonce,
    );
    constrain_instance(tx_commitment);
    constrain_instance(derived_table_id);
}