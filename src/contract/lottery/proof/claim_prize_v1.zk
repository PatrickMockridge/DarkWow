# Lottery ClaimPrize Circuit — proves ticket ownership via ZK.
k = 11; field = "pallas";
constant "ClaimPrizeV1" { }
witness "ClaimPrizeV1" {
    Base ticket_id, Base ticket_secret, Base ticket_commitment, Base tx_commitment,
}
circuit "ClaimPrizeV1" {
    computed_commit = poseidon_hash(ticket_id, ticket_secret);
    constrain_equal_base(computed_commit, ticket_commitment);
    constrain_instance(ticket_id); constrain_instance(ticket_commitment);
    constrain_instance(tx_commitment);
}
