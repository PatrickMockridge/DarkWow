# CommitTicket_V2 — domain-separated lottery ticket commitment.
k = 11; field = "pallas";
constant "CommitTicketV2" { EcFixedPointBase NULLIFIER_K, }
witness "CommitTicketV2" {
    Base lottery_id, Base ticket_secret, Base ticket_pub_x, Base ticket_pub_y,
    Base amount, Base nonce, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "CommitTicketV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    computed_ticket_id = poseidon_hash(DOMAIN_COIN_COMMIT, lottery_id, ticket_pub_x, ticket_pub_y, amount, nonce);
    constrain_instance(computed_ticket_id);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
