# Lottery Commit Ticket Circuit
#
# This circuit proves that a player has committed to a valid ticket
# without revealing the numbers.

k = 11;
field = "pallas";

constant "CommitTicket_V1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "CommitTicket_V1" {
    Base player_pub_x,
    Base player_pub_y,
    Base ticket_id,
    Base commitment,
    Base token_id,
    Base value,
    Scalar value_blind,
}

circuit "CommitTicket_V1" {
    # Derive ticket ID from parameters (same as contract)
    computed_ticket_id = poseidon_hash(
        player_pub_x,
        player_pub_y,
        commitment,
        token_id,
        value,
    );
    constrain_instance(computed_ticket_id);

    # Verify value commitment matches value + blind
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));
}