# Lottery Circuit — proves house identity via ZK.
k = 11; field = "pallas";
constant "InitializeV1" { EcFixedPointBase NULLIFIER_K, }
witness "InitializeV1" {
    Base lottery_id, Base house_secret, Base house_pub_x, Base house_pub_y,
    Base house_nullifier, Base tx_commitment,
}
circuit "InitializeV1" {
    house_pub = ec_mul_base(house_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(house_pub), house_pub_x);
    constrain_equal_base(ec_get_y(house_pub), house_pub_y);
    computed = poseidon_hash(lottery_id, house_secret);
    constrain_equal_base(computed, house_nullifier);
    constrain_instance(house_pub_x); constrain_instance(house_pub_y);
    constrain_instance(house_nullifier); constrain_instance(tx_commitment);
}
