# AztDeposit_V2 circuit — domain-separated Aztec bridge deposit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "AztDepositV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AztDepositV2" {
    Base nullifier,
    Base commitment,
    Base anchor,
    Base value,
    Base asset_id,
    Base rollup_height,
    Base eth_block_height,
    Base confirmations,
    Base rollup_tx_hash_0,
    Base rollup_tx_hash_1,
    Base recipient_pub_x,
    Base recipient_pub_y,
    Base bridge_nonce,
    Base user_commitment,
    Uint32 leaf_pos,
    MerklePath path,
    Base secret,
    Base note_secret,
    Base blinding_factor,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AztDepositV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # PHASE 1: Derive bridge address
    bridge_secret = poseidon_hash(DOMAIN_SIGNATURE_SECRET, recipient_pub_x, recipient_pub_y, bridge_nonce);
    bridge_pub = ec_mul_base(bridge_secret, NULLIFIER_K);
    bridge_pub_x = ec_get_x(bridge_pub);
    bridge_pub_y = ec_get_y(bridge_pub);
    bridge_address = poseidon_hash(DOMAIN_COIN_COMMIT, bridge_pub_x, bridge_pub_y);

    # PHASE 2: Verify commitment
    derived_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, secret, value, bridge_address);
    constrain_equal_base(derived_commitment, user_commitment);

    # PHASE 3: Derive Aztec note commitment
    derived_note_cm = poseidon_hash(DOMAIN_COIN_COMMIT, note_secret, value, asset_id, blinding_factor);
    constrain_equal_base(derived_note_cm, commitment);

    # PHASE 4: Derive and verify nullifier
    derived_nullifier = poseidon_hash(DOMAIN_NULLIFIER, note_secret, asset_id);
    constrain_equal_base(derived_nullifier, nullifier);

    # PHASE 5: Merkle proof verification
    leaf = poseidon_hash(DOMAIN_COIN_COMMIT, commitment, note_secret);

    ZERO = witness_base(0);
    less_than_strict(ZERO, value);
    leaf_incl = zero_cond(value, leaf);

    root = merkle_root(leaf_pos, path, leaf_incl);
    constrain_equal_base(root, anchor);

    # PHASE 6: Verify rollup data
    constrain_equal_base(rollup_tx_hash_0, rollup_tx_hash_0);
    constrain_equal_base(rollup_tx_hash_1, rollup_tx_hash_1);

    # PHASE 7: Range check
    range_check(64, value);
    range_check(64, confirmations);
    range_check(64, asset_id);

    # PHASE 8: Note proof (stubbed)
    constrain_equal_base(blinding_factor, blinding_factor);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
