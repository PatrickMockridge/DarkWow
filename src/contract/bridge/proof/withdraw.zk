# Withdraw_V2 circuit — domain-separated bridge withdrawal.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
#
# Bridge-core: the wrapped promissory note is burned by the child
# promissory_note::redeem_v1 call (spend_hook = bridge). This proof binds the
# withdrawal nullifier to the external recipient (CRIT-3 front-running fix).
# There is no bridge-side Sinsemilla merkle membership check.
k = 14;
field = "pallas";

constant "WithdrawV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "WithdrawV2" {
    Base nullifier,
    Base recipient_hash,
    Base amount,
    Base token_minimum,
    Base secret,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "WithdrawV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Derive nullifier from secret AND recipient_hash (CRIT-3 fix)
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, secret, recipient_hash);
    constrain_instance(computed_nullifier);
    constrain_equal_base(computed_nullifier, nullifier);

    # Verify recipient hash
    derived_recipient = poseidon_hash(DOMAIN_SIGNATURE_SECRET, recipient_hash);
    constrain_instance(derived_recipient);

    # Range proof for amount + token minimum (anti-dust)
    #
    # `amount` was bounded here and `token_minimum` was not, which made the comparison one of field
    # residues: the chip range-checks the *difference* of its operands, never the operands, so a
    # `token_minimum` chosen near p satisfies `token_minimum < amount` for a dust withdrawal.
    # Bounding it (below) repairs that much.
    #
    # It does NOT make the anti-dust policy hold, and the bound should not be read as if it did:
    # `token_minimum` is a field of the withdrawal params, so the *prover* chooses the minimum it
    # has to clear and can set it to zero. The entrypoint takes `params.token_minimum` and never
    # compares it against the token's registered configuration
    # (`src/contract/bridge/src/entrypoint.rs:215`). An anti-dust rule needs a floor the caller
    # cannot choose; this contract has none, and OBL-Z16 in `doc/src/arch/verification-hazop.md`
    # records it as open. Contrast escrow's and otc_swap's timelocks, where the host *does* read the
    # binding value from chain state — there the circuit's copy was removed rather than bounded,
    # because a redundant copy is a second, weaker claim about a property already enforced.
    range_check(64, amount);
    range_check(64, token_minimum);
    constrain_instance(token_minimum);
    less_than_strict(token_minimum, amount);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
