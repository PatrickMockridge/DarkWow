k = 11;
field = "pallas";

constant "DepositV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "DepositV1" {
    # Public inputs
    Base commitment,
    Base recipient_pub_x,
    Base recipient_pub_y,
    Base bridge_nonce,
    Base external_block_hash,
    Base merkle_root,

    # Merkle proof path
    Base merkle_path_0,
    Base merkle_path_1,
    Base merkle_path_2,
    Base merkle_path_3,
    Base leaf_index,

    # Private inputs
    Base secret,
    Base amount,
}

circuit "DepositV1" {
    # Derive bridge secret from recipient identity + nonce
    bridge_secret = poseidon_hash(recipient_pub_x, recipient_pub_y, bridge_nonce);

    # Compute bridge public key
    bridge_pub = ec_mul_base(bridge_secret, NULLIFIER_K);
    bridge_pub_x = ec_get_x(bridge_pub);
    bridge_pub_y = ec_get_y(bridge_pub);

    # Derive deterministic bridge address
    bridge_address = poseidon_hash(bridge_pub_x, bridge_pub_y);

    # Compute commitment: H(secret, amount, bridge_address)
    derived_commitment = poseidon_hash(secret, amount, bridge_address);

    # Verify commitment matches
    assert_equal(derived_commitment, commitment);

    # Create Merkle leaf for deposit verification
    deposit_leaf = poseidon_hash(secret, amount);
    constrain_instance(deposit_leaf);

    # Verify deposit exists in external chain (simplified - actual implementation
    # would verify full Merkle proof against external_state_root)
    # This is a placeholder for the actual Merkle verification
    assert(leaf_index < 16);  # Limit proof depth

    # Range proof for amount
    assert(amount > 0);
    assert(amount < 2^64);
}