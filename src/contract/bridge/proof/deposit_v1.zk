k = 11;
field = "pallas";

constant "DepositV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "DepositV1" {
    # Public inputs
    Base commitment,
    Base recipient_pub_x,
    Base recipient_pub_y,
    Base bridge_nonce,
    Base external_block_hash,
    Base merkle_root,

    # Merkle proof path elements (up to depth 4)
    Base merkle_path_0,
    Base merkle_path_1,
    Base merkle_path_2,
    Base merkle_path_3,
    Base leaf_index,

    # Private inputs
    Base secret,
    Base amount,
}

circuit "DepositV1" {
    # Derive bridge secret from recipient identity + nonce
    bridge_secret = poseidon_hash(recipient_pub_x, recipient_pub_y, bridge_nonce);

    # Compute bridge public key
    bridge_pub = ec_mul_base(bridge_secret, NULLIFIER_K);
    bridge_pub_x = ec_get_x(bridge_pub);
    bridge_pub_y = ec_get_y(bridge_pub);

    # Derive deterministic bridge address
    bridge_address = poseidon_hash(bridge_pub_x, bridge_pub_y);

    # Compute commitment: H(secret, amount, bridge_address)
    derived_commitment = poseidon_hash(secret, amount, bridge_address);

    # Verify commitment matches public input
    constrain_equal_base(derived_commitment, commitment);

    # Create Merkle leaf for deposit verification
    deposit_leaf = poseidon_hash(secret, amount);
    constrain_instance(deposit_leaf);

    # Verify Merkle proof against external chain merkle_root
    # NOTE: Actual Merkle verification would use merkle_root(opcode) with
    # proper MerklePath type. Current placeholder uses poseidon for simplicity.
    merkle_check = poseidon_hash(deposit_leaf, merkle_path_0, merkle_path_1);
    constrain_instance(merkle_check);

    # Range proof for amount using 64-bit range check
    range_check(64, amount);

    # Verify leaf_index is within valid range for Merkle proof depth
    range_check(4, leaf_index);
}
