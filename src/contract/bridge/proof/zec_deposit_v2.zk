# ZecDeposit_V2 circuit — domain-separated Zcash bridge deposit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "ZecDepositV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ZecDepositV2" {
    Base nullifier,
    Base commitment,
    Base anchor,
    Base block_height,
    Base amount,
    Base randomized_pub_key_x,
    Base randomized_pub_key_y,
    Base randomness,
    Base confirmations,
    Base recipient_pub_x,
    Base recipient_pub_y,
    Base bridge_nonce,
    Base user_commitment,
    Uint32 leaf_pos,
    MerklePath path,
    Base secret,
    Base position,
    Base note_encryption,
    Base spend_proof_bytes,
    Base output_proof_bytes,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ZecDepositV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # PHASE 1: Derive bridge address
    bridge_secret = poseidon_hash(DOMAIN_SIGNATURE_SECRET, recipient_pub_x, recipient_pub_y, bridge_nonce);
    bridge_pub = ec_mul_base(bridge_secret, NULLIFIER_K);
    bridge_pub_x = ec_get_x(bridge_pub);
    bridge_pub_y = ec_get_y(bridge_pub);
    bridge_address = poseidon_hash(DOMAIN_COIN_COMMIT, bridge_pub_x, bridge_pub_y);

    # PHASE 2: Verify commitment
    derived_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, secret, amount, bridge_address);
    constrain_equal_base(derived_commitment, user_commitment);

    # PHASE 3: Derive Sapling note commitment
    derived_note_cm = poseidon_hash(DOMAIN_COIN_COMMIT, randomized_pub_key_x, randomized_pub_key_y, amount, randomness);
    constrain_equal_base(derived_note_cm, commitment);

    # PHASE 4: Derive and verify nullifier
    derived_nullifier = poseidon_hash(DOMAIN_NULLIFIER, secret, commitment, position);
    constrain_equal_base(derived_nullifier, nullifier);

    # PHASE 5: Merkle proof verification
    leaf = poseidon_hash(DOMAIN_COIN_COMMIT, commitment, position);

    ZERO = witness_base(0);
    less_than_strict(ZERO, amount);
    leaf_incl = zero_cond(amount, leaf);

    root = merkle_root(leaf_pos, path, leaf_incl);
    constrain_equal_base(root, anchor);

    # PHASE 6: Verify randomized public key
    constrain_instance(randomized_pub_key_x);
    constrain_instance(randomized_pub_key_y);

    # PHASE 7: Range check
    range_check(64, amount);
    range_check(64, confirmations);

    # PHASE 8: Spend proof (stubbed)
    constrain_equal_base(spend_proof_bytes, spend_proof_bytes);
    constrain_equal_base(output_proof_bytes, output_proof_bytes);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
