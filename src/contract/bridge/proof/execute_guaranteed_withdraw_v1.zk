# Bridge ExecuteGuaranteedWithdrawV1 Circuit — relayer authorization for guaranteed withdrawals.
# HAZOP WP-BRIDGE-3: proves relayer knows their secret key.
k = 11;
field = "pallas";

constant "ExecuteGuaranteedWithdrawV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExecuteGuaranteedWithdrawV1" {
    Base nullifier,
    Base relayer_secret,
    Base relayer_pub_x,
    Base relayer_pub_y,
    Base fee_cap,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ExecuteGuaranteedWithdrawV1" {
    # Prove relayer identity: relayer_pub = secret * K
    relayer_pub = ec_mul_base(relayer_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(relayer_pub);
    derived_pub_y = ec_get_y(relayer_pub);
    constrain_equal_base(derived_pub_x, relayer_pub_x);
    constrain_equal_base(derived_pub_y, relayer_pub_y);

    tx_binding = poseidon_hash(tx_commitment, tx_nonce);

    constrain_instance(nullifier);
    constrain_instance(relayer_pub_x);
    constrain_instance(relayer_pub_y);
    constrain_instance(fee_cap);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
