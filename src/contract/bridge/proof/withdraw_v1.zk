k = 14;
field = "pallas";

constant "WithdrawV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "WithdrawV1" {
    # Public inputs
    Base nullifier,
    Base recipient_hash,
    Base amount,
    Base bridge_address,
    Base merkle_root_val,
    Base commitment,
    Base token_minimum,

    # Private inputs
    Base secret,
    SparseMerklePath merkle_path,
    Base leaf_index,
    Base tx_commitment,
}

circuit "WithdrawV1" {
    # Derive nullifier from secret AND recipient_hash.
    # HAZOP CRIT-3 FIX: Previously nullifier = poseidon_hash(secret) — independent
    # of the recipient. This allowed Mallory to front-run withdrawals by extracting
    # the nullifier from the mempool and creating a new proof with her own
    # recipient_hash. Now the nullifier is recipient-specific: changing recipient_hash
    # changes the nullifier, and the original depositor's nullifier can't be reused.
    # nullifier = poseidon_hash(secret, recipient_hash)
    computed_nullifier = poseidon_hash(secret, recipient_hash);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches public input
    constrain_equal_base(computed_nullifier, nullifier);

    # Verify commitment matches
    derived_commitment = poseidon_hash(secret, amount, bridge_address);
    constrain_equal_base(derived_commitment, commitment);

    # Create deposit leaf for verification
    deposit_leaf = poseidon_hash(secret, amount);
    constrain_instance(deposit_leaf);

    # Verify Merkle proof: deposit leaf is in the bridge's Merkle tree
    computed_root = sparse_merkle_root(leaf_index, merkle_path, deposit_leaf);
    constrain_equal_base(computed_root, merkle_root_val);
    # Expose merkle_root_val as a public input so the verifier can check
    # it against the on-chain bridge deposit tree root.
    constrain_instance(merkle_root_val);

    # Verify recipient hash matches (privacy-preserving address)
    derived_recipient = poseidon_hash(recipient_hash);
    constrain_instance(derived_recipient);

    # Range proof for amount
    range_check(64, amount);

    # Minimum amount check (prevents dust/zero-value griefing)
    # Token-aware minimum passed as public input from bridge config
    constrain_instance(token_minimum);
    less_than_strict(token_minimum, amount);

    # Verify leaf_index is valid for Merkle proof
    constrain_instance(tx_commitment);
    range_check(64, leaf_index);
}
