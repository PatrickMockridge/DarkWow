k = 11;
field = "pallas";

constant "WithdrawV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "WithdrawV1" {
    # Public inputs
    Base nullifier,
    Base recipient_hash,
    Base amount,
    Base bridge_address,
    Base merkle_root,
    Base commitment,

    # Private inputs
    Base secret,
    Base merkle_proof_0,
    Base merkle_proof_1,
    Base merkle_proof_2,
    Base merkle_proof_3,
    Base leaf_index,
}

circuit "WithdrawV1" {
    # Derive nullifier from secret
    # nullifier = poseidon_hash(secret)
    computed_nullifier = poseidon_hash(secret);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    assert_equal(computed_nullifier, nullifier);

    # Verify commitment matches
    derived_commitment = poseidon_hash(secret, amount, bridge_address);
    assert_equal(derived_commitment, commitment);

    # Verify Merkle proof (deposit exists and not already spent)
    deposit_leaf = poseidon_hash(secret, amount);
    constrain_instance(deposit_leaf);

    # Verify recipient hash matches (privacy-preserving address)
    derived_recipient = poseidon_hash(recipient_hash);
    constrain_instance(derived_recipient);

    # Range proof
    assert(amount > 0);
    assert(amount < 2^64);
}