k = 14;
field = "pallas";

constant "WithdrawV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "WithdrawV1" {
    # Public inputs
    Base nullifier,
    Base recipient_hash,
    Base amount,
    Base bridge_address,
    Base merkle_root,
    Base commitment,

    # Private inputs
    Base secret,
    Base merkle_proof_0,
    Base merkle_proof_1,
    Base merkle_proof_2,
    Base merkle_proof_3,
    Base leaf_index,
}

circuit "WithdrawV1" {
    # Derive nullifier from secret
    # nullifier = poseidon_hash(secret)
    computed_nullifier = poseidon_hash(secret);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches public input
    constrain_equal_base(computed_nullifier, nullifier);

    # Verify commitment matches
    derived_commitment = poseidon_hash(secret, amount, bridge_address);
    constrain_equal_base(derived_commitment, commitment);

    # Create deposit leaf for verification
    deposit_leaf = poseidon_hash(secret, amount);
    constrain_instance(deposit_leaf);

    # Verify recipient hash matches (privacy-preserving address)
    derived_recipient = poseidon_hash(recipient_hash);
    constrain_instance(derived_recipient);

    # Range proof for amount
    range_check(64, amount);

    # Minimum amount check (prevents dust/zero-value griefing)
    # TODO: This should be token-aware and use DEX price feed for 1 DAI equivalent.
    # Pending DEX integration, using 100_000_000 as conservative dust threshold.
    # less_than_strict(a, b) constrains a < b (constrain-only, sound)
    minimum_withdraw = witness_base(100000000);
    less_than_strict(minimum_withdraw, amount);

    # Verify leaf_index is valid for Merkle proof
    range_check(64, leaf_index);
}
