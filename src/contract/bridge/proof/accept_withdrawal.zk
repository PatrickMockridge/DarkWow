# Bridge AcceptWithdrawalV2 Circuit — domain-separated relayer acceptance.
# V2: domain separation on poseidon_hash per HAZOP RC3.
k = 11; field = "pallas";
constant "AcceptWithdrawalV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "AcceptWithdrawalV2" {
    Base nullifier, Base relayer_secret, Base relayer_pub_x, Base relayer_pub_y,
    Base max_fee_bp,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "AcceptWithdrawalV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    relayer_pub = ec_mul_base(relayer_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(relayer_pub), relayer_pub_x);
    constrain_equal_base(ec_get_y(relayer_pub), relayer_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(nullifier);
    constrain_instance(relayer_pub_x); constrain_instance(relayer_pub_y);
    constrain_instance(max_fee_bp);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
