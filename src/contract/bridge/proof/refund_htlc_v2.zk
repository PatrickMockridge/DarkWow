# Bridge RefundHtlcV2 Circuit — domain-separated HTLC refund authorization.
# V2: domain separation on poseidon_hash per HAZOP RC3.
k = 11; field = "pallas";
constant "RefundHtlcV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "RefundHtlcV2" {
    Base swap_id, Base sender_secret, Base sender_pub_x, Base sender_pub_y,
    Base timelock_height,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "RefundHtlcV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    sender_pub = ec_mul_base(sender_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(sender_pub), sender_pub_x);
    constrain_equal_base(ec_get_y(sender_pub), sender_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(swap_id);
    constrain_instance(sender_pub_x); constrain_instance(sender_pub_y);
    constrain_instance(timelock_height);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
