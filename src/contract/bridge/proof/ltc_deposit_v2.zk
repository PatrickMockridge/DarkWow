# LtcDeposit_V2 circuit — domain-separated Litecoin bridge deposit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "LtcDepositV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "LtcDepositV2" {
    Base tx_hash_0,
    Base tx_hash_1,
    Base output_index,
    Base amount,
    Base block_merkle_root,
    Base block_height,
    Base confirmations,
    Base recipient_pub_x,
    Base recipient_pub_y,
    Base bridge_nonce,
    Base user_commitment,
    Base confidential_commitment,
    Uint32 leaf_pos,
    MerklePath path,
    Base secret,
    Base blinding_factor,
    Base range_proof_bytes,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "LtcDepositV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # PHASE 1: Derive bridge address
    bridge_secret = poseidon_hash(DOMAIN_SIGNATURE_SECRET, recipient_pub_x, recipient_pub_y, bridge_nonce);
    bridge_pub = ec_mul_base(bridge_secret, NULLIFIER_K);
    bridge_pub_x = ec_get_x(bridge_pub);
    bridge_pub_y = ec_get_y(bridge_pub);
    bridge_address = poseidon_hash(DOMAIN_COIN_COMMIT, bridge_pub_x, bridge_pub_y);

    # PHASE 2: Verify commitment
    derived_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, secret, amount, bridge_address);
    constrain_equal_base(derived_commitment, user_commitment);

    # PHASE 3: Verify transaction data
    constrain_equal_base(tx_hash_0, tx_hash_0);
    constrain_equal_base(tx_hash_1, tx_hash_1);
    constrain_equal_base(block_merkle_root, block_merkle_root);

    # PHASE 4: Merkle proof verification
    block_leaf = poseidon_hash(DOMAIN_COIN_COMMIT, tx_hash_0, tx_hash_1);

    ZERO = witness_base(0);
    less_than_strict(ZERO, amount);
    coin_incl = zero_cond(amount, block_leaf);

    root = merkle_root(leaf_pos, path, coin_incl);
    constrain_equal_base(root, block_merkle_root);

    # PHASE 5: MWEB confidential deposit (stubbed)
    constrain_equal_base(confidential_commitment, confidential_commitment);
    constrain_equal_base(blinding_factor, blinding_factor);
    constrain_equal_base(range_proof_bytes, range_proof_bytes);

    # PHASE 6: Range check
    range_check(64, amount);
    range_check(64, confirmations);
    range_check(64, output_index);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
