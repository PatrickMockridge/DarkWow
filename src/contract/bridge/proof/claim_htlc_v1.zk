# Bridge ClaimHtlcV1 Circuit — proves knowledge of HTLC preimage without revealing it.
# HAZOP WP-BRIDGE-1 fix: replaces plaintext secret reveal with ZK proof.
# HAZOP-03 mitigation: secret is never revealed on-chain.
k = 11;
field = "pallas";

constant "ClaimHtlcV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ClaimHtlcV1" {
    # HTLC swap identifier
    Base swap_id,

    # Secret preimage (private — never revealed on-chain)
    Base secret,

    # Derived hash = poseidon_hash(secret) — must match stored htlc.hash
    Base derived_hash,

    # Transaction binding
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ClaimHtlcV1" {
    # Prove knowledge of preimage: derived_hash = H(secret)
    computed_hash = poseidon_hash(secret);
    constrain_equal_base(computed_hash, derived_hash);

    # Transaction binding
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);

    # Public inputs: swap_id, derived_hash (verifier checks against htlc.hash)
    constrain_instance(swap_id);
    constrain_instance(derived_hash);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
