# Bridge CancelWithdrawV2 Circuit — domain-separated cancellation authorization.
# V2: domain separation on poseidon_hash per HAZOP RC3.
k = 11; field = "pallas";
constant "CancelWithdrawV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "CancelWithdrawV2" {
    Base nullifier,
    Base withdrawal_id,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "CancelWithdrawV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(nullifier);
    constrain_instance(withdrawal_id);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
