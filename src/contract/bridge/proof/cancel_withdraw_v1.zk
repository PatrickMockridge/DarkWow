# Bridge CancelWithdrawV1 Circuit — proves ownership of the deposit being cancelled.
# HAZOP WP-BRIDGE-2 fix: caller must prove knowledge of the deposit secret.
# HAZOP-05 mitigation: nullifier is restored on cancellation, deposit can be re-withdrawn.
k = 11;
field = "pallas";

constant "CancelWithdrawV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CancelWithdrawV1" {
    # The nullifier being cancelled (proves we know the deposit)
    Base nullifier,

    # Withdrawal identifier
    Base withdrawal_id,

    # Transaction binding
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CancelWithdrawV1" {
    # Transaction binding
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);

    # Public inputs: nullifier + withdrawal_id
    constrain_instance(nullifier);
    constrain_instance(withdrawal_id);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
