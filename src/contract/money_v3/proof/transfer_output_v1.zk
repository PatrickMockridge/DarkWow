# TransferOutput circuit - proves output coin is correctly formed
# PRIVACY FIRST: All operations use Poseidon hash, no EC operations
# Enables cross-contract composition by optionally revealing value and token_id
# to parent contracts via public_value/public_token_id instance variables.
k = 11;
field = "pallas";

constant "TransferOutput_V1" {
    # No EC constants needed - using Poseidon-only design
}

witness "TransferOutput_V1" {
    # Coin attributes
    Base coin_public,
    Base coin_value,
    Base coin_token_id,
    Base coin_spend_hook,
    Base coin_user_data,
    Base coin_blind,
    # Value commitment blind
    Base value_blind,
    # Public values for cross-contract composition (constrained to equal witnesses)
    Base public_value,
    Base public_token_id,
}

circuit "TransferOutput_V1" {
    # Create the coin
    coin = poseidon_hash(
        coin_public,
        coin_value,
        coin_token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );
    constrain_instance(coin);

    # Value commitment using Poseidon hash
    value_commit = poseidon_hash(coin_value, value_blind);
    constrain_instance(value_commit);

    # Constrain public values to equal the witness values
    # Parent contracts verify these match their expected amounts
    constrain_instance(public_value);
    constrain_instance(public_token_id);

    # Range proof for value
    range_check(64, coin_value);
}