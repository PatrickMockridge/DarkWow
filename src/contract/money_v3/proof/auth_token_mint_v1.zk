# AuthTokenMint circuit - authorizes minting for an existing token type
# PRIVACY FIRST: All operations use Poseidon hash, no EC operations
# This proves the caller has authority to mint tokens of a specific token_id
k = 11;
field = "pallas";

constant "AuthTokenMint_V1" {
    # No EC constants needed - using Poseidon-only design
}

witness "AuthTokenMint_V1" {
    # Secret key for signing
    Base mint_secret,
    # Token ID we are authorizing to mint
    Base token_id,
    # Merkle proof that this token_id exists in the token registry
    Uint32 leaf_pos,
    MerklePath path,
}

circuit "AuthTokenMint_V1" {
    # Derive public key from secret using Poseidon (Schnorr-style)
    # public_key = poseidon_hash(secret)
    mint_public = poseidon_hash(mint_secret);

    # Nullifier to prevent replay
    # nullifier = poseidon_hash(mint_secret, token_id)
    nullifier = poseidon_hash(mint_secret, token_id);
    constrain_instance(nullifier);

    # Verify the token_id exists in the registry
    # We use a Merkle tree where leaves are token_ids
    root = merkle_root(leaf_pos, path, token_id);
    constrain_instance(root);

    # Export the derived public key as public input
    # This binds the signature to this proof
    constrain_instance(mint_public);
}