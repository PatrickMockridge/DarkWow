# TokenMint circuit - creates a new token type
# Uses Pedersen commitments for value — consistent with other promissory_note circuits.
k = 11;
field = "pallas";

constant "TokenMint_V1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "TokenMint_V1" {
    # Authority parent - who has permission to mint this token
    Base token_auth_parent,
    # User data for the token
    Base token_user_data,
    # Blinding factor for token ID
    Base token_blind,
    # Coin attributes for initial mint
    Base coin_public,
    Base coin_value,
    Base coin_token_id,
    Base coin_spend_hook,
    Base coin_user_data,
    Base coin_blind,
    # Value commitment blind
    Scalar value_blind,
}

circuit "TokenMint_V1" {
    # Derive token ID from auth_parent, user_data, and blind
    # This creates a commitment that hides the token identity
    # Token ID = poseidon_hash(auth_parent, user_data, blind)
    token_id = poseidon_hash(token_auth_parent, token_user_data, token_blind);
    constrain_instance(token_id);

    # The token auth parent is revealed (public authority)
    constrain_instance(token_auth_parent);

    # Create the coin with this token_id
    coin = poseidon_hash(
        coin_public,
        coin_value,
        token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );
    constrain_instance(coin);

    # Value commitment - Pedersen (additively homomorphic)
    # C = v * G_v + r * G_r
    vcv = ec_mul_short(coin_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    coin_value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(coin_value_commit));
    constrain_instance(ec_get_y(coin_value_commit));

    # Reveal spend_hook so parent contracts verify output coin binding
    constrain_instance(coin_spend_hook);

    # Range proof for value
    range_check(64, coin_value);
}
