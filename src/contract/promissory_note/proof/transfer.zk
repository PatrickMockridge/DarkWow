# Transfer_V2 circuit — proves output coin is correctly formed.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "Transfer_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "Transfer_V2" {
    Base coin_public,
    Base value,
    Base asset_id,
    Base coin_spend_hook,
    Base user_data,
    Base commitment_blind,
    Scalar value_blind,
    Base asset_id_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Transfer_V2" {
    DOMAIN_TOK_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Coin commitment
    coin = poseidon_hash(
        DOMAIN_COMMITMENT,
        coin_public,
        value,
        asset_id,
        coin_spend_hook,
        user_data,
        commitment_blind,
    );
    constrain_instance(coin);

    # Value commitment - Pedersen
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Token ID commitment
    token_commit = poseidon_hash(DOMAIN_TOK_COMMIT, asset_id, asset_id_blind);
    constrain_instance(token_commit);

    constrain_instance(coin_spend_hook);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, value);
}
