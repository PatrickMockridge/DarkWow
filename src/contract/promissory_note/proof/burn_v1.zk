# Burn circuit - proves spending with nullifier reveal
# Uses Pedersen commitments for additively homomorphic value conservation.
# Schnorr-style signature where public_key = poseidon_hash(secret)
k = 11;
field = "pallas";

constant "Burn_V1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "Burn_V1" {
    # Secret key for spending
    Base coin_secret,
    # Coin attributes
    Base coin_value,
    Base coin_token_id,
    Base coin_spend_hook,
    Base coin_user_data,
    Base coin_blind,
    # Blinding factors
    Scalar value_blind,
    Base token_id_blind,
    Base user_data_blind,
    # Merkle proof
    Uint32 leaf_pos,
    MerklePath path,
    # Signature secret key — derived from coin_secret in-circuit (see below)
    Base signature_secret,
}

circuit "Burn_V1" {
    # Derive public key from secret using Poseidon (not EC)
    # Schnorr-style: public_key = poseidon_hash(secret)
    pub = poseidon_hash(coin_secret);

    # Coin hash using derived public key (single field element, not EC point)
    coin = poseidon_hash(
        pub,
        coin_value,
        coin_token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );

    # Nullifier - breaks the link between mint and burn
    # nullifier = poseidon_hash(coin_secret, coin)
    nullifier = poseidon_hash(coin_secret, coin);
    constrain_instance(nullifier);

    # Value commitment - Pedersen (additively homomorphic)
    # C = v * G_v + r * G_r
    vcv = ec_mul_short(coin_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    coin_value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(coin_value_commit));
    constrain_instance(ec_get_y(coin_value_commit));

    # Token ID commitment
    token_commit = poseidon_hash(coin_token_id, token_id_blind);
    constrain_instance(token_commit);

    # Merkle proof - verify coin exists in the Merkle tree
    # Uses zero_cond trick for dummy zero-value inputs
    # HAZOP HIGH-1 FIX: Enforce coin_value > 0 before zero_cond.
    # Without this, a prover could set coin_value=0, making zero_cond return 0
    # (the tree's zero leaf) and the Merkle proof would verify against empty
    # positions rather than a real coin. less_than_strict(0, coin_value) is
    # constrain-only — it enforces the inequality but returns no value.
    ZERO = witness_base(0);
    less_than_strict(ZERO, coin_value);
    coin_incl = zero_cond(coin_value, coin);
    root = merkle_root(leaf_pos, path, coin_incl);
    constrain_instance(root);

    # Encrypted user data
    user_data_enc = poseidon_hash(coin_user_data, user_data_blind);
    constrain_instance(user_data_enc);

    # Reveal spend hook (can be used for cross-contract composition)
    constrain_instance(coin_spend_hook);

    # Derive per-burn unique signature_secret from coin_secret + nullifier.
    # poseidon_hash(coin_secret, nullifier) ensures:
    # 1. The signature IS cryptographically bound to coin_secret
    #    (can't use an independent secret — fixes H2 separation attack)
    # 2. Each burn has a DIFFERENT signature_public (nullifier is unique per coin)
    #    so signature_public is unlinkable across burns (preserves privacy)
    derived_signature_secret = poseidon_hash(coin_secret, nullifier);
    constrain_equal_base(derived_signature_secret, signature_secret);

    # Derive per-burn signature public key (Schnorr-style)
    signature_public = poseidon_hash(signature_secret);
    constrain_instance(signature_public);

    # Range proof - ensure value is valid
    range_check(64, coin_value);
}
