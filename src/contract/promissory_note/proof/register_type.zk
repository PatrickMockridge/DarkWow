# RegisterType_V2 circuit — creates a new token type.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "RegisterType_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "RegisterType_V2" {
    Base token_auth_parent,
    Base token_user_data,
    Base token_blind,
    Base coin_public,
    Base coin_value,
    Base coin_token_id,
    Base coin_spend_hook,
    Base coin_user_data,
    Base coin_blind,
    Scalar value_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "RegisterType_V2" {
    DOMAIN_TOK_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # Derive token ID from auth_parent, user_data, and blind
    token_id = poseidon_hash(DOMAIN_TOK_COMMIT, token_auth_parent, token_user_data, token_blind);
    constrain_instance(token_id);

    constrain_instance(token_auth_parent);

    # Create the coin with this token_id
    coin = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        coin_public,
        coin_value,
        token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );
    constrain_instance(coin);

    # Value commitment - Pedersen
    vcv = ec_mul_short(coin_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    coin_value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(coin_value_commit));
    constrain_instance(ec_get_y(coin_value_commit));

    constrain_instance(coin_spend_hook);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, coin_value);
}
