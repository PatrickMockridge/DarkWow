# Mint circuit - mints tokens of an existing token type
# Proves knowledge of the backing secret directly against the stored
# token_auth_parent in the token registry (single-step capability proof).
# Uses Pedersen commitments for value — consistent with Transfer/Burn.
k = 11;
field = "pallas";

constant "Issue_V1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "Issue_V1" {
    # Backing capability proof (mint_public = poseidon_hash(backing_secret))
    Base backing_secret,
    Base mint_public,
    # Token registry Merkle proof (proves token_id exists in registry)
    Uint32 token_leaf_pos,
    MerklePath token_path,
    # Coin attributes
    Base coin_public,
    Base coin_value,
    Base coin_token_id,
    Base coin_spend_hook,
    Base coin_user_data,
    Base coin_blind,
    # Value commitment blind
    Scalar value_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Issue_V1" {
    # Verify token_id exists in the token registry via Merkle proof
    token_root = merkle_root(token_leaf_pos, token_path, coin_token_id);
    constrain_instance(token_root);

    # Bind mint_public (proves knowledge of backing secret)
    # CRITICAL: Derive mint_public from backing_secret to prevent
    # unauthorized minting. Without this constraint, a prover can
    # set mint_public = stored_auth (read from on-chain registry)
    # and bypass the entrypoint authorization check.
    derived_mint_public = poseidon_hash(backing_secret);
    constrain_equal_base(derived_mint_public, mint_public);
    constrain_instance(mint_public);

    # RC1-B: bind coin_public to mint_public — the minted coin MUST go to
    # the minter's own key. Without this, a prover who knows backing_secret
    # can mint coins to arbitrary keys they don't control, making rewards
    # permanently unspendable (same class as native_token Mint_V1 M8).
    constrain_equal_base(coin_public, mint_public);

    # Create the coin with the given token_id
    coin = poseidon_hash(
        coin_public,
        coin_value,
        coin_token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );
    constrain_instance(coin);

    # Value commitment - Pedersen (additively homomorphic)
    # C = v * G_v + r * G_r
    vcv = ec_mul_short(coin_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    coin_value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(coin_value_commit));
    constrain_instance(ec_get_y(coin_value_commit));

    # The token_id is constrained via Merkle proof above
    constrain_instance(coin_token_id);

    # Reveal spend_hook so parent contracts verify output coin binding
    constrain_instance(coin_spend_hook);

    # Range proof for value
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, coin_value);
}
