# The k parameter defining the number of rows used in our circuit (2^k)
k = 14;
field = "pallas";

# Labor Market Refund Circuit (Version 1)
#
# This circuit proves:
# - Employer knows their secret key
# - Employer public key is correctly derived
# - The deadline has passed (timeout)
# - Employer is claiming refund for a specific job
# - For milestone jobs: refund is reduced by completed milestones' payments
#
# For milestone jobs:
#   - completed_payment: Sum of payments for completed milestones
#   - refund_amount = total_payment - completed_payment
#
# Public Inputs (constrain_instance):
#   - job_id: The job being refunded
#   - employer_pub_x, employer_pub_y: Employer's public key coordinates
#   - milestone_count: Number of milestones (0 if no milestones)
#   - completed_payment: Sum of completed milestone payments
#   - refund_amount: Amount being refunded
#
# Witnesses:
#   - employer_secret: Employer's secret key
#   - deadline_block: When work was due
#   - current_block: Current block height
#   - total_payment: Total job payment

constant "Refund" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Refund" {
    # Job being refunded
    Base job_id,

    # Employer's secret (for key derivation and nullifier)
    Base employer_secret,

    # Employer's public key coordinates (public input - must match derived)
    Base employer_pub_x,
    Base employer_pub_y,

    # Milestone info
    Base milestone_count,
    Base completed_payment,

    # Refund amount being claimed
    Base refund_amount,

    # Time verification (passed as Base to avoid .into() issues)
    Base deadline_block,
    Base current_block,

    # Total payment for this job
    Base total_payment,
}

circuit "Refund" {
    ZERO = witness_base(0);
    ONE = witness_base(1);

    # ==========================================================================
    # PHASE 1: Derive employer public key from secret
    # ==========================================================================

    employer_pub = ec_mul_base(employer_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(employer_pub);
    derived_pub_y = ec_get_y(employer_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the employer_secret to the employer_pubkey
    constrain_equal_base(derived_pub_x, employer_pub_x);
    constrain_equal_base(derived_pub_y, employer_pub_y);

    # ==========================================================================
    # PHASE 2: Verify timeout has passed
    # ==========================================================================
    #
    # less_than_strict(deadline_block, current_block)
    # constrains: deadline_block < current_block
    # This means the deadline has passed and work was never delivered

    less_than_strict(deadline_block, current_block);

    # ==========================================================================
    # PHASE 3: Calculate refund amount for milestone jobs
    # ==========================================================================
    #
    # For milestone jobs, the refund is reduced by completed milestones:
    #   refund = total_payment - completed_payment
    #
    # For non-milestone jobs (milestone_count == 0):
    #   refund = total_payment

    # Check if this is a milestone job
    is_milestone = is_equal_base(milestone_count, ZERO);
    is_not_milestone = not_base(is_milestone);

    # Calculate: total_payment - completed_payment
    payment_remaining = base_sub(total_payment, completed_payment);

    # For milestone jobs: refund = total_payment - completed_payment
    # For non-milestone jobs: refund = total_payment
    # We select based on is_not_milestone
    expected_refund = cond_select(payment_remaining, total_payment, is_milestone);

    # Verify the refund amount is correct
    refund_match = is_equal_base(expected_refund, refund_amount);

    # For milestone jobs, refund must match calculated amount
    milestone_refund_valid = base_mul(is_not_milestone, refund_match);

    # The refund check should pass for milestone jobs
    refund_check_ok = is_equal_base(milestone_refund_valid, is_not_milestone);
    constrain_equal_base(refund_check_ok, ONE);

    # ==========================================================================
    # PHASE 4: Compute refund nullifier
    # ==========================================================================
    #
    # nullifier = H(job_id, employer_secret)
    # This proves the employer authorized the refund

    spent_nullifier = poseidon_hash(job_id, employer_secret);

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(job_id);
    constrain_instance(employer_pub_x);
    constrain_instance(employer_pub_y);
    constrain_instance(milestone_count);
    constrain_instance(completed_payment);
    constrain_instance(refund_amount);
    constrain_instance(spent_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - is_equal_base: equality check
    #   - not_base: boolean NOT
    #   - cond_select: conditional selection
    #   - base_sub: field subtraction
    #   - base_mul: field multiplication
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The contract layer verifies:
    # 1. Job is in "InProgress" or "Delivered" state
    # 2. No previous refund/claim has been made
    # 3. milestone_count matches the actual job milestones
    # 4. completed_payment matches sum of completed milestone payments
    #
    # This is the HTLC-style timeout refund - if the worker doesn't deliver
    # by the deadline, the employer gets their funds back (minus completed
    # milestone payments for milestone jobs).
}
