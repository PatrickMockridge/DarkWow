# SubmitGitDeliverable_V2 — domain-separated git deliverable submission.
# V2 (HAZOP RC3): domain separation on poseidon_hash
k = 14; field = "pallas";
constant "SubmitGitDeliverableV2" { EcFixedPointBase NULLIFIER_K, }
witness "SubmitGitDeliverableV2" { Base job_id, Base worker_secret, Base worker_pub_x, Base worker_pub_y, Base tx_commitment, Base tx_nonce, Base tx_binding, }
circuit "SubmitGitDeliverableV2" { DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3); spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, job_id, worker_secret); constrain_instance(spent_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce); constrain_instance(tx_binding); constrain_instance(tx_nonce); }
