# Dispute_V2 — domain-separated dispute filing.
# V2 (HAZOP RC3): domain separation on poseidon_hash
k = 14; field = "pallas";
constant "DisputeV2" { EcFixedPointBase NULLIFIER_K, }
witness "DisputeV2" { Base job_id, Base disputer_secret, Base disputer_pub_x, Base disputer_pub_y, Base dispute_reason_hash, Base tx_commitment, Base tx_nonce, Base tx_binding, }
circuit "DisputeV2" { DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3); spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, job_id, disputer_secret, dispute_reason_hash); constrain_instance(spent_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce); constrain_instance(tx_binding); constrain_instance(tx_nonce); }
