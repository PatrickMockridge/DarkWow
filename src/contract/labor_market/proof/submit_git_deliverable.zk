# SubmitGitDeliverable_V2 — domain-separated git deliverable submission.
# HAZOP HIGH-4 fix: added GIT_SUBMIT_TAG to nullifier to prevent collision
# with submit_deliverable (was identical nullifier derivation).
k = 14; field = "pallas";
constant "SubmitGitDeliverableV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "SubmitGitDeliverableV2" {
    Base job_id,
    Base worker_secret,
    Base worker_pub_x,
    Base worker_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "SubmitGitDeliverableV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    GIT_SUBMIT_TAG = witness_base(6);

    # Derive worker pubkey
    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(worker_pub), worker_pub_x);
    constrain_equal_base(ec_get_y(worker_pub), worker_pub_y);

    # Nullifier with distinct action tag from submit_deliverable
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, GIT_SUBMIT_TAG, job_id, worker_secret);
    constrain_instance(spent_nullifier);
    constrain_instance(job_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
