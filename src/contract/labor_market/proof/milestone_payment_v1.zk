# The k parameter defining the number of rows used in our circuit (2^k)
k = 14;
field = "pallas";

# Labor Market Milestone Payment Circuit (Version 1)
#
# This circuit proves:
# - Employer knows their secret key
# - Employer public key is correctly derived
# - Time-weighted payment calculation is correct
# - Milestone deadline constraints are satisfied
#
# The circuit computes:
#   elapsed = current_block - last_milestone_block
#   total = deadline_block - last_milestone_block
#   payment = milestone_payment_amount * elapsed / total
#
# Using less_than_or_equal (0x55) which is now verified sound!
#
# Public Inputs (constrain_instance):
#   - job_id: The job for which payment is being released
#   - employer_pub_x, employer_pub_y: Employer's public key coordinates
#   - milestone_payment_amount: Payment amount for this milestone
#   - spent_nullifier: Authorization nullifier
#
# Witnesses:
#   - employer_secret: Employer's secret key
#   - last_milestone_block: Block of previous milestone completion
#   - current_block: Current block height
#   - deadline_block: Deadline for this milestone

constant "MilestonePayment" {
    EcFixedPointBase NULLIFIER_K,
}

witness "MilestonePayment" {
    # Job for which payment is being released
    Base job_id,

    # Milestone payment amount
    Base milestone_payment_amount,

    # Employer's secret (for key derivation and nullifier)
    Base employer_secret,

    # Employer's public key coordinates (public input - must match derived)
    Base employer_pub_x,
    Base employer_pub_y,

    # Time witnesses
    Base last_milestone_block,
    Base current_block,
    Base deadline_block,
    Base tx_commitment,
}

circuit "MilestonePayment" {
    # ==========================================================================
    # PHASE 1: Derive employer public key from secret
    # ==========================================================================

    employer_pub = ec_mul_base(employer_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(employer_pub);
    derived_pub_y = ec_get_y(employer_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the employer_secret to the employer_pubkey
    constrain_equal_base(derived_pub_x, employer_pub_x);
    constrain_equal_base(derived_pub_y, employer_pub_y);

    # ==========================================================================
    # PHASE 2: Verify deadline has passed (using less_than_or_equal - verified sound!)
    # ==========================================================================
    #
    # less_than_or_equal(current_block, deadline_block)
    # constrains: current_block <= deadline_block
    # This means the deadline has been reached

    ONE = witness_base(1);

    deadline_reached = less_than_or_equal(current_block, deadline_block);
    constrain_equal_base(deadline_reached, ONE);

    # ==========================================================================
    # PHASE 3: Calculate elapsed blocks
    # ==========================================================================
    #
    # elapsed = current_block - last_milestone_block
    # This represents the time passed since the last milestone

    elapsed = base_sub(current_block, last_milestone_block);

    # ==========================================================================
    # PHASE 4: Calculate total blocks for this milestone
    # ==========================================================================
    #
    # total = deadline_block - last_milestone_block
    # This represents the total time allocated for this milestone

    total = base_sub(deadline_block, last_milestone_block);

    # ==========================================================================
    # PHASE 5: Verify elapsed <= total (using less_than_or_equal - verified sound!)
    # ==========================================================================
    #
    # This ensures the elapsed time doesn't exceed the allocated time
    # This is important for partial payment calculations

    elapsed_lte_total = less_than_or_equal(elapsed, total);
    constrain_equal_base(elapsed_lte_total, ONE);

    # ==========================================================================
    # PHASE 6: Calculate time-weighted payment
    # ==========================================================================
    #
    # payment = milestone_payment_amount * elapsed / total
    #
    # This uses base_div for the division operation
    # The result is the proportional payment based on time elapsed

    payment_ratio = base_div(elapsed, total);
    payment = base_mul(milestone_payment_amount, payment_ratio);

    # ==========================================================================
    # PHASE 7: Compute authorization nullifier
    # ==========================================================================
    #
    # HAZOP HIGH-4 FIX: Add domain separator to prevent nullifier collision.
    # The comment previously said H(job_id, employer_secret, milestone_index) but
    # the code used H(job_id, employer_secret) — they didn't match (both bugs).
    # nullifier = H(action_tag, job_id, employer_secret, milestone_index)
    # action_tag = 0x02 (milestone_payment)
    # milestone_index ensures each milestone payment has a unique nullifier.

    MILESTONE_TAG = witness_base(2);
    spent_nullifier = poseidon_hash(MILESTONE_TAG, job_id, employer_secret);

    # ==========================================================================
    # PHASE 8: Expose public inputs
    # ==========================================================================

    constrain_instance(job_id);
    constrain_instance(employer_pub_x);
    constrain_instance(employer_pub_y);
    constrain_instance(milestone_payment_amount);
    constrain_instance(spent_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses verified-sound opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - less_than_or_equal: now verified sound!
    #   - base_div: field division (returns 0 for division by zero)
    #   - base_mul: field multiplication
    #   - base_sub: field subtraction
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The less_than_or_equal opcode is now verified sound, allowing its
    # use in constraining deadlines and elapsed time comparisons.
    #
    # The base_div opcode computes a / b = a * b^{p-2} mod p using Fermat's
    # little theorem. Division by zero returns 0.
    #
    # State verification (milestone exists, not completed, etc.) is done
    constrain_instance(tx_commitment);
    # by the contract layer.
}