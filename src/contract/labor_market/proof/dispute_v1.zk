# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Labor Market Dispute Circuit (Version 1)
#
# This circuit proves:
# - Disputer knows their secret key
# - Disputer public key is correctly derived
# - Disputer is either the employer or worker for this job
# - The dispute is being escalated to DAO governance
#
# Public Inputs (constrain_instance):
#   - job_id: The job being disputed
#   - disputer_pub_x, disputer_pub_y: Disputer's public key coordinates
#   - dao_escrow_bulla: The DAO-Escrow handling the dispute
#
# Witnesses:
#   - disputer_secret: Disputer's secret key
#   - dispute_reason_hash: Hash of the reason for dispute (privacy-preserving)

constant "Dispute" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Dispute" {
    # Job being disputed
    Base job_id,

    # Disputer's secret (employer or worker)
    Base disputer_secret,

    # Hash of dispute reason (for privacy, not the full text)
    Base dispute_reason_hash,

    # DAO-Escrow handling this dispute
    Base dao_escrow_bulla,
}

circuit "Dispute" {
    # ==========================================================================
    # PHASE 1: Derive disputer public key from secret
    # ==========================================================================

    disputer_pub = ec_mul_base(disputer_secret, NULLIFIER_K);
    disputer_pub_x = ec_get_x(disputer_pub);
    disputer_pub_y = ec_get_y(disputer_pub);

    # ==========================================================================
    # PHASE 2: Compute dispute nullifier
    # ==========================================================================
    #
    # nullifier = H(job_id, disputer_secret, dispute_reason_hash)
    # This uniquely identifies this dispute

    spent_nullifier = poseidon_hash(job_id, disputer_secret, dispute_reason_hash);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================
    #
    # The disputer's public key being valid proves they are part of this job.
    # The contract layer verifies the disputer is either employer or worker.
    # The dao_escrow_bulla binds this dispute to a specific DAO-Escrow.

    constrain_instance(job_id);
    constrain_instance(disputer_pub_x);
    constrain_instance(disputer_pub_y);
    constrain_instance(dao_escrow_bulla);
    constrain_instance(spent_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # Note: The actual verification that disputer is employer or worker
    # is done by the contract layer by checking against stored job data.
    #
    # The dispute_reason_hash allows the disputer to keep their reason
    # private while still committing to it. Full details can be revealed
    # off-chain during DAO deliberation.
}
