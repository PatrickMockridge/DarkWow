# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Labor Market Submit Deliverable Circuit - Generic (Version 1)
#
# This circuit proves:
# - Worker knows their secret key
# - Worker public key is correctly derived
# - Worker is submitting a deliverable hash for a specific job
# - The deadline has not passed
#
# This is the GENERIC version: deliverable_hash is the hash of a zip file.
# The actual zip contents are verified off-chain by the employer.
#
# Public Inputs (constrain_instance):
#   - job_id: The job for which work is being delivered
#   - deliverable_hash: Hash of the delivered work (zip hash)
#
# Witnesses:
#   - worker_secret: Worker's secret key
#   - deadline_block: When work was due (for verification)
#   - current_block: Current block height

constant "SubmitDeliverable" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SubmitDeliverable" {
    # Job being completed
    Base job_id,

    # Worker's secret (for key derivation and nullifier)
    Base worker_secret,

    # Time verification (passed as Base to avoid .into() issues)
    Base deadline_block,
    Base current_block,
}

circuit "SubmitDeliverable" {
    # ==========================================================================
    # PHASE 1: Derive worker public key from secret
    # ==========================================================================

    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    worker_pub_x = ec_get_x(worker_pub);
    worker_pub_y = ec_get_y(worker_pub);

    # ==========================================================================
    # PHASE 2: Verify deadline has not passed
    # ==========================================================================
    #
    # less_than_strict: constrains current_block < deadline_block
    # If this fails, the deadline has passed and work is late.
    # The circuit will reject late submissions.

    less_than_strict(current_block, deadline_block);

    # ==========================================================================
    # PHASE 3: Compute nullifier to prevent double-submission
    # ==========================================================================
    #
    # nullifier = H(job_id, worker_secret)
    # This ensures the same worker can't submit multiple times for the same job

    spent_nullifier = poseidon_hash(job_id, worker_secret);

    # ==========================================================================
    # PHASE 4: Expose public inputs
    # ==========================================================================
    #
    # The deliverable_hash is NOT included here - it's part of the job
    # commitment created by the employer. The worker submits the actual
    # hash of their work to the contract, which verifies it matches.
    #
    # This circuit only proves:
    # 1. Worker knows their secret
    # 2. Worker is assigned to this job
    # 3. Deadline hasn't passed
    # 4. Nullifier for double-submission prevention

    constrain_instance(job_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);
    constrain_instance(spent_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The actual deliverable verification (does zip hash match?) is done
    # by the contract layer comparing submitted_hash to job's deliverable_hash.
}
