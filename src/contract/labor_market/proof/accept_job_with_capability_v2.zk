# AcceptJobWithCapability_V2 — domain-separated job acceptance with capability.
# HAZOP fix: expanded from stub. Worker pubkey derivation, nullifier with
# ACCEPT_WITH_CAP_TAG (distinct from plain accept_job), capability_id constrain.
k = 14; field = "pallas";
constant "AcceptJobWithCapabilityV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "AcceptJobWithCapabilityV2" {
    Base job_id,
    Base worker_secret,
    Base worker_pub_x,
    Base worker_pub_y,
    Base capability_id,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "AcceptJobWithCapabilityV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    ACCEPT_WITH_CAP_TAG = witness_base(8);

    # Derive worker pubkey
    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(worker_pub), worker_pub_x);
    constrain_equal_base(ec_get_y(worker_pub), worker_pub_y);

    # Nullifier with distinct tag from plain accept_job
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, ACCEPT_WITH_CAP_TAG, job_id, worker_secret);
    constrain_instance(spent_nullifier);
    constrain_instance(job_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);
    constrain_instance(capability_id);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
