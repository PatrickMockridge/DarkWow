# Dispute_V2 — domain-separated dispute filing.
# HAZOP fix: added disputer pubkey derivation + DISPUTE_TAG in nullifier +
# constrain_instance for job_id, pubkeys, dispute_reason_hash.
k = 14; field = "pallas";
constant "DisputeV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "DisputeV2" {
    Base job_id,
    Base disputer_secret,
    Base disputer_pub_x,
    Base disputer_pub_y,
    Base dispute_reason_hash,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "DisputeV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DISPUTE_TAG = witness_base(9);

    # Derive disputer pubkey
    disputer_pub = ec_mul_base(disputer_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(disputer_pub), disputer_pub_x);
    constrain_equal_base(ec_get_y(disputer_pub), disputer_pub_y);

    # Nullifier with action tag
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, DISPUTE_TAG, job_id, disputer_secret, dispute_reason_hash);
    constrain_instance(spent_nullifier);
    constrain_instance(job_id);
    constrain_instance(disputer_pub_x);
    constrain_instance(disputer_pub_y);
    constrain_instance(dispute_reason_hash);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
