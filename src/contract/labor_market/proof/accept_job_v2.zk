# AcceptJob_V2 — domain-separated job acceptance with full circuit logic.
# HAZOP fix: expanded from stub (was only tx_binding). Now includes worker
# pubkey derivation + constrain_instance for job_id + pubkeys.
k = 14; field = "pallas";
constant "AcceptJobV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "AcceptJobV2" {
    Base job_id,
    Base worker_secret,
    Base worker_pub_x,
    Base worker_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "AcceptJobV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    ACCEPT_TAG = witness_base(7);

    # Derive worker public key from secret
    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(worker_pub);
    derived_pub_y = ec_get_y(worker_pub);
    constrain_equal_base(derived_pub_x, worker_pub_x);
    constrain_equal_base(derived_pub_y, worker_pub_y);

    # Nullifier: unique per (job_id, worker_secret) with action tag
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, ACCEPT_TAG, job_id, worker_secret);
    constrain_instance(spent_nullifier);

    # Public inputs
    constrain_instance(job_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
