# Refund_V2 — domain-separated job refund.
# V2 (HAZOP RC3): domain separation on poseidon_hash
k = 14; field = "pallas";
constant "RefundV2" { EcFixedPointBase NULLIFIER_K, }
witness "RefundV2" { Base job_id, Base employer_secret, Base employer_pub_x, Base employer_pub_y, Base completed_payment, Base refund_amount, Base total_payment, Base tx_commitment, Base tx_nonce, Base tx_binding, }
circuit "RefundV2" { DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3); REFUND_TAG = witness_base(3); range_check(64, completed_payment); range_check(64, refund_amount); range_check(64, total_payment); spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, REFUND_TAG, job_id, employer_secret); constrain_instance(spent_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce); constrain_instance(tx_binding); constrain_instance(tx_nonce); }
