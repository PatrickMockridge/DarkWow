# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Labor Market Submit Git Deliverable Circuit (Version 1)
#
# This circuit proves:
# - Worker knows their secret key
# - Worker public key is correctly derived
# - Worker has a valid claim on the attestation for this job
# - The deadline has not passed
#
# The claim_id references a claim created in the attestation contract.
# The attestation contract handles the actual git commit verification.
#
# Public Inputs (constrain_instance):
#   - job_id: The job for which work is being delivered
#   - claim_id: ID of the attestation claim
#
# Witnesses:
#   - worker_secret: Worker's secret key
#   - deadline_block: When work was due (for verification)
#   - current_block: Current block height

constant "SubmitGitDeliverable" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SubmitGitDeliverable" {
    # Job being completed
    Base job_id,

    # Attestation claim ID
    Base claim_id,

    # Worker's secret (for key derivation and nullifier)
    Base worker_secret,

    # Worker's public key coordinates (public input - must match derived)
    Base worker_pub_x,
    Base worker_pub_y,

    # Time verification (passed as Base to avoid .into() issues)
    Base deadline_block,
    Base current_block,
}

circuit "SubmitGitDeliverable" {
    # ==========================================================================
    # PHASE 1: Derive worker public key from secret
    # ==========================================================================

    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(worker_pub);
    derived_pub_y = ec_get_y(worker_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the worker_secret to the worker_pubkey
    constrain_equal_base(derived_pub_x, worker_pub_x);
    constrain_equal_base(derived_pub_y, worker_pub_y);

    # ==========================================================================
    # PHASE 2: Verify deadline has not passed
    # ==========================================================================
    #
    # Verify: current_block <= deadline_block using less_than_or_equal (0x55)

    ONE = witness_base(1);
    deadline_ok = less_than_or_equal(current_block, deadline_block);
    constrain_equal_base(deadline_ok, ONE);

    # ==========================================================================
    # PHASE 3: Compute nullifier to prevent double-submission
    # ==========================================================================
    #
    # nullifier = H(job_id, worker_secret)
    # This ensures the same worker can't submit multiple times for the same job

    spent_nullifier = poseidon_hash(job_id, worker_secret);

    # ==========================================================================
    # PHASE 4: Expose public inputs
    # ==========================================================================

    constrain_instance(job_id);
    constrain_instance(claim_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);
    constrain_instance(spent_nullifier);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # Git commit verification is handled by the attestation contract via claims.
}
