k = 14;
field = "pallas";

# Labor Market Accept Job With Capability Circuit (Version 1)
#
# This circuit proves:
# - Worker knows their secret key
# - Worker public key is correctly derived
# - Worker has required capability (verified via ZK proof from Identity contract)
# - Worker is accepting a valid job that requires a capability
#
# Public Inputs (constrain_instance):
#   - job_id: The job being accepted
#   - worker_pub_x, worker_pub_y: Worker's public key coordinates
#   - required_capability_id: The capability this job requires
#
# Witnesses:
#   - worker_secret: Worker's secret key
#   - capability_proof: ZK proof from Identity contract (verified off-chain)

constant "AcceptJobWithCapability" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AcceptJobWithCapability" {
    # Job being accepted
    Base job_id,

    # Worker's secret (for key derivation, not revealed)
    Base worker_secret,

    # Worker's public key coordinates (public input - must match derived)
    Base worker_pub_x,
    Base worker_pub_y,

    # Required capability ID for this job
    Base required_capability_id,

    # Capability proof data (from Identity contract's VerifyCapabilityV1)
    Base capability_nullifier,
    Base capability_predicate_result,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AcceptJobWithCapability" {
    # ==========================================================================
    # PHASE 1: Derive worker public key from secret
    # ==========================================================================

    worker_pub = ec_mul_base(worker_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(worker_pub);
    derived_pub_y = ec_get_y(worker_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the worker_secret to the worker_pubkey
    constrain_equal_base(derived_pub_x, worker_pub_x);
    constrain_equal_base(derived_pub_y, worker_pub_y);

    # ==========================================================================
    # PHASE 2: Verify capability predicate result
    # ==========================================================================

    # The capability predicate result should be 1 (satisfied)
    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(job_id);
    constrain_instance(worker_pub_x);
    constrain_instance(worker_pub_y);
    constrain_instance(required_capability_id);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    #
    # The prover proves that:
    # 1. They know the worker's secret key
    # 2. Their public key is correctly derived
    # 3. The capability_predicate_result is 1 (capability satisfied)
    #
    # What this enables:
    # - Worker can accept jobs that require specific capabilities
    # - The capability verification is done via Identity contract
    # - Worker identity is hidden, only capability is proven
    #
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # Soundness: Uses proven opcodes (ec_mul_base, ec_get_x, ec_get_y)
}