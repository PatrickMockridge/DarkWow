# ConfirmDelivery_V2 — domain-separated delivery confirmation.
# HAZOP fix: added employer pubkey derivation + constrain_instance for
# job_id, employer_pub_x, employer_pub_y.
k = 14; field = "pallas";
constant "ConfirmDeliveryV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "ConfirmDeliveryV2" {
    Base job_id,
    Base employer_secret,
    Base employer_pub_x,
    Base employer_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "ConfirmDeliveryV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    CONFIRM_TAG = witness_base(4);

    # Derive employer pubkey
    employer_pub = ec_mul_base(employer_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(employer_pub), employer_pub_x);
    constrain_equal_base(ec_get_y(employer_pub), employer_pub_y);

    # Nullifier with action tag
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, CONFIRM_TAG, job_id, employer_secret);
    constrain_instance(spent_nullifier);
    constrain_instance(job_id);
    constrain_instance(employer_pub_x);
    constrain_instance(employer_pub_y);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
