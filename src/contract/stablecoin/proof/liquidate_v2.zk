# Liquidate_V2 circuit — liquidates an undercollateralized position.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

# No EC constants needed - using Poseidon only
constant "LiquidateV2" {
}

witness "LiquidateV2" {
    # Public inputs
    Base old_commitment,
    Base new_commitment,
    Base position_nullifier,
    Base collateral_amount,
    Base debt_amount,
    Base liquidation_penalty,
    Base current_price,
    Base position_root,

    # Private inputs
    Base owner_secret,
    Base collateral_blind,
    Base debt_blind,
    Base liquidator_reward,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "LiquidateV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Derive owner public key (Poseidon hash, no EC)
    owner_pub = poseidon_hash(DOMAIN_SIGNATURE_SECRET, owner_secret);

    # Verify nullifier matches
    nullifier_check = poseidon_hash(DOMAIN_NULLIFIER, owner_secret, old_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Verify old commitment matches computed
    old_collateral_commit = poseidon_hash(DOMAIN_COIN_COMMIT, collateral_amount, collateral_blind);
    old_debt_commit = poseidon_hash(DOMAIN_COIN_COMMIT, debt_amount, debt_blind);
    old_position = poseidon_hash(DOMAIN_COIN_COMMIT, old_collateral_commit, old_debt_commit, owner_pub);
    constrain_equal_base(old_position, old_commitment);

    # Calculate new_collateral after liquidation (collateral seized)
    new_collateral = base_sub(collateral_amount, liquidator_reward);
    # bool_check removed (RC1-A)

    # Verify new commitment after liquidation
    new_collateral_commit = poseidon_hash(DOMAIN_COIN_COMMIT, new_collateral, collateral_blind);
    new_debt_commit = poseidon_hash(DOMAIN_COIN_COMMIT, debt_amount, debt_blind);
    new_position = poseidon_hash(DOMAIN_COIN_COMMIT, new_collateral_commit, new_debt_commit, owner_pub);
    constrain_equal_base(new_position, new_commitment);

    # Calculate if position is undercollateralized
    debt_value = base_mul(debt_amount, current_price);
    collateral_value = base_mul(collateral_amount, witness_base(10000));

    # HAZOP CRIT-2 FIX: Verify position is actually undercollateralized in-circuit.
    LIQ_THRESHOLD = witness_base(15000);
    threshold_debt = base_mul(debt_value, LIQ_THRESHOLD);
    ONE = witness_base(1);
    collat_plus_one = base_add(collateral_value, ONE);
    is_undercollateralized = less_than_or_equal(collat_plus_one, threshold_debt);
    constrain_equal_base(is_undercollateralized, ONE);

    # Range proofs (64-bit values)
    range_check(64, collateral_amount);
    range_check(64, debt_amount);
    range_check(64, liquidator_reward);

    # liquidator_reward <= collateral_amount
    ONE = witness_base(1);
    is_lte = less_than_or_equal(liquidator_reward, collateral_amount);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_equal_base(is_lte, ONE);
}
