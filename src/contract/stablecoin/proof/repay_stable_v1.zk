k = 11;
field = "pallas";

# RepayStableV1 circuit - repays stablecoin debt against a CDP position
# Proves: position exists, debt reduced by repay amount, still collateralized
# Note: This circuit handles the debt side; the actual stablecoin burn happens via promissory_note child call

constant "RepayStableV1" {
}

witness "RepayStableV1" {
    # Public inputs
    Base position_commitment,    # New position commitment after debt repayment
    Base owner_pub,              # Poseidon hash of owner_secret
    Base collateral_type,        # Collateral type (Xmr=0, Drk=1, Eth=2)
    Base position_nullifier,     # Nullifier for the position
    Base position_root,          # Merkle root for position proof
    Base leaf_index,             # Position of leaf in Merkle tree

    # Private inputs
    Base owner_secret,           # Owner's secret key
    Base old_collateral,         # Current collateral amount (unchanged in repay)
    Base old_debt,               # Previous debt amount
    Base repaid_debt,            # Amount of debt being repaid
    Base collateral_blind,       # Blind factor for collateral commitment (reuse)
    Base debt_blind,             # Blind factor for new debt commitment
    Base merkle_proof_0,        # Merkle proof path element 0
    Base merkle_proof_1,        # Merkle proof path element 1
    Base merkle_proof_2,        # Merkle proof path element 2
    Base merkle_proof_3,         # Merkle proof path element 3
}

circuit "RepayStableV1" {
    # Verify owner public key derived from secret
    owner_pub_check = poseidon_hash(owner_secret);
    constrain_equal_base(owner_pub_check, owner_pub);

    # Compute new total debt after repayment
    new_debt = base_sub(old_debt, repaid_debt);

    # Range check on new debt (64-bit)
    range_check(64, new_debt);
    bool_check(new_debt);

    # Range check on repaid amount
    range_check(64, repaid_debt);
    bool_check(repaid_debt);

    # Verify repayment doesn't exceed existing debt
    # repaid_debt <= old_debt (implicit in subtraction)

    # Create Poseidon commitments for collateral (unchanged) and new debt
    # collateral_commit = poseidon_hash(old_collateral, collateral_blind) - unchanged
    collateral_commit = poseidon_hash(old_collateral, collateral_blind);

    # debt_commit = poseidon_hash(new_debt, debt_blind)
    debt_commit = poseidon_hash(new_debt, debt_blind);

    # Verify position commitment matches computed values
    position_check = poseidon_hash(
        collateral_commit,
        debt_commit,
        owner_pub,
        collateral_type
    );
    constrain_instance(position_check);
    constrain_equal_base(position_check, position_commitment);

    # Derive and verify nullifier for this position
    # nullifier = poseidon_hash(owner_secret, position_commitment)
    nullifier_check = poseidon_hash(owner_secret, position_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Collateralization check: old_collateral >= 2 * new_debt (200% minimum)
    # Note: collateral unchanged, debt reduced, so collateralization improves
    two_times_debt = base_add(new_debt, new_debt);
    range_check(64, two_times_debt);
    ONE = witness_base(1);
    is_lte = less_than_or_equal(two_times_debt, old_collateral);
    constrain_equal_base(is_lte, ONE);
}