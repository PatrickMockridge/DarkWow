k = 11;
field = "pallas";

# No EC constants needed - using Poseidon only
constant "OpenPositionV1" {
}

witness "OpenPositionV1" {
    # Public inputs
    Base position_commitment,
    Base owner_pub,         # Poseidon hash of owner_secret (as field element, not EC point)
    Base collateral_type,
    Base position_nullifier,
    Base position_root,
    Base leaf_index,

    # Private inputs
    Base owner_secret,
    Base collateral_amount,
    Base debt_amount,
    Base collateral_blind,
    Base debt_blind,
    Base merkle_proof_0,
    Base merkle_proof_1,
    Base merkle_proof_2,
    Base merkle_proof_3,
    Base tx_commitment,
}

circuit "OpenPositionV1" {
    # Derive owner public key from secret using Poseidon (no EC)
    # owner_pub = poseidon_hash(owner_secret) as a field element
    owner_pub_check = poseidon_hash(owner_secret);
    constrain_equal_base(owner_pub_check, owner_pub);

    # Create Poseidon commitments for collateral and debt (no Pedersen, no EC)
    # collateral_commit = poseidon_hash(collateral_amount, collateral_blind)
    collateral_commit = poseidon_hash(collateral_amount, collateral_blind);

    # debt_commit = poseidon_hash(debt_amount, debt_blind)
    debt_commit = poseidon_hash(debt_amount, debt_blind);

    # Position commitment = Poseidon hash of all components
    # H(collateral_commit, debt_commit, owner_pub, collateral_type)
    position_check = poseidon_hash(
        collateral_commit,
        debt_commit,
        owner_pub,
        collateral_type
    );
    constrain_instance(position_check);
    constrain_equal_base(position_check, position_commitment);

    # Derive nullifier for this position
    # nullifier = poseidon_hash(owner_secret, position_commitment)
    nullifier_check = poseidon_hash(owner_secret, position_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Range checks for amounts (64-bit values)
    range_check(64, collateral_amount);
    range_check(64, debt_amount);
    bool_check(collateral_amount);
    bool_check(debt_amount);

    # Collateralization check: collateral >= 2 * debt (200% minimum collateralization)
    # Using verified LessThanOrEqual
    two_times_debt = base_add(debt_amount, debt_amount);
    range_check(64, two_times_debt);
    ONE = witness_base(1);
    is_lte = less_than_or_equal(two_times_debt, collateral_amount);
    constrain_instance(tx_commitment);
    constrain_equal_base(is_lte, ONE);
}