k = 11;
field = "pallas";

constant "OpenPositionV1" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPoint VALUE_COMMIT,
    EcFixedPoint RANDOM_COMMIT,
}

witness "OpenPositionV1" {
    # Public inputs
    Base position_commitment,
    Base owner_pub_x,
    Base owner_pub_y,
    Base collateral_type,
    Base position_nullifier,
    Base position_root,
    Base leaf_index,

    # Private inputs
    Base owner_secret,
    Base collateral_amount,
    Base debt_amount,
    Base collateral_blind,
    Base debt_blind,
    Base merkle_proof_0,
    Base merkle_proof_1,
    Base merkle_proof_2,
    Base merkle_proof_3,
}

circuit "OpenPositionV1" {
    # Derive owner public key from secret
    owner_public = ec_mul_base(owner_secret, NULLIFIER_K);
    owner_public_x = ec_get_x(owner_public);
    owner_public_y = ec_get_y(owner_public);
    constrain_equal_base(owner_public_x, owner_pub_x);
    constrain_equal_base(owner_public_y, owner_pub_y);

    # Derive nullifier for this position
    nullifier_check = poseidon_hash(owner_secret, position_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Create Pedersen commitments for collateral and debt
    # NOTE: ec_mul_short, ec_add are custom opcodes (not standard in zkVM)
    collateral_commit = ec_mul_short(collateral_amount, VALUE_COMMIT);
    collateral_random = ec_mul(collateral_blind, RANDOM_COMMIT);
    collateral_total = ec_add(collateral_commit, collateral_random);
    collateral_x = ec_get_x(collateral_total);
    collateral_y = ec_get_y(collateral_total);

    debt_commit = ec_mul_short(debt_amount, VALUE_COMMIT);
    debt_random = ec_mul(debt_blind, RANDOM_COMMIT);
    debt_total = ec_add(debt_commit, debt_random);
    debt_x = ec_get_x(debt_total);
    debt_y = ec_get_y(debt_total);

    # Position commitment = H(collateral_x, collateral_y, debt_x, debt_y, owner_pub)
    position_check = poseidon_hash(
        collateral_x,
        collateral_y,
        debt_x,
        debt_y,
        owner_pub_x,
        owner_pub_y,
    );
    constrain_instance(position_check);
    constrain_equal_base(position_check, position_commitment);

    # Range checks for amounts
    range_check(64, collateral_amount);
    range_check(64, debt_amount);
    bool_check(collateral_amount);
    bool_check(debt_amount);

    # NOTE: Collateralization ratio check (collateral >= 2 * debt) requires
    # LessThanOrEqual opcode. See doc/src/zkas/bincode.md "Reasoned Opcodes".
}