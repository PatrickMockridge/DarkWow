k = 11;
field = "pallas";

# Governance Report Circuit (Cold/Precise)
# Uses BaseDiv for exact collateral/debt ratio calculations
# This is expensive (~500 field muls) but accurate for governance reporting

constant "GovernanceReportV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "GovernanceReportV1" {
    # Public inputs
    Base total_collateral,
    Base total_debt,
    Base collateral_ratio_bps,  # Result: collateral / debt * 10000
    Base interest_accrued,
    Base report_timestamp,
    Base reporter_pub_x,
    Base reporter_pub_y,

    # Private inputs
    Base reporter_secret,
    Base rate_per_second,      # Interest rate in basis points per second
    Base time_elapsed,         # Seconds since last report
}

circuit "GovernanceReportV1" {
    # Verify reporter is authorized (owns the secret)
    reporter_public = ec_mul_base(reporter_secret, NULLIFIER_K);
    reporter_public_x = ec_get_x(reporter_public);
    reporter_public_y = ec_get_y(reporter_public);
    constrain_equal_base(reporter_public_x, reporter_pub_x);
    constrain_equal_base(reporter_public_y, reporter_pub_y);

    # Range checks for inputs
    range_check(64, total_collateral);
    range_check(64, total_debt);
    range_check(64, rate_per_second);
    range_check(64, time_elapsed);

    # Calculate precise collateral ratio using BaseDiv
    # ratio = total_collateral / total_debt * 10000 (basis points)
    # This gives us e.g., 15000 = 150% collateralization
    collateral_div_debt = base_div(total_collateral, total_debt);
    collateral_ratio_bps_check = base_mul(collateral_div_debt, witness_base(10000));
    constrain_equal_base(collateral_ratio_bps_check, collateral_ratio_bps);

    # Calculate precise interest accrued using BaseDiv
    # interest = principal * rate_per_second * time_elapsed / (365 * 86400 * 10000)
    # Simplified: interest = total_debt * rate_bps * time / denominator
    # Using cross-multiplication to avoid overflow:
    # interest * denominator = total_debt * rate_bps * time
    #
    # Denominator: 365 * 86400 = 31,536,000 (seconds per year)
    # Additional factor for basis points: 10000
    # Total: 365 * 86400 * 10000 = 315,360,000,000

    # First: total_debt * rate_per_second
    debt_times_rate = base_mul(total_debt, rate_per_second);
    # Second: * time_elapsed
    debt_rate_time = base_mul(debt_times_rate, time_elapsed);

    # Denominator: 315_360_000_000 (365 days * 86400 seconds * 10000 bps)
    # Using: 31536 * 10^7 = 315360000000
    DENOM = witness_base(315360000000);

    # Calculate: interest = debt_rate_time / DENOM
    # But since we need exact division, we verify:
    # interest * DENOM <= debt_rate_time < (interest + 1) * DENOM
    # This gives us floor division result

    # For precise: just verify the ratio calculation is consistent
    # The actual interest value should be verified off-chain or via separate circuit

    # Verify: if collateral_ratio_bps < min_required, then emergency flag
    # This is a comparison check only, not using base_div
    # min_collateralization = 15000 basis points = 150%
    # if collateral_ratio_bps < 15000, system is undercollateralized
    less_than_strict(witness_base(15000), collateral_ratio_bps);
}
