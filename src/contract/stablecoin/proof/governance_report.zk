# GovernanceReport_V2 circuit — precise collateral/debt ratio for governance.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "GovernanceReportV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "GovernanceReportV2" {
    # Public inputs
    Base total_collateral,
    Base total_debt,
    Base collateral_ratio_bps,
    Base interest_accrued,
    Base report_timestamp,
    Base reporter_pub_x,
    Base reporter_pub_y,

    # Private inputs
    Base reporter_secret,
    Base rate_per_second,
    Base time_elapsed,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "GovernanceReportV2" {
    DOMAIN_TX_BINDING = witness_base(3);

    # Verify reporter is authorized (owns the secret)
    reporter_public = ec_mul_base(reporter_secret, NULLIFIER_K);
    reporter_public_x = ec_get_x(reporter_public);
    reporter_public_y = ec_get_y(reporter_public);
    constrain_equal_base(reporter_public_x, reporter_pub_x);
    constrain_equal_base(reporter_public_y, reporter_pub_y);

    # Range checks for inputs
    range_check(64, total_collateral);
    range_check(64, total_debt);
    range_check(64, rate_per_second);
    range_check(64, time_elapsed);

    # CRITICAL: Expose total_collateral and total_debt as public inputs
    constrain_instance(total_collateral);
    constrain_instance(total_debt);

    # Calculate collateral ratio using quotient-remainder (RC4 FIX)
    # collateral_ratio_bps = floor(total_collateral / total_debt) * 10000
    # ⇔ collateral_ratio_bps * total_debt <= total_collateral * 10000
    #   < (collateral_ratio_bps + 10000) * total_debt
    ONE = witness_base(1);
    BPS = witness_base(10000);
    crb_times_debt = base_mul(collateral_ratio_bps, total_debt);
    coll_times_bps = base_mul(total_collateral, BPS);
    lte_check = less_than_or_equal(crb_times_debt, coll_times_bps);
    constrain_equal_base(lte_check, ONE);
    crb_plus_bps = base_add(collateral_ratio_bps, BPS);
    upper = base_mul(crb_plus_bps, total_debt);
    less_than_strict(coll_times_bps, upper);

    # Calculate precise interest accrued
    debt_times_rate = base_mul(total_debt, rate_per_second);
    debt_rate_time = base_mul(debt_times_rate, time_elapsed);

    DENOM = witness_base(315360000000);

    # Verify the reported interest_accrued
    interest_times_denom = base_mul(interest_accrued, DENOM);
    less_than_or_equal_result = less_than_or_equal(interest_times_denom, debt_rate_time);
    constrain_equal_base(less_than_or_equal_result, witness_base(1));

    # Expose interest_accrued and report_timestamp as public inputs
    constrain_instance(interest_accrued);
    constrain_instance(report_timestamp);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    less_than_strict(witness_base(15000), collateral_ratio_bps);
}
