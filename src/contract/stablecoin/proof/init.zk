# Init_V2 circuit — domain-separated initialization authorization.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "InitV2" {
}

witness "InitV2" {
    Base deployer_secret,
    Base contract_salt,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "InitV2" {
    DOMAIN_SIGNATURE_SECRET = witness_base(7);
    DOMAIN_TX_BINDING = witness_base(3);

    # Derive deployer authorization from secret
    deployer_auth = poseidon_hash(DOMAIN_SIGNATURE_SECRET, deployer_secret, contract_salt);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(deployer_auth);
}
