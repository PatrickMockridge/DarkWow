k = 11;
field = "pallas";

constant "MintStableV1" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "MintStableV1" {
    # Public inputs
    Base old_commitment,
    Base new_commitment,
    Base position_nullifier,
    Base mint_amount,
    Base position_root,

    # Private inputs
    Base owner_secret,
    Base old_collateral,
    Base old_debt,
    Base new_collateral,
    Base new_debt,
    Scalar collateral_blind,
    Scalar debt_blind,
}

circuit "MintStableV1" {
    # Verify nullifier matches
    nullifier_check = poseidon_hash(owner_secret, old_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Verify new debt is old debt + mint_amount
    # base_add exists in zkVM (opcode 0x30)
    mint_check = base_add(old_debt, mint_amount);
    constrain_equal_base(mint_check, new_debt);

    # Verify collateral unchanged (for simple minting)
    constrain_equal_base(old_collateral, new_collateral);

    # New commitment verification
    # Pedersen commitment: C = value * G + blind * H
    collateral_commit = ec_mul_short(new_collateral, VALUE_COMMIT_VALUE);
    collateral_random = ec_mul(collateral_blind, VALUE_COMMIT_RANDOM);
    collateral_total = ec_add(collateral_commit, collateral_random);
    collateral_x = ec_get_x(collateral_total);

    debt_commit = ec_mul_short(new_debt, VALUE_COMMIT_VALUE);
    debt_random = ec_mul(debt_blind, VALUE_COMMIT_RANDOM);
    debt_total = ec_add(debt_commit, debt_random);
    debt_x = ec_get_x(debt_total);

    # Range check for mint_amount
    range_check(64, mint_amount);
    bool_check(mint_amount);

    # Mint amount must be positive (handled by range_check above)
    # The contract should verify: new_debt >= old_debt (debt can only increase)
}