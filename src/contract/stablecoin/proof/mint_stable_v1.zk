k = 11;
field = "pallas";

constant "MintStableV1" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPoint VALUE_COMMIT,
    EcFixedPoint RANDOM_COMMIT,
}

witness "MintStableV1" {
    # Public inputs
    Base old_commitment,
    Base new_commitment,
    Base position_nullifier,
    Base mint_amount,
    Base position_root,

    # Private inputs
    Base owner_secret,
    Base old_collateral,
    Base old_debt,
    Base new_collateral,
    Base new_debt,
    Base collateral_blind,
    Base debt_blind,
}

circuit "MintStableV1" {
    # Verify nullifier matches
    nullifier_check = poseidon_hash(owner_secret, old_commitment);
    constrain_instance(nullifier_check);
    assert_equal(nullifier_check, position_nullifier);

    # Verify new debt is old debt + mint_amount
    one = witness_base(1);
    mint_check = base_add(old_debt, mint_amount);
    assert_equal(mint_check, new_debt);

    # Verify collateral unchanged (for simple minting)
    assert_equal(old_collateral, new_collateral);

    # New commitment verification
    collateral_commit = ec_mul_short(new_collateral, VALUE_COMMIT);
    collateral_random = ec_mul(collateral_blind, RANDOM_COMMIT);
    collateral_total = ec_add(collateral_commit, collateral_random);
    collateral_x = ec_get_x(collateral_total);

    debt_commit = ec_mul_short(new_debt, VALUE_COMMIT);
    debt_random = ec_mul(debt_blind, RANDOM_COMMIT);
    debt_total = ec_add(debt_commit, debt_random);
    debt_x = ec_get_x(debt_total);

    # Verify mint_amount is positive
    assert(mint_amount > 0);
    assert(mint_amount < 2^64);
}