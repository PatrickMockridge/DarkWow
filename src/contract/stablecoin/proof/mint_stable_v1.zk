k = 11;
field = "pallas";

# No EC constants needed - using Poseidon only
constant "MintStableV1" {
}

witness "MintStableV1" {
    # Public inputs
    Base old_commitment,
    Base new_commitment,
    Base position_nullifier,
    Base mint_amount,
    Base position_root,

    # Private inputs
    Base owner_secret,
    Base old_collateral,
    Base old_debt,
    Base new_collateral,
    Base new_debt,
    Base collateral_blind,
    Base debt_blind,
    Base tx_commitment,
}

circuit "MintStableV1" {
    # Derive owner public key (Poseidon hash, no EC)
    owner_pub = poseidon_hash(owner_secret);

    # Verify nullifier matches
    nullifier_check = poseidon_hash(owner_secret, old_commitment);
    constrain_instance(nullifier_check);
    constrain_equal_base(nullifier_check, position_nullifier);

    # Verify new debt is old debt + mint_amount
    mint_check = base_add(old_debt, mint_amount);
    constrain_equal_base(mint_check, new_debt);

    # Verify collateral unchanged (for simple minting)
    constrain_equal_base(old_collateral, new_collateral);

    # New commitment verification using Poseidon (no Pedersen, no EC)
    # old_commitment = poseidon_hash(old_collateral, old_debt, owner_pub, collateral_blind, debt_blind)
    # But we just need to verify transition: old → new

    # Compute old commitment components
    old_collateral_commit = poseidon_hash(old_collateral, collateral_blind);
    old_debt_commit = poseidon_hash(old_debt, debt_blind);
    old_position = poseidon_hash(old_collateral_commit, old_debt_commit, owner_pub);
    constrain_equal_base(old_position, old_commitment);

    # Compute new commitment components
    new_collateral_commit = poseidon_hash(new_collateral, collateral_blind);
    new_debt_commit = poseidon_hash(new_debt, debt_blind);
    new_position = poseidon_hash(new_collateral_commit, new_debt_commit, owner_pub);
    constrain_equal_base(new_position, new_commitment);

    # Range check for mint_amount
    range_check(64, mint_amount);
    bool_check(mint_amount);

    # Mint amount must be positive (handled by range_check above)
    constrain_instance(tx_commitment);
    # The contract should verify: new_debt >= old_debt (debt can only increase)
}