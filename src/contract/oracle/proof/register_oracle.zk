# The k parameter defining the number of rows used in our circuit (2^k)
k = 13;
field = "pallas";

# register_oracle_V2 — domain-separated circuit.

# Oracle Register Circuit
#
# This circuit proves that the registrant knows the operator secret behind the
# commitment it is registering.
#
# Public Inputs (constrain_instance):
#   - oracle_id: The oracle being registered
#   - oracle_commitment: H(DOMAIN_OPERATOR_COMMITMENT, oracle_secret, oracle_id)
#
# Witnesses:
#   - oracle_secret: Oracle operator's secret key

constant "RegisterOracleV2" {
}

witness "RegisterOracleV2" {
    # Oracle operator's secret (for the commitment, not revealed)
    Base oracle_secret,

    # Oracle ID being registered
    Base oracle_id,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "RegisterOracleV2" {
    DOMAIN_TX_BINDING = witness_base(1);
    # The operator commitment has its OWN domain rather than the generic DOMAIN_COMMITMENT.
    # Sharing one made `oracle_commitment` constructibly equal to any other three-argument hash
    # over prover-chosen elements in the same circuit (OBL-Z19, inherited from OBL-Z9). The value
    # is registered on chain and compared on every later operation, so it MUST be identical in all
    # six oracle circuits and in the client's `compute_commitment()`.
    DOMAIN_OPERATOR_COMMITMENT = witness_base(8);

    # ==========================================================================
    # PHASE 1: The registered identity is a HIDING COMMITMENT to the secret
    # ==========================================================================
    #
    # This used to be `oracle_pub = ec_mul_base(oracle_secret, NULLIFIER_K)` with the point's
    # coordinates exposed as the registration record. That disclosed a static public key — the
    # anti-pattern this design exists to prevent (see "no static key, in or out" in
    # doc/src/arch/verification-hazop.md) — and it authorized nothing, because every later
    # circuit compared a derived point against an unexposed witness.
    #
    # Nothing static is disclosed here: the commitment is hiding, and only the holder of
    # `oracle_secret` can open it. The host stores it and every later operation proves the same
    # opening.

    oracle_commitment = poseidon_hash(DOMAIN_OPERATOR_COMMITMENT, oracle_secret, oracle_id);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_id);
    constrain_instance(oracle_commitment);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
