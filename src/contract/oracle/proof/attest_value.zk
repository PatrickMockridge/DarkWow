# The k parameter defining the number of rows used in our circuit (2^k)
k = 13;
field = "pallas";

# attest_value_V2 — domain-separated circuit.

# Oracle Attest Value Circuit
#
# This circuit proves:
# - The prover knows the operator secret behind the registered commitment
# - The attestation's nullifier is derived from that same secret
# - Attestation is being created for a valid oracle
#
# Public Inputs (constrain_instance):
#   - oracle_id: The oracle being attested
#   - oracle_commitment: The registered operator commitment, re-derived in-circuit
#   - attestation_id: ID of the attestation to be created
#   - predicate: Predicate type (0=Matches, 1=GreaterOrEqual, 2=LessOrEqual)
#   - threshold: Threshold value for comparison predicates
#   - nullifier: H(DOMAIN_NULLIFIER, oracle_secret, oracle_id, attestation_id)
#
# Witnesses:
#   - oracle_secret: Oracle operator's secret key

constant "AttestValueV2" {
}

witness "AttestValueV2" {
    # Oracle ID being attested
    Base oracle_id,

    # Attestation ID to be created
    Base attestation_id,

    # Oracle operator's secret (for the commitment and the nullifier)
    Base oracle_secret,

    # Predicate type
    Base predicate,

    # Threshold for comparison
    Base threshold,

    # Current value being attested
    Base value,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AttestValueV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_OPERATOR_COMMITMENT = witness_base(4);
    DOMAIN_NULLIFIER = witness_base(1);

    # ==========================================================================
    # PHASE 1: Authorize — re-derive the registered operator commitment
    # ==========================================================================
    #
    # The previous revision compared `ec_get_x(ec_mul_base(oracle_secret, NULLIFIER_K))` against
    # `oracle_pub_x`, a witness it never exposed — an equality between two prover-chosen values
    # that holds for any secret (OBL-Z9). See push_value.zk for the full note.

    oracle_commitment = poseidon_hash(DOMAIN_OPERATOR_COMMITMENT, oracle_secret, oracle_id);

    # ==========================================================================
    # PHASE 2: The operation's nullifier
    # ==========================================================================
    #
    # Bound to `attestation_id` — the identity of the operation. `value` is a witness here and is
    # not exposed, so the attestation's own id is what distinguishes one attestation from another;
    # a given id can be attested once, which is what an id is for.

    nullifier = poseidon_hash(DOMAIN_NULLIFIER, oracle_secret, oracle_id, attestation_id);

    # ==========================================================================
    # PHASE 3: Predicate logic
    # ==========================================================================
    #
    # predicate = 0: value == threshold (Matches)
    # predicate = 1: value >= threshold (GreaterOrEqual)
    # predicate = 2: value <= threshold (LessOrEqual)
    #
    # Note: Actual predicate verification is done by the attestation contract.
    # This circuit only proves the oracle operator is creating the attestation.

    # ==========================================================================
    # PHASE 4: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_id);
    constrain_instance(oracle_commitment);
    constrain_instance(attestation_id);
    constrain_instance(predicate);
    constrain_instance(threshold);
    constrain_instance(nullifier);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
