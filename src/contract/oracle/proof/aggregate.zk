# The k parameter defining the number of rows used in our circuit (2^k)
k = 13;
field = "pallas";

# aggregate_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Oracle Aggregate Circuit (Version 1)
#
# This circuit computes a weighted average from multiple revealed commitments.
#
# The aggregation formula is: result = sum(value_i * weight_i) / sum(weight_i)
#
# This circuit verifies:
# 1. The weighted average is computed correctly, as an exact integer division
# 2. The result is within acceptable bounds
#
# Note: This circuit operates on REVEALED commitments. The actual values
# are revealed on-chain when commitments are opened. This circuit then
# computes the aggregated result from those revealed values.
#
# Public Inputs (constrain_instance):
#   - oracle_id: The oracle being aggregated
#   - result: The computed weighted average result
#   - min_result: Minimum acceptable aggregated value
#   - max_result: Maximum acceptable aggregated value
#
# Witnesses:
#   - values: Array of revealed data point values
#   - weights: Array of weights for each value
#   - sum_weights: Sum of all weights (for verification)

constant "AggregateV2" {
}

witness "AggregateV2" {
    # Oracle ID being aggregated
    Base oracle_id,

    # Revealed data point values (from opened commitments)
    Base value_0,
    Base value_1,
    Base value_2,
    Base value_3,

    # Weights for each value
    Base weight_0,
    Base weight_1,
    Base weight_2,
    Base weight_3,

    # Sum of weights (prover claims this is sum of weight_i)
    Base sum_weights,

    # Computed weighted average result
    Base result,

    # Bounds for the result
    Base min_result,
    Base max_result,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AggregateV2" {
    DOMAIN_TX_BINDING = witness_base(3);

    ZERO = witness_base(0);
    ONE = witness_base(1);

    # Every operand that enters a multiplication or a comparison is range-checked, so no product
    # can wrap the field. This is load-bearing rather than decorative: the comparison chip is 253
    # bits wide and range-checks its *offset*, never its operands, so an unbounded `result` or
    # `sum_weights` would let a prover satisfy the quotient-remainder below with a `result` whose
    # products wrap modulo p — a fabricated aggregate, not an extreme one. With every operand
    # `< 2^64` the sums are `< 2^66` and the products are `< 2^130 < 2^253`, so the field
    # comparisons are integer comparisons.
    range_check(64, value_0);
    range_check(64, value_1);
    range_check(64, value_2);
    range_check(64, value_3);
    range_check(64, weight_0);
    range_check(64, weight_1);
    range_check(64, weight_2);
    range_check(64, weight_3);
    range_check(64, sum_weights);
    range_check(64, result);
    range_check(64, min_result);
    range_check(64, max_result);

    # ==========================================================================
    # PHASE 1: Compute weighted sum
    # ==========================================================================
    #
    # weighted_sum = sum(value_i * weight_i)

    weighted_0 = base_mul(value_0, weight_0);
    weighted_1 = base_mul(value_1, weight_1);
    weighted_2 = base_mul(value_2, weight_2);
    weighted_3 = base_mul(value_3, weight_3);

    weighted_sum_0 = base_add(weighted_0, weighted_1);
    weighted_sum_1 = base_add(weighted_2, weighted_3);
    weighted_sum = base_add(weighted_sum_0, weighted_sum_1);

    # ==========================================================================
    # PHASE 2: Compute sum of weights
    # ==========================================================================
    #
    # claimed_sum = sum(weight_i)

    claimed_sum_0 = base_add(weight_0, weight_1);
    claimed_sum_1 = base_add(weight_2, weight_3);
    claimed_sum = base_add(claimed_sum_0, claimed_sum_1);

    # Verify the sum of weights matches what the prover claims
    constrain_equal_base(claimed_sum, sum_weights);

    # ==========================================================================
    # PHASE 3: Compute the weighted average as an exact integer division
    # ==========================================================================
    #
    # result = floor(weighted_sum / sum_weights)
    #   ⇔  result * sum_weights <= weighted_sum < (result + 1) * sum_weights

    # The denominator is positive. With the `+ 1` below this is already unsatisfiable at
    # sum_weights = 0 — the upper bound would be 0 and no non-negative weighted_sum is below it —
    # but the check is stated rather than left emergent, because "the contract checks it" was the
    # circuit's previous answer and the contract does not (`aggregate_v1` checks only
    # `min_result <= result <= max_result`).
    less_than_strict(ZERO, sum_weights);

    res_times_sum = base_mul(result, sum_weights);
    lte_check = less_than_or_equal(res_times_sum, weighted_sum);
    constrain_equal_base(lte_check, ONE);
    res_plus_one = base_add(result, ONE);
    upper = base_mul(res_plus_one, sum_weights);
    less_than_strict(weighted_sum, upper);

    # ==========================================================================
    # PHASE 4: Verify result is within bounds
    # ==========================================================================
    #
    # The result must satisfy: min_result <= result <= max_result
    # This prevents extreme values from affecting the oracle

    # Check result >= min_result: result - min_result >= 0
    # We verify this by checking (result - min_result) is non-negative
    # In the field, we can't directly check ">= 0", so we use bounds

    # Check result <= max_result: max_result - result >= 0
    diff_max = base_sub(max_result, result);
    # HAZOP CRIT-4 FIX: Enforce diff_max is non-negative by requiring it to
    # fit in 64 bits. If result > max_result, the field subtraction wraps to
    # p - (result - max_result) ~ 2^254, which fails range_check(64).
    range_check(64, diff_max);

    # Check result >= min_result: result - min_result >= 0
    diff_min = base_sub(result, min_result);
    range_check(64, diff_min);

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_id);
    constrain_instance(result);
    constrain_instance(min_result);
    constrain_instance(max_result);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses:
    #   - base_mul / base_add / base_sub: field arithmetic
    #   - range_check: the operand bound that makes the comparisons integer comparisons
    #   - constrain_equal_base: equality constraints
    #   - constrain_instance: public input exposure
    #
    # It does NOT use `base_div` (opcode 0x58). An earlier revision did, and an earlier revision
    # still carried a comment saying so after the code had already been replaced by the
    # quotient-remainder above. Field division and integer division are different functions: the
    # former is `a * b^(p-2) mod p`, which for the values here is a number near p rather than a
    # small quotient, so a reader who believed the comment would have been reasoning about a
    # computation that was not happening.
    #
    # Security considerations:
    # - Division by zero: `sum_weights > 0` is enforced in-circuit (PHASE 3).
    # - Bounds checking: `min_result <= result <= max_result` is enforced in-circuit (PHASE 4), by
    #   requiring each difference to fit in 64 bits — a difference that wrapped is ~2^254 and fails.
    # - Operand bounds: every operand is `range_check(64)`ed, without which PHASE 3 and PHASE 4
    #   are satisfiable by wrapping (PHASE 1, and the note there).
    #
    # Limitations:
    # - This circuit assumes exactly 4 values (fixed-size input)
    # - For production, consider a loop-based approach or multiple circuits
    #
    # WHAT IS STILL OPEN, and is a host question rather than a circuit one: the four `value_i` and
    # the four `weight_i` are prover-chosen. The circuit proves that `result` is their weighted
    # average and that it lies in `[min_result, max_result]`, all four of which the prover also
    # chooses. Nothing ties a value or a weight to a revealed commitment, so an oracle operator can
    # publish any aggregate at all. See OBL-Z1 in `doc/src/arch/verification-hazop.md`.
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}