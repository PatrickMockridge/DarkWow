# The k parameter defining the number of rows used in our circuit (2^k)
k = 10;
field = "pallas";

# Oracle Register Circuit (Version 1)
#
# This circuit proves:
# - Oracle operator knows their secret key
# - Oracle public key is correctly derived
#
# Public Inputs (constrain_instance):
#   - oracle_pub_x: Oracle operator's public key x coordinate
#   - oracle_pub_y: Oracle operator's public key y coordinate
#
# Witnesses:
#   - oracle_secret: Oracle operator's secret key

constant "RegisterOracle" {
    EcFixedPointBase NULLIFIER_K,
}

witness "RegisterOracle" {
    # Oracle operator's secret (for key derivation, not revealed)
    Base oracle_secret,
}

circuit "RegisterOracle" {
    # ==========================================================================
    # PHASE 1: Derive oracle public key from secret
    # ==========================================================================

    oracle_pub = ec_mul_base(oracle_secret, NULLIFIER_K);
    oracle_pub_x = ec_get_x(oracle_pub);
    oracle_pub_y = ec_get_y(oracle_pub);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_pub_x);
    constrain_instance(oracle_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_instance: public input exposure
    #
    # The oracle registration data (name, type) is stored by the contract.
    # The ZK proof only establishes that the operator knows their secret.
}
