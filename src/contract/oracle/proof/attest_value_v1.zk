# The k parameter defining the number of rows used in our circuit (2^k)
k = 10;
field = "pallas";

# Oracle Attest Value Circuit (Version 1)
#
# This circuit proves:
# - Oracle operator knows their secret key
# - Oracle public key matches the registered oracle
# - Attestation is being created for a valid oracle value
#
# Public Inputs (constrain_instance):
#   - oracle_id: The oracle being attested
#   - attestation_id: ID of the attestation to be created
#   - predicate: Predicate type (0=Matches, 1=GreaterOrEqual, 2=LessOrEqual)
#   - threshold: Threshold value for comparison predicates
#
# Witnesses:
#   - oracle_secret: Oracle operator's secret key
#   - oracle_pub_x: Registered oracle's public key x coordinate
#   - oracle_pub_y: Registered oracle's public key y coordinate
#   - value: Current value being attested

constant "AttestValue" {
    EcFixedPointBase NULLIFIER_K,
}

witness "AttestValue" {
    # Oracle ID being attested
    Base oracle_id,

    # Attestation ID to be created
    Base attestation_id,

    # Oracle operator's secret (for key derivation)
    Base oracle_secret,

    # Oracle's public key coordinates (registered)
    Base oracle_pub_x,
    Base oracle_pub_y,

    # Predicate type
    Base predicate,

    # Threshold for comparison
    Base threshold,

    # Current value being attested
    Base value,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "AttestValue" {
    # ==========================================================================
    # PHASE 1: Derive oracle public key from secret
    # ==========================================================================

    oracle_pub = ec_mul_base(oracle_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(oracle_pub);
    derived_pub_y = ec_get_y(oracle_pub);

    # ==========================================================================
    # PHASE 2: Verify public key matches registered oracle
    # ==========================================================================

    constrain_equal_base(derived_pub_x, oracle_pub_x);
    constrain_equal_base(derived_pub_y, oracle_pub_y);

    # ==========================================================================
    # PHASE 3: Verify predicate logic
    # ==========================================================================
    #
    # predicate = 0: value == threshold (Matches)
    # predicate = 1: value >= threshold (GreaterOrEqual)
    # predicate = 2: value <= threshold (LessOrEqual)
    #
    # Note: Actual predicate verification is done by the attestation contract.
    # This circuit only proves the oracle operator is creating the attestation.

    # ==========================================================================
    # PHASE 4: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_id);
    constrain_instance(attestation_id);
    constrain_instance(predicate);
    constrain_instance(threshold);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - constrain_instance: public input exposure
    #
    # The attestation contract handles the actual predicate verification.
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # This circuit proves the oracle operator authorized the attestation.
}
