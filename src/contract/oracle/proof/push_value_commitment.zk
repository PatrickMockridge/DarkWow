# The k parameter defining the number of rows used in our circuit (2^k)
k = 14;
field = "pallas";

# push_value_commitment_V2 — domain-separated circuit.

# Oracle Push Value Commitment Circuit
#
# This circuit enables private data point submission.
#
# Instead of submitting a value directly (which reveals the value), operators
# submit a commitment to their data point. The circuit proves:
#
# 1. The prover knows the operator secret behind the registered commitment
# 2. The commitment matches poseidon_hash(value, nonce)
# 3. The operation's nullifier is derived from that same secret
#
# NOTE: No Merkle membership proof. The oracle contract does not maintain a
# data tree, so membership against a caller-supplied root proves nothing.
# Merkle membership (set_membership / sparse_merkle_root) is a box/purse
# pattern — use it only when the contract actually stores the tree. See
# doc/src/arch/consensus/safety.md §8.
#
# Public Inputs (constrain_instance):
#   - oracle_id: The oracle being updated
#   - oracle_commitment: The registered operator commitment, re-derived in-circuit
#   - commitment: The Poseidon hash commitment to the data point
#   - nullifier: H(DOMAIN_NULLIFIER, oracle_secret, oracle_id, commitment)
#
# Witnesses:
#   - staker_secret: Oracle operator's secret key
#   - value: The actual data point value (known only to the operator)
#   - nonce: Random nonce used in commitment (known only to the operator)

constant "PushValueCommitmentV2" {
}

witness "PushValueCommitmentV2" {
    # Oracle ID being updated
    Base oracle_id,

    # Oracle operator's secret (for the commitment and the nullifier, not revealed)
    Base staker_secret,

    # The actual data point value (private - known only to the operator)
    Base value,

    # Nonce used in commitment computation (private - known only to the operator)
    Base nonce,

    # The commitment itself (should match poseidon_hash(DOMAIN_COMMITMENT, value, nonce))
    Base commitment,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PushValueCommitmentV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);
    # The operator commitment has its OWN domain rather than the generic DOMAIN_COMMITMENT, and in
    # THIS circuit that is not a matter of taste: with both at `witness_base(4)` the two hashes
    # below are both three arguments over prover-chosen field elements, so `(value, nonce) =
    # (staker_secret, oracle_id)` made `computed_commitment == oracle_commitment` exactly, and both
    # are exposed — a "data point commitment" that is the operator's own public registration value,
    # carrying no data point (OBL-Z19). The value is registered on chain and compared on every later
    # operation, so it MUST be identical in all six oracle circuits and in the client's
    # `compute_commitment()`; changing it here alone would make this circuit's proof disagree with
    # every `oracle_commitment` the contract has stored.
    DOMAIN_OPERATOR_COMMITMENT = witness_base(8);
    DOMAIN_NULLIFIER = witness_base(1);

    # ==========================================================================
    # PHASE 1: Authorize — re-derive the registered operator commitment
    # ==========================================================================
    #
    # The previous revision derived the operator's point from `staker_secret` and compared it
    # against `staker_pub_x`/`staker_pub_y`, two witnesses it never exposed: an equality between
    # two prover-chosen values, which holds for any secret (OBL-Z9). See push_value.zk.

    oracle_commitment = poseidon_hash(DOMAIN_OPERATOR_COMMITMENT, staker_secret, oracle_id);

    # ==========================================================================
    # PHASE 2: Verify commitment matches poseidon_hash(DOMAIN_COMMITMENT, value, nonce)
    # ==========================================================================

    computed_commitment = poseidon_hash(DOMAIN_COMMITMENT, value, nonce);
    constrain_equal_base(computed_commitment, commitment);

    # ==========================================================================
    # PHASE 3: The operation's nullifier
    # ==========================================================================
    #
    # Bound to the commitment — the identity of the operation.

    nullifier = poseidon_hash(DOMAIN_NULLIFIER, staker_secret, oracle_id, commitment);

    # ==========================================================================
    # PHASE 4: Expose public inputs
    # ==========================================================================

    constrain_instance(oracle_id);
    constrain_instance(oracle_commitment);
    constrain_instance(commitment);
    constrain_instance(nullifier);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
