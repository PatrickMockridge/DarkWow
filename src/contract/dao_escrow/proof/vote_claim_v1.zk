# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Vote Claim Circuit (Version 1)
#
# This circuit proves:
# - Voter holds a valid member_vote capability
# - Voter casts a single vote on a specific proposal
# - Vote nullifier prevents double-voting
#
# Public Inputs (constrain_instance):
#   - proposal_id: Proposal being voted on
#   - capability_id: Required capability identifier
#   - vote_nullifier: Prevents double-vote (H(capability_secret, proposal_id))
#   - vote_commit: Commit to vote direction
#
# Witnesses:
#   - capability_secret: Holder's capability secret
#   - voter_secret: Voter's secret key
#   - vote_type: Vote direction (0 = No, 1 = Yes)
#   - vote_blind: Blinding for vote commitment

constant "VoteClaim" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "VoteClaim" {
    # Proposal identifier
    Base proposal_id,

    # Required capability ID
    Base capability_id,

    # Capability secret (proves holder knows the secret)
    Base capability_secret,

    # Voter's secret key
    Base voter_secret,

    # Vote direction
    Base vote_type,

    # Blinding for vote commitment
    Scalar vote_blind,
    Base tx_commitment,
}

circuit "VoteClaim" {
    # ==========================================================================
    # PHASE 1: Derive voter public key from secret
    # ==========================================================================

    voter_pub = ec_mul_base(voter_secret, NULLIFIER_K);
    voter_pub_x = ec_get_x(voter_pub);
    voter_pub_y = ec_get_y(voter_pub);

    # ==========================================================================
    # PHASE 2: Verify capability possession
    # ==========================================================================

    capability_commit = poseidon_hash(capability_id, capability_secret);

    # ==========================================================================
    # PHASE 3: Compute vote nullifier (prevents double-vote)
    # ==========================================================================
    #
    # vote_nullifier = H(capability_secret, proposal_id, voter_pub_x, voter_pub_y)
    # This binds the vote to a specific capability, proposal, and voter.
    # Once spent, the same capability cannot vote again on the same proposal.

    vote_nullifier = poseidon_hash(
        capability_secret,
        proposal_id,
        voter_pub_x,
        voter_pub_y,
    );

    # ==========================================================================
    # PHASE 4: Compute vote commitment (hides vote direction)
    # ==========================================================================
    #
    # C = vote_type * G + blind * H
    # Pedersen commitment hides the vote direction.
    # vote_type is constrained to be 0 (No) or 1 (Yes).

    vcv = ec_mul_short(vote_type, VALUE_COMMIT_VALUE);
    vcr = ec_mul(vote_blind, VALUE_COMMIT_RANDOM);
    vote_commit = ec_add(vcv, vcr);

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(proposal_id);
    constrain_instance(capability_id);
    constrain_instance(vote_nullifier);
    constrain_instance(ec_get_x(vote_commit));
    constrain_instance(ec_get_y(vote_commit));

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # Uses ONLY proven opcodes:
    #   - ec_mul_base, ec_get_x, ec_get_y: Standard EC operations
    #   - poseidon_hash: Field-proven
    #   - ec_mul_short, ec_mul, ec_add: Standard EC operations
    #   - constrain_instance: Public input exposure
    #
    # SECURITY: The vote_nullifier binds capability_secret + proposal_id,
    # preventing the same capability from voting twice on the same proposal.
    constrain_instance(tx_commitment);
    # The vote_commit hides the vote direction from public observers.
}
