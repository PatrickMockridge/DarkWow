# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Premium Payment Circuit (Version 1)
#
# Simplfied MVP: Members pay premiums and receive a time-limited membership note.
# The DAO (via existing treasury management) acts as "escrow oracle" for claims.
#
# This circuit proves:
# - Member is paying a legitimate premium to the endowment
# - Membership note is correctly formed with expiry
#
# Public Inputs (constrain_instance):
#   - dao_escrow_bulla: DAO-Escrow identifier
#   - membership_note: H(member_pub, value, token_id, expiry, membership_blind)
#   - value_commit.x, value_commit.y: Pedersen commitment to premium value
#
# Witnesses:
#   - member_secret: Member's secret key
#   - value: Premium amount
#   - token_id: Token being paid
#   - expiry: Membership expiry block (annual = current_block + ~52500)
#   - membership_blind: Blinding for membership note
#   - value_blind: Blinding for value commitment

constant "PayPremium" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "PayPremium" {
    # DAO-Escrow identifier
    Base dao_escrow_bulla,

    # Current block height (public input for time lock)
    Uint64 current_block,

    # Member's secret key
    Base member_secret,

    # Premium details
    Base value,
    Base token_id,

    # Membership expiry block (must be > current_block)
    Uint64 expiry,

    # Blinding factors
    Scalar membership_blind,
    Scalar value_blind,
}

circuit "PayPremium" {
    # ==========================================================================
    # PHASE 1: Verify block-based time lock
    # ==========================================================================
    #
    # Block-based expiry: The membership is valid only while current_block < expiry.
    # This uses DarkFi's deterministic block heights - no oracle needed.
    #
    # This replaces timestamp-based locks which can be manipulated by miners.
    # A block number N means "the Nth block in the chain" - not an approximation.
    #
    # less_than_strict: constrains current_block < expiry
    # If this fails, the membership has already expired.

    less_than_strict(current_block, expiry);

    # ==========================================================================
    # PHASE 2: Derive member public key from secret
    # ==========================================================================

    member_pub = ec_mul_base(member_secret, NULLIFIER_K);
    member_pub_x = ec_get_x(member_pub);
    member_pub_y = ec_get_y(member_pub);

    # ==========================================================================
    # PHASE 3: Compute membership note
    # ==========================================================================
    #
    # Membership note = H(member_pub, value, token_id, expiry, blind)
    # This note is spent when claiming DAO-Escrow benefits.
    # The expiry is checked above (Phase 1) - this hash binds it.

    membership_note = poseidon_hash(
        member_pub_x,
        member_pub_y,
        value,
        token_id,
        expiry,
        membership_blind,
    );

    # ==========================================================================
    # PHASE 4: Compute value commitment for the premium payment
    # ==========================================================================
    #
    # C = value * G + blind * H
    # Pedersen commitment hides the premium value.

    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(dao_escrow_bulla);
    constrain_instance(membership_note);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes (no grey-market opcodes):
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - poseidon_hash: field-proven, standard in DarkFi
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - ec_mul_short, ec_mul: standard EC operations
    #   - ec_add: point addition
    #   - constrain_instance: public input exposure
    #
    # There are NO uses of:
    #   - LessThanOrEqual (gate soundness issue)
    #   - IsEqualBase (delta-invert issue when a == b)
    #
    # The block-based time lock is sound because:
    #   - DarkFi block numbers are deterministic
    #   - The constraint only verifies current_block < expiry
    #   - If expiry is in the past, the constraint fails
}
