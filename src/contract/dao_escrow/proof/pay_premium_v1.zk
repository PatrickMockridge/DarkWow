# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Premium Payment Circuit (Version 1)
#
# Simplfied MVP: Members pay premiums and receive a time-limited membership note.
# The DAO (via existing treasury management) acts as "escrow oracle" for claims.
#
# This circuit proves:
# - Member is paying a legitimate premium to the endowment
# - Membership note is correctly formed with expiry
#
# Public Inputs (constrain_instance):
#   - dao_escrow_bulla: DAO-Escrow identifier
#   - membership_note: H(member_pub, value, token_id, expiry, membership_blind)
#   - value_commit.x, value_commit.y: Pedersen commitment to premium value
#
# Witnesses:
#   - member_secret: Member's secret key
#   - value: Premium amount
#   - token_id: Token being paid
#   - expiry: Membership expiry block (annual = current_block + ~52500)
#   - membership_blind: Blinding for membership note
#   - value_blind: Blinding for value commitment

constant "PayPremium" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "PayPremium" {
    # DAO-Escrow identifier
    Base dao_escrow_bulla,

    # Member's secret key
    Base member_secret,

    # Premium details
    Base value,
    Base token_id,

    # Membership expiry (annual = ~52500 blocks)
    Base expiry,

    # Blinding factors
    Scalar membership_blind,
    Scalar value_blind,
}

circuit "PayPremium" {
    # Derive member public key from secret
    member_pub = ec_mul_base(member_secret, NULLIFIER_K);
    member_pub_x = ec_get_x(member_pub);
    member_pub_y = ec_get_y(member_pub);

    # Compute membership note = H(member_pub, value, token_id, expiry, blind)
    # This note is spent when claiming DAO-Escrow benefits
    # The expiry is checked by the spend_hook at spend time
    membership_note = poseidon_hash(
        member_pub_x,
        member_pub_y,
        value,
        token_id,
        expiry,
        membership_blind,
    );

    # Compute value commitment for the premium payment
    # C = value * G + blind * H
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);

    # Expose public inputs
    constrain_instance(dao_escrow_bulla);
    constrain_instance(membership_note);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));
}
