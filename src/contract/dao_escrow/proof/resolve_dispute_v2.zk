# ResolveDispute_V2 circuit — domain-separated DAO-Escrow dispute resolution.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "ResolveDisputeV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ResolveDisputeV2" {
    Base dao_escrow_bulla,
    Base arbitrator_secret,
    Base arbitrator_pub_x,
    Base arbitrator_pub_y,
    Base capability_id,
    Base capability_secret,
    Base dispute_id,
    Base resolution_type,
    Base resolution_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ResolveDisputeV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    arbitrator_pub = ec_mul_base(arbitrator_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(arbitrator_pub), arbitrator_pub_x);
    constrain_equal_base(ec_get_y(arbitrator_pub), arbitrator_pub_y);

    capability_commit = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        capability_id,
        capability_secret,
        dao_escrow_bulla,
    );

    dispute_nullifier = poseidon_hash(
        DOMAIN_NULLIFIER,
        capability_secret,
        dispute_id,
    );

    resolution_commit = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        dispute_id,
        resolution_type,
        resolution_blind,
    );

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(resolution_commit);
}
