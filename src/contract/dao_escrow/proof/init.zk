# Init_V2 circuit — domain-separated DAO-Escrow initialization.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "InitV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "InitV2" {
    Base dao_bulla,
    Base owner_secret,
    Base endowment_asset_id,
    Base bulla_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "InitV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    owner_pub_x = ec_get_x(owner_pub);
    owner_pub_y = ec_get_y(owner_pub);

    endowment_bulla = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        dao_bulla,
        owner_pub_x,
        owner_pub_y,
        endowment_asset_id,
        bulla_blind,
    );

    constrain_instance(dao_bulla);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(endowment_bulla);
}
