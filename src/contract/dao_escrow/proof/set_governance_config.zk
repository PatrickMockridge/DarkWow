# SetGovernanceConfig_V2 circuit — domain-separated governance identity.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11; field = "pallas";
constant "SetGovernanceConfigV2" { EcFixedPointBase NULLIFIER_K, }
witness "SetGovernanceConfigV2" {
    Base owner_secret, Base owner_pub_x, Base owner_pub_y,
    Base owner_nullifier, Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
    # HAZOP H-8 fix: instance_id for per-instance unique governance nullifiers
    Base dao_escrow_bulla,
}
circuit "SetGovernanceConfigV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(owner_pub), owner_pub_x);
    constrain_equal_base(ec_get_y(owner_pub), owner_pub_y);
    # HAZOP H-8 fix: include dao_escrow_bulla for per-instance unique nullifiers
    computed = poseidon_hash(DOMAIN_NULLIFIER, owner_pub_x, owner_pub_y, owner_secret, dao_escrow_bulla);
    constrain_equal_base(computed, owner_nullifier);
    constrain_instance(owner_pub_x); constrain_instance(owner_pub_y);
    constrain_instance(owner_nullifier); tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
