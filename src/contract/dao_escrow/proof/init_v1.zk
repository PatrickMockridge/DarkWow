# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Initialization Circuit (Version 1)
#
# This circuit proves:
# - Owner knows their secret key
# - Governance parameters are correctly committed
#
# Public Inputs (constrain_instance):
#   - bulla = H(owner_pub.x, owner_pub.y, gov_token_id, params...)
#
# Witnesses:
#   - owner_secret: Owner's secret key
#   - Various governance parameters

constant "Init" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Init" {
    # Owner's secret key
    Base owner_secret,

    # Governance parameters
    Base gov_token_id,
    Base proposer_limit,
    Base quorum,
    Base early_exec_quorum,
    Base approval_ratio_quot,
    Base approval_ratio_base,
    Base premium_rate_quot,
    Base premium_rate_base,
    Base max_claim_ratio_quot,
    Base max_claim_ratio_base,
    Base claim_voting_window,
    Base claim_execution_window,

    # Bulla blind
    Base bulla_blind,
}

circuit "Init" {
    # Derive owner public key from secret
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    owner_pub_x = ec_get_x(owner_pub);
    owner_pub_y = ec_get_y(owner_pub);

    # Compute bulla (unique identifier)
    bulla = poseidon_hash(
        owner_pub_x,
        owner_pub_y,
        gov_token_id,
        proposer_limit,
        quorum,
        early_exec_quorum,
        approval_ratio_quot,
        approval_ratio_base,
        premium_rate_quot,
        premium_rate_base,
        max_claim_ratio_quot,
        max_claim_ratio_base,
        bulla_blind,
    );

    # Expose bulla as public input
    constrain_instance(bulla);
}
