# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Initialization Circuit (Version 1)
#
# Simplified MVP: The DAO-Escrow is an endowment pool controlled by a DAO.
# The DAO (via existing treasury management) votes on claims.
# This circuit just creates the endowment and links it to a DAO.
#
# Public Inputs (constrain_instance):
#   - dao_bulla: The controlling DAO's bulla
#   - endowment_bulla: H(dao_bulla, owner_pub, endowment_token_id, owner_secret)
#
# Witnesses:
#   - dao_bulla: The controlling DAO's bulla (passed as public input for verification)
#   - owner_secret: Endowment owner's secret key
#   - endowment_token_id: Token ID held in the endowment

constant "Init" {
    EcFixedPointBase NULLIFIER_K,
}

witness "Init" {
    # The controlling DAO's bulla (proves this endowment is governed by a DAO)
    Base dao_bulla,

    # Owner's secret key
    Base owner_secret,

    # Endowment token ID
    Base endowment_token_id,

    # Bulla blind
    Base bulla_blind,
    Base tx_commitment,
}

circuit "Init" {
    # Derive owner public key from secret
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    owner_pub_x = ec_get_x(owner_pub);
    owner_pub_y = ec_get_y(owner_pub);

    # Compute endowment bulla = H(dao_bulla, owner_pub, endowment_token_id, blind)
    # This uniquely identifies this endowment and proves it's controlled by the DAO
    endowment_bulla = poseidon_hash(
        dao_bulla,
        owner_pub_x,
        owner_pub_y,
        endowment_token_id,
        bulla_blind,
    );

    # Expose bulla as public input
    constrain_instance(dao_bulla);
    constrain_instance(tx_commitment);
    constrain_instance(endowment_bulla);
}
