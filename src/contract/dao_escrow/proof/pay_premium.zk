# PayPremium_V2 circuit — domain-separated DAO-Escrow premium payment.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "PayPremiumV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "PayPremiumV2" {
    Base dao_escrow_bulla,
    Base member_secret,
    Base member_pub_x,
    Base member_pub_y,
    Base mpc_secret_1,
    Base mpc_secret_2,
    Base mpc_secret_3,
    Base value,
    Base asset_id,
    Base expiry,
    Base current_block,
    Base membership_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PayPremiumV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # A premium may be paid only before the membership expires: `current_block < expiry`.
    #
    # Both operands are witnesses the prover supplies, and until 2026-09-20 neither was bounded —
    # which made this check a comparison of field *residues* rather than of block heights. The
    # comparison chip is 253 bits wide and range-checks the difference of its operands, never the
    # operands themselves, so an unbounded `expiry` could be chosen so the difference wraps modulo
    # p back under 2^253 and the check succeeds for a block height past the expiry. Nothing else
    # enforces this: the entrypoint stores `expiry` and reads `current_block` without comparing
    # them. Bounding both operands is what makes the check sound, and the check is the only
    # enforcement, so here it is repaired rather than removed.
    range_check(64, current_block);
    range_check(64, expiry);
    less_than_strict(current_block, expiry);

    member_pub = ec_mul_base(member_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(member_pub), member_pub_x);
    constrain_equal_base(ec_get_y(member_pub), member_pub_y);

    computed_bulla = poseidon_hash(
        DOMAIN_COMMITMENT,
        member_pub_x,
        member_pub_y,
        mpc_secret_1,
        mpc_secret_2,
        mpc_secret_3,
    );
    constrain_equal_base(computed_bulla, dao_escrow_bulla);

    membership_note = poseidon_hash(
        DOMAIN_COMMITMENT,
        member_pub_x,
        member_pub_y,
        value,
        asset_id,
        expiry,
        membership_blind,
    );

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
