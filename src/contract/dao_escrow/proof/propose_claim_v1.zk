# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Propose Claim Circuit (Version 1)
#
# This circuit proves:
# - Proposer holds a valid member_vote capability
# - Claim parameters are correctly formed
# - Capability secret is known to the proposer
#
# Public Inputs (constrain_instance):
#   - dao_escrow_bulla: DAO-Escrow identifier
#   - claim_id: Unique claim identifier (nullifier-based)
#   - capability_id: Required capability identifier
#   - proposal_nullifier: Prevents double-propose on same capability
#
# Witnesses:
#   - capability_secret: Holder's capability secret
#   - proposer_secret: Proposer's secret key
#   - value: Claim amount
#   - description_hash: Hash of claim description
#   - recipient_pub_x, recipient_pub_y: Recipient public key

constant "ProposeClaim" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ProposeClaim" {
    # DAO-Escrow identifier
    Base dao_escrow_bulla,

    # Claim identifier
    Base claim_id,

    # Required capability ID
    Base capability_id,

    # Capability secret (proves holder knows the secret)
    Base capability_secret,

    # Proposer's secret key
    Base proposer_secret,

    # Claim parameters
    Base value,
    Base description_hash,

    # Recipient public key coordinates
    Base recipient_pub_x,
    Base recipient_pub_y,

    # Blinding for proposal nullifier
    Base proposal_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ProposeClaim" {
    # ==========================================================================
    # PHASE 1: Derive proposer public key from secret
    # ==========================================================================

    proposer_pub = ec_mul_base(proposer_secret, NULLIFIER_K);
    proposer_pub_x = ec_get_x(proposer_pub);
    proposer_pub_y = ec_get_y(proposer_pub);

    # ==========================================================================
    # PHASE 2: Verify capability possession
    # ==========================================================================
    #
    # The capability is proved by hashing the capability ID with the secret.
    # capability_commit = H(capability_id, capability_secret)
    # Only a holder with the correct secret can produce a valid commitment.

    capability_commit = poseidon_hash(capability_id, capability_secret);

    # ==========================================================================
    # PHASE 3: Compute proposal nullifier (prevents double-propose)
    # ==========================================================================
    #
    # proposal_nullifier = H(capability_secret, dao_escrow_bulla, claim_id)
    # This binds the proposal to a specific capability and DAO escrow.
    # Once spent, the same capability cannot propose another claim
    # with the same claim_id.

    proposal_nullifier = poseidon_hash(
        capability_secret,
        dao_escrow_bulla,
        claim_id,
    );

    # ==========================================================================
    # PHASE 4: Bind claim parameters
    # ==========================================================================
    #
    # claim_commit = H(dao_escrow_bulla, claim_id, value, description_hash,
    #                  recipient_pub_x, recipient_pub_y)
    # This binds all claim parameters together.

    claim_commit = poseidon_hash(
        dao_escrow_bulla,
        claim_id,
        value,
        description_hash,
        recipient_pub_x,
        recipient_pub_y,
    );

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(dao_escrow_bulla);
    constrain_instance(claim_id);
    constrain_instance(capability_id);
    constrain_instance(proposal_nullifier);
    constrain_instance(claim_commit);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # Uses ONLY proven opcodes:
    #   - ec_mul_base, ec_get_x, ec_get_y: Standard EC operations
    #   - poseidon_hash: Field-proven
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    #   - constrain_instance: Public input exposure
}
