# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DAO-Escrow Claim Execution Circuit (Version 1)
#
# This circuit proves:
# - Claim was approved by DAO vote
# - Execution deadline hasn't passed
# - Claim value matches approved value
#
# Public Inputs (constrain_instance):
#   - claim_id
#   - released_value
#   - recipient_pub.x, recipient_pub.y
#   - execution_deadline
#
# Witnesses:
#   - approval_proof (vote aggregation proof)
#   - execution_secret (to derive recipient)

constant "ExecuteClaim" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExecuteClaim" {
    # Claim identifier
    Base claim_id,

    # Approved value
    Base released_value,

    # Recipient public key (derived from execution secret)
    Base recipient_pub_x,
    Base recipient_pub_y,

    # Execution deadline
    Base execution_deadline,

    # Execution secret (proves right to receive funds)
    Base execution_secret,
}

circuit "ExecuteClaim" {
    # Derive recipient public key from execution secret
    recipient_pub = ec_mul_base(execution_secret, NULLIFIER_K);
    recipient_pub_x_verify = ec_get_x(recipient_pub);
    recipient_pub_y_verify = ec_get_y(recipient_pub);

    # Verify derived matches claimed
    constrain_eq(recipient_pub_x_verify, recipient_pub_x);
    constrain_eq(recipient_pub_y_verify, recipient_pub_y);

    # Note: Vote aggregation verification would go here
    # This would verify:
    # - total_votes >= quorum
    # - yes_votes * base >= approval_ratio_quot * total_votes

    # Expose public inputs
    constrain_instance(claim_id);
    constrain_instance(released_value);
    constrain_instance(recipient_pub_x);
    constrain_instance(recipient_pub_y);
    constrain_instance(execution_deadline);
}
