# VoteClaim_V2 circuit — domain-separated DAO-Escrow claim voting.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "VoteClaimV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "VoteClaimV2" {
    Base dao_escrow_bulla,
    Base voter_secret,
    Base voter_pub_x,
    Base voter_pub_y,
    Base capability_id,
    Base capability_secret,
    Base proposal_id,
    Base vote_type,
    Base vote_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "VoteClaimV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    voter_pub = ec_mul_base(voter_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(voter_pub), voter_pub_x);
    constrain_equal_base(ec_get_y(voter_pub), voter_pub_y);

    capability_commit = poseidon_hash(DOMAIN_COIN_COMMIT, capability_id, capability_secret);

    vote_nullifier = poseidon_hash(
        DOMAIN_NULLIFIER,
        capability_secret,
        proposal_id,
        voter_pub_x,
        voter_pub_y,
    );

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(vote_nullifier);
}
