# BuyPosition_V2 — domain-separated position purchase.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "BuyPositionV2" { EcFixedPointBase NULLIFIER_K, }
witness "BuyPositionV2" {
    Base market_id, Base owner_pub_x, Base owner_pub_y, Base owner_secret,
    Base outcome, Base amount, Base block_height, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "BuyPositionV2" {
    DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COMMITMENT = witness_base(4);
    derived_position_id = poseidon_hash(DOMAIN_COMMITMENT, market_id, owner_pub_x, owner_pub_y, outcome, amount, block_height);
    constrain_instance(derived_position_id);
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, derived_position_id, owner_secret);
    constrain_instance(computed_nullifier);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
