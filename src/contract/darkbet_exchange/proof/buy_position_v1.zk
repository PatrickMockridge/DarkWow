# Darkbet Exchange Buy Position Circuit — includes owner identity proof.
k = 11; field = "pallas";
constant "BuyPosition" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
    EcFixedPointBase NULLIFIER_K,
}
witness "BuyPosition" {
    Base market_id, Base owner_secret, Base owner_pub_x, Base owner_pub_y,
    Base outcome, Base amount, Base block_height,
    Base owner_nullifier, Scalar value_blind, Base tx_commitment,
}
circuit "BuyPosition" {
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(owner_pub), owner_pub_x);
    constrain_equal_base(ec_get_y(owner_pub), owner_pub_y);
    derived_position_id = poseidon_hash(market_id, owner_pub_x, owner_pub_y, outcome, amount, block_height);
    constrain_instance(derived_position_id);
    vcv = ec_mul_short(amount, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));
    computed_nullifier = poseidon_hash(derived_position_id, owner_secret);
    constrain_equal_base(computed_nullifier, owner_nullifier);
    constrain_instance(owner_nullifier);
    constrain_instance(tx_commitment);
}
