# MatchOrders_V2 — domain-separated order matching.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "MatchOrdersV2" { EcFixedPointBase NULLIFIER_K, }
witness "MatchOrdersV2" {
    Base market_id, Base user_secret, Base user_pub_x, Base user_pub_y,
    Base user_nullifier, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "MatchOrdersV2" {
    DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3);
    user_pub = ec_mul_base(user_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(user_pub), user_pub_x); constrain_equal_base(ec_get_y(user_pub), user_pub_y);
    computed = poseidon_hash(DOMAIN_NULLIFIER, market_id, user_secret);
    constrain_equal_base(computed, user_nullifier);
    constrain_instance(user_pub_x); constrain_instance(user_pub_y); constrain_instance(user_nullifier);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
