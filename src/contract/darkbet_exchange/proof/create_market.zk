# CreateMarket_V2 — domain-separated market creation.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "CreateMarketV2" { EcFixedPointBase NULLIFIER_K, }
witness "CreateMarketV2" {
    Base creator_pub_x, Base creator_pub_y, Base creator_secret,
    Base close_block, Base block_height, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "CreateMarketV2" {
    DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COMMITMENT = witness_base(4);
    derived_market_id = poseidon_hash(DOMAIN_COMMITMENT, creator_pub_x, creator_pub_y, close_block, block_height);
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, derived_market_id, creator_secret);
    constrain_instance(derived_market_id); constrain_instance(computed_nullifier);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
