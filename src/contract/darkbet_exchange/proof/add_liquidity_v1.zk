# Darkbet Exchange Add Liquidity Circuit
#
# This circuit proves that:
# 1. The provider knows their secret key
# 2. The lp_share_id is correctly derived
# 3. The amount commitment is valid
#
# Public inputs:
# - lp_share_id: The derived LP share ID

k = 11;
field = "pallas";

constant "AddLiquidity" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "AddLiquidity" {
    Base market_id,
    Base provider_pub_x,
    Base provider_pub_y,
    Base amount,
    Base block_height,
    Scalar value_blind,
}

circuit "AddLiquidity" {
    # Derive lp_share_id from parameters (same as contract)
    derived_lp_share_id = poseidon_hash(
        market_id,
        provider_pub_x,
        provider_pub_y,
        amount,
        block_height,
    );
    constrain_instance(derived_lp_share_id);

    # Verify value commitment
    vcv = ec_mul_short(amount, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));
}