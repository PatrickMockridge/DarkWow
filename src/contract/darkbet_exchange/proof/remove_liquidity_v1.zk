# Darkbet Exchange RemoveLiquidity Circuit — proves provider identity via ZK.
k = 11; field = "pallas";
constant "RemoveLiquidity" { EcFixedPointBase NULLIFIER_K, }
witness "RemoveLiquidity" {
    Base market_id, Base provider_secret, Base provider_pub_x, Base provider_pub_y,
    Base provider_nullifier, Base tx_commitment,
}
circuit "RemoveLiquidity" {
    provider_pub = ec_mul_base(provider_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(provider_pub), provider_pub_x);
    constrain_equal_base(ec_get_y(provider_pub), provider_pub_y);
    computed = poseidon_hash(market_id, provider_secret);
    constrain_equal_base(computed, provider_nullifier);
    constrain_instance(market_id); constrain_instance(provider_pub_x);
    constrain_instance(provider_pub_y); constrain_instance(provider_nullifier);
    constrain_instance(tx_commitment);
}
