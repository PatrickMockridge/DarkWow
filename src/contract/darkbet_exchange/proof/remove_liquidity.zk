# RemoveLiquidity_V2 — domain-separated liquidity removal.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "RemoveLiquidityV2" { EcFixedPointBase NULLIFIER_K, }
witness "RemoveLiquidityV2" {
    Base market_id, Base provider_secret, Base provider_pub_x, Base provider_pub_y,
    Base provider_nullifier, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "RemoveLiquidityV2" {
    DOMAIN_NULLIFIER = witness_base(1); DOMAIN_TX_BINDING = witness_base(3);
    provider_pub = ec_mul_base(provider_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(provider_pub), provider_pub_x); constrain_equal_base(ec_get_y(provider_pub), provider_pub_y);
    computed = poseidon_hash(DOMAIN_NULLIFIER, market_id, provider_secret);
    constrain_equal_base(computed, provider_nullifier);
    constrain_instance(provider_pub_x); constrain_instance(provider_pub_y); constrain_instance(provider_nullifier);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
