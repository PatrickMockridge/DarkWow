# ClaimWinnings_V2 — domain-separated winnings claim.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "ClaimWinningsV2" { EcFixedPointBase NULLIFIER_K, }
witness "ClaimWinningsV2" {
    Base market_id, Base owner_pub_x, Base owner_pub_y, Base owner_secret,
    Base outcome, Base amount, Base block_height, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "ClaimWinningsV2" {
    DOMAIN_COMMITMENT = witness_base(4); DOMAIN_TX_BINDING = witness_base(3);
    owner_pub = ec_mul_base(owner_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(owner_pub), owner_pub_x); constrain_equal_base(ec_get_y(owner_pub), owner_pub_y);
    derived_claim_id = poseidon_hash(DOMAIN_COMMITMENT, market_id, owner_pub_x, owner_pub_y, outcome, amount);
    constrain_instance(derived_claim_id);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
