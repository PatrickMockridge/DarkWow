# `LockV2` — deployooor `LockV1` is documented as "only the original deployer", i.e. the keypair
# whose public key derived the contract's `ContractId`. It enforced nothing: `lock_get_metadata_v1`
# published an *empty* signature-pubkey vector (`Schnorr signatures prohibited`,
# contract-standards.md §3) and `lock_process_instruction_v1` read no signer, so any transaction
# could lock any deployed contract (docs-review F-511).
#
# Signatures are not available to a contract here, so the tree's way to bind a caller to a public
# key is a proof of the secret — `create_attestation.zk`'s derive-and-expose form, which
# `check-pubkey-binding.sh` calls SOUND: the exposed coordinates are the ones the secret opens, and
# the host derives the `ContractId` from them. The caller must therefore know the deployer's secret.
k = 11; field = "pallas";
constant "LockV2" {
    EcFixedPointBase NULLIFIER_K,
}
witness "LockV2" {
    Base deployer_secret,
    Base public_key_x,
    Base public_key_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}
circuit "LockV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);

    # Derive-and-expose: `derived_pub` is the point `deployer_secret` opens, and the exposed
    # coordinates are constrained equal to it. The host then derives the same `ContractId` from
    # those coordinates that `DeployV1` stored, so the lock applies to the deployer's own contract.
    derived_pub = ec_mul_base(deployer_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(derived_pub);
    derived_pub_y = ec_get_y(derived_pub);
    constrain_equal_base(derived_pub_x, public_key_x);
    constrain_equal_base(derived_pub_y, public_key_y);
    constrain_instance(public_key_x); constrain_instance(public_key_y);

    # `OBL-C198`: the tx pair is the **last two** instances — the node reads that position to
    # recompute the binding from the enclosing transaction.
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
