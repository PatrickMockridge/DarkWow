# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Tender Select Winner Circuit (Version 1)
#
# This circuit proves:
# - Requester knows their secret key
# - Requester public key is correctly derived
# - Winner selection is authorized
#
# Public Inputs (constrain_instance):
#   - tender_id: The tender
#   - winner_bid_id: The winning bid
#   - requester_pub_x, requester_pub_y: Requester's public key
#
# Witnesses:
#   - requester_secret: Requester's secret key

constant "SelectWinner" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SelectWinner" {
    # Tender being settled
    Base tender_id,

    # Winner's bid ID
    Base winner_bid_id,

    # Requester's secret (for key derivation)
    Base requester_secret,
}

circuit "SelectWinner" {
    # ==========================================================================
    # PHASE 1: Derive requester public key from secret
    # ==========================================================================

    requester_pub = ec_mul_base(requester_secret, NULLIFIER_K);
    requester_pub_x = ec_get_x(requester_pub);
    requester_pub_y = ec_get_y(requester_pub);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(tender_id);
    constrain_instance(winner_bid_id);
    constrain_instance(requester_pub_x);
    constrain_instance(requester_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_instance: public input exposure
    #
    # The contract layer verifies:
    # 1. Tender is in Revealed state
    # 2. Winner bid was properly revealed
    # 3. Requester is the tender creator
    # 4. Winner meets competency requirements
}