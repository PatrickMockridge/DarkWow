# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Tender Submit Bid Circuit (Version 1)
#
# This circuit proves:
# - Bidder knows their secret key
# - Bidder public key is correctly derived
# - Bid is valid for this tender
# - Competency requirements are met
#
# Public Inputs (constrain_instance):
#   - tender_id: The tender this bid is for
#   - bid_id: Poseidon hash commitment of bid
#   - competency_commitment: Proves bidder meets requirements
#
# Witnesses:
#   - bidder_secret: Bidder's secret key
#   - amount: Bid amount (hidden)

constant "SubmitBid" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SubmitBid" {
    # Tender being bid on
    Base tender_id,

    # Bidder's secret (for key derivation and nullifier)
    Base bidder_secret,

    # Bid details
    Base amount,
    Base bid_nonce,
}

circuit "SubmitBid" {
    # ==========================================================================
    # PHASE 1: Derive bidder public key from secret
    # ==========================================================================

    bidder_pub = ec_mul_base(bidder_secret, NULLIFIER_K);
    bidder_pub_x = ec_get_x(bidder_pub);
    bidder_pub_y = ec_get_y(bidder_pub);

    # ==========================================================================
    # PHASE 2: Compute bid ID commitment
    # ==========================================================================
    #
    # bid_id = H(tender_id, bidder_pub.x, bidder_pub.y, amount, bid_nonce)
    #
    # This uniquely identifies this specific bid
    # Amount is hashed to hide the actual bid until reveal

    bid_id = poseidon_hash(
        tender_id,
        bidder_pub_x,
        bidder_pub_y,
        amount,
        bid_nonce,
    );

    # ==========================================================================
    # PHASE 3: Expose public inputs
    # ==========================================================================

    constrain_instance(tender_id);
    constrain_instance(bid_id);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - poseidon_hash: field-proven commitment
    #   - constrain_instance: public input exposure
    #
    # The actual competency verification (issuer credentials) is done
    # by the contract layer verifying the competency proof.
}