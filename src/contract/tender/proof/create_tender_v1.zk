# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# Tender Create Circuit (Version 1)
#
# This circuit proves:
# - Requester knows their secret key
# - Requester public key is correctly derived
# - Tender ID is correctly computed
#
# Public Inputs (constrain_instance):
#   - tender_id: Poseidon hash commitment of tender parameters
#   - requester_pub_x, requester_pub_y: Requester's public key coordinates
#
# Witnesses:
#   - requester_secret: Requester's secret key

constant "CreateTender" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateTender" {
    # Requester's secret (for key derivation, not revealed)
    Base requester_secret,

    # Requester's public key coordinates (public input - must match derived)
    Base requester_pub_x,
    Base requester_pub_y,
    Base tx_commitment,
}

circuit "CreateTender" {
    # ==========================================================================
    # PHASE 1: Derive requester public key from secret
    # ==========================================================================

    requester_pub = ec_mul_base(requester_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(requester_pub);
    derived_pub_y = ec_get_y(requester_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the requester_secret to the requester_pubkey
    constrain_equal_base(derived_pub_x, requester_pub_x);
    constrain_equal_base(derived_pub_y, requester_pub_y);

    # ==========================================================================
    # PHASE 2: Expose public inputs
    # ==========================================================================

    constrain_instance(requester_pub_x);
    constrain_instance(requester_pub_y);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes:
    #   - ec_mul_base: standard EC operations
    #   - ec_get_x, ec_get_y: standard EC operations
    #   - constrain_instance: public input exposure
    #
    # The tender parameters are stored by the contract from the public inputs.
    constrain_instance(tx_commitment);
    # The ZK proof only establishes that the creator knows their secret.
}