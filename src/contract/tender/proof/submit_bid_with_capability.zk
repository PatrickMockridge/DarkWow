k = 11;
field = "pallas";

# submit_bid_with_capability_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Tender Submit Bid With Capability Circuit (Version 1)
#
# This circuit proves:
# - Bidder knows their secret key
# - Bidder public key is correctly derived and matches the provided coordinates
# - Bid is valid for this tender
# - Bidder has required capability (verified via Identity contract)
#
# Public Inputs (constrain_instance):
#   - tender_id: The tender this bid is for
#   - bid_id: Poseidon hash commitment of bid
#   - bidder_pub_x: Bidder's public key x coordinate
#   - bidder_pub_y: Bidder's public key y coordinate
#   - required_capability_id: The capability this tender requires
#
# Witnesses:
#   - bidder_secret: Bidder's secret key
#   - amount: Bid amount (hidden)
#   - bid_nonce: Random nonce for bid commitment
#   - capability_predicate_result: Result from Identity contract verification

constant "SubmitBidWithCapabilityV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SubmitBidWithCapabilityV2" {
    # Tender being bid on
    Base tender_id,

    # Bidder's secret (for key derivation and nullifier)
    Base bidder_secret,

    # Bidder's public key coordinates (public input - must match derived)
    Base bidder_pub_x,
    Base bidder_pub_y,

    # Bid details
    Base amount,
    Base bid_nonce,

    # Required capability ID for this tender
    Base required_capability_id,

    # Capability predicate result (from Identity contract)
    Base capability_predicate_result,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SubmitBidWithCapabilityV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # ==========================================================================
    # PHASE 1: Derive bidder public key from secret
    # ==========================================================================

    bidder_pub = ec_mul_base(bidder_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(bidder_pub);
    derived_pub_y = ec_get_y(bidder_pub);

    # ==========================================================================
    # PHASE 2: Verify public key matches the provided coordinates
    # ==========================================================================

    # CRITICAL: Verify derived public key matches the public input
    # This binds the bidder_secret to the bidder_pubkey
    constrain_equal_base(derived_pub_x, bidder_pub_x);
    constrain_equal_base(derived_pub_y, bidder_pub_y);

    # RC1-E: Range proof for u64 bid amount
    range_check(64, amount);

    # Expose as public inputs
    constrain_instance(bidder_pub_x);
    constrain_instance(bidder_pub_y);

    # ==========================================================================
    # PHASE 3: Verify capability predicate result
    # ==========================================================================

    # The capability predicate result should be 1 (satisfied)
    ONE = witness_base(1);
    constrain_equal_base(capability_predicate_result, ONE);

    # ==========================================================================
    # PHASE 4: Compute bid ID commitment
    # ==========================================================================
    #
    # bid_id = H(tender_id, bidder_pub.x, bidder_pub.y, amount, bid_nonce)
    #
    # This uniquely identifies this specific bid
    # Amount is hashed to hide the actual bid until reveal

    bid_id = poseidon_hash(DOMAIN_COMMITMENT, 
        tender_id,
        bidder_pub_x,
        bidder_pub_y,
        amount,
        bid_nonce,
    );

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(tender_id);
    constrain_instance(bid_id);
    constrain_instance(required_capability_id);
    constrain_instance(capability_predicate_result);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    #
    # The prover proves that:
    # 1. They know the bidder's secret key
    # 2. Their public key is correctly derived
    # 3. The capability_predicate_result is 1 (capability satisfied)
    #
    # What this enables:
    # - Bidder can submit bids in tenders requiring specific capabilities
    # - The capability verification is done via Identity contract
    # - Bidder identity is hidden, only capability is proven
    #
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # Soundness: Uses proven opcodes (ec_mul_base, ec_get_x, ec_get_y, poseidon_hash)
}