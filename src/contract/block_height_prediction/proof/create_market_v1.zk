# Block Height Prediction Create Market Circuit
#
# This circuit proves that:
# 1. The market creator knows their secret key
# 2. The market ID is correctly derived from parameters
#
# Public inputs:
# - market_id: The derived market ID

k = 11;
field = "pallas";

constant "CreateMarket" {
}

witness "CreateMarket" {
    Base creator_pub_x,
    Base creator_pub_y,
    Base target_timestamp,
    Base token_id,
    Base confirmation_depth,
    Base nonce,
}

circuit "CreateMarket" {
    # Derive market_id from parameters (same as contract's derive_market_id)
    # Contract uses: poseidon_hash(cx, cy, target_time, token_id, confirmation_depth)
    derived_market_id = poseidon_hash(
        creator_pub_x,
        creator_pub_y,
        target_timestamp,
        token_id,
        confirmation_depth,
    );
    constrain_instance(derived_market_id);

    # Verify creator pubkey is consistent (proves knowledge of corresponding secret)
    derived_creator_key = poseidon_hash(
        creator_pub_x,
        creator_pub_y,
    );
    constrain_instance(derived_creator_key);
}