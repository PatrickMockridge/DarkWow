# CreateClaimV1Multi_V2 circuit — domain-separated multi-credential claim.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "CreateClaimV2Multi" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV2Multi" {
    Base nullifier,
    Base claim_type,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,
    Base secret_1,
    Base commitment_1,
    Base secret_2,
    Base commitment_2,
    Base secret_3,
    Base commitment_3,
    Base threshold_1,
    Base attribute_value_1,
    Base threshold_2,
    Base attribute_value_2,
    Base threshold_3,
    Base attribute_value_3,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateClaimV2Multi" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    computed_nullifier_1 = poseidon_hash(DOMAIN_NULLIFIER, secret_1, commitment_1);
    computed_nullifier_2 = poseidon_hash(DOMAIN_NULLIFIER, secret_2, commitment_2);
    computed_nullifier_3 = poseidon_hash(DOMAIN_NULLIFIER, secret_3, commitment_3);

    combined = poseidon_hash(DOMAIN_NULLIFIER, computed_nullifier_1, computed_nullifier_2);
    combined = poseidon_hash(DOMAIN_NULLIFIER, combined, computed_nullifier_3);

    range_check(64, attribute_value_1);
    range_check(64, threshold_1);
    range_check(64, attribute_value_2);
    range_check(64, threshold_2);
    range_check(64, attribute_value_3);
    range_check(64, threshold_3);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
