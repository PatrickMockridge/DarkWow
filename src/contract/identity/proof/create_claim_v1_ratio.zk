k = 11;
field = "pallas";

# Identity: Create Ratio-Based Claim (Version 1)
#
# Enables supply-relative and percentage-based predicates.
# Proves: my_value / total_supply >= threshold_ratio
#
# Examples:
# - "Hold >= 10% of token supply"
# - "Balance >= 1% of total"
# - "Weight >= 50% of total supply"
#
# Uses BaseDiv for ratio calculation and LessThanOrEqual for comparison.

constant "CreateClaimV1Ratio" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1Ratio" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,
    Base predicate_result,  # 1 if ratio >= threshold

    # Private inputs
    Base credential_secret,
    Base commitment,
    Base my_value,          # Holder's value (e.g., token balance)
    Base total_supply,      # Total supply to compare against
    Base threshold_ratio,   # Threshold ratio (in basis points, e.g., 1000 = 10%)
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateClaimV1Ratio" {
    # ==========================================================================
    # NULLIFIER VERIFICATION
    # ==========================================================================

    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);
    constrain_equal_base(computed_nullifier, nullifier);

    # ==========================================================================
    # RATIO CALCULATION
    # ==========================================================================

    # Range checks to ensure inputs are well-formed
    range_check(64, my_value);
    range_check(64, total_supply);
    range_check(64, threshold_ratio);

    # Constrain predicate_result to be binary
    bool_check(predicate_result);

    # Calculate ratio: my_value / total_supply >= threshold_ratio
    # RC4 FIX: Replace base_div with cross-multiplication.
    # my_value / total_supply >= threshold_ratio / 10000
    # ⇔ my_value * 10000 >= threshold_ratio * total_supply
    BPS = witness_base(10000);
    my_value_scaled = base_mul(my_value, BPS);
    threshold_scaled = base_mul(threshold_ratio, total_supply);
    is_lte = less_than_or_equal(threshold_scaled, my_value_scaled);
    constrain_equal_base(is_lte, predicate_result);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    # The prover proves that my_value / total_supply >= threshold_ratio
    #
    # Example: threshold_ratio = 1000 (basis points)
    #          my_value = 1500, total_supply = 10000
    #          ratio = 1500/10000 = 0.15 = 15%
    #          15% >= 10% (1000 bps) → predicate_result = 1
    #
    # This enables predicates like:
    # - "Hold >= 10% of token supply"
    # - "Balance >= 1% of total"
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # - "Weight >= threshold_ratio"
}
