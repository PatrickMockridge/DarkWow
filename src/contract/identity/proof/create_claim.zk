# CreateClaim_V2 — unified claim creation circuit.
# Consolidates basic (mode 0), threshold/L1 (mode 1), ratio (mode 2),
# multi-AND (mode 3), and DAG path (mode 4) into a single circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
# Note: k=12 (4096 rows) — 30 witnesses with full mode multiplexing.
# The old per-variant circuits used k=11 with ≤19 witnesses each.
k = 12;
field = "pallas";

constant "CreateClaimV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV2" {
    Base mode,
    Base nullifier,
    Base claim_type,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,
    Base credential_secret,
    Base commitment,
    Base attribute_value,
    Base threshold,
    Base predicate_result,
    Base my_value,
    Base total_supply,
    Base threshold_ratio,
    Base secret_2,
    Base commitment_2,
    Base attribute_value_2,
    Base threshold_2,
    Base secret_3,
    Base commitment_3,
    Base attribute_value_3,
    Base threshold_3,
    Base path_index,
    Base num_credentials,
    Base is_lte_1,
    Base is_lte_2,
    Base is_lte_3,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateClaimV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    ONE = witness_base(1);
    ZERO = witness_base(0);
    BPS = witness_base(10000);

    # --- mode selector: exactly one of {0,1,2,3,4} ---
    is_basic     = is_equal_base(mode, witness_base(0));
    is_threshold = is_equal_base(mode, witness_base(1));
    is_ratio     = is_equal_base(mode, witness_base(2));
    is_multi     = is_equal_base(mode, witness_base(3));
    is_dag       = is_equal_base(mode, witness_base(4));
    sum_bt = base_add(is_basic, is_threshold);
    sum_btr = base_add(sum_bt, is_ratio);
    sum_btrm = base_add(sum_btr, is_multi);
    mode_sum = base_add(sum_btrm, is_dag);
    constrain_equal_base(mode_sum, ONE);

    # --- credential nullifiers ---
    n1 = poseidon_hash(DOMAIN_NULLIFIER, credential_secret, commitment);
    n2 = poseidon_hash(DOMAIN_NULLIFIER, secret_2, commitment_2);
    n3 = poseidon_hash(DOMAIN_NULLIFIER, secret_3, commitment_3);
    combined_12 = poseidon_hash(DOMAIN_NULLIFIER, n1, n2);
    combined = poseidon_hash(DOMAIN_NULLIFIER, combined_12, n3);

    # --- DAG path hash ---
    ph1 = poseidon_hash(DOMAIN_COIN_COMMIT, path_index, num_credentials);
    ph2 = poseidon_hash(DOMAIN_COIN_COMMIT, ph1, is_lte_1);
    ph3 = poseidon_hash(DOMAIN_COIN_COMMIT, ph2, is_lte_2);
    path_hash = poseidon_hash(DOMAIN_COIN_COMMIT, ph3, is_lte_3);
    dag_nullifier = poseidon_hash(DOMAIN_NULLIFIER, n1, path_hash);

    # --- bound nullifier = instance slot 1 ---
    bn1 = cond_select(is_dag, dag_nullifier, n1);
    bound_nullifier = cond_select(is_multi, combined, bn1);
    constrain_instance(bound_nullifier);
    constrain_equal_base(bound_nullifier, nullifier);

    # --- range / bool checks ---
    range_check(64, attribute_value);
    range_check(64, threshold);
    range_check(64, my_value);
    range_check(64, total_supply);
    range_check(64, threshold_ratio);
    range_check(64, attribute_value_2);
    range_check(64, threshold_2);
    range_check(64, attribute_value_3);
    range_check(64, threshold_3);
    bool_check(predicate_result);
    bool_check(is_lte_1);
    bool_check(is_lte_2);
    bool_check(is_lte_3);

    # --- threshold predicate: modes 0,1 MUST satisfy attr >= threshold ---
    is_lte = less_than_or_equal(threshold, attribute_value);
    need_lte = base_add(is_basic, is_threshold);
    constrain_equal_base(base_mul(need_lte, not_base(is_lte)), ZERO);

    # --- ratio predicate (cross-multiply, no division) ---
    my_value_scaled  = base_mul(my_value, BPS);
    threshold_scaled = base_mul(threshold_ratio, total_supply);
    is_lte_ratio = less_than_or_equal(threshold_scaled, my_value_scaled);

    # --- predicate_result binding per mode ---
    ep1 = cond_select(is_threshold, is_lte, ONE);
    expected_pred = cond_select(is_ratio, is_lte_ratio, ep1);
    constrain_equal_base(expected_pred, predicate_result);

    # --- tx binding: instance slots 2,3 ---
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
