k = 11;
field = "pallas";

constant "IssueCredentialV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "IssueCredentialV1" {
    # Public inputs
    Base commitment,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base holder_pub_x,
    Base holder_pub_y,
    Base schema_hash,
    Base issued_at,
    Base expires_at,

    # Private inputs
    Base issuer_secret,
    Base credential_secret,
    Base attribute_1,
    Base attribute_2,
    Base attribute_blind,
}

circuit "IssueCredentialV1" {
    # Derive issuer public key from secret
    issuer_public = ec_mul_base(issuer_secret, NULLIFIER_K);
    issuer_public_x = ec_get_x(issuer_public);
    issuer_public_y = ec_get_y(issuer_public);

    # Verify issuer public key matches
    constrain_equal_base(issuer_public_x, issuer_pub_x);
    constrain_equal_base(issuer_public_y, issuer_pub_y);

    # Create credential commitment: H(issuer_pub, holder_pub, schema, attributes, blinds)
    credential_data = poseidon_hash(
        issuer_pub_x,
        issuer_pub_y,
        holder_pub_x,
        holder_pub_y,
        schema_hash,
        attribute_1,
        attribute_2,
        attribute_blind,
    );

    # The commitment proves the credential exists without revealing attributes
    commitment_check = poseidon_hash(
        credential_data,
        credential_secret,
        issued_at,
        expires_at,
    );
    constrain_instance(commitment_check);

    # Verify the commitment matches the public input
    constrain_equal_base(commitment_check, commitment);
}