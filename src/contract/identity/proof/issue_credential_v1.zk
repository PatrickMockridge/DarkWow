// DarkFi Identity Contract - Issue Credential V1
//
// Circuit for issuing a credential. Proves the issuer legitimately
// created this credential without revealing the holder's attributes.

circuit issue_credential_v1(prover: Witness) {
    // ============================================
    // PUBLIC INPUTS
    // ============================================

    // Commitment to the credential
    commitment: Scalar = prover.pub_input("commitment");

    // Issuer's public key
    issuer_pub: Scalar = prover.pub_input("issuer_pub");

    // Holder's public key (committed)
    holder_pub: Scalar = prover.pub_input("holder_pub");

    // Schema hash defining credential structure
    schema_hash: Scalar = prover.pub_input("schema_hash");

    // ============================================
    // PRIVATE INPUTS (WITNESS)
    // ============================================

    // Credential attributes (encrypted/hidden)
    attributes: [Scalar] = prover.witness_array("attributes");

    // Issuer's secret key
    issuer_secret: Scalar = prover.witness("issuer_secret");

    // Credential secret (known only to holder)
    credential_secret: Scalar = prover.witness("credential_secret");

    // ============================================
    // COMMITMENT VERIFICATION
    // ============================================

    // Verify commitment = H(issuer_pub, holder_pub, schema_hash, attributes)
    computed_commitment: Scalar = poseidon_hash(
        issuer_pub,
        holder_pub,
        schema_hash,
        poseidon_hash_array(attributes)
    );
    assert_equal(computed_commitment, commitment);

    // ============================================
    // ISSUER SIGNATURE VERIFICATION
    // ============================================

    // Verify issuer signed the commitment
    // signature = H(issuer_secret, commitment)
    expected_sig: Scalar = poseidon_hash(issuer_secret, commitment);
    // In production: proper signature scheme

    // ============================================
    // ATTRIBUTE VALIDITY
    // ============================================

    // Verify all attributes are well-formed
    for attr in attributes {
        assert(attr > 0); // All attributes must be positive
    }
}

// ============================================
// NOTES
// ============================================
//
// The issue_credential circuit hides:
// - The actual attribute values (encrypted in commitment)
// - The credential secret
//
// What is revealed:
// - Issuer public key
// - Schema hash (what TYPE of credential)
// - That commitment is valid
//
// The holder can later prove attributes without revealing them!
// ============================================