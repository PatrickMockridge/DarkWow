# VerifyCapability_V2 circuit — domain-separated capability verification.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
#
# What this circuit proves, and what it did not until 2026-09-21:
#
#   * it proves the prover knows a credential secret, via the nullifier;
#   * it proves the credential's attribute satisfies a predicate;
#   * and it proves *nothing else*, while every consumer — `dao_escrow`, `labor_market`, `tender`,
#     `insurance_market` — treated it as an authorization. The capability's own record says what a
#     valid credential must be (`CredentialRequirement { schema_hash, issuer_pub, min_threshold }`,
#     `model/mod.rs:437-446`) and the circuit carried `schema_hash`, `issuer_pub_x/y` and `threshold`
#     as witnesses it never exposed, so no host could compare them: an unknown issuer, any schema,
#     and a threshold of zero were all acceptable. The nullifier was exposed and read by nobody, so a
#     revoked credential verified exactly like a live one.
#
# The four values are now public inputs. The host compares them against the capability record it
# already loads and discards, checks the threshold against the record's `min_threshold`, and uses the
# nullifier as a revocation handle. See OBL-Z17 in `doc/src/arch/verification-hazop.md`; possession
# (the credential *is* a box) is the part still open.
#
# AND the credential itself is bound. That was Stage 2, and without it the paragraph above was thin:
# `commitment` was a witness the prover picked, so the nullifier was over a commitment of their
# choosing, and a caller holding no credential at all could state a schema and an issuer that matched
# some capability and pass every check. The circuit now reconstructs the commitment from its preimage
# exactly as `issue_credential.zk:41-61` builds it — issuer, holder, schema, both attributes, the
# attribute blind, the credential secret and the validity window — and constrains the result. The
# predicate is evaluated over the *committed* attribute (`attribute_1`), not over a free witness.
#
# Still open, and it is the last piece: *possession*. The credential is a box, and
# `IDENTITY_CONTRACT_BOX_CONTRACT_ID` is stored for precisely the `Box::Take` child call that proves
# the caller holds it — nothing requires that call, so a caller who can *produce* a valid credential's
# preimage (not merely claim one) still passes without holding the box.
k = 11;
field = "pallas";

constant "VerifyCapabilityV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "VerifyCapabilityV2" {
    # The credential's preimage, exactly the fields `issue_credential.zk` hashes. `capability_id`,
    # `nullifier` (a duplicate of the exposed value), `capability_secret` (the input to the deleted
    # `computed_capability` binding) and `attribute_value` (a free witness standing in for the
    # committed attribute) are gone: a witness nothing reads is a value the prover chooses.
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base holder_pub_x,
    Base holder_pub_y,
    Base schema_hash,
    Base attribute_1,
    Base attribute_2,
    Base attribute_blind,
    Base credential_secret,
    Base issued_at,
    Base expires_at,
    Base commitment,
    Base threshold,
    Base predicate_result,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "VerifyCapabilityV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # The credential commitment, reconstructed from its preimage. The two hashes and the equality are
    # `issue_credential.zk`'s, unchanged: whatever the issuer committed to is what this proof is
    # about, and nothing else about it is knowable to the prover.
    credential_data = poseidon_hash(
        DOMAIN_COMMITMENT,
        issuer_pub_x,
        issuer_pub_y,
        holder_pub_x,
        holder_pub_y,
        schema_hash,
        attribute_1,
        attribute_2,
        attribute_blind,
    );

    commitment_check = poseidon_hash(
        DOMAIN_COMMITMENT,
        credential_data,
        credential_secret,
        issued_at,
        expires_at,
    );
    constrain_equal_base(commitment_check, commitment);

    # The nullifier, over the *bound* commitment — so it identifies a real credential, and not a
    # commitment the prover made up.
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # The predicate, over the *committed* attribute.
    range_check(64, attribute_1);
    range_check(64, threshold);
    bool_check(predicate_result);

    is_lte = less_than_or_equal(threshold, attribute_1);
    constrain_equal_base(is_lte, predicate_result);

    # REMOVED: `computed_capability = poseidon_hash(DOMAIN_NULLIFIER, capability_secret,
    # capability_id);` — computed and then used nowhere, so it tied nothing to anything. What binds a
    # proof to a capability is the credential's own content (above) plus the capability record's
    # requirement (host-side).

    # Exposed so the host can compare them against the capability record and the credential it
    # stores. `commitment` is among them because the stored `Credential` carries that field, so the
    # host can require the proof's commitment to be the stored one's.
    constrain_instance(schema_hash);
    constrain_instance(issuer_pub_x);
    constrain_instance(issuer_pub_y);
    constrain_instance(threshold);
    constrain_instance(predicate_result);
    constrain_instance(commitment);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
