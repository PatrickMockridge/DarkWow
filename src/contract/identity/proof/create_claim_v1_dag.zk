k = 12;
field = "pallas";

# Identity: Create DAG Claim (Version 1)
#
# Competency DAG: Multiple paths where ANY path can be satisfied (OR logic).
# Each path is an AND chain of credentials.
#
# Example: "Qualified Developer" can be achieved via:
#   PATH A: High School → Associate's → Bachelor's (all must pass)
#   PATH B: Self-Taught + Industry Certification (all must pass)
#
# This circuit verifies that one path is fully satisfied.

constant "CreateClaimV1DAG" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1DAG" {
    # Public inputs
    Base dag_id,              # DAG identifier
    Base path_index,          # Which path is being claimed
    Base path_hash,           # Merkle root of path structure
    Base num_credentials,     # Number of credentials in this path

    # Issuer info
    Base issuer_pub_x,        # Issuer public key X
    Base issuer_pub_y,        # Issuer public key Y

    # Path predicates (all must be 1 for path to pass)
    Base path_predicate_result,  # 1 if entire path is satisfied

    # Credential 1
    Base secret_1,
    Base commitment_1,
    Base attribute_1,
    Base threshold_1,

    # Credential 2
    Base secret_2,
    Base commitment_2,
    Base attribute_2,
    Base threshold_2,

    # Credential 3 (optional)
    Base secret_3,
    Base commitment_3,
    Base attribute_3,
    Base threshold_3,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateClaimV1DAG" {
    # ==========================================================================
    # PATH VERIFICATION (AND logic within the path)
    # ==========================================================================

    # Range checks for all attributes and thresholds
    range_check(64, attribute_1);
    range_check(64, threshold_1);
    range_check(64, attribute_2);
    range_check(64, threshold_2);
    range_check(64, attribute_3);
    range_check(64, threshold_3);

    # Verify each credential's predicate using LessThanOrEqual
    is_lte_1 = less_than_or_equal(threshold_1, attribute_1);
    is_lte_2 = less_than_or_equal(threshold_2, attribute_2);
    is_lte_3 = less_than_or_equal(threshold_3, attribute_3);

    # ==========================================================================
    # AND LOGIC - All credentials in path must be valid
    # ==========================================================================
    # Combine using multiplication (AND logic)
    path_satisfied = base_mul(is_lte_1, is_lte_2);
    path_satisfied = base_mul(path_satisfied, is_lte_3);

    # ==========================================================================
    # VERIFY PATH RESULT
    # ==========================================================================
    # The path_predicate_result should be 1 if all credentials pass
    ONE = witness_base(1);
    constrain_equal_base(path_satisfied, ONE);
    constrain_equal_base(path_satisfied, path_predicate_result);

    # ==========================================================================
    # DAG ROOT VERIFICATION
    # ==========================================================================
    # Verify the path is part of the DAG by checking path_hash
    computed_path_hash = poseidon_hash(path_index, num_credentials);
    computed_path_hash = poseidon_hash(computed_path_hash, is_lte_1);
    computed_path_hash = poseidon_hash(computed_path_hash, is_lte_2);
    computed_path_hash = poseidon_hash(computed_path_hash, is_lte_3);

    constrain_equal_base(computed_path_hash, path_hash);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    # The prover proves that:
    # 1. All credentials in this path have predicate satisfied (AND)
    # 2. The path is part of the DAG with dag_id
    # 3. The path_hash correctly represents this path
    #
    # This enables OR logic between multiple DAG paths:
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # - Path A passes OR Path B passes OR Path C passes
}