# IssueCredential_V2 circuit — domain-separated credential issuance.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant
k = 11;
field = "pallas";

constant "IssueCredentialV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "IssueCredentialV2" {
    Base commitment,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base holder_pub_x,
    Base holder_pub_y,
    Base schema_hash,
    Base issued_at,
    Base expires_at,
    Base issuer_secret,
    Base credential_secret,
    # Each attribute commits its *name* and its value: `attribute_N_hash` below. A value alone
    # cannot say whether it is a role or a tenure, so a capability naming an attribute had nothing to
    # compare against (OBL-Z17).
    Base attribute_1_name,
    Base attribute_1,
    Base attribute_2_name,
    Base attribute_2,
    Base attribute_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "IssueCredentialV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);
    DOMAIN_ATTRIBUTE = witness_base(10);

    # Derive issuer public key from secret
    issuer_public = ec_mul_base(issuer_secret, NULLIFIER_K);
    issuer_public_x = ec_get_x(issuer_public);
    issuer_public_y = ec_get_y(issuer_public);
    constrain_equal_base(issuer_public_x, issuer_pub_x);
    constrain_equal_base(issuer_public_y, issuer_pub_y);

    # Named attributes: one hash per slot, domain-separated, so the name inside the commitment is
    # the name a capability can compare against.
    attribute_1_hash = poseidon_hash(DOMAIN_ATTRIBUTE, attribute_1_name, attribute_1);
    attribute_2_hash = poseidon_hash(DOMAIN_ATTRIBUTE, attribute_2_name, attribute_2);

    # Create credential commitment
    credential_data = poseidon_hash(
        DOMAIN_COMMITMENT,
        issuer_pub_x,
        issuer_pub_y,
        holder_pub_x,
        holder_pub_y,
        schema_hash,
        attribute_1_hash,
        attribute_2_hash,
        attribute_blind,
    );

    commitment_check = poseidon_hash(
        DOMAIN_COMMITMENT,
        credential_data,
        credential_secret,
        issued_at,
        expires_at,
    );
    constrain_instance(commitment_check);

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_equal_base(commitment_check, commitment);
}
