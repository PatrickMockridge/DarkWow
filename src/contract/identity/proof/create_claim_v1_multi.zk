k = 11;
field = "pallas";

# Identity: Create Multi-Credential Claim (Version 1)
#
# Enables credential chaining for Competency DAG verification.
# Proves holder has multiple valid credentials meeting threshold requirements.
#
# Example: "Software Engineer" = Degree (>= 1) + Experience (>= 5 years)
#
# This circuit verifies all credentials in one proof using AND logic.

constant "CreateClaimV1Multi" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1Multi" {
    # Public inputs
    Base nullifier,           # Combined nullifier for all credentials
    Base claim_type,         # Type of claim (e.g., "software_engineer")
    Base issuer_pub_x,        # Issuer public key X (assumed same for all)
    Base issuer_pub_y,        # Issuer public key Y
    Base schema_hash,        # Hash of credential schema
    Base num_credentials,    # Number of credentials being verified

    # Credential 1
    Base secret_1,
    Base commitment_1,
    Base attribute_1,
    Base threshold_1,

    # Credential 2
    Base secret_2,
    Base commitment_2,
    Base attribute_2,
    Base threshold_2,

    # Credential 3 (optional, use 0 if not needed)
    Base secret_3,
    Base commitment_3,
    Base attribute_3,
    Base threshold_3,
    Base tx_commitment,
}

circuit "CreateClaimV1Multi" {
    # ==========================================================================
    # COMBINED NULLIFIER
    # ==========================================================================
    # Derive combined nullifier from all credential secrets
    computed_nullifier_1 = poseidon_hash(secret_1, commitment_1);
    computed_nullifier_2 = poseidon_hash(secret_2, commitment_2);
    computed_nullifier_3 = poseidon_hash(secret_3, commitment_3);

    # Combine all nullifiers
    combined = poseidon_hash(computed_nullifier_1, computed_nullifier_2);
    combined = poseidon_hash(combined, computed_nullifier_3);

    constrain_instance(combined);
    constrain_equal_base(combined, nullifier);

    # ==========================================================================
    # PREDICATE VERIFICATION (ALL credentials)
    # ==========================================================================

    # Range checks to ensure inputs are well-formed
    range_check(64, attribute_1);
    range_check(64, threshold_1);
    range_check(64, attribute_2);
    range_check(64, threshold_2);
    range_check(64, attribute_3);
    range_check(64, threshold_3);

    # Verify each credential's predicate using LessThanOrEqual
    is_lte_1 = less_than_or_equal(threshold_1, attribute_1);
    is_lte_2 = less_than_or_equal(threshold_2, attribute_2);
    is_lte_3 = less_than_or_equal(threshold_3, attribute_3);

    # ==========================================================================
    # AND LOGIC - All credentials must be valid
    # ==========================================================================
    # Combine using multiplication (AND logic)
    # is_lte_1 * is_lte_2 * is_lte_3 = 1 only if all are 1

    combined_predicates = base_mul(is_lte_1, is_lte_2);
    combined_predicates = base_mul(combined_predicates, is_lte_3);

    # Verify combined is 1 (all predicates satisfied)
    ONE = witness_base(1);
    constrain_equal_base(combined_predicates, ONE);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    # The prover proves that ALL of the following are true:
    # 1. credential_1.attribute_1 >= threshold_1
    # 2. credential_2.attribute_2 >= threshold_2
    # 3. credential_3.attribute_3 >= threshold_3
    #
    # If any credential is invalid or any threshold not met,
    constrain_instance(tx_commitment);
    # verification fails.
}
