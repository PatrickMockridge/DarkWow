k = 11;
field = "pallas";

constant "CreateClaimV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base predicate_result,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,

    # Private inputs
    Base credential_secret,
    Base attribute_value,
    Base threshold,
    Base commitment,
}

circuit "CreateClaimV1" {
    # Derive nullifier from credential secret and commitment
    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    constrain_equal_base(computed_nullifier, nullifier);

    # ============================================================
    # PREDICATE VERIFICATION
    # ============================================================
    # This circuit proves: attribute_value >= threshold
    # (e.g., proving "I am over 18" without revealing age)
    #
    # LESS THAN OR EQUAL LOGIC:
    # We need to verify: threshold <= attribute_value
    #
    # LessThanOrEqual(a, b) returns 1 if a <= b, 0 otherwise.
    # Available: LessThanLoose(a, b) which constrains a < b but returns nothing.
    #
    # Implementation using existing opcodes:
    #   less_than_or_equal(a, b) = is_equal(a, b) OR less_than_loose(a, b)
    #
    # Where is_equal(a, b) can be computed as:
    #   is_equal(a, b) = 1 - less_than_loose(a, b) - less_than_loose(b, a)
    #
    # This requires IsEqualBase(a, b) opcode that returns 0 or 1.
    #
    # PENDING: Implement LessThanOrEqual using IsEqualBase + LessThanLoose.
    # See: doc/src/zkas/bincode.md "Reasoned Opcodes: LessThanOrEqual"
    # ============================================================

    # Range checks to ensure inputs are well-formed
    range_check(64, attribute_value);
    range_check(64, threshold);

    # Placeholder: constrain predicate_result to itself (always true)
    # PENDING: Replace with actual less_than_or_equal verification
    # is_satisfied = less_than_or_equal(threshold, attribute_value);
    # constrain_equal_base(is_satisfied, predicate_result);
    constrain_equal_base(predicate_result, predicate_result);
}
