k = 11;
field = "pallas";

constant "CreateClaimV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base predicate_result,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,

    # Private inputs
    Base credential_secret,
    Base attribute_value,
    Base threshold,
    Base commitment,
}

circuit "CreateClaimV1" {
    # Derive nullifier from credential secret and commitment
    # nullifier = poseidon_hash(credential_secret, commitment)
    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    assert_equal(computed_nullifier, nullifier);

    # Verify predicate is satisfied: attribute_value >= threshold
    # This is the core of minimal viable information - we prove the condition
    # without revealing the actual attribute value
    is_satisfied = less_than_or_equal(threshold, attribute_value);
    result = is_satisfied as Base;
    constrain_instance(result);

    # Verify the predicate result matches
    assert_equal(result, predicate_result);

    # Additional constraints on inputs
    assert(attribute_value > 0);
    assert(threshold > 0);
}