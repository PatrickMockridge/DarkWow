k = 11;
field = "pallas";

constant "CreateClaimV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,

    # Private inputs
    Base credential_secret,
    Base attribute_value,
    Base threshold,
    Base commitment,
}

circuit "CreateClaimV1" {
    # Derive nullifier from credential secret and commitment
    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    constrain_equal_base(computed_nullifier, nullifier);

    # ============================================================
    # PREDICATE VERIFICATION (Level 0: zk_only)
    # ============================================================
    # This circuit proves: attribute_value >= threshold
    # without revealing the actual values or the result.
    #
    # Level 0 (zk_only): Verifier learns ONLY "proof is valid" or "invalid"
    # Level 1 (selective): Would reveal predicate_result publicly
    #
    # Using safemath assert_lte pattern: threshold < attribute + 1
    # This replaces LessThanOrEqual which was returning a Boolean publicly.
    #
    # See: doc/src/arch/safemath.md
    # See: doc/src/arch/experimental-opcodes.md
    # ============================================================

    # Range checks to ensure inputs are well-formed (prevents field wraparound)
    range_check(64, attribute_value);
    range_check(64, threshold);

    # Assert: threshold <= attribute_value
    # Pattern from assert_lte_u64_v1.zk: prove lhs <= rhs via lhs < rhs + 1
    ONE = witness_base(1);
    attribute_plus_one = base_add(attribute_value, ONE);
    less_than_strict(threshold, attribute_plus_one);
}
