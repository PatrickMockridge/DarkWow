k = 11;
field = "pallas";

constant "CreateClaimV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base predicate_result,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,

    # Private inputs
    Base credential_secret,
    Base attribute_value,
    Base threshold,
    Base commitment,
}

circuit "CreateClaimV1" {
    # Derive nullifier from credential secret and commitment
    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    constrain_equal_base(computed_nullifier, nullifier);

    # ============================================================
    # PREDICATE VERIFICATION
    # ============================================================
    # This circuit proves: attribute_value >= threshold
    # (e.g., proving "I am over 18" without revealing age)
    #
    # less_than_or_equal(a, b) returns 1 if a <= b, 0 otherwise.
    # is_equal_base(a, b) returns 1 if a == b, 0 otherwise.
    #
    # NOTE: These opcodes are experimental (grey-market goods).
    # See: doc/src/arch/zkvm_primitives.md "Experimental Status"
    # ============================================================

    # Range checks to ensure inputs are well-formed
    range_check(64, attribute_value);
    range_check(64, threshold);

    # Verify the attribute value satisfies the threshold:
    # is_authorized = 1 if threshold <= attribute_value, 0 otherwise.
    # The public input predicate_result should match this computed result.
    is_authorized = less_than_or_equal(threshold, attribute_value);
    constrain_equal_base(is_authorized, predicate_result);
}
