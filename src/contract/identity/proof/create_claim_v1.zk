k = 11;
field = "pallas";

constant "CreateClaimV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CreateClaimV1" {
    # Public inputs
    Base nullifier,
    Base claim_type,
    Base issuer_pub_x,
    Base issuer_pub_y,
    Base schema_hash,

    # Private inputs
    Base credential_secret,
    Base attribute_value,
    Base threshold,
    Base commitment,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateClaimV1" {
    # Derive nullifier from credential secret and commitment
    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);

    # Verify nullifier matches
    constrain_equal_base(computed_nullifier, nullifier);

    # ============================================================
    # PREDICATE VERIFICATION (Level 0: zk_only)
    # ============================================================
    # This circuit proves: attribute_value >= threshold
    # without revealing the actual values or the result.
    #
    # Level 0 (zk_only): Verifier learns ONLY "proof is valid" or "invalid"
    # Level 1 (selective): Would reveal predicate_result publicly
    #
    # Using verified LessThanOrEqual opcode (0x55) directly.
    # less_than_or_equal(a, b) returns 1 if a <= b, 0 otherwise.
    #
    # ALTERNATIVE: For Level 1 with public bit, see bounded equation:
    #   threshold + delta = attribute_value + (1 - result) * 2^64
    # This returns a public predicate_result bit using only proven opcodes.
    # See: doc/src/arch/safemath.md#bounded-equation-construction
    # ============================================================

    # Range checks to ensure inputs are well-formed (prevents field wraparound)
    range_check(64, attribute_value);
    range_check(64, threshold);

    # Assert: threshold <= attribute_value using verified LessThanOrEqual
    ONE = witness_base(1);
    is_lte = less_than_or_equal(threshold, attribute_value);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_equal_base(is_lte, ONE);
}
