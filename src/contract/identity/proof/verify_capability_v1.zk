k = 11;
field = "pallas";

# Identity: Verify Capability Proof (Version 1)
#
# Verifies a holder has a valid capability without revealing identity.
# Proves: holder owns capability_id AND meets threshold requirements.
#
# This circuit enables O-Cap (Object Capability) authorization:
# - Instead of ACLs ("Alice has access to X")
# - We use: prove you have capability for X → ACCESS GRANTED
#
# Uses LessThanOrEqual for threshold verification.

constant "VerifyCapabilityV1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "VerifyCapabilityV1" {
    # Public inputs
    Base capability_id,       # Hash of capability definition
    Base nullifier,          # From underlying credential
    Base issuer_pub_x,       # Issuer public key X
    Base issuer_pub_y,       # Issuer public key Y
    Base schema_hash,         # Required credential schema
    Base predicate_result,   # 1 if threshold <= attribute_value

    # Private inputs
    Base credential_secret,   # From holder's credential
    Base commitment,         # Credential commitment
    Base attribute_value,     # Holder's actual attribute value
    Base threshold,          # Required threshold for capability
    Base capability_secret,   # Derived from holder + capability_name
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "VerifyCapabilityV1" {
    # ==========================================================================
    # NULLIFIER VERIFICATION
    # ==========================================================================
    # Verify the underlying credential exists and is valid

    computed_nullifier = poseidon_hash(credential_secret, commitment);
    constrain_instance(computed_nullifier);
    constrain_equal_base(computed_nullifier, nullifier);

    # ==========================================================================
    # CAPABILITY SECRET VERIFICATION
    # ==========================================================================
    # Verify the holder owns this specific capability

    computed_capability = poseidon_hash(capability_secret, capability_id);
    # This could be constrained but is implicit in the proof

    # ==========================================================================
    # PREDICATE VERIFICATION
    # ==========================================================================
    # Verify: threshold <= attribute_value

    range_check(64, attribute_value);
    range_check(64, threshold);

    bool_check(predicate_result);

    is_lte = less_than_or_equal(threshold, attribute_value);
    constrain_equal_base(is_lte, predicate_result);

    # ==========================================================================
    # SEMANTIC GUARANTEE
    # ==========================================================================
    # The prover proves ALL of the following:
    # 1. credential_secret is valid for the credential commitment
    # 2. nullifier matches the credential
    # 3. threshold <= attribute_value (capability requirement met)
    # 4. capability_secret is bound to capability_id
    #
    # What verifier learns:
    # - capability_id (what capability is being proven)
    # - predicate_result (1 if requirements met, 0 if not)
    # - nullifier (proves credential exists, not who)
    #
    # What verifier does NOT learn:
    # - Who the holder is
    # - What the actual attribute_value or threshold is
    # - What the credential contains beyond the predicate
    #
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # This enables O-Cap authorization without identity revelation.
}