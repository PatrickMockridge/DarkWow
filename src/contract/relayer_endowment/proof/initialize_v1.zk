k = 11;
field = "pallas";

constant "Initialize" {
}

witness "Initialize" {
    Base relayer_pub_x,
    Base relayer_pub_y,
    Base config_hash,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Initialize" {
    derived_endowment_id = poseidon_hash(
        relayer_pub_x,
        relayer_pub_y,
        config_hash,
        nonce
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_endowment_id);
}