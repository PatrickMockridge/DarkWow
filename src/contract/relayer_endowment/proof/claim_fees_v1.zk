k = 11;
field = "pallas";

constant "ClaimFees" {
}

witness "ClaimFees" {
    Base deployment_id,
    Base backer_pub_x,
    Base backer_pub_y,
    Base fee_share,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ClaimFees" {
    derived_claim_id = poseidon_hash(
        deployment_id,
        backer_pub_x,
        backer_pub_y,
        fee_share,
        nonce
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_claim_id);
}