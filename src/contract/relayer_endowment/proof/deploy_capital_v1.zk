k = 11;
field = "pallas";

constant "DeployCapital" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "DeployCapital" {
    Base endowment_id,
    Base backer_pub_x,
    Base backer_pub_y,
    Base deploy_amount,
    Base token_id,
    Base nonce,
    Scalar value_blind,
    Base tx_commitment,
}

circuit "DeployCapital" {
    derived_deployment_id = poseidon_hash(
        endowment_id,
        backer_pub_x,
        backer_pub_y,
        deploy_amount,
        nonce
    );
    constrain_instance(derived_deployment_id);

    vcv = ec_mul_short(deploy_amount, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(tx_commitment);
    constrain_instance(ec_get_y(value_commit));
}