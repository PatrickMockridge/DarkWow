k = 11;
field = "pallas";

# initialize_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "InitializeV2" {
}

witness "InitializeV2" {
    Base relayer_pub_x,
    Base relayer_pub_y,
    Base config_hash,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "InitializeV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    derived_endowment_id = poseidon_hash(DOMAIN_COIN_COMMIT, 
        relayer_pub_x,
        relayer_pub_y,
        config_hash,
        nonce
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_endowment_id);
}