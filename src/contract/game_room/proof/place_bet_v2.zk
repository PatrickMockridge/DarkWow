# PlaceBet_V2 circuit — domain-separated game room bet placement.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "PlaceBetV2" { }
witness "PlaceBetV2" {
    Base room_id, Base pot_id, Base player_pub_x, Base player_pub_y,
    Base amount, Base block_height, Base nonce,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "PlaceBetV2" {
    DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COIN_COMMIT = witness_base(4);
    derived_bet_id = poseidon_hash(DOMAIN_COIN_COMMIT, pot_id, player_pub_x, amount, block_height);
    constrain_instance(derived_bet_id);
    derived_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, amount, nonce, block_height);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
    constrain_instance(derived_commitment);
}
