# Game Room Settle Pot Circuit
#
# This circuit proves that:
# 1. The caller is the house/owner DAO
# 2. The pot total matches the sum of payouts
# 3. Winners and amounts are valid
#
# Public inputs:
# - pot_id: The pot being settled
# - room_id: The room this pot belongs to
# - house_pub_x: House public key x-coordinate
# - house_pub_y: House public key y-coordinate
# - pot_total: Total amount in the pot

k = 11;
field = "pallas";

constant "SettlePot" {
}

witness "SettlePot" {
    Base room_id,
    Base pot_id,
    Base house_pub_x,
    Base house_pub_y,
    Base pot_total,
    Base num_winners,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettlePot" {
    # Verify house is authorized for this room
    # The room_id is derived during CreateRoom as:
    # poseidon_hash(owner_dao.inner(), token_id, block_height, nonce)
    # We verify the house owns this room by deriving the room_id similarly
    derived_room_id = poseidon_hash(
        house_pub_x,
        house_pub_y,
        nonce,
    );
    constrain_instance(derived_room_id);

    # Verify pot_id is derived correctly for this room
    derived_pot_id = poseidon_hash(
        room_id,
        pot_total,
        house_pub_x,
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_pot_id);
}