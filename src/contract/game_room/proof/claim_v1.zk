# Game Room Claim Circuit
#
# This circuit proves that:
# 1. The winner knows their secret key
# 2. The claim is for a valid settled pot
# 3. The payout amount is correct for this winner
#
# Public inputs:
# - claim_id: The derived claim ID (pot_id || winner_x || payout)
# - winner_pub_x: Winner's public key x-coordinate
# - winner_pub_y: Winner's public key y-coordinate
# - pot_id: The pot being claimed

k = 11;
field = "pallas";

constant "Claim" {
}

witness "Claim" {
    Base room_id,
    Base pot_id,
    Base winner_pub_x,
    Base winner_pub_y,
    Base payout_amount,
    Base nonce,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Claim" {
    # Derive claim_id from parameters (matches contract nullifier key format)
    # Contract stores: darkfi_serial::serialize(&(params.pot_id, params.winner.xy().0))
    derived_claim_id = poseidon_hash(
        pot_id,
        winner_pub_x,
        payout_amount,
        nonce,
    );
    constrain_instance(derived_claim_id);

    # Verify winner pubkey is valid
    derived_winner_key = poseidon_hash(
        winner_pub_x,
        winner_pub_y,
    );
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(derived_winner_key);
}