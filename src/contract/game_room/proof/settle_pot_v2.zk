# SettlePot_V2 circuit — domain-separated game room pot settlement.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "SettlePotV2" { }
witness "SettlePotV2" {
    Base room_id, Base pot_id, Base house_pub_x, Base house_pub_y,
    Base pot_total, Base num_winners, Base nonce,
    Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "SettlePotV2" {
    DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COIN_COMMIT = witness_base(4);
    derived_room_id = poseidon_hash(DOMAIN_COIN_COMMIT, house_pub_x, house_pub_y, nonce);
    constrain_instance(derived_room_id);
    derived_pot_id = poseidon_hash(DOMAIN_COIN_COMMIT, room_id, pot_total, house_pub_x);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
    constrain_instance(derived_pot_id);
}
