# Game Room Place Bet Circuit
#
# This circuit proves that:
# 1. The player knows their secret key
# 2. The bet commitment is correctly derived
# 3. The bet amount is valid
#
# Public inputs:
# - bet_id: The derived bet ID

k = 11;
field = "pallas";

constant "PlaceBet" {
}

witness "PlaceBet" {
    Base room_id,
    Base pot_id,
    Base player_pub_x,
    Base player_pub_y,
    Base amount,
    Base block_height,
    Base nonce,
    Base tx_commitment,
}

circuit "PlaceBet" {
    # Derive bet_id from parameters (same as contract)
    derived_bet_id = poseidon_hash(
        pot_id,
        player_pub_x,
        amount,
        block_height,
    );
    constrain_instance(derived_bet_id);

    # Verify commitment for the bet
    derived_commitment = poseidon_hash(
        amount,
        nonce,
        block_height,
    );
    constrain_instance(tx_commitment);
    constrain_instance(derived_commitment);
}