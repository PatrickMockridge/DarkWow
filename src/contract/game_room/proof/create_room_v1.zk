# Game Room Create Room Circuit
#
# This circuit proves that:
# 1. The room_id is correctly derived from the owner and parameters
#
# Public inputs:
# - room_id: The derived room ID

k = 11;
field = "pallas";

constant "CreateRoom" {
}

witness "CreateRoom" {
    Base owner_pub_x,
    Base owner_pub_y,
    Base token_id,
    Base block_height,
    Base nonce,
}

circuit "CreateRoom" {
    # Derive room_id from parameters (same as contract)
    derived_room_id = poseidon_hash(
        owner_pub_x,
        owner_pub_y,
        token_id,
        block_height,
        nonce,
    );
    constrain_instance(derived_room_id);
}