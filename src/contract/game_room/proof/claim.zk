# Claim_V2 circuit — domain-separated game room winner claim.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "ClaimV2" { }
witness "ClaimV2" {
    Base room_id, Base pot_id, Base winner_pub_x, Base winner_pub_y,
    Base payout_amount, Base nonce, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "ClaimV2" {
    DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COMMITMENT = witness_base(4);
    derived_claim_id = poseidon_hash(DOMAIN_COMMITMENT, pot_id, winner_pub_x, payout_amount, nonce);
    constrain_instance(derived_claim_id);
    derived_winner_key = poseidon_hash(DOMAIN_COMMITMENT, winner_pub_x, winner_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
}
