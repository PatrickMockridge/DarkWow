# Deposit_V2 circuit — domain-separated game room deposit.
# V2 changes from V1 (HAZOP RC3): domain separation on poseidon_hash
k = 11; field = "pallas";
constant "DepositV2" { }
witness "DepositV2" {
    Base room_id, Base player_pub_x, Base player_pub_y, Base amount,
    Base nonce, Base tx_commitment, Base tx_nonce, Base tx_binding,
}
circuit "DepositV2" {
    DOMAIN_TX_BINDING = witness_base(3); DOMAIN_COMMITMENT = witness_base(4);
    derived_account_key = poseidon_hash(DOMAIN_COMMITMENT, room_id, player_pub_x);
    constrain_instance(derived_account_key);
    derived_player_key = poseidon_hash(DOMAIN_COMMITMENT, player_pub_x, player_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding); constrain_instance(tx_nonce);
    constrain_instance(derived_player_key);
}
