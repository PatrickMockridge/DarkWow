# Slot Machine Settle Bet Circuit
#
# This circuit proves that a spin result was correctly derived from entropy
# and the payout was calculated according to the paytable.

k = 14;
field = "pallas";

# settle_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SettleBet_V2" {
}

witness "SettleBet_V2" {
    Base player_pub_x,
    Base player_pub_y,
    Base bet_value,
    Base paylines,
    Base secret_nonce,
    Base blind,
    Base asset_id,
    Base position_0,
    Base position_1,
    Base position_2,
    Base match_count,
    Base payout,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettleBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Verify the spin_id matches our known parameters.
    # Must match the on-chain derivation in commit_bet_v1.rs:
    # spin_id = poseidon_hash(DOMAIN_COMMITMENT, [player_pub_x, player_pub_y, bet_value,
    #                         paylines, secret_nonce, blind, asset_id])
    derived_spin_id = poseidon_hash(DOMAIN_COMMITMENT, 
        player_pub_x,
        player_pub_y,
        bet_value,
        paylines,
        secret_nonce,
        blind,
        asset_id,
    );
    constrain_instance(derived_spin_id);

    # Verify payout is correctly computed (output)
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(payout);
}