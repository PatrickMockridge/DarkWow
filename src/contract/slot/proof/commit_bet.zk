# Slot Machine Commit Bet Circuit
#
# This circuit proves that a player has committed to a valid slot spin
# without revealing the bet parameters or secret nonce.
#
# The player knows:
# - Their secret nonce (for randomness)
# - Their bet value (per line)
# - Number of paylines
# - Their blinding factor
# - Their token ID
#
# Public inputs:
# - spin_id: The Poseidon hash commitment
# - value_commit: Pedersen commitment to the bet value

k = 11;
field = "pallas";

# commit_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Pedersen commitment generators for value
constant "CommitBet_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

# Private witnesses
witness "CommitBet_V2" {
    # Player's public key coordinates
    Base player_pub_x,
    Base player_pub_y,

    # Spin parameters
    Base bet_value,
    Base paylines,
    Base secret_nonce,
    Base blind,
    Base asset_id,

    # Pedersen blinding factor for value commitment
    Scalar value_blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CommitBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # Derive spin ID from parameters (same as contract)
    spin_id = poseidon_hash(DOMAIN_COIN_COMMIT, 
        player_pub_x,
        player_pub_y,
        bet_value,
        paylines,
        secret_nonce,
        blind,
        asset_id,
    );
    constrain_instance(spin_id);

    # Verify value commitment matches bet_value + blind
    vcv = ec_mul_short(bet_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # At this point we've enforced all of our public inputs.
}