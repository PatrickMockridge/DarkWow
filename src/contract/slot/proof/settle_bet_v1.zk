# Slot Machine Settle Bet Circuit
#
# This circuit proves that a spin result was correctly derived from entropy
# and the payout was calculated according to the paytable.

k = 14;
field = "pallas";

constant "SettleBet_V1" {
}

witness "SettleBet_V1" {
    Base player_pub_x,
    Base player_pub_y,
    Base bet_value,
    Base paylines,
    Base secret_nonce,
    Base blind,
    Base token_id,
    Base position_0,
    Base position_1,
    Base position_2,
    Base match_count,
    Base payout,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettleBet_V1" {
    # Verify the spin_id matches our known parameters.
    # Must match the on-chain derivation in commit_bet_v1.rs:
    # spin_id = poseidon_hash([player_pub_x, player_pub_y, bet_value,
    #                         paylines, secret_nonce, blind, token_id])
    derived_spin_id = poseidon_hash(
        player_pub_x,
        player_pub_y,
        bet_value,
        paylines,
        secret_nonce,
        blind,
        token_id,
    );
    constrain_instance(derived_spin_id);

    # Verify payout is correctly computed (output)
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(payout);
}