# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# cancel_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Escrow Cancel Circuit (Version 1)
#
# This circuit proves:
# - Buyer knows buyer_secret
# - buyer_pubkey derived from buyer_secret matches escrow.buyer_pubkey
# - The escrow is in Created state (not funded/claimed) — CONTRACT ENFORCED
#
# Replaces Schnorr signature verification. Buyer proves knowledge of
# their secret key inside ZK without exposing a raw EC point in a signature.
#
# Public Inputs (constrain_instance):
#   - escrow_id: The escrow identifier
#   - buyer_pub_x: Buyer public key X coordinate (verified against stored escrow)
#   - buyer_pub_y: Buyer public key Y coordinate (verified against stored escrow)
#   - cancel_nullifier: Nullifier proving the cancel is authorized
#
# Witnesses:
#   - buyer_secret: Buyer's secret key

constant "CancelEscrowV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "CancelEscrowV2" {
    # Escrow identifier
    Base escrow_id,

    # Buyer's secret (proves ownership)
    Base buyer_secret,

    # Buyer public key coordinates (passed as public input, verified against escrow state)
    Base buyer_pub_x,
    Base buyer_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CancelEscrowV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    # Derive buyer public key from secret
    # buyer_pub = buyer_secret * G
    buyer_pub = ec_mul_base(buyer_secret, NULLIFIER_K);
    buyer_pub_x_computed = ec_get_x(buyer_pub);
    buyer_pub_y_computed = ec_get_y(buyer_pub);

    # Verify derived buyer_pub matches the public inputs
    # Entrypoint verifies these match the escrow's stored buyer_pubkey
    constrain_equal_base(buyer_pub_x_computed, buyer_pub_x);
    constrain_equal_base(buyer_pub_y_computed, buyer_pub_y);

    # Compute cancel nullifier
    # cancel_nullifier = H(escrow_id, buyer_secret)
    cancel_nullifier = poseidon_hash(DOMAIN_NULLIFIER, escrow_id, buyer_secret);

    # Expose public inputs
    constrain_instance(escrow_id);
    constrain_instance(buyer_pub_x);
    constrain_instance(buyer_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(cancel_nullifier);
}
