# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# refund_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Escrow Refund Circuit (Version 1)
#
# This circuit proves:
# - Buyer knows buyer_secret
# - buyer_pubkey derived from buyer_secret matches escrow.buyer_pubkey
# - The escrow is in Funded state (not already spent)
#
# This circuit does **not** prove the timelock. It used to carry
# `less_than_strict(timeout, current_block)`, which proves nothing: both operands are witnesses
# the prover supplies, so the comparison holds for any pair the prover chooses. The timelock is
# enforced by the host, which reads `current_block` from the chain
# (`wasm::util::get_verifying_block_height()`) and `escrow.timeout` from the escrow record
# (`src/contract/escrow/src/entrypoint.rs:647-652`) — neither value is taken from this proof. The
# un-sound check was removed rather than bounded, because a proof the host does not consult
# should not read as if it were the enforcement.
#
# Public Inputs (constrain_instance):
#   - escrow_id: The escrow identifier
#   - timeout: The refund timeout block height
#   - current_block: Current block height (revealed by block proposer)
#   - buyer_pub_x, buyer_pub_y: Buyer's public key (must match escrow)
#   - spent_nullifier: Nullifier proving the escrow is spent
#
# Witnesses:
#   - buyer_secret: Buyer's secret key

constant "RefundEscrowV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "RefundEscrowV2" {
    # Escrow identifier
    Base escrow_id,

    # Timeout from escrow storage
    Base timeout,

    # Current block height (revealed by chain)
    Base current_block,

    # Buyer's secret (proves ownership)
    Base buyer_secret,

    # Buyer public key passed as public input
    Base input_buyer_pub_x,
    Base input_buyer_pub_y,

    # Stored buyer public key from escrow (revealed for verification)
    Base escrow_buyer_pub_x,
    Base escrow_buyer_pub_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "RefundEscrowV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    # REMOVED: `less_than_strict(timeout, current_block);`
    #
    # Both operands were prover-supplied witnesses, so the check asserted only that the prover
    # chose two numbers in a certain order, and the host never reads either value from the proof
    # (`entrypoint.rs:647-652` compares chain height against `escrow.timeout`). Kept: the two
    # witnesses remain public inputs — see `script/circuit_free_instances.txt`, where both are
    # declared free precisely because the host does not consult the proof's copies.

    # Derive buyer public key from secret
    # buyer_pub = buyer_secret * G
    buyer_pub = ec_mul_base(buyer_secret, NULLIFIER_K);
    buyer_pub_x = ec_get_x(buyer_pub);
    buyer_pub_y = ec_get_y(buyer_pub);

    # Verify derived public key matches the escrow's buyer public key
    constrain_equal_base(buyer_pub_x, escrow_buyer_pub_x);
    constrain_equal_base(buyer_pub_y, escrow_buyer_pub_y);

    # CRITICAL: Verify buyer_pub matches the public input
    # This prevents an attacker from refunding to a different recipient
    constrain_equal_base(buyer_pub_x, input_buyer_pub_x);
    constrain_equal_base(buyer_pub_y, input_buyer_pub_y);

    # Compute nullifier
    # nullifier = H(escrow_id, buyer_secret)
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, escrow_id, buyer_secret);

    # Expose public inputs
    constrain_instance(escrow_id);
    constrain_instance(timeout);
    constrain_instance(current_block);
    constrain_instance(input_buyer_pub_x);
    constrain_instance(input_buyer_pub_y);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(spent_nullifier);
}
