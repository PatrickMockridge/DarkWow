# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# claim_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Escrow Claim Circuit (Version 1)
#
# This circuit proves:
# - Seller knows seller_secret
# - seller_pubkey derived from seller_secret matches escrow.seller_pubkey via H(seller_pub)
# - The escrow is in Funded state (not already spent) - CONTRACT ENFORCED
#
# PRIVACY IMPROVEMENT: seller_pub is NOT exposed on-chain.
# Instead, we verify H(seller_pub) matches the escrow's stored commitment.
# This allows private verification at claim time without revealing the seller's public key.
#
# This uses the Hashed Timelock pattern:
# - Seller reveals spent_nullifier = H(escrow_id, seller_secret)
# - The nullifier is recorded to prevent double-claim
#
# Public Inputs (constrain_instance):
#   - escrow_id: The escrow identifier
#   - seller_commitment: H(seller_pub_x, seller_pub_y) - private verification, does not expose seller_pub
#   - spent_nullifier: Nullifier proving the escrow is spent
#
# Witnesses:
#   - seller_secret: Seller's secret key
#
# SECURITY NOTE: This circuit does NOT verify escrow state directly.
# The contract layer MUST verify the escrow is in "Funded" state before
# accepting this proof. Without this check, an already-refunded or
# already-claimed escrow could be claimed again.

constant "ClaimEscrowV2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ClaimEscrowV2" {
    # Escrow identifier
    Base escrow_id,

    # Seller's secret (proves ownership)
    Base seller_secret,

    # Recipient public key coordinates (passed as public input)
    Base seller_x,
    Base seller_y,

    # Stored seller commitment from escrow: H(seller_pub_x, seller_pub_y)
    # Allows private verification without revealing seller_pub on-chain
    Base escrow_seller_commitment,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ClaimEscrowV2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Derive seller public key from secret
    # seller_pub = seller_secret * G
    seller_pub = ec_mul_base(seller_secret, NULLIFIER_K);
    seller_pub_x = ec_get_x(seller_pub);
    seller_pub_y = ec_get_y(seller_pub);

    # ==========================================================================
    # PRIVACY: Verify seller_commitment without revealing seller_pub on-chain
    # ==========================================================================
    # Compute H(seller_pub) and verify it matches the escrow's stored commitment.
    # This allows the seller to prove knowledge of seller_secret without
    # exposing seller_pub_x/y on-chain.

    seller_commitment_computed = poseidon_hash(DOMAIN_COMMITMENT, seller_pub_x, seller_pub_y);
    constrain_equal_base(seller_commitment_computed, escrow_seller_commitment);

    # Compute nullifier
    # nullifier = H(escrow_id, seller_secret)
    spent_nullifier = poseidon_hash(DOMAIN_NULLIFIER, escrow_id, seller_secret);

    # CRITICAL: Verify recipient_pubkey matches the derived seller public key
    # This prevents an attacker from claiming to a different recipient
    constrain_equal_base(seller_pub_x, seller_x);
    constrain_equal_base(seller_pub_y, seller_y);

    # Expose public inputs
    constrain_instance(escrow_id);
    constrain_instance(escrow_seller_commitment);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(spent_nullifier);
}
