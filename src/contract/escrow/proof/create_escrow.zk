# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# create_escrow_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

# Escrow Create Circuit (Version 1)
#
# This circuit proves:
# - Buyer knows (buyer_pubkey, buyer_secret)
# - Seller's public key is correctly formed
# - Escrow commitment is correctly computed from public parameters
#
# PRIVACY IMPROVEMENT: seller_pub is NOT exposed in the commitment.
# Instead, we store H(seller_pub) which allows private verification
# at claim time without revealing the seller's public key on-chain.
#
# Public Inputs (constrain_instance):
#   - commitment = H(buyer_pub.x, buyer_pub.y, H(seller_pub), value, asset_id, timeout)
#   - seller_commitment = H(seller_pub.x, seller_pub.y)
#
# Witnesses:
#   - buyer_pub_x, buyer_pub_y: Buyer's public key coordinates
#   - seller_pub_x, seller_pub_y: Seller's public key coordinates
#   - value: Escrow value (u64)
#   - asset_id: Token identifier
#   - timeout: Refund timeout block height
#   - buyer_secret: Buyer's secret for deriving public key

constant "CreateEscrowV2" {
    EcFixedPointBase NULLIFIER_K,
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

witness "CreateEscrowV2" {
    # Buyer's public key
    Base buyer_pub_x,
    Base buyer_pub_y,

    # Seller's public key
    Base seller_pub_x,
    Base seller_pub_y,

    # Escrow parameters
    Base value,
    Base asset_id,
    Base timeout,

    # Buyer's secret (for key derivation, not revealed)
    Base buyer_secret,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "CreateEscrowV2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # Verify buyer public key is correctly derived from secret
    # buyer_pub = buyer_secret * G
    buyer_pub_computed = ec_mul_base(buyer_secret, NULLIFIER_K);
    buyer_pub_computed_x = ec_get_x(buyer_pub_computed);
    buyer_pub_computed_y = ec_get_y(buyer_pub_computed);
    # Constrain computed pubkey to match revealed pubkey
    constrain_equal_base(buyer_pub_x, buyer_pub_computed_x);
    constrain_equal_base(buyer_pub_y, buyer_pub_computed_y);

    # ==========================================================================
    # PRIVACY: Compute seller commitment (hides seller_pub on-chain)
    # ==========================================================================
    #
    # Instead of including seller_pub directly in the commitment (which would
    # reveal the seller's public key on-chain), we include H(seller_pub).
    #
    # At claim time, the circuit verifies H(seller_pub) privately without
    # exposing seller_pub_x/y on-chain.

    seller_commitment = poseidon_hash(DOMAIN_COIN_COMMIT, seller_pub_x, seller_pub_y);

    # Compute escrow commitment
    # C = H(buyer_pub.x, buyer_pub.y, H(seller_pub), value, asset_id, timeout)
    C = poseidon_hash(DOMAIN_COIN_COMMIT, 
        buyer_pub_x,
        buyer_pub_y,
        seller_commitment,
        value,
        asset_id,
        timeout,
    );

    # Expose commitment and seller commitment as public inputs
    constrain_instance(C);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(seller_commitment);
}
