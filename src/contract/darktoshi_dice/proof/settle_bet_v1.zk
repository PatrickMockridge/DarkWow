# DarkToshi Dice Settle Bet Circuit
#
# Proves:
# 1. Player knows the secret nonce that derives the bet_id
# 2. Roll hash is correctly computed from block_hash + bet_id + secret_nonce
#
# The contract computes roll_result = roll_hash.to_repr()[0] % 100 off-circuit
# (cheap integer arithmetic, no expensive ZK ops needed).

k = 11;
field = "pallas";

constant "SettleBet_V1" {
}

witness "SettleBet_V1" {
    Base player_pub_x,
    Base player_pub_y,
    Base bet_value,
    Base target,
    Base secret_nonce,
    Base blind,
    Base token_id,

    # Block hash from entropy module (tx_hash_to_base)
    Base block_hash,
}

circuit "SettleBet_V1" {
    # Verify the secret nonce derives the bet_id
    derived_bet_id = poseidon_hash(
        player_pub_x,
        player_pub_y,
        bet_value,
        target,
        secret_nonce,
        blind,
        token_id,
    );
    constrain_instance(derived_bet_id);

    # Compute roll hash: poseidon_hash([block_hash, bet_id, secret_nonce])
    # Contract layer does roll_hash.to_repr()[0] % 100 off-circuit.
    roll_hash = poseidon_hash(
        block_hash,
        derived_bet_id,
        secret_nonce,
    );
    constrain_instance(roll_hash);
}