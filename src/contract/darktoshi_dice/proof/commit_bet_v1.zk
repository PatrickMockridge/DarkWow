# DarkToshi Dice Commit Bet Circuit
#
# This circuit proves that a player has committed to a valid bet
# without revealing the bet parameters.
#
# The player knows:
# - Their secret nonce
# - Their bet value
# - Their target number
# - Their blinding factor
# - Their token ID
#
# Public inputs:
# - bet_id: The Poseidon hash commitment
# - value_commit: Pedersen commitment to the bet value

k = 11;
field = "pallas";

# Pedersen commitment generators for value
constant "CommitBet_V1" {
    EcFixedPointShort VALUE_COMMIT_VALUE,
    EcFixedPoint VALUE_COMMIT_RANDOM,
}

# Private witnesses
witness "CommitBet_V1" {
    # Player's public key coordinates
    Base player_pub_x,
    Base player_pub_y,

    # Bet parameters
    Base bet_value,
    Base target,
    Base secret_nonce,
    Base blind,
    Base token_id,

    # Pedersen blinding factor for value commitment
    Scalar value_blind,
}

circuit "CommitBet_V1" {
    # Derive bet ID from parameters (same as contract)
    bet_id = poseidon_hash(
        player_pub_x,
        player_pub_y,
        bet_value,
        target,
        secret_nonce,
        blind,
        token_id,
    );
    constrain_instance(bet_id);

    # Verify value commitment matches bet_value + blind
    vcv = ec_mul_short(bet_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # At this point we've enforced all of our public inputs.
}
