# DarkToshi Dice Settle Bet Circuit
#
# Proves:
# 1. Player knows the secret nonce that derives the bet_id
# 2. Roll hash is correctly computed from block_hash + bet_id + secret_nonce
#
# The contract computes roll_result = roll_hash.to_repr()[0] % 100 off-circuit
# (cheap integer arithmetic, no expensive ZK ops needed).

k = 11;
field = "pallas";

# settle_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SettleBet_V2" {
}

witness "SettleBet_V2" {
    Base player_pub_x,
    Base player_pub_y,
    Base bet_value,
    Base target,
    Base secret_nonce,
    Base blind,
    Base asset_id,

    # Block hash from entropy module (tx_hash_to_base)
    Base block_hash,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettleBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Verify the secret nonce derives the bet_id
    derived_bet_id = poseidon_hash(DOMAIN_COMMITMENT, 
        player_pub_x,
        player_pub_y,
        bet_value,
        target,
        secret_nonce,
        blind,
        asset_id,
    );
    constrain_instance(derived_bet_id);

    # Compute roll hash: poseidon_hash(DOMAIN_COMMITMENT, [block_hash, bet_id, secret_nonce])
    # Contract layer does roll_hash.to_repr()[0] % 100 off-circuit.
    roll_hash = poseidon_hash(DOMAIN_COMMITMENT, 
        block_hash,
        derived_bet_id,
        secret_nonce,
    );
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(roll_hash);
}