# The k parameter defining the number of rows used in our circuit (2^k)
k = 11;
field = "pallas";

# DrainProtection Exit Circuit (Version 1)
#
# Proves a member can exit with a haircut from the endowment/treasury.
#
# This circuit proves:
# - Member is a valid DAO-Escrow member
# - Member's contribution weight is correctly computed
# - Exit value calculation is correct
#
# Public Inputs (constrain_instance):
#   - fund_id: DAO-Escrow fund identifier
#   - member_pub_x, member_pub_y: Member's public key coordinates
#   - contribution_weight: Member's block-height-adjusted weight
#   - current_funds: Total funds in endowment
#   - exit_value: Payout after haircut
#   - dao_escrow_bulla: DAO-Escrow identifier
#
# Witnesses:
#   - member_secret: Member's secret key
#   - deposited_at: Block when contribution was made
#   - contribution_amount: Raw contribution amount
#   - current_block: Current block height

constant "ExitProof" {
    EcFixedPointBase NULLIFIER_K,
}

witness "ExitProof" {
    # Fund identifier
    Base fund_id,

    # Current block height
    Base current_block,

    # Member's secret key
    Base member_secret,

    # Member's public key coordinates (public input - must match derived)
    Base member_pub_x,
    Base member_pub_y,

    # Contribution details
    Base deposited_at,
    Base contribution_amount,

    # DAO-Escrow verification
    Base dao_escrow_bulla,
    Base dao_membership_note,

    # Constant for time multiplier divisor (10000 = 10_000)
    Base DIVISOR,

    # Constant for exit multiplier (6667 = 10_000 - 3333 bps haircut)
    Base EXIT_MULTIPLIER,

    # ==========================================================================
    # MERKLE PROOF FOR DAO-ESCROW MEMBERSHIP VERIFICATION
    # ==========================================================================
    # These prove the member is in the DAO-Escrow membership Merkle tree

    # Position of the membership leaf in the DAO-Escrow Merkle tree
    Uint32 dao_leaf_pos,

    # Merkle authentication path for the membership note
    MerklePath dao_path,

    # DAO-Escrow Merkle root (public input - stored in DrainProtection state)
    Base dao_escrow_merkle_root,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "ExitProof" {
    # ==========================================================================
    # PHASE 1: Derive member public key from secret
    # ==========================================================================

    member_pub = ec_mul_base(member_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(member_pub);
    derived_pub_y = ec_get_y(member_pub);

    # CRITICAL: Verify derived public key matches the public input
    # This binds the member_secret to the member_pubkey
    constrain_equal_base(derived_pub_x, member_pub_x);
    constrain_equal_base(derived_pub_y, member_pub_y);

    # ==========================================================================
    # PHASE 2: Compute contribution weight (block-height-adjusted)
    # ==========================================================================
    #
    # weight = contribution × (1_000 + blocks_held / 10_000) / 1_000
    # where blocks_held = current_block - deposited_at
    #
    # Capped at 3x multiplier after ~20,000 blocks

    # less_than_strict: ensures current_block >= deposited_at
    less_than_strict(deposited_at, current_block);

    blocks_held = base_sub(current_block, deposited_at);

    # multiplier = 1_000 + min(blocks_held / 10_000, 2_000)
    # This gives up to 3x weight after ~20k blocks
    time_multiplier = base_div(blocks_held, DIVISOR);

    # Effective weight
    effective_weight = base_mul(contribution_amount, time_multiplier);

    # ==========================================================================
    # PHASE 3: Verify DAO-Escrow membership via Merkle proof
    # ==========================================================================
    #
    # This verifies the member is in the DAO-Escrow membership Merkle tree.
    # The membership note was issued by DAO-Escrow's pay_premium circuit.
    #
    # Composability pattern: DrainProtection verifies DAO-Escrow membership
    # by checking a Merkle proof. No direct state sharing - pure ZK verification.

    # Verify the Merkle proof of the membership note
    # This proves the membership_note exists in DAO-Escrow's tree
    verified_dao_root = merkle_root(dao_leaf_pos, dao_path, dao_membership_note);
    constrain_equal_base(verified_dao_root, dao_escrow_merkle_root);

    # The Merkle proof verifies dao_membership_note is in the DAO-Escrow tree.
    # This proves the membership belongs to this member without exposing
    # additional data. The membership_note was created with member_pub
    # bound inside it (in pay_premium_v1.zk), so Merkle proof = ownership proof.

    # ==========================================================================
    # PHASE 4: Compute exit value with haircut
    # ==========================================================================
    #
    # exit_value = (weight / total_weight) × current_funds × 0.666
    # haircut = 1/3 withheld

    # haircut_bps = 3333 (33.33%)
    # exit_multiplier = 10_000 - haircut_bps = 6667
    exit_value = base_mul(effective_weight, EXIT_MULTIPLIER);
    # Note: Final division by total_weight and current_funds normalization
    # would be done in the contract or with additional constraints

    # ==========================================================================
    # PHASE 5: Expose public inputs
    # ==========================================================================

    constrain_instance(fund_id);
    constrain_instance(member_pub_x);
    constrain_instance(member_pub_y);
    constrain_instance(dao_escrow_bulla);
    constrain_instance(dao_membership_note);
    # HAZOP ELEV-3 FIX: dao_escrow_merkle_root was constrained internally by the
    # Merkle proof (constrain_equal_base) but never exposed as a public input.
    # Without constrain_instance, the prover could use ANY Merkle root — the host
    # never verified it against the on-chain DAO-Escrow tree root.
    constrain_instance(dao_escrow_merkle_root);
    constrain_instance(effective_weight);

    # ==========================================================================
    # SOUNDNESS NOTES
    # ==========================================================================
    #
    # This circuit uses ONLY proven opcodes (no grey-market opcodes):
    #   - less_than_strict: constrain-only comparison (SOUND)
    #   - ec_mul_base, ec_get_x, ec_get_y: standard EC operations
    #   - constrain_equal_base: equality constraint
    #   - base_add, base_sub, base_mul, base_div: field arithmetic
    #   - constrain_instance: public input exposure
    #
    # There are NO uses of:
    #   - LessThanOrEqual (gate soundness issue)
    #   - IsEqualBase (delta-invert issue when a == b)

    # ==========================================================================
    # TODO: Remaining work
    # ==========================================================================
    #
    # 1. Add total_weight verification (from on-chain state)
    #
    # 2. Add current_funds verification (from on-chain state)
    #
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # 3. Complete exit_value calculation with proper division
}