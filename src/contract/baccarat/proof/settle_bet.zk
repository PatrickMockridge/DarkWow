# Baccarat Settle Bet Circuit
#
# This circuit proves that:
# 1. The player knows the secret nonce that derives the bet_id
# 2. The outcome has been correctly determined
# 3. The player won their bet
#
# This allows the player to claim their winnings without
# revealing the secret nonce until after settlement.

k = 11;
field = "pallas";

# settle_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SettleBet_V2" {
    # No external constants needed for this simple verification
}

witness "SettleBet_V2" {
    # Known bet parameters (revealed during settle)
    Base bet_id,
    Base secret_nonce,
    Base player_pub_x,
    Base player_pub_y,
    Base bet_value,
    Base bet_type,
    Base asset_id,
    Base blind,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettleBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Verify the secret nonce derives the bet_id
    derived_bet_id = poseidon_hash(DOMAIN_COMMITMENT, 
        player_pub_x,
        player_pub_y,
        bet_type,
        bet_value,
        secret_nonce,
        blind,
        asset_id,
    );
    constrain_instance(derived_bet_id);

    # The actual card dealing and outcome calculation happens on-chain
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    # This circuit just verifies the player knows the secret nonce
}
