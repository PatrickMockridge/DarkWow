# Burn_V2 circuit - proves spending with nullifier reveal
# V2 changes from V1 (HAZOP H11): domain constants prepended to every poseidon_hash.
# Following money_v2 burn pattern: nullifier = poseidon_hash(spend_secret, coin)
# PRIVACY CRITICAL: This circuit enables private transfers
k = 11;
field = "pallas";

constant "Burn_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,   # G_v for Pedersen value commitment
    EcFixedPoint VALUE_COMMIT_RANDOM,       # G_r for blinding
    EcFixedPointBase NULLIFIER_K,           # For deriving public keys from secrets
}

witness "Burn_V2" {
    # Secret key for spending
    Base spend_secret,
    # Coin attributes (same as in mint)
    Base value,
    Base asset_id,
    Base coin_spend_hook,
    Base user_data,
    Base commitment_blind,
    # Blinding factors
    Scalar value_blind,
    Base asset_id_blind,
    Base user_data_blind,
    # Merkle proof
    Uint32 leaf_pos,
    MerklePath path,
    # Signature secret key — derived from spend_secret in-circuit (see below)
    Base signature_secret,
    # Signature public key coordinates (public inputs — bound below)
    Base signature_public_x,
    Base signature_public_y,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "Burn_V2" {
    # Domain constants: witness_base(N) creates a Base field element N.
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TOKEN_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);
    DOMAIN_USER_DATA_ENC = witness_base(6);
    DOMAIN_SIGNATURE_SECRET = witness_base(7);

    # Derive public key from secret (same pattern as money_v2)
    pub = ec_mul_base(spend_secret, NULLIFIER_K);
    derived_pub_x = ec_get_x(pub);
    derived_pub_y = ec_get_y(pub);

    # Coin hash using derived public key coordinates.
    coin = poseidon_hash(
        DOMAIN_COMMITMENT,
        derived_pub_x,
        derived_pub_y,
        value,
        asset_id,
        coin_spend_hook,
        user_data,
        commitment_blind,
    );

    # Nullifier.
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, spend_secret, coin);
    constrain_instance(nullifier);

    # Value commitment - Pedersen commitment of the value
    vcv = ec_mul_short(value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    value_commit = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(value_commit));
    constrain_instance(ec_get_y(value_commit));

    # Token ID commitment.
    asset_id_commit = poseidon_hash(DOMAIN_TOKEN_COMMIT, asset_id, asset_id_blind);
    constrain_instance(asset_id_commit);

    # Merkle proof
    ZERO = witness_base(0);
    less_than_strict(ZERO, value);
    coin_incl = zero_cond(value, coin);
    root = merkle_root(leaf_pos, path, coin_incl);
    constrain_instance(root);

    # Encrypted user data.
    user_data_enc = poseidon_hash(DOMAIN_USER_DATA_ENC, user_data, user_data_blind);
    constrain_instance(user_data_enc);

    # Reveal spend hook
    constrain_instance(coin_spend_hook);

    # Derive per-burn unique signature_secret from spend_secret + nullifier.
    derived_signature_secret = poseidon_hash(DOMAIN_SIGNATURE_SECRET, spend_secret, nullifier);
    constrain_equal_base(derived_signature_secret, signature_secret);

    # Derive signature public key from the per-burn signature_secret
    signature_public = ec_mul_base(signature_secret, NULLIFIER_K);
    derived_sig_pub_x = ec_get_x(signature_public);
    derived_sig_pub_y = ec_get_y(signature_public);
    constrain_equal_base(derived_sig_pub_x, signature_public_x);
    constrain_equal_base(derived_sig_pub_y, signature_public_y);

    constrain_instance(signature_public_x);
    constrain_instance(signature_public_y);

    # Range proof.
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, value);
}