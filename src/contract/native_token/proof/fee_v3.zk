# Fee_V3 circuit — pays transaction fees with hidden fee amount (CONSENSUS CRITICAL)
# V3 removes constrain_instance(fee) — the fee is a private witness.
# Adds fee_value_commit as public input for defense-in-depth commitment verification.
# FeeV1 uses Fee_V2 (fee.zk, fee exposed). FeeV2 uses Fee_V3 (fee hidden).
#
# This is a copy of fee.zk with these changes:
#   - constrain_instance(fee) REMOVED (fee is private witness only)
#   - fee_value_commit = PedersenCommit(fee, fee_value_blind) ADDED
#   - constrain_instance(fee_value_commit) ADDED (defense-in-depth, fee-spec.md §5.3 P5)
#   - fee_value_blind witness ADDED
# V2 changes from V1 (HAZOP H11): domain constants prepended to every poseidon_hash.
# This circuit must be simple, fast, and extremely reliable.
k = 11;
field = "pallas";

constant "Fee_V3" {
    EcFixedPointShort VALUE_COMMIT_VALUE,   # G_v for Pedersen value commitment
    EcFixedPoint VALUE_COMMIT_RANDOM,       # G_r for blinding
    EcFixedPointBase NULLIFIER_K,           # For deriving public keys from secrets
}

witness "Fee_V3" {
    Base input_secret,
    Uint32 input_leaf_pos,
    MerklePath input_path,
    Base signature_secret,
    Base signature_public_x,
    Base signature_public_y,
    Base input_value,
    Scalar input_value_blind,
    Base input_spend_hook,
    Base input_user_data,
    Base input_coin_blind,
    Base input_user_data_blind,
    Base output_value,
    Base output_spend_hook,
    Base output_user_data,
    Scalar output_value_blind,
    Base output_coin_blind,
    Base token,
    Base token_blind,
    Base fee,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
    Scalar fee_value_blind,
}

circuit "Fee_V3" {
    # Domain constants: witness_base(N) creates a Base field element N.
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TOKEN_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);
    DOMAIN_USER_DATA_ENC = witness_base(6);

    # Derive the input coin.
    pub = ec_mul_base(input_secret, NULLIFIER_K);
    pub_x = ec_get_x(pub);
    pub_y = ec_get_y(pub);
    input_coin = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        pub_x,
        pub_y,
        input_value,
        token,
        input_spend_hook,
        input_user_data,
        input_coin_blind,
    );

    # Nullifier.
    nullifier = poseidon_hash(DOMAIN_NULLIFIER, input_secret, input_coin);
    constrain_instance(nullifier);

    input_vcv = ec_mul_short(input_value, VALUE_COMMIT_VALUE);
    input_vcr = ec_mul(input_value_blind, VALUE_COMMIT_RANDOM);
    input_value_commit = ec_add(input_vcv, input_vcr);
    constrain_instance(ec_get_x(input_value_commit));
    constrain_instance(ec_get_y(input_value_commit));

    # Token ID commitment.
    token_commit = poseidon_hash(DOMAIN_TOKEN_COMMIT, token, token_blind);
    constrain_instance(token_commit);

    root = merkle_root(input_leaf_pos, input_path, input_coin);
    constrain_instance(root);

    # User data encryption.
    user_data_enc = poseidon_hash(DOMAIN_USER_DATA_ENC, input_user_data, input_user_data_blind);
    constrain_instance(user_data_enc);

    ZERO = witness_base(0);
    constrain_equal_base(input_spend_hook, ZERO);

    signature_public = ec_mul_base(signature_secret, NULLIFIER_K);
    derived_sig_pub_x = ec_get_x(signature_public);
    derived_sig_pub_y = ec_get_y(signature_public);
    constrain_equal_base(derived_sig_pub_x, signature_public_x);
    constrain_equal_base(derived_sig_pub_y, signature_public_y);
    constrain_instance(signature_public_x);
    constrain_instance(signature_public_y);

    # Output coin.
    output_coin = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        pub_x,
        pub_y,
        output_value,
        token,
        output_spend_hook,
        output_user_data,
        output_coin_blind,
    );
    constrain_instance(output_coin);

    output_vcv = ec_mul_short(output_value, VALUE_COMMIT_VALUE);
    output_vcr = ec_mul(output_value_blind, VALUE_COMMIT_RANDOM);
    output_value_commit = ec_add(output_vcv, output_vcr);
    constrain_instance(ec_get_x(output_value_commit));
    constrain_instance(ec_get_y(output_value_commit));

    # Value conservation: input = output + fee.
    # Fee is NOT exposed as a public input (unlike Fee_V2).
    # The prover proves they know fee such that input = output + fee,
    # and fee_value_commit is a Pedersen commitment to that fee.
    computed_sum = base_add(output_value, fee);
    constrain_equal_base(computed_sum, input_value);

    # Fee value commitment — Pedersen commitment to the hidden fee.
    # Defense-in-depth per fee-spec.md §5.3 P5: the contract verifies
    # this commitment matches FeeParamsV2.fee_value_commit without
    # learning the fee amount.
    fee_vcv = ec_mul_short(fee, VALUE_COMMIT_VALUE);
    fee_vcr = ec_mul(fee_value_blind, VALUE_COMMIT_RANDOM);
    fee_value_commit = ec_add(fee_vcv, fee_vcr);
    constrain_instance(ec_get_x(fee_value_commit));
    constrain_instance(ec_get_y(fee_value_commit));

    range_check(64, input_value);
    range_check(64, output_value);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    range_check(64, fee);
}