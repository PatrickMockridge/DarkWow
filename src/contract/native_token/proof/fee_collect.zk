# FeeCollect_V2 circuit — proves fee coin construction for the "collection plate."
# V2 changes from V1 (HAZOP H11): domain constants prepended to every poseidon_hash.
# The final transaction in every block. Forwards accumulated FeeV1 burns to the miner.
# Uses the same capability model as PoWRewardV1: nf = poseidon_hash(sk_H, C).
# No cumulative supply update — fees are redistribution, not minting.
#
# Key difference from Mint_V2: no S_H witnesses, no ec_add(old_cum, coin_vc).
# The circuit proves the miner knows sk_H (via nullifier) and constructs a valid
# fee coin with deterministic blinds. The entrypoint validates total_fees against
# fees_db[height] and the mass balance checker skips FeeCollectV2 calls.
#
# CONSENSUS CRITICAL: irreversible once deployed.
k = 11;
field = "pallas";

constant "FeeCollect_V2" {
    EcFixedPointShort VALUE_COMMIT_VALUE,   # G_v for Pedersen value commitment
    EcFixedPoint VALUE_COMMIT_RANDOM,       # G_r for blinding
    EcFixedPointBase NULLIFIER_K,           # For deriving public keys from secrets
}

witness "FeeCollect_V2" {
    # CoinAttributes — fee coin for the miner
    Base coin_public_x,      # pk_H.x — miner's per-block public key
    Base coin_public_y,      # pk_H.y
    Base coin_value,         # total_fees — sum of all FeeV1 burns in this block
    Base coin_token_id,      # DRKW_TOKEN_ID = 0
    Base coin_spend_hook,    # 0 (no restrictions)
    Base coin_user_data,     # 0
    Base coin_blind,         # deterministic from poseidon_hash(sk_H, height, domain=12)

    # Coin secret — sk_H.inner(). Proves miner knows the per-block derived key.
    # Same derivation as coinbase: derive_instance(sk_owner, NATIVE_TOKEN, H).
    Base coin_secret,

    # Blinding factors — all deterministic from (sk_H, height, typed domain)
    Scalar value_blind,      # domain=10
    Base token_blind,        # domain=11

    Base tx_commitment,
    Base tx_nonce,
}

circuit "FeeCollect_V2" {
    # Domain constants: witness_base(N) creates a Base field element N.
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TOKEN_COMMIT = witness_base(2);
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COIN_COMMIT = witness_base(4);

    # C1: Derive pk_H from sk_H — proves knowledge of secret key
    pk = ec_mul_base(coin_secret, NULLIFIER_K);
    pk_x = ec_get_x(pk);
    pk_y = ec_get_y(pk);

    # C2: Bind derived pk_H to witness values
    constrain_equal_base(pk_x, coin_public_x);
    constrain_equal_base(pk_y, coin_public_y);

    # C3: Coin commitment.
    C = poseidon_hash(
        DOMAIN_COIN_COMMIT,
        coin_public_x,
        coin_public_y,
        coin_value,
        coin_token_id,
        coin_spend_hook,
        coin_user_data,
        coin_blind,
    );
    constrain_instance(C);

    # C4: Nullifier — capability claim.
    nf = poseidon_hash(DOMAIN_NULLIFIER, coin_secret, C);
    constrain_instance(nf);

    # C5-C6: Pedersen value commitment
    vcv = ec_mul_short(coin_value, VALUE_COMMIT_VALUE);
    vcr = ec_mul(value_blind, VALUE_COMMIT_RANDOM);
    vc = ec_add(vcv, vcr);
    constrain_instance(ec_get_x(vc));
    constrain_instance(ec_get_y(vc));

    # C7: Token commitment.
    tc = poseidon_hash(DOMAIN_TOKEN_COMMIT, coin_token_id, token_blind);
    constrain_instance(tc);

    # C8: Transaction binding.
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);

    # C9: Range check
    range_check(64, coin_value);
}