k = 11;
field = "pallas";

constant "SM_CrossMulLTEU64_V1" {
}

witness "SM_CrossMulLTEU64_V1" {
    Base lhs_num,
    Base lhs_den,
    Base rhs_num,
    Base rhs_den,
}

circuit "SM_CrossMulLTEU64_V1" {
    ZERO = witness_base(0);
    ONE = witness_base(1);

    # Each input is u64, so both cross-products fit below 2^128 and can be
    # compared directly with stock official DarkFi's field comparison gadgets.
    range_check(64, lhs_num);
    range_check(64, lhs_den);
    range_check(64, rhs_num);
    range_check(64, rhs_den);

    less_than_strict(ZERO, lhs_den);
    less_than_strict(ZERO, rhs_den);

    lhs_cross = base_mul(lhs_num, rhs_den);
    rhs_cross = base_mul(rhs_num, lhs_den);
    rhs_cross_plus_one = base_add(rhs_cross, ONE);

    less_than_strict(lhs_cross, rhs_cross_plus_one);
}
