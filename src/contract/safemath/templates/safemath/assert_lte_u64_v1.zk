k = 11;
field = "pallas";

constant "SafeMath_AssertLTEU64_V1" {
}

witness "SafeMath_AssertLTEU64_V1" {
    Base lhs,
    Base rhs,
}

circuit "SafeMath_AssertLTEU64_V1" {
    ONE = witness_base(1);

    range_check(64, lhs);
    range_check(64, rhs);

    # rhs < 2^64 keeps rhs + 1 below 2^65 without field wrap.
    rhs_plus_one = base_add(rhs, ONE);
    less_than_strict(lhs, rhs_plus_one);
}
