k = 11;
field = "pallas";

constant "SafeMath_RatioLTE_V1" {
}

witness "SafeMath_RatioLTE_V1" {
    Base lhs_num,
    Base lhs_den,
    Base rhs_num,
    Base rhs_den,
}

circuit "SafeMath_RatioLTE_V1" {
    ZERO = witness_base(0);
    ONE = witness_base(1);

    # 126-bit ratio limbs keep cross products within the compare-safe 252-bit domain.
    range_check(126, lhs_num);
    range_check(126, lhs_den);
    range_check(126, rhs_num);
    range_check(126, rhs_den);

    less_than_strict(ZERO, lhs_den);
    less_than_strict(ZERO, rhs_den);

    lhs_cross = base_mul(lhs_num, rhs_den);
    rhs_cross = base_mul(rhs_num, lhs_den);

    range_check(252, lhs_cross);
    range_check(252, rhs_cross);

    rhs_cross_plus_one = base_add(rhs_cross, ONE);
    range_check(253, rhs_cross_plus_one);

    less_than_strict(lhs_cross, rhs_cross_plus_one);
}
