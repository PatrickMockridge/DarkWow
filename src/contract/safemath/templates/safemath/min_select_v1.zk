k = 11;
field = "pallas";

constant "SafeMath_MinSelect_V1" {
}

witness "SafeMath_MinSelect_V1" {
    Base lhs,
    Base rhs,
    Base min_value,
    Base choose_lhs,
}

circuit "SafeMath_MinSelect_V1" {
    ONE = witness_base(1);

    # compare-safe values can use the +1 transform without wrapping.
    range_check(252, lhs);
    range_check(252, rhs);
    range_check(252, min_value);
    bool_check(choose_lhs);

    selected = cond_select(choose_lhs, lhs, rhs);
    constrain_equal_base(selected, min_value);

    lhs_plus_one = base_add(lhs, ONE);
    rhs_plus_one = base_add(rhs, ONE);
    upper_bound = cond_select(choose_lhs, rhs_plus_one, lhs_plus_one);

    # If choose_lhs = 1, enforce lhs <= rhs.
    # If choose_lhs = 0, enforce rhs <= lhs.
    less_than_strict(min_value, upper_bound);
}
