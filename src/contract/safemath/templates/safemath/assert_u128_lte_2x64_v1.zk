k = 11;
field = "pallas";

constant "SM_AssertU128LTE_2x64_V1" {
}

witness "SM_AssertU128LTE_2x64_V1" {
    Base lhs_lo,
    Base lhs_hi,
    Base rhs_lo,
    Base rhs_hi,
}

circuit "SM_AssertU128LTE_2x64_V1" {
    ONE = witness_base(1);
    TWO_POW_32 = witness_base(4294967296);
    TWO_POW_64 = base_mul(TWO_POW_32, TWO_POW_32);

    # Comparison is sound because both packed values are built from range-checked u64 limbs.
    range_check(64, lhs_lo);
    range_check(64, lhs_hi);
    range_check(64, rhs_lo);
    range_check(64, rhs_hi);

    lhs_hi_scaled = base_mul(lhs_hi, TWO_POW_64);
    lhs = base_add(lhs_lo, lhs_hi_scaled);

    rhs_hi_scaled = base_mul(rhs_hi, TWO_POW_64);
    rhs = base_add(rhs_lo, rhs_hi_scaled);
    rhs_plus_one = base_add(rhs, ONE);

    less_than_strict(lhs, rhs_plus_one);
}
