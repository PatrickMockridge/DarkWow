k = 11;
field = "pallas";

constant "SM_MinSelectU128_2x64_V1" {
}

witness "SM_MinSelectU128_2x64_V1" {
    Base lhs_lo,
    Base lhs_hi,
    Base rhs_lo,
    Base rhs_hi,
    Base min_lo,
    Base min_hi,
    Base choose_lhs,
}

circuit "SM_MinSelectU128_2x64_V1" {
    ONE = witness_base(1);
    TWO_POW_32 = witness_base(4294967296);
    TWO_POW_64 = base_mul(TWO_POW_32, TWO_POW_32);

    range_check(64, lhs_lo);
    range_check(64, lhs_hi);
    range_check(64, rhs_lo);
    range_check(64, rhs_hi);
    range_check(64, min_lo);
    range_check(64, min_hi);
    bool_check(choose_lhs);

    lhs_hi_scaled = base_mul(lhs_hi, TWO_POW_64);
    lhs = base_add(lhs_lo, lhs_hi_scaled);

    rhs_hi_scaled = base_mul(rhs_hi, TWO_POW_64);
    rhs = base_add(rhs_lo, rhs_hi_scaled);

    min_hi_scaled = base_mul(min_hi, TWO_POW_64);
    min_value = base_add(min_lo, min_hi_scaled);

    selected = cond_select(choose_lhs, lhs, rhs);
    constrain_equal_base(selected, min_value);

    lhs_plus_one = base_add(lhs, ONE);
    rhs_plus_one = base_add(rhs, ONE);
    upper_bound = cond_select(choose_lhs, rhs_plus_one, lhs_plus_one);

    # If choose_lhs = 1, enforce lhs <= rhs.
    # If choose_lhs = 0, enforce rhs <= lhs.
    less_than_strict(min_value, upper_bound);
}
