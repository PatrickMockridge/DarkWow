k = 11;
field = "pallas";

constant "SM_SqrtFloorU128_V1" {
}

witness "SM_SqrtFloorU128_V1" {
    Base radicand_lo,
    Base radicand_hi,
    Base root,
}

circuit "SM_SqrtFloorU128_V1" {
    ONE = witness_base(1);
    TWO_POW_32 = witness_base(4294967296);
    TWO_POW_64 = base_mul(TWO_POW_32, TWO_POW_32);

    # Public stock contract: a u128 radicand encoded as two u64 limbs, with the
    # floor square root returned as a u64. That narrowing is exact for all u128 inputs.
    range_check(64, radicand_lo);
    range_check(64, radicand_hi);
    range_check(64, root);

    radicand_hi_scaled = base_mul(radicand_hi, TWO_POW_64);
    radicand = base_add(radicand_lo, radicand_hi_scaled);

    root_sq = base_mul(root, root);
    next_root = base_add(root, ONE);
    next_root_sq = base_mul(next_root, next_root);
    radicand_plus_one = base_add(radicand, ONE);

    # root^2 <= radicand
    less_than_strict(root_sq, radicand_plus_one);
    # radicand < (root + 1)^2
    less_than_strict(radicand, next_root_sq);
}
