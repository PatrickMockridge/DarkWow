k = 11;
field = "pallas";

constant "SM_DivFloorU128ByU64ToU64_V1" {
}

witness "SM_DivFloorU128ByU64ToU64_V1" {
    Base numerator_lo,
    Base numerator_hi,
    Base denominator,
    Base quotient,
    Base remainder,
}

circuit "SM_DivFloorU128ByU64ToU64_V1" {
    ZERO = witness_base(0);
    TWO_POW_32 = witness_base(4294967296);
    TWO_POW_64 = base_mul(TWO_POW_32, TWO_POW_32);

    # Public stock contract: a stock-compatible u128 numerator divided by a u64
    # denominator, with the quotient intentionally narrowed to a u64 AMM-state output.
    range_check(64, numerator_lo);
    range_check(64, numerator_hi);
    range_check(64, denominator);
    range_check(64, quotient);
    range_check(64, remainder);

    less_than_strict(ZERO, denominator);
    less_than_strict(remainder, denominator);

    numerator_hi_scaled = base_mul(numerator_hi, TWO_POW_64);
    numerator = base_add(numerator_lo, numerator_hi_scaled);

    denominator_times_quotient = base_mul(denominator, quotient);
    recomposed = base_add(denominator_times_quotient, remainder);
    constrain_equal_base(recomposed, numerator);
}
