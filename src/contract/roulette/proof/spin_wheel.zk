# Roulette Spin Wheel Circuit (Version 1)
#
# Proves house authorizes spinning the wheel. Replaces Schnorr.
#
# Public Inputs: table_id, house_pub_x, house_pub_y, spin_nullifier, tx_commitment
# Witnesses: table_id, house_secret, house_pub_x, house_pub_y, spin_nullifier, tx_commitment

k = 11;
field = "pallas";

# spin_wheel_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SpinWheel_V2" {
    EcFixedPointBase NULLIFIER_K,
}

witness "SpinWheel_V2" {
    Base table_id,
    Base house_secret,
    Base house_pub_x,
    Base house_pub_y,
    Base spin_nullifier,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SpinWheel_V2" {
    DOMAIN_NULLIFIER = witness_base(1);
    DOMAIN_TX_BINDING = witness_base(3);

    house_pub = ec_mul_base(house_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(house_pub), house_pub_x);
    constrain_equal_base(ec_get_y(house_pub), house_pub_y);
    computed_nullifier = poseidon_hash(DOMAIN_NULLIFIER, table_id, house_secret);
    constrain_equal_base(computed_nullifier, spin_nullifier);
    constrain_instance(table_id);
    constrain_instance(house_pub_x);
    constrain_instance(house_pub_y);
    constrain_instance(spin_nullifier);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
