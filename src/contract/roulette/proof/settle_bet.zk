# ZK Circuit for SettleBetV1
# Proves correct settlement of bets after wheel spin

k = 11;
field = "pallas";

# settle_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "SettleBet_V2" {
}

witness "SettleBet_V2" {
    Base table_id,
    Base bet_id,
    Base won,
    Base payout,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "SettleBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);

    # Payout is calculated externally and verified here
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_instance(payout);
}