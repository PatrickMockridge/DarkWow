# ZK Circuit for PlaceBetV1
# Proves player has valid bet without revealing numbers or amount

k = 11;
field = "pallas";

# place_bet_V2 — domain-separated circuit.
# V2 changes from V1 (HAZOP RC3):
#   - Domain separation: every poseidon_hash prepends a unique domain constant

constant "PlaceBet_V2" {
}

witness "PlaceBet_V2" {
    Base table_id,
    Base player_pub_x,
    Base player_pub_y,
    Base bet_type,
    Base amount,
    Base nonce,
    Base bet_id,
    Base nullifier,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PlaceBet_V2" {
    DOMAIN_TX_BINDING = witness_base(3);
    DOMAIN_COMMITMENT = witness_base(4);

    # Verify bet commitment matches
    derived_bet_id = poseidon_hash(DOMAIN_COMMITMENT, table_id, player_pub_x, player_pub_y, amount);
    constrain_equal_base(derived_bet_id, bet_id);

    # Verify nullifier
    derived_nullifier = poseidon_hash(DOMAIN_COMMITMENT, bet_id, nonce);
    tx_binding = poseidon_hash(DOMAIN_TX_BINDING, tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
    constrain_equal_base(derived_nullifier, nullifier);
}