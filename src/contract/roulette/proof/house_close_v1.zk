# Roulette House Close Circuit (Version 1)
#
# Proves house authorizes closing a table. Replaces Schnorr.
#
# Public Inputs: table_id, house_pub_x, house_pub_y, close_nullifier, tx_commitment
# Witnesses: table_id, house_secret, house_pub_x, house_pub_y, close_nullifier, tx_commitment

k = 11;
field = "pallas";

constant "HouseClose_V1" {
    EcFixedPointBase NULLIFIER_K,
}

witness "HouseClose_V1" {
    Base table_id,
    Base house_secret,
    Base house_pub_x,
    Base house_pub_y,
    Base close_nullifier,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "HouseClose_V1" {
    house_pub = ec_mul_base(house_secret, NULLIFIER_K);
    constrain_equal_base(ec_get_x(house_pub), house_pub_x);
    constrain_equal_base(ec_get_y(house_pub), house_pub_y);
    computed_nullifier = poseidon_hash(table_id, house_secret);
    constrain_equal_base(computed_nullifier, close_nullifier);
    constrain_instance(table_id);
    constrain_instance(house_pub_x);
    constrain_instance(house_pub_y);
    constrain_instance(close_nullifier);
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}
