# ZK Circuit for PlaceBetV1
# Proves player has valid bet without revealing numbers or amount

k = 11;
field = "pallas";

constant "PlaceBet_V1" {
}

witness "PlaceBet_V1" {
    Base table_id,
    Base player_pub_x,
    Base player_pub_y,
    Base bet_type,
    Base amount,
    Base nonce,
    Base bet_id,
    Base nullifier,
    Base tx_commitment,
    Base tx_nonce,
    Base tx_binding,
}

circuit "PlaceBet_V1" {
    # Verify bet commitment matches
    derived_bet_id = poseidon_hash(table_id, player_pub_x, player_pub_y, amount);
    constrain_equal_base(derived_bet_id, bet_id);

    # Verify nullifier
    derived_nullifier = poseidon_hash(bet_id, nonce);
    constrain_equal_base(derived_nullifier, nullifier);

    # Transaction binding
    tx_binding = poseidon_hash(tx_commitment, tx_nonce);

    # HAZOP C-9 fix: expose application-level values as public inputs.
    # table_id, player_pub_x/y, and amount are the raw inputs; bet_id and
    # nullifier are derived in-circuit and constrained internally. The
    # verifier can now check which table, player, and amount the proof is for.
    # TODO: expose bet_id and nullifier once metadata can replicate circuit
    # derivation (requires computing nonce from instance_seed + spin_count).
    constrain_instance(table_id);
    constrain_instance(player_pub_x);
    constrain_instance(player_pub_y);
    constrain_instance(amount);
    constrain_instance(tx_binding);
    constrain_instance(tx_nonce);
}