(constant 'LIB (or (env "DARKWOW_LIB") "libdwow_wallet.so"))
(import LIB "dwow_wallet_version")
(import LIB "dwow_wallet_open")
(import LIB "dwow_wallet_free")
(import LIB "dwow_wallet_scan_block_json")
(import LIB "dwow_wallet_cap_count")
(import LIB "dwow_wallet_balance")
(import LIB "dwow_wallet_chain_height")

(context 'DarkWow)
(define (open keys-path section network)
  (dwow_wallet_open keys-path section network))
(define (close handle) (dwow_wallet_free handle))
(define (scan-block handle json) (dwow_wallet_scan_block_json handle json))
(define (cap-count handle) (dwow_wallet_cap_count handle))
(define (balance handle) (dwow_wallet_balance handle))
(define (chain-height handle) (dwow_wallet_chain_height handle))
(define (version) (dwow_wallet_version))
(context 'MAIN)
